  startAutoRefresh(): void {
    this.refreshSubscription = interval(this.REFRESH_INTERVAL).subscribe(() => {
      this.refreshAllZones();
    });
  }
  refreshAllZones(): void {
    this.lineZones.forEach((z) => {
      this.loadDataForZone(z.line, z.zone);
    });
  }
  ngAfterViewInit(): void {
    this.paginators.forEach((paginator, index) => {
      const z = this.lineZones[index];
      const key = this.getKey(z.line, z.zone);
      this.dataSources[key].paginator = paginator;
