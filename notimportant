    public ResponseEntity<?> executeStoredProcedure(DataSource dataSource, String storedProcedure, Object... params) {
        try (Connection connection = DataSourceUtils.getConnection(dataSource);
             CallableStatement callableStatement = connection.prepareCall(storedProcedure)) {

            for (int i = 0; i < params.length; i++) {
                if (params[i] instanceof Timestamp) {
                    callableStatement.setTimestamp(i + 1, (Timestamp) params[i]);
                } else if (params[i] instanceof String) {
                    callableStatement.setString(i + 1, (String) params[i]);
                } else if (params[i] instanceof Integer) {
                    callableStatement.setInt(i + 1, (Integer) params[i]);
                }
            }

            boolean hasResultSet = callableStatement.execute();
            if (!hasResultSet) {
                // No result set returned by the stored procedure
                Map<String, Object> response = new HashMap<>();
                response.put("status",200);
                response.put("message","Request Processed successfully.");
                return ResponseEntity.ok(response);
            }
            if (dataSource instanceof DriverManagerDataSource) {
                DriverManagerDataSource dmds = (DriverManagerDataSource) dataSource;
                String url = dmds.getUrl();
                logger.info("Result obtained from URL: " + url);
            }
            ResultSet resultSet = callableStatement.getResultSet();
            List<Map<String, Object>> resultList = mapResultSetToList(resultSet);

            ObjectMapper objectMapper = new ObjectMapper();
            String resultJson = objectMapper.writeValueAsString(resultList);

            return ResponseEntity.ok(resultJson);

        } catch (SQLException | IOException e) {
            if (dataSource instanceof DriverManagerDataSource) {
                DriverManagerDataSource dmds = (DriverManagerDataSource) dataSource;
                String url = dmds.getUrl();
                logger.error(e.getMessage() + "URL: " + url);
            }
            logger.error(e.getMessage());
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Failed to execute stored procedure.");
        }
    }

    public static List<Map<String, Object>> mapResultSetToList(ResultSet resultSet) throws SQLException {
        ResultSetMetaData metaData = resultSet.getMetaData();
        int columnCount = metaData.getColumnCount();
        List<Map<String, Object>> resultList = new ArrayList<>();

        while (resultSet.next()) {
            Map<String, Object> row = new HashMap<>();
            for (int i = 1; i <= columnCount; i++) {
                String columnName = metaData.getColumnName(i);
                Object value = resultSet.getObject(i);
                row.put(columnName, value);
            }
            resultList.add(row);
        }

        return resultList;
    }
    @PostMapping("/getSideTabs")
    public ResponseEntity<?> getSideTabs(@RequestBody Map<String, String> requestBody) {
        int UID = Integer.parseInt(requestBody.get("UID"));

        String storedProcedure = "SELECT * FROM tab_access(?)"; // Update the stored procedure name
        try (Connection connection = DataSourceUtils.getConnection(PostgresDataSource);) {
            if (connection != null) {
                CallableStatement callableStatement = connection.prepareCall(storedProcedure);
                callableStatement.setInt(1, UID);

                ResultSet resultSet = callableStatement.executeQuery();

                List<Map<String, Object>> resultList = new ArrayList<>();
                Map<String, List<Map<String, Object>>> reportsMap = new HashMap<>();
                boolean reportsStatus = false;

                while (resultSet.next()) {
                    String tabName = resultSet.getString("Tab");
                    int tabId = resultSet.getInt("tab_id");
                    boolean status = resultSet.getBoolean("Status");

                    if (tabName.startsWith("Reports")) {
                        String category = "Reports";
                        reportsMap.putIfAbsent(category, new ArrayList<>());
                        List<Map<String, Object>> categoryTabs = reportsMap.get(category);
                        Map<String, Object> reportTab = new HashMap<>();
                        reportTab.put("label", tabName.substring(tabName.indexOf(":") + 2));
                        reportTab.put("tab_id", tabId);
                        reportTab.put("Status", status);
                        categoryTabs.add(reportTab);
                        reportsStatus |= status; // Update reportsStatus
                    } else {
                        Map<String, Object> tabMap = new HashMap<>();
                        tabMap.put("label", tabName);
                        tabMap.put("tab_id", tabId);
                        tabMap.put("Status", status);
                        resultList.add(tabMap);
                    }
                }

                if (!reportsMap.isEmpty()) {
                    Map<String, Object> reportsCategory = new HashMap<>();
                    reportsCategory.put("label", "Reports");
                    reportsCategory.put("children", reportsMap.get("Reports"));
                    reportsCategory.put("Status", reportsStatus); // Set status for reports category
                    resultList.add(reportsCategory);
                }

                return ResponseEntity.ok(resultList);
            } else {
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Failed to connect to the database.");
            }
        } catch (SQLException e) {
            e.printStackTrace();
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error generating report.");
        }
    }

    @GetMapping("/tabs")
