import { Component, EventEmitter, OnInit, Output } from '@angular/core';
import {
  FormBuilder,
  FormControl,
  FormGroup,
  Validators
} from '@angular/forms';
import { environment } from 'src/environments/environment';
import { NgbModal } from '@ng-bootstrap/ng-bootstrap';
import { Global } from 'src/app/shared/constants/Global';
import { AuthService } from 'src/app/shared/services/auth.service';
import { ToastrMsgService } from 'src/app/shared/services/toastr-msg.service';
@Component({
  selector: 'app-header',
  templateUrl: './header.component.html',
  styleUrls: ['./header.component.scss']
})
export class HeaderComponent implements OnInit {
  sidebarForm = new FormControl();
  sideMenu: boolean = false;
  @Output() sidenavToggled = new EventEmitter<boolean>();
  readonly appName = environment.appName;
  loggedInUsername: any = sessionStorage.getItem('tokenKey');
  updatePwdForm!: FormGroup;
  isPasswordVisible = false;
  constructor(
    private authService: AuthService,
    private modalService: NgbModal,
    private toastrMsgService: ToastrMsgService,
    private fb: FormBuilder
  ) {}
  ngOnInit(): void {
    if (this.loggedInUsername) {
      this.loggedInUsername = JSON.parse(this.loggedInUsername);
    }
    this.createUpdatePwdForm();
  }
  createUpdatePwdForm() {
    this.updatePwdForm = this.fb.group({
      currentPassword: ['', [Validators.required]],
      newPassword: ['', [Validators.required, Validators.minLength(4)]],
      confirmNewPassword: ['', [Validators.required]]
    });
  }
  sideNavToggle() {
    this.sideMenu = !this.sideMenu;
    this.sidenavToggled.emit(this.sideMenu);
  }
  signOut() {
    this.authService.shareModalPopup();
  }
  open(content: any) {
    this.modalService.open(content, { ariaLabelledBy: 'modal-basic-title' });
  }
  onUpdatePassword() {
    const newPassword = this.updatePwdForm.controls['newPassword'].value;
    const confirmNewPassword =
      this.updatePwdForm.controls['confirmNewPassword'].value;
    if (newPassword !== confirmNewPassword) {
      this.toastrMsgService.showWarningMsg(
        'New password & Confirm new password must be same.'
      );
      return;
    } else {
      const updatePwdObj = {
        userId: this.loggedInUsername.userID,
        currentPassword: this.updatePwdForm.controls['currentPassword'].value,
        newPassword: newPassword,
        confirmNewPassword: confirmNewPassword
      };
      this.authService
        .httpPostRequest(Global['UPDATE_PASSWORD'], updatePwdObj)
        .subscribe({
          next: (res: any) => {
            if (res.status == 200) {
              this.toastrMsgService.showSuccessMsg(res.message);
              this.updatePwdForm.reset();
              this.modalService.dismissAll();
            }
          }
        });
    }
  }
}
