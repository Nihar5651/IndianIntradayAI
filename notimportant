import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import jakarta.transaction.Transactional;
import java.io.InputStream;
import java.time.LocalDateTime;
import java.util.*;
import java.util.stream.Collectors;

@Service
public class MacKittingService {

    private final MacArticleRepository macArticleRepository;
    private final LineAllowedHierarchyRepository lineAllowedHierarchyRepository;
    private final PartMasterRepository partMasterRepository;

    public MacKittingService(MacArticleRepository macArticleRepository,
                             LineAllowedHierarchyRepository lineAllowedHierarchyRepository,
                             PartMasterRepository partMasterRepository) {
        this.macArticleRepository = macArticleRepository;
        this.lineAllowedHierarchyRepository = lineAllowedHierarchyRepository;
        this.partMasterRepository = partMasterRepository;
    }

    @Transactional
    public MacKittingUploadResult uploadExcel(MultipartFile file, String uploadedBy) {
        List<String> errors = new ArrayList<>();

        // Build allowed set for (lineDenotion, zone)
        Set<String> allowedLineZone = new HashSet<>();
        List<LineAllowedHierarchy> allowedList = lineAllowedHierarchyRepository.findAll();
        for (LineAllowedHierarchy lah : allowedList) {
            String key = normalize(lah.getLineDenotion()) + "|" + normalize(lah.getZone());
            allowedLineZone.add(key);
        }

        List<MacArticle> toSave = new ArrayList<>();

        try (InputStream is = file.getInputStream(); Workbook wb = WorkbookFactory.create(is)) {
            Sheet sheet = wb.getSheetAt(0);
            if (sheet == null) {
                errors.add("No sheet found in Excel file");
                return new MacKittingUploadResult(false, null, errors);
            }

            Iterator<Row> rows = sheet.iterator();
            if (!rows.hasNext()) {
                errors.add("Excel file is empty (no header row)");
                return new MacKittingUploadResult(false, null, errors);
            }

            Row header = rows.next();
            Map<String, Integer> headerIndex = new HashMap<>();
            for (Cell c : header) {
                String h = c.getStringCellValue();
                if (h != null) {
                    headerIndex.put(h.trim().toUpperCase(), c.getColumnIndex());
                }
            }

            String[] requiredHeaders = new String[] {
                    "ARTICLEID", "PTLMACADDRESS 4.3", "ITEM_CODE", "LINE", "LINEDENOTION", "ZONE"
            };
            for (String req : requiredHeaders) {
                if (!headerIndex.containsKey(req)) {
                    errors.add("Missing required header: " + req + " (exact header text expected)");
                }
            }
            if (!errors.isEmpty()) return new MacKittingUploadResult(false, null, errors);

            Map<String, Integer> fileArticleCount = new HashMap<>();
            // 🔥 TRACK WHERE THE ITEM IS GOING, NOT JUST HOW MANY TIMES
            Map<String, List<String>> fileItemLocations = new HashMap<>();
            List<Row> rowsToProcess = new ArrayList<>();
            int rowNum = 1;

            while (rows.hasNext()) {
                rowNum++;
                Row r = rows.next();
                boolean allBlank = true;
                for (String req : requiredHeaders) {
                    int idx = headerIndex.get(req);
                    Cell c = r.getCell(idx);
                    if (c != null && c.getCellType() != CellType.BLANK) {
                        String v = getCellValue(c);
                        if (!v.isEmpty()) {
                            allBlank = false;
                            break;
                        }
                    }
                }
                if (allBlank) {
                    errors.add("Empty row found at Excel row " + rowNum + ". Please remove or fill it.");
                    return new MacKittingUploadResult(false, null, errors);
                }

                List<String> missingCols = new ArrayList<>();
                for (String req : requiredHeaders) {
                    int idx = headerIndex.get(req);
                    String v = getCellValue(r.getCell(idx)).trim();
                    if (v.isEmpty()) {
                        missingCols.add(req);
                    }
                }
                if (!missingCols.isEmpty()) {
                    errors.add("Row " + rowNum + " missing required values for: " + missingCols);
                    return new MacKittingUploadResult(false, null, errors);
                }

                // Track data for validation
                String articleId = getCellValue(r.getCell(headerIndex.get("ARTICLEID"))).trim();
                String itemCode = getCellValue(r.getCell(headerIndex.get("ITEM_CODE"))).trim();
                String trackLine = normalize(getCellValue(r.getCell(headerIndex.get("LINEDENOTION"))));
                String trackZone = normalize(getCellValue(r.getCell(headerIndex.get("ZONE"))));

                fileArticleCount.put(articleId, fileArticleCount.getOrDefault(articleId, 0) + 1);

                // 🔥 Add the exact Line|Zone to this item's location list
                fileItemLocations.computeIfAbsent(itemCode, k -> new ArrayList<>()).add(trackLine + "|" + trackZone);

                rowsToProcess.add(r);
            }

            // 1️⃣ Validate: Check for duplicate Article IDs inside the file
            List<String> dupArticlesInFile = fileArticleCount.entrySet().stream()
                    .filter(e -> e.getValue() > 1)
                    .map(Map.Entry::getKey)
                    .collect(Collectors.toList());
            if (!dupArticlesInFile.isEmpty()) {
                errors.add("Duplicate ArticleId(s) found inside the uploaded file: " + dupArticlesInFile);
                return new MacKittingUploadResult(false, null, errors);
            }

            // 2️⃣ Validate: Smart Duplicate Check (Allows Door Line Exceptions)
            List<String> invalidDuplicates = new ArrayList<>();
            for (Map.Entry<String, List<String>> entry : fileItemLocations.entrySet()) {
                String item = entry.getKey();
                List<String> locations = entry.getValue();

                // If the part appears more than once...
                if (locations.size() > 1) {
                    boolean allDoorLine = true;
                    for (String loc : locations) {
                        // Check if every single assignment is strictly within the Door line ("DR")
                        if (!loc.startsWith("DR|")) {
                            allDoorLine = false;
                            break;
                        }
                    }
                    // If even one location was outside the Door line, it's an illegal duplicate
                    if (!allDoorLine) {
                        invalidDuplicates.add(item + " -> " + locations);
                    }
                }
            }

            if (!invalidDuplicates.isEmpty()) {
                errors.add("Duplicate ITEM_CODE(s) found. Duplicates are ONLY allowed if all bins are strictly within the Door line (DR). Illegal parts: " + invalidDuplicates);
                return new MacKittingUploadResult(false, null, errors);
            }

            // Preload Part Masters for Cross-Validation
            Map<String, PartMaster> partMasterMap = new HashMap<>();
            for (PartMaster pm : partMasterRepository.findAll()) {
                partMasterMap.put(normalize(pm.getPartNumber()), pm);
            }

            // 3️⃣ Validate: Line/Zone Hierarchy & Cross-Validation against Part Master
            int excelRowIndex = 1;
            for (Row r : rowsToProcess) {
                excelRowIndex++;
                String lineDenotion = normalize(getCellValue(r.getCell(headerIndex.get("LINEDENOTION"))));
                String zone = normalize(getCellValue(r.getCell(headerIndex.get("ZONE"))));
                String itemCode = normalize(getCellValue(r.getCell(headerIndex.get("ITEM_CODE"))));

                String key = lineDenotion + "|" + zone;
                if (!allowedLineZone.contains(key)) {
                    errors.add("Row " + excelRowIndex + " invalid combination of LineDenotion & Zone: [" + lineDenotion + " / " + zone + "]");
                }

                // 🛡️ THE CROSS-VALIDATION SHIELD
                PartMaster masterRecord = partMasterMap.get(itemCode);
                if (masterRecord == null) {
                    errors.add("Row " + excelRowIndex + ": ITEM_CODE " + itemCode + " DOES NOT EXIST in the Part Master. Please upload it there first.");
                } else {
                    String pmLine = normalize(masterRecord.getLine());
                    String pmZone = normalize(masterRecord.getZone());

                    // 🔥 DOOR BYPASS: If PartMaster says it is a Door part (DR), and the MAC Excel says it is a Door part (DR),
                    // we bypass the strict Zone check so it can exist in both Z1 and Z2 simultaneously.
                    boolean isDoorException = pmLine.equals("DR") && lineDenotion.equals("DR");

                    if (!isDoorException && (!pmLine.equals(lineDenotion) || !pmZone.equals(zone))) {
                        errors.add("CROSS-VALIDATION FAILED (Row " + excelRowIndex + "): ITEM_CODE " + itemCode +
                                " belongs to [" + masterRecord.getLine() + " / " + masterRecord.getZone() +
                                "] according to Part Master. MAC file is trying to map it to [" +
                                getCellValue(r.getCell(headerIndex.get("LINEDENOTION"))) + " / " +
                                getCellValue(r.getCell(headerIndex.get("ZONE"))) + "].");
                    }
                }
            }

            // If any errors were found in validation, abort entirely
            if (!errors.isEmpty()) {
                return new MacKittingUploadResult(false, null, errors);
            }

            // Prepare summarize map (line->zone->{inserted,updated})
            Map<String, Map<String, Object>> details = new HashMap<>();
            int totalInserted = 0;
            int totalUpdated = 0;

            // Process and build toSave list
            for (Row r : rowsToProcess) {
                String articleId = getCellValue(r.getCell(headerIndex.get("ARTICLEID"))).trim();
                String macAddr = getCellValue(r.getCell(headerIndex.get("PTLMACADDRESS 4.3"))).trim();
                String itemCode = getCellValue(r.getCell(headerIndex.get("ITEM_CODE"))).trim();
                String line = getCellValue(r.getCell(headerIndex.get("LINE"))).trim();
                String lineDenotion = getCellValue(r.getCell(headerIndex.get("LINEDENOTION"))).trim();
                String zone = getCellValue(r.getCell(headerIndex.get("ZONE"))).trim();

                Optional<MacArticle> existingOpt = macArticleRepository.findById(articleId);
                MacArticle m;
                if (existingOpt.isPresent()) {
                    m = existingOpt.get();
                    m.setMacAddress(macAddr);
                    m.setItemCode(itemCode);
                    m.setLine(line);
                    m.setLineDenotion(lineDenotion);
                    m.setZone(zone);
                    m.setUploadedBy(uploadedBy);
                    m.setUploadTimestamp(LocalDateTime.now());
                    totalUpdated++;

                    details.computeIfAbsent(line, k -> new HashMap<>());
                    Map<String, Object> zoneMap = details.get(line);
                    @SuppressWarnings("unchecked")
                    Map<String, Integer> inner = (Map<String, Integer>) zoneMap.get(zone);
                    if (inner == null) {
                        inner = new HashMap<>();
                        inner.put("inserted", 0);
                        inner.put("updated", 1);
                        zoneMap.put(zone, inner);
                    } else {
                        inner.put("updated", inner.getOrDefault("updated", 0) + 1);
                    }
                } else {
                    m = new MacArticle();
                    m.setArticleId(articleId);
                    m.setMacAddress(macAddr);
                    m.setItemCode(itemCode);
                    m.setLine(line);
                    m.setLineDenotion(lineDenotion);
                    m.setZone(zone);
                    m.setUploadedBy(uploadedBy);
                    m.setUploadTimestamp(LocalDateTime.now());
                    totalInserted++;

                    details.computeIfAbsent(line, k -> new HashMap<>());
                    Map<String, Object> zoneMap = details.get(line);
                    @SuppressWarnings("unchecked")
                    Map<String, Integer> inner = (Map<String, Integer>) zoneMap.get(zone);
                    if (inner == null) {
                        inner = new HashMap<>();
                        inner.put("inserted", 1);
                        inner.put("updated", 0);
                        zoneMap.put(zone, inner);
                    } else {
                        inner.put("inserted", inner.getOrDefault("inserted", 0) + 1);
                    }
                }
                toSave.add(m);
            }

            // Save all (batch)
            macArticleRepository.saveAll(toSave);

            MacKittingUploadSummary summary = new MacKittingUploadSummary();
            summary.setTotalInserted(totalInserted);
            summary.setTotalUpdated(totalUpdated);
            summary.setDetails(details);
            return new MacKittingUploadResult(true, summary, Collections.emptyList());

        } catch (Exception ex) {
            errors.add("Failed to process Excel file: " + ex.getMessage());
            return new MacKittingUploadResult(false, null, errors);
        }
    }

    private String getCellValue(Cell cell) {
        if (cell == null) return "";
        if (cell.getCellType() == CellType.STRING) return cell.getStringCellValue().trim();
        if (cell.getCellType() == CellType.NUMERIC) {
            double dv = cell.getNumericCellValue();
            if (Math.floor(dv) == dv) return String.valueOf((long) dv);
            return String.valueOf(dv);
        }
        if (cell.getCellType() == CellType.BOOLEAN) return String.valueOf(cell.getBooleanCellValue());
        if (cell.getCellType() == CellType.FORMULA) {
            try { return cell.getStringCellValue().trim(); } catch (Exception e) { return String.valueOf(cell.getNumericCellValue()); }
        }
        return "";
    }

    private String normalize(String v) {
        if (v == null) return "";
        return v.trim().toUpperCase();
    }
