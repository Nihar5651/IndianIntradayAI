package com.kitting.service;

import com.kitting.integration.ExternalEslLedPublisher;
import com.kitting.integration.ExternalEslStatusPublisher;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.sql.Timestamp;
import java.time.Instant;
import java.util.*;

/**
 * Forcefully completes kitting for given VIN(s) on a specific line & zone.
 *
 * Behaviour:
 * - If VIN row exists AND is tied to a trolley/assigned LED or reserved flag => it is "in kitting" and we
 * complete the kitting instance for that zone (clear reserved fields and assigned LED for that zone),
 * set forceful flags and zone/global kitting_completed_at timestamps and simulate remaining P2L acks.
 * - If VIN row exists but is not assigned/reserved => old logic path.
 * - If VIN row not present => old logic path.
 *
 * Forceful flags:
 * - Single-zone lines (CR, CP): forcefulkitting = true
 * - Two-zone lines (T1, T2, DR): forcefulkittingz1 / forcefulkittingz2 as per zone
 *
 * Zone-wise completion timestamps:
 * - Single-zone lines: kitting_completed_at set when forcefully completed.
 * - Two-zone lines:
 * kitting_completed_at_z1 / kitting_completed_at_z2 set per zone.
 * kitting_completed_at set when both zones are processed.
 */
@Service
public class ForceKittingService {

    private static final Logger log = LoggerFactory.getLogger(ForceKittingService.class);

    private static final String STATION_CODE = "100";

    @PersistenceContext
    private EntityManager entityManager;

    private final ForceKittingP2LCompletionService p2lCompletionService;
    private final ExternalEslStatusPublisher eslStatusPublisher;
    private final ExternalEslLedPublisher eslLedPublisher;
    private final TrolleyDsnAllotmentService trolleyDsnAllotmentService;

    // Map line -> kitting table
    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    // Dynamic dependency ordering map
    private static final Map<String, List<String>> LINE_ZONE_ORDER = Map.of(
            "DR", List.of("Z2", "Z1"), // DOOR: Zone 1 first, then Zone 2
            "T2", List.of("Z2", "Z1")  // TRIM2: Zone 2 first, then Zone 1
    );

    // Lines that have two zones
    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");

    // Lines that are single-zone only (for validation)
    private static final Set<String> SINGLE_ZONE_LINES = Set.of("CR", "CP");

    public ForceKittingService(ForceKittingP2LCompletionService p2lCompletionService,
                               ExternalEslStatusPublisher eslStatusPublisher,
                               ExternalEslLedPublisher eslLedPublisher,
                               TrolleyDsnAllotmentService trolleyDsnAllotmentService) {
        this.p2lCompletionService = p2lCompletionService;
        this.eslStatusPublisher = eslStatusPublisher;
        this.eslLedPublisher = eslLedPublisher;
        this.trolleyDsnAllotmentService = trolleyDsnAllotmentService;
    }

    /**
     * Force-complete VINs for a specific line & zone.
     */
    @Transactional
    public Map<String, Object> forceComplete(String line, String zone, List<String> vins, String performedBy) {
        Map<String, Object> result = new LinkedHashMap<>();
        List<Map<String, String>> success = new ArrayList<>();
        List<Map<String, String>> failed = new ArrayList<>();

        if (line == null || zone == null || vins == null || vins.isEmpty()) {
            result.put("status", "error");
            result.put("message", "line, zone, and vins must be provided.");
            return result;
        }

        String upperLine = line.trim().toUpperCase();
        String upperZone = zone.trim().toUpperCase();

        if (!KITTING_TABLES.containsKey(upperLine)) {
            result.put("status", "error");
            result.put("message", "Unsupported line. Allowed: T1, T2, DR, CR, CP.");
            return result;
        }

        // Validate zone and line combination
        if (SINGLE_ZONE_LINES.contains(upperLine) && !"Z1".equals(upperZone)) {
            result.put("status", "error");
            result.put("message", "Line " + upperLine + " supports only Zone Z1.");
            return result;
        }

        boolean isTwoZone = TWO_ZONE_LINES.contains(upperLine);
        String table = KITTING_TABLES.get(upperLine);
        int zoneNumber = extractZoneNumber(upperZone);

        String zoneProcessedCol = "isprocessedzone" + zoneNumber;
        String zoneReservedCol = "isreservedzone" + zoneNumber;
        String operatorCol = (zoneNumber == 2) ? "operatornamez2" : "operatorname";
        String assignedLedCol = (zoneNumber == 2) ? "assignedledcolorz2" : "assignedledcolor";
        String trolleyCol = (zoneNumber == 2) ? "trolleycodez2" : "trolleycode";

        String forcefulFlagColSingle = "forcefulkitting"; // for CR/CP
        String forcefulFlagColZ = (zoneNumber == 2) ? "forcefulkittingz2" : "forcefulkittingz1";
        String zoneCompletedAtColZ = (zoneNumber == 2) ? "kitting_completed_at_z2" : "kitting_completed_at_z1";

        // Check if the user is an admin
        boolean isAdmin = performedBy != null && performedBy.trim().equalsIgnoreCase("admin");

        // SAFEGUARD: Prevent multiple "IN-KITTING" (Picking) VINs from being force-kitted at once
        if (vins.size() > 1) {
            String checkActiveSql = String.format(
                    "SELECT COUNT(1) FROM %s WHERE vinnumber IN (:vins) AND (%s = true OR %s IS NOT NULL OR %s IS NOT NULL) AND coalesce(%s, false) = false",
                    table, zoneReservedCol, assignedLedCol, trolleyCol, zoneProcessedCol
            );
            Query activeCountQuery = entityManager.createNativeQuery(checkActiveSql);
            activeCountQuery.setParameter("vins", vins);

            Number activeCountNum = (Number) activeCountQuery.getSingleResult();
            int activeCount = activeCountNum != null ? activeCountNum.intValue() : 0;

            if (activeCount > 1) {
                result.put("status", "error");
                result.put("message", "Hardware protection: You cannot force-complete " + activeCount + " active (PICKING) trolleys at the same time. Please force-complete active trolleys one by one.");
                return result;
            }
        }

        Timestamp nowTs = Timestamp.from(Instant.now());

        for (String vinRaw : vins) {
            String vin = (vinRaw == null) ? null : vinRaw.trim();
            if (vin == null || vin.isEmpty()) {
                failed.add(Map.of("vin", vinRaw, "reason", "Empty VIN"));
                continue;
            }

            // Strict dependency validation before attempting force kit
            if (!isPreviousZoneCompleted(upperLine, upperZone, vin)) {
                String prevZone = LINE_ZONE_ORDER.get(upperLine).get(LINE_ZONE_ORDER.get(upperLine).indexOf(upperZone) - 1);
                failed.add(Map.of(
                        "vin", vin,
                        "reason", "Dependency Error: Complete " + prevZone + " first before proceeding to " + upperZone + "."
                ));
                continue;
            }

            try {
                // Check if VIN row exists
                String fetchSql = String.format(
                        "SELECT id, vinnumber, vcnumber, %s, %s, %s, %s FROM %s WHERE vinnumber = :vin LIMIT 1",
                        assignedLedCol, trolleyCol, zoneProcessedCol, zoneReservedCol, table
                );
                Query fetchQ = entityManager.createNativeQuery(fetchSql);
                fetchQ.setParameter("vin", vin);
                @SuppressWarnings("unchecked")
                List<Object[]> rows = fetchQ.getResultList();

                if (rows.isEmpty()) {
                    // WAITING CAR FIX: Block non-admins from doing this
                    if (!isAdmin) {
                        failed.add(Map.of("vin", vin, "reason", "Access Denied: Vehicle is WAITING. Only Admins can force-complete waiting vehicles."));
                        continue;
                    }

                    // VIN not present -> run admin waiting logic
                    boolean oldOk = runOldLogicPath(
                            table, upperLine, zoneNumber, zoneProcessedCol, zoneReservedCol,
                            operatorCol, forcefulFlagColSingle, forcefulFlagColZ,
                            zoneCompletedAtColZ, vin, isTwoZone, nowTs
                    );
                    if (oldOk) {
                        success.add(Map.of("vin", vin, "status", "processed (row not present / not allocated)"));
                    } else {
                        failed.add(Map.of("vin", vin, "reason", "Old-logic update failed (row not present)"));
                    }
                    continue;
                }

                // row exists
                Object[] row = rows.get(0);
                Number idNum = (Number) row[0];
                Long id = (idNum == null) ? null : idNum.longValue();
                String foundVin = row[1] == null ? null : row[1].toString();
                String vc = row[2] == null ? null : row[2].toString();
                Object assignedLedObj = row[3];
                Object trolleyObj = row[4];
                Boolean zoneProcessed = row[5] == null ? false : (Boolean) row[5];
                Boolean zoneReserved = row[6] == null ? false : (Boolean) row[6];

                String assignedColor = (assignedLedObj == null) ? null : assignedLedObj.toString();
                String trolleyCode = (trolleyObj == null) ? null : trolleyObj.toString();

                boolean hasAssignment = (assignedColor != null && !assignedColor.isBlank())
                        || (trolleyCode != null && !trolleyCode.isBlank())
                        || Boolean.TRUE.equals(zoneReserved);

                // COMPLETED CAR: Block everyone
                if (Boolean.TRUE.equals(zoneProcessed)) {
                    failed.add(Map.of("vin", vin, "reason", "Vehicle is already COMPLETED for this zone."));
                    continue;
                }

                if (!hasAssignment) {
                    // WAITING CAR FIX: Block non-admins from doing this
                    if (!isAdmin) {
                        failed.add(Map.of("vin", vin, "reason", "Access Denied: Vehicle is WAITING. Only Admins can force-complete waiting vehicles."));
                        continue;
                    }

                    // Row exists but not assigned -> run admin waiting logic
                    boolean oldOk = runOldLogicPath(
                            table, upperLine, zoneNumber, zoneProcessedCol, zoneReservedCol,
                            operatorCol, forcefulFlagColSingle, forcefulFlagColZ,
                            zoneCompletedAtColZ, vin, isTwoZone, nowTs
                    );
                    if (oldOk) {
                        success.add(Map.of("vin", vin, "status", "processed (row existed but not in-kitting)"));
                    } else {
                        failed.add(Map.of("vin", vin, "reason", "Old-logic update failed (row existed but not in-kitting)"));
                    }
                    continue;
                }

                // 🔥 PICKING CAR: This is the active workflow
                log.info("Force-completing IN-KITTING VIN={} on {} {} (id={}, vc={}, trolley={}, color={})",
                        foundVin, upperLine, upperZone, id, vc, trolleyCode, assignedColor);

                // Build UPDATE for in-kitting case
                StringBuilder sb = new StringBuilder();
                sb.append("UPDATE ").append(table).append(" SET ")
                        .append(zoneProcessedCol).append(" = true, ")
                        .append(zoneReservedCol).append(" = false, ")
                        // 🔥 FIX: Hardcoded operatorname to admin and REMOVED reservedat overwrite to preserve original start time
                        .append(operatorCol).append(" = 'admin', ")
                        .append(assignedLedCol).append(" = NULL, ")
                        .append(trolleyCol).append(" = NULL, ");

                if (isTwoZone) {
                    sb.append(zoneCompletedAtColZ).append(" = :now, ")
                            .append(forcefulFlagColZ).append(" = true, ");
                } else {
                    sb.append("kitting_completed_at = :now, ")
                            .append(forcefulFlagColSingle).append(" = true, ");
                }

                sb.append("lastmodifiedtime = :now ").append("WHERE id = :id");

                Query uq = entityManager.createNativeQuery(sb.toString());
                uq.setParameter("now", nowTs);
                uq.setParameter("id", id);
                int updated = uq.executeUpdate();

                if (updated == 0) {
                    failed.add(Map.of("vin", vin, "reason", "Failed to update in-kitting row."));
                    continue;
                }

                // Finalize overall isprocessed if needed
                if (isTwoZone) {
                    String finalizeSql = String.format("""
                            UPDATE %s
                            SET isprocessed = true,
                                kitting_completed_at = :now,
                                lastmodifiedtime = :now
                            WHERE id = :id
                              AND coalesce(isprocessedzone1,false) = true
                              AND coalesce(isprocessedzone2,false) = true
                            """, table);
                    Query finQ = entityManager.createNativeQuery(finalizeSql);
                    finQ.setParameter("id", id);
                    finQ.setParameter("now", nowTs);
                    finQ.executeUpdate();
                } else {
                    String singleFinalize = String.format("""
                            UPDATE %s
                            SET isprocessed = true,
                                kitting_completed_at = :now,
                                lastmodifiedtime = :now
                            WHERE id = :id
                            """, table);
                    Query sfq = entityManager.createNativeQuery(singleFinalize);
                    sfq.setParameter("id", id);
                    sfq.setParameter("now", nowTs);
                    sfq.executeUpdate();
                }

                // Simulate remaining P2L acks
                try {
                    if (vc != null && trolleyCode != null && assignedColor != null) {
                        p2lCompletionService.simulateMissingP2LAcksAndTurnOff(
                                upperLine, upperZone, vc, trolleyCode, assignedColor
                        );
                    } else {
                        log.warn("P2L completion skipped for VIN={} (missing vc/trolley/color).", vin);
                    }
                } catch (Exception e) {
                    log.error("Error in P2L completion for VIN={} (line={}, zone={}): {}",
                            vin, upperLine, upperZone, e.getMessage(), e);
                }

                // ESL tab + LED
                if (trolleyCode != null && !trolleyCode.isBlank()) {
                    try {
                        eslStatusPublisher.publishComplete(STATION_CODE, trolleyCode);
                    } catch (Exception ex) {
                        log.error("ESL STATUS update failed during force-complete for trolley {} : {}",
                                trolleyCode, ex.getMessage());
                    }

                    try {
                        if (assignedColor != null && !assignedColor.isBlank()) {
                            eslLedPublisher.publishLed(trolleyCode, assignedColor, STATION_CODE);
                        }
                    } catch (Exception ex) {
                        log.error("ESL LED off publish failed during force-complete for trolley {} : {}",
                                trolleyCode, ex.getMessage());
                    }
                }

                // free in-memory LED color
                if (assignedColor != null && !assignedColor.isBlank()) {
                    trolleyDsnAllotmentService.freeLed(upperLine, upperZone, assignedColor);
                }

                success.add(Map.of("vin", vin, "status", "processed (in-kitting)"));
            } catch (Exception ex) {
                log.error("❌ Error force-completing VIN={} on {} {} (table={}): {}",
                        vin, upperLine, upperZone, table, ex.getMessage(), ex);
                failed.add(Map.of("vin", vin, "reason",
                        (ex.getMessage() != null ? ex.getMessage() : "Unknown error")));
            }
        }

        result.put("status", "success");
        result.put("message", "Force kitting evaluation completed.");
        result.put("line", upperLine);
        result.put("zone", upperZone);
        result.put("processed", success);
        result.put("failed", failed);
        result.put("processedCount", success.size());
        result.put("failedCount", failed.size());

        // Fix for the frontend toast popup: if the single VIN failed, force status to ERROR
        if (!failed.isEmpty() && success.isEmpty()) {
            result.put("status", "error");
            result.put("message", failed.get(0).get("reason"));
        }
        return result;
    }

    /**
     * Old logic path
     */
    private boolean runOldLogicPath(String table, String upperLine, int zoneNumber, String zoneProcessedCol,
                                    String zoneReservedCol, String operatorCol,
                                    String forcefulFlagColSingle, String forcefulFlagColZ, String zoneCompletedAtColZ,
                                    String vin, boolean isTwoZone, Timestamp nowTs) {
        try {
            StringBuilder sb = new StringBuilder();
            sb.append("UPDATE ").append(table).append(" SET ")
                    .append(zoneProcessedCol).append(" = true, ")
                    .append(zoneReservedCol).append(" = false, ")
                    // 🔥 FIX: Hardcoded operatorname to admin and REMOVED reservedat overwrite to preserve original start time
                    .append(operatorCol).append(" = 'admin', ");

            if (isTwoZone) {
                sb.append(zoneCompletedAtColZ).append(" = :now, ")
                        .append(forcefulFlagColZ).append(" = true, ");
            } else {
                sb.append("kitting_completed_at = :now, ")
                        .append(forcefulFlagColSingle).append(" = true, ");
            }

            sb.append("lastmodifiedtime = :now ").append("WHERE vinnumber = :vin");

            String updateSql = sb.toString();

            Query uq = entityManager.createNativeQuery(updateSql);
            uq.setParameter("now", nowTs);
            uq.setParameter("vin", vin);
            int updated = uq.executeUpdate();

            if (updated == 0) {
                log.warn("Old logic: no kitting row updated for VIN={} on table={}", vin, table);
                return false;
            }

            if (!isTwoZone) {
                String singleSql = String.format("""
                        UPDATE %s
                        SET isprocessed = true,
                            kitting_completed_at = :now,
                            lastmodifiedtime = :now
                        WHERE vinnumber = :vin
                        """, table);
                Query sq = entityManager.createNativeQuery(singleSql);
                sq.setParameter("now", nowTs);
                sq.setParameter("vin", vin);
                sq.executeUpdate();
            } else {
                String finalizeSql = String.format("""
                        UPDATE %s
                        SET isprocessed = true,
                            kitting_completed_at = :now,
                            lastmodifiedtime = :now
                        WHERE vinnumber = :vin
                          AND coalesce(isprocessedzone1,false) = true
                          AND coalesce(isprocessedzone2,false) = true
                        """, table);
                Query fq = entityManager.createNativeQuery(finalizeSql);
                fq.setParameter("now", nowTs);
                fq.setParameter("vin", vin);
                fq.executeUpdate();
            }

            log.info("Old-logic force-complete applied for VIN={} on line={} zone=Z{} (table={})",
                    vin, upperLine, zoneNumber, table);
            return true;
        } catch (Exception ex) {
            log.error("Error in old-logic forceComplete for vin={} on table={}: {}",
                    vin, table, ex.getMessage(), ex);
            return false;
        }
    }

    private int extractZoneNumber(String zone) {
        try {
            return Integer.parseInt(zone.replaceAll("[^0-9]", ""));
        } catch (Exception e) {
            throw new IllegalArgumentException("Invalid zone. Expected format: Z1 or Z2");
        }
    }

    private boolean isPreviousZoneCompleted(String line, String currentZone, String vin) {
        List<String> order = LINE_ZONE_ORDER.get(line);
        if (order == null) return true; // single-zone line

        int idx = order.indexOf(currentZone);
        if (idx <= 0) return true; // first zone → no dependency

        String previousZone = order.get(idx - 1);
        String table = KITTING_TABLES.get(line);

        String processedCol = previousZone.equals("Z1") ? "isprocessedzone1" : "isprocessedzone2";

        String sql = "SELECT " + processedCol + " FROM " + table + " WHERE vinnumber = :vin LIMIT 1";

        try {
            Object result = entityManager.createNativeQuery(sql)
                    .setParameter("vin", vin)
                    .getSingleResult();
            return Boolean.TRUE.equals(result);
        } catch (Exception e) {
            return false; // Safely return false if something goes wrong
        }
    }
