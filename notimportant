  getPageNumbers(): number[] {
    const totalPages = this.totalPages;
    const currentPage = this.currentPage;
    const delta = 2;
    if (totalPages <= 1) {
      return [1];
    }
    const range = [];
    const rangeWithDots: (number | string)[] = [];
    // Always show first page
    rangeWithDots.push(1);
    // Calculate range around current page
    for (
      let i = Math.max(2, currentPage - delta);
      i <= Math.min(totalPages - 1, currentPage + delta);
      i++
    ) {
      range.push(i);
    }
    // Add ellipsis and range
    if (currentPage - delta > 2) {
      rangeWithDots.push('...');
    } else if (totalPages > 1) {
      rangeWithDots.push(2);
    }
    rangeWithDots.push(...range);
    if (currentPage + delta < totalPages - 1) {
      rangeWithDots.push('...');
    } else if (currentPage + delta >= totalPages - 1 && totalPages > 1) {
      rangeWithDots.push(totalPages - 1);
    }
    // Always show last page if there is more than one page
    if (totalPages > 1) {
      rangeWithDots.push(totalPages);
    }
    // Filter out duplicates and ensure all values are numbers
    const uniqueNumbers = Array.from(new Set(rangeWithDots))
      .filter((page) => typeof page === 'number')
      .map((page) => page as number);
    return uniqueNumbers;
