 import { Component, OnInit, DestroyRef, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { catchError } from 'rxjs/operators';
import { of } from 'rxjs';
import { RouterModule } from '@angular/router';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
import { Global } from 'src/app/shared/constants/Global';
import { AuthService } from 'src/app/shared/services/auth.service';
interface BomItem {
  [key: string]: any;
}
interface BomResponse {
  content: BomItem[];
  totalElements: number;
  totalPages: number;
  number: number;
  size: number;
}
interface UploadResponse {
  success: boolean;
  message: string;
  processedVcs?: string[];
  totalParts?: number;
  missingVcs?: string[];
}
@Component({
  selector: 'app-full-vc-bom-upload',
  standalone: true,
  imports: [CommonModule, FormsModule, RouterModule],
  templateUrl: './full-vc-bom-upload.component.html',
  styleUrls: ['./full-vc-bom-upload.component.scss']
})
export class FullVcBomUploadComponent implements OnInit {
  private destroyRef = inject(DestroyRef);
  private authService = inject(AuthService);
  bomData: BomResponse | null = null;
  tableColumns: string[] = [];
  isLoading = false;
  // Search Filters
  searchTerm = '';
  classificationFilter = '';
  // Pagination Configuration Settings
  currentPage = 0;
  itemsPerPage = 10;
  // Modal Control Overlays
  showSuccessModal = false;
  showErrorModal = false;
  modalTitle = '';
  modalMessage = '';
  missingVcs: string[] = [];
  modalDetails: Partial<UploadResponse> = {};
  ngOnInit(): void {
    this.loadBomData();
  }
  loadBomData(): void {
    this.isLoading = true;
    // 1. Build the base URL with Pagination manually to protect the Auth Token
    let apiUrl = `${Global['VC_BOM_RAW_VIEW']}?page=${this.currentPage}&size=${this.itemsPerPage}`;
    // 2. Append Search Term if it exists
    if (this.searchTerm && this.searchTerm.trim().length >= 3) {
      apiUrl += `&search=${encodeURIComponent(this.searchTerm.trim())}`;
    }
    // 3. Append Classification Filter if it exists
    if (this.classificationFilter) {
      apiUrl += `&classification=${encodeURIComponent(this.classificationFilter)}`;
    }
    // 4. Send the SINGLE STRING URL to your AuthService
    this.authService.httpGetRequest(apiUrl)
      .pipe(
        catchError((err) => {
          console.error('Error fetching view metrics', err);
          this.isLoading = false;
          return of(null);
        }),
        takeUntilDestroyed(this.destroyRef)
      )
      .subscribe((data: BomResponse | null) => {
        this.isLoading = false;
        if (data && data.content) {
          this.bomData = data;
          this.extractTableHeaders(data.content);
        } else {
          this.bomData = null;
          this.tableColumns = [];
        }
      });
  }
  extractTableHeaders(content: BomItem[]): void {
    if (content.length === 0) {
      this.tableColumns = [];
      return;
    }
    const fixedOrder = ['vc', 'item', 'level', 'material', 'description', 'quantity', 'uom'];
    const rowKeys = Object.keys(content[0]);
    this.tableColumns = fixedOrder.filter(key => rowKeys.includes(key));
    // Catch-all structural verification loop for custom keys
    rowKeys.forEach(key => {
      if (!this.tableColumns.includes(key) && key !== 'id') {
        this.tableColumns.push(key);
      }
    });
  }
  onSearch(): void {
    this.currentPage = 0;
    this.loadBomData();
  }
  onFilterChange(): void {
    this.currentPage = 0;
    this.loadBomData();
  }
  clearFilters(): void {
    this.searchTerm = '';
    this.classificationFilter = '';
    this.currentPage = 0;
    this.loadBomData();
  }
  onFileSelected(event: any, isLargeFile: boolean): void {
    const file: File = event.target.files[0];
    if (!file) return;
    this.isLoading = true;
    const formData = new FormData();
    formData.append('file', file);
    // Clean URL resolution using the Global variables we set up earlier!
    const uploadUrl = isLargeFile ? Global['VC_BOM_RAW_UPLOAD_LARGE'] : Global['VC_BOM_RAW_UPLOAD'];
    this.authService.httpPostRequest(uploadUrl, formData)
      .pipe(
        catchError((err) => {
          this.isLoading = false;
          this.triggerErrorView('Upload Failure', err?.error?.message || 'A network error occurred while uploading.');
          return of(null);
        }),
        takeUntilDestroyed(this.destroyRef)
      )
      .subscribe((res: UploadResponse | null) => {
        this.isLoading = false;
        event.target.value = ''; // Reset input target securely
        if (!res) return;
        if (res.missingVcs && res.missingVcs.length > 0) {
          this.missingVcs = res.missingVcs;
          this.triggerErrorView('Validation Configuration Discrepancy', res.message || 'Missing VCs found.');
        } else {
          this.modalDetails = res;
          this.showSuccessModal = true;
          this.currentPage = 0;
          this.loadBomData();
        }
      });
  }
  triggerErrorView(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showErrorModal = true;
  }
  closeSuccessModal(): void { this.showSuccessModal = false; }
  closeErrorModal(): void { this.showErrorModal = false; this.missingVcs = []; }
  // Pagination Actions
  goToPage(page: number): void {
    if (page >= 0 && page < (this.bomData?.totalPages || 0)) {
      this.currentPage = page;
      this.loadBomData();
    }
  }
  getVisiblePages(): number[] {
    const pages: number[] = [];
    const totalPages = this.bomData?.totalPages || 0;
    const maxVisible = 5;
    if (totalPages <= maxVisible) {
      for (let i = 0; i < totalPages; i++) pages.push(i);
    } else {
      let start = Math.max(0, this.currentPage - 2);
      let end = Math.min(totalPages - 1, start + maxVisible - 1);
      if (end - start + 1 < maxVisible) {
        start = Math.max(0, end - maxVisible + 1);
      }
      for (let i = start; i <= end; i++) pages.push(i);
    }
    return pages;
  }
  getColumnDisplayName(column: string): string {
    const maps: { [key: string]: string } = {
      vc: 'VC', item: 'Item', level: 'Level', material: 'Part No',
      description: 'Part Description', quantity: 'Quantity', uom: 'UOM',
      createdAt: 'Created At', updatedAt: 'Updated At'
    };
    return maps[column] || column.toUpperCase();
  }
}
