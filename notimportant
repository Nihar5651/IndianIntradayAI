 import { Component, Input, OnInit } from '@angular/core';
import { AuthService } from 'src/app/shared/services/auth.service';
import { filter } from 'rxjs';
import { NavigationEnd, Router } from '@angular/router';
import { isParentTab, sideNav, Tab } from './sidenav';
import { Global } from 'src/app/shared/constants/Global';
@Component({
  selector: 'app-sidebar',
  templateUrl: './sidebar.component.html',
  styleUrls: ['./sidebar.component.scss'],
})
export class SidebarComponent implements OnInit {
  @Input() sidenavStatus: boolean = false;
  reportsBgChange!: boolean;
  currentRoute!: string;
  userId: any;
  menuList = sideNav;
 userTabAccessData: any[] = [];
   readonly isParentTab = isParentTab;
  constructor(private authService: AuthService, private router: Router) {}
  ngOnInit(): void {
    this.accessRoute(true);
    const userData = sessionStorage.getItem('tokenKey');
    if (userData) {
      this.userId = JSON.parse(userData)['userID'];
      let userId = {
        UID: this.userId,
      };
      this.authService
        .httpPostRequest(Global['USER_MANAGEMENT_SIDEBAR_TAB'], userId)
        .subscribe({
          next: (userTabAcessData) => {
            // Store full tab data
            this.userTabAccessData = userTabAcessData;
             const accessibleTabs = this.userTabAccessData.filter(
              (obj) => obj.Status
            );
            // Store info on Tabs having subTabs
            let parentChildRelation: { [key: string]: string[] } = {};
           const subTabSeparator = ':';
             for (let tab of accessibleTabs) {
              let tabName: string = tab.label;
              if (tabName.includes(subTabSeparator)) {
                const tabSeparatorIndex = tabName.indexOf(subTabSeparator);
               const parentTabName = tabName.substring(0, tabSeparatorIndex);
                 // Format for tabs with subTabs is fixed as "ParentTabName: ChildTabName"
                const childTabName = tabName.substring(tabSeparatorIndex + 2);
                if (parentChildRelation[parentTabName] == null) {
                  parentChildRelation[parentTabName] = [childTabName];
                } else {
                  parentChildRelation[parentTabName].push(childTabName);
                }
              }
           }
             // Filter out all accessible tabs
            this.menuList = this.menuList.flatMap((tab): Tab[] => {
              // If tab contains subtabs
              if (isParentTab(tab)) {
                const hasAccessibleChild =
                  !!parentChildRelation[tab.label]?.length;
                // Current tab has no subtabs that are accessible
                // Disable the entire parent tab
                if (!hasAccessibleChild) {
                  return [];
               }
                 const parentTabName = tab.label;
                // Some tabs exist that are accessible; filter those
                tab.children = tab.children.filter((childTab) =>
                  parentChildRelation[parentTabName].some(
                    (accessibleChildTabName) =>
                      accessibleChildTabName == childTab.label
                  )
               );
                 return [tab];
              } else {
                const isAccessible = accessibleTabs.some(
                  (at) => at.label === tab.label
                );
                return isAccessible ? [tab] : [];
              }
            });
          },
        });
    }
  }
  accessRoute(isParent: boolean) {
    this.router.events
      .pipe(filter((event: any) => event instanceof NavigationEnd))
      .subscribe((event: any) => {
        this.currentRoute = (event as NavigationEnd).url; // Cast to NavigationEnd
        const isTrue = this.currentRoute.indexOf('/reports');
        if (isTrue != -1) {
          this.reportsBgChange = isParent ? isParent : true;
        } else {
          this.reportsBgChange = false;
        }
      });
  } 
  signout() {
    this.authService.shareModalPopup();
  }
  toggleSubMenu(nav: any) {
    nav.showSubMenu = !nav.showSubMenu;
  }
}
 export type ChildTab = {
  label: string;
  icon: string;
  routerLink: string;
};
export type ParentTab = {
  label: string;
  icon: string;
  children: ChildTab[];
};
export type Tab = ChildTab | ParentTab;
export function isParentTab(tab: Tab): tab is ParentTab {
  return 'children' in tab;
}
