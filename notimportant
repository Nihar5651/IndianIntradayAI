package com.kitting.service;

import com.kitting.dto.DekiUploadResult;

import com.kitting.entity.LineAllowedHierarchy;

import com.kitting.entity.MacArticle;

import com.kitting.entity.PartMaster;

import com.kitting.repositories.LineAllowedHierarchyRepository;

import com.kitting.repositories.MacArticleRepository;

import com.kitting.repositories.PartMasterRepository;

import org.apache.poi.ss.usermodel.*;

import org.springframework.stereotype.Service;

import org.springframework.transaction.annotation.Transactional;

import org.springframework.web.multipart.MultipartFile;

import java.io.InputStream;

import java.time.LocalDateTime;

import java.util.*;

import java.util.regex.Matcher;

import java.util.regex.Pattern;

@Service

public class DekiMasterUploadService {

    private final PartMasterRepository partRepo;

    private final MacArticleRepository macRepo;

    private final LineAllowedHierarchyRepository allowedHierarchyRepo;

    private static final Pattern ARTICLE_PATTERN = Pattern.compile("^([A-Z0-9]{2})(Z[0-9])");

    public DekiMasterUploadService(PartMasterRepository partRepo,

                                   MacArticleRepository macRepo,

                                   LineAllowedHierarchyRepository allowedHierarchyRepo) {

        this.partRepo = partRepo;

        this.macRepo = macRepo;

        this.allowedHierarchyRepo = allowedHierarchyRepo;

    }

    @Transactional

    public DekiUploadResult processUnifiedDekiFile(MultipartFile file, String uploadedBy) {

        List<String> violations = new ArrayList<>();

        Map<String, PartMaster> partsToSaveMap = new HashMap<>();

        List<MacArticle> macsToSaveList = new ArrayList<>();

        try (InputStream is = file.getInputStream(); Workbook wb = WorkbookFactory.create(is)) {

            Sheet sheet = wb.getSheetAt(0);

            Iterator<Row> rows = sheet.iterator();

            if (!rows.hasNext()) throw new RuntimeException("Excel sheet is empty");

            Row headerRow = rows.next();

            Map<String, Integer> colMap = new HashMap<>();

            for (Cell cell : headerRow) {

                String head = cell.getStringCellValue().trim().toUpperCase();

                if (!head.isEmpty()) colMap.put(head, cell.getColumnIndex());

            }

            Set<String> validCombos = new HashSet<>();

            allowedHierarchyRepo.findAll().forEach(h ->

                    validCombos.add(h.getLineDenotion().toUpperCase() + "|" + h.getZone().toUpperCase()));

            Map<String, PartMaster> existingParts = new HashMap<>();

            partRepo.findAll().forEach(p -> existingParts.put(p.getPartNumber().toUpperCase(), p));

            int currentRow = 1;

            while (rows.hasNext()) {

                Row masterRow = rows.next();

                currentRow++;

                String articleId = getVal(masterRow, colMap, "ARTICLE_ID").toUpperCase();

                if (articleId.isEmpty()) continue;

                String partNo = getVal(masterRow, colMap, "PART_NUMBER").toUpperCase();

                String desc = getVal(masterRow, colMap, "PART_DESC");

                if (desc.isEmpty()) {

                    desc = getVal(masterRow, colMap, "ITEM_NAME");

                }

                String rack = getValOrDefault(masterRow, colMap, "RACK", "NA");

                String rowNo = getValOrDefault(masterRow, colMap, "ROW", "NA");

                String colNo = getValOrDefault(masterRow, colMap, "COLUMN", "NA");

                String macAddr = getVal(masterRow, colMap, "VAR2").toUpperCase();

                if (partNo.isEmpty() || macAddr.isEmpty()) {

                    violations.add("Row " + currentRow + ": Missing Part Number or MAC Address.");

                    continue;

                }

                Matcher m = ARTICLE_PATTERN.matcher(articleId);

                if (!m.find()) {

                    violations.add("Row " + currentRow + ": Invalid Article ID format: " + articleId);

                    continue;

                }

                String line = m.group(1);

                String zone = m.group(2);

                if (!validCombos.contains(line + "|" + zone)) {

                    violations.add("Row " + currentRow + ": Combo [" + line + "|" + zone + "] not allowed in Hierarchy.");

                    continue;

                }

                PartMaster pm = existingParts.getOrDefault(partNo, partsToSaveMap.get(partNo));

                if (pm != null) {

                    boolean isDr = "DR".equals(pm.getLine()) && "DR".equals(line);

                    if (!isDr && (!pm.getLine().equals(line) || !pm.getZone().equals(zone))) {

                        violations.add("Row " + currentRow + ": Part " + partNo + " is locked to " + pm.getLine() + "/" + pm.getZone());

                        continue;

                    }

                    pm.setPartDescription(desc);

                    pm.setRack(rack);

                    pm.setRowNo(rowNo);

                    pm.setColumnNo(colNo);

                    pm.setUploadTimestamp(LocalDateTime.now());

                    pm.setUploadedBy(uploadedBy);

                } else {

                    pm = new PartMaster();

                    pm.setPartNumber(partNo);

                    pm.setPartDescription(desc);

                    pm.setType("P2L");

                    pm.setIsActive("1");

                    pm.setLine(line);

                    pm.setZone(zone);

                    pm.setRack(rack);

                    pm.setRowNo(rowNo);

                    pm.setColumnNo(colNo);

                    pm.setUploadTimestamp(LocalDateTime.now());

                    pm.setUploadedBy(uploadedBy);

                }

                partsToSaveMap.put(partNo, pm);

                MacArticle mac = new MacArticle();

                mac.setArticleId(articleId);

                mac.setMacAddress(macAddr);

                mac.setItemCode(partNo);

                mac.setLine(getFullLineName(line));

                mac.setLineDenotion(line);

                mac.setZone(zone);

                mac.setUploadTimestamp(LocalDateTime.now());

                mac.setUploadedBy(uploadedBy);

                macsToSaveList.add(mac);

            }

            if (!violations.isEmpty()) return new DekiUploadResult(violations, 0, 0);

            partRepo.saveAll(partsToSaveMap.values());

            macRepo.saveAll(macsToSaveList);

            return new DekiUploadResult(Collections.emptyList(), partsToSaveMap.size(), macsToSaveList.size());

        } catch (Exception e) {

            throw new RuntimeException("Unified Upload Failed: " + e.getMessage());

        }

    }

    // 🚀 NEW: Fetches and Joins the MAC & Part data for the Frontend Grid!

    public List<Map<String, Object>> getUnifiedGridData() {
        List<MacArticle> macs = macRepo.findAll();
        Map<String, PartMaster> partMap = new HashMap<>();
        partRepo.findAll().forEach(p -> partMap.put(p.getPartNumber(), p));

        List<Map<String, Object>> resultList = new ArrayList<>();

        for (MacArticle mac : macs) {
            Map<String, Object> row = new HashMap<>();
            row.put("articleId", mac.getArticleId());
            row.put("macAddress", mac.getMacAddress());
            row.put("line", mac.getLine());
            row.put("zone", mac.getZone());

            // Map the item code from MAC relation explicitly to display Part Number
            row.put("partNumber", mac.getItemCode());

            PartMaster pm = partMap.get(mac.getItemCode());
            if (pm != null) {
                row.put("partDescription", pm.getPartDescription());
                row.put("type", pm.getType());
                row.put("isActive", pm.getIsActive());
                row.put("rack", pm.getRack());
                row.put("rowNo", pm.getRowNo());
                row.put("columnNo", pm.getColumnNo());
            } else {
                row.put("partDescription", "N/A");
                row.put("type", "N/A");
                row.put("isActive", "0");
                row.put("rack", "N/A");
                row.put("rowNo", "N/A");
                row.put("columnNo", "N/A");
            }
            resultList.add(row);
        }
        return resultList;
    }

    private String getFullLineName(String lineDenotion) {

        switch (lineDenotion.toUpperCase()) {

            case "CP": return "COCKPIT";

            case "CR": return "CRADLE";

            case "T1": return "Trim 1";

            case "T2": return "Trim 2";

            case "DR": return "Door";

            default: return lineDenotion;

        }

    }

    private String getVal(Row r, Map<String, Integer> map, String col) {

        Integer idx = map.get(col);

        if (idx == null || r.getCell(idx) == null) return "";

        DataFormatter df = new DataFormatter();

        return df.formatCellValue(r.getCell(idx)).trim();

    }

    private String getValOrDefault(Row r, Map<String, Integer> map, String col, String def) {

        String v = getVal(r, map, col);

        return v.isEmpty() ? def : v;

    }

}
package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class DoorTrolleyContinuityService {

    @PersistenceContext
    private EntityManager entityManager;

    /**
     * ZONE 1 VALIDATION ONLY
     * Ensures Zone 2 has already processed the row (ID) before Zone 1 is allowed to scan it.
     */
    @Transactional(readOnly = true)
    public void validateZone1Prerequisite(Long vehicleId, String currentZone1Dsn) {
        if (vehicleId == null || currentZone1Dsn == null) return;

        // Fetch Zone 2 status for the EXACT SAME ROW using the unique ID
        String sql = """
            SELECT isprocessedzone2, forcefulkittingz2
            FROM door_kitting_table
            WHERE id = :id
            """;

        Object[] result = (Object[]) entityManager.createNativeQuery(sql)
                .setParameter("id", vehicleId)
                .getResultStream().findFirst().orElse(null);

        // 1. If no row exists (safety net)
        if (result == null) {
            throw new IllegalArgumentException(
                    "Sequence Error: Zone 2 must process DSN " + currentZone1Dsn + " first. " +
                            "No record found in the database for this vehicle."
            );
        }

        boolean isProcessedZ2 = parseBooleanSafe(result[0]);
        boolean isForceKittedZ2 = parseBooleanSafe(result[1]);

        // 2. If row exists but isn't finished in Zone 2
        if (!isProcessedZ2 && !isForceKittedZ2) {
            throw new IllegalArgumentException(
                    "Sequence Error: Zone 2 has not COMPLETED DSN " + currentZone1Dsn + " yet. " +
                            "Zone 2 MUST finish this DSN before Zone 1 can begin."
            );
        }
    }

    // --- Utility Methods ---

    private long parseDsnSafe(String dsn) {
        try {
            return Long.parseLong(dsn.trim());
        } catch (Exception e) {
            return -1; // Invalid DSN
        }
    }

    private boolean parseBooleanSafe(Object obj) {
        if (obj == null) return false;
        if (obj instanceof Boolean) return (Boolean) obj;
        String val = obj.toString().trim().toLowerCase();
        return val.equals("true") || val.equals("t") || val.equals("1") || val.equals("y") || val.equals("yes");
    }
}

