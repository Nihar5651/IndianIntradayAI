    } else if (statusUpper === 'KITTING IN-PROGRESS DURING HOLD' || statusUpper === 'IN_PROGRESS') {
      return 'In-Progress';
    } else if (statusUpper === 'KITTING CAN BE HOLD FOR THAT LINE ZONE' || statusUpper === 'AVAILABLE') {
