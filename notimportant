package com.kitting.queue;

import com.kitting.integration.ExternalPickToLightPublisher;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.OffsetDateTime;
import java.time.ZoneId;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
public class MacPickQueueService {

    private static final Logger log = LoggerFactory.getLogger(MacPickQueueService.class);
    private static final ZoneId IST = ZoneId.of("Asia/Kolkata");

    @PersistenceContext
    private EntityManager em;

    private final ExternalPickToLightPublisher p2lPublisher;

    public MacPickQueueService(ExternalPickToLightPublisher p2lPublisher) {
        this.p2lPublisher = p2lPublisher;
    }

    /**
     * Step-2 (persistent gating):
     *  - Resolve articleId → MAC (P2L mapping).
     *  - Split into FREE vs BUSY by MAC.
     *  - Batch one P2L PUT for all FREE articleIds (single array body).
     *  - Insert rows:
     *      FREE  → WAITING_BLINK (attempts=1, last_attempt_at=now IST)
     *      BUSY  → PENDING (dedup by partial unique index)
     * Any failure while publishing the FREE batch throws → caller rolls back.
     */
    @Transactional(rollbackFor = Exception.class)
    public void enqueueAndMaybeTrigger(String vc,
                                       String line,
                                       String zone,
                                       String trolleyCode,
                                       String operatorName,
                                       String ledColor,
                                       List<String> articleIds) {

        if (articleIds == null || articleIds.isEmpty()) {
            log.info("No P2L articleIds to enqueue for VC {}", vc);
            return;
        }

        // Resolve articleId -> mac
        Map<String, String> macByArticle = resolveMacs(articleIds); // may throw if any missing

        List<String> freeArticleIds = new ArrayList<>();
        List<PendingRow> busyRows = new ArrayList<>();

        for (Map.Entry<String, String> e : macByArticle.entrySet()) {
            String aid = e.getKey();
            String mac = e.getValue();
            if (isMacBusy(mac)) {
                busyRows.add(new PendingRow(mac, aid));
            } else {
                freeArticleIds.add(aid);
            }
        }

        // Batch publish FREE items (single PUT array)
        OffsetDateTime nowIst = OffsetDateTime.now(IST);
        if (!freeArticleIds.isEmpty()) {
            p2lPublisher.publishPickToLights(freeArticleIds, ledColor); // must return 202 or throws

            for (String aid : freeArticleIds) {
                String mac = macByArticle.get(aid);
                insertRow(mac, aid, vc, line, zone, trolleyCode, operatorName, ledColor,
                        "WAITING_BLINK", 1, nowIst);
            }
        }

        // Insert BUSY -> PENDING (dedup via partial unique index)
        int queued = 0;
        for (PendingRow pr : busyRows) {
            if (insertPendingIfAbsent(pr.mac, pr.articleId, vc, line, zone, trolleyCode, operatorName, ledColor)) {
                queued++;
            }
        }

        log.info("MAC queue (batch): free_published={} queued={} for VC={} line={} zone={} trolley={}",
                freeArticleIds.size(), queued, vc, line, zone, trolleyCode);
    }

    // ---------- internals ----------

    private Map<String, String> resolveMacs(List<String> articleIds) {
        Map<String, String> out = new HashMap<>(articleIds.size());
        for (String aid : articleIds) {
            String mac = findMacByArticle(aid);
            if (mac == null || mac.isBlank()) {
                throw new IllegalArgumentException("No MAC mapping for articleId: " + aid);
            }
            out.put(aid, mac);
        }
        return out;
    }

    private String findMacByArticle(String articleId) {
        List<?> list = em.createNativeQuery(
                        "SELECT mac_address FROM mac_articleid_kitting WHERE article_id = :aid LIMIT 1")
                .setParameter("aid", articleId)
                .getResultList();
        if (list.isEmpty()) return null;
        Object v = list.get(0);
        return v == null ? null : v.toString();
    }

    private boolean isMacBusy(String mac) {
        Number cnt = (Number) em.createNativeQuery(
                        "SELECT COUNT(1) FROM mac_pick_queue " +
                                "WHERE mac_address=:mac AND status IN ('WAITING_BLINK','ACTIVE')")
                .setParameter("mac", mac)
                .getSingleResult();
        return cnt != null && cnt.intValue() > 0;
    }

    private void insertRow(String mac, String articleId, String vc, String line, String zone,
                           String trolley, String operator, String color,
                           String status, int attempts, OffsetDateTime lastAttemptAtIst) {
        OffsetDateTime nowIst = OffsetDateTime.now(IST);
        em.createNativeQuery(
                        "INSERT INTO mac_pick_queue " +
                                "(mac_address, article_id, vc, line, zone, trolley_code, operator_name, color, " +
                                " status, attempts, last_attempt_at, created_at, updated_at) " +
                                "VALUES (:mac, :aid, :vc, :line, :zone, :trolley, :op, :color, " +
                                " :status, :attempts, :last_attempt_at, :created_at, :updated_at)")
                .setParameter("mac", mac)
                .setParameter("aid", articleId)
                .setParameter("vc", vc)
                .setParameter("line", line)
                .setParameter("zone", zone)
                .setParameter("trolley", trolley)
                .setParameter("op", operator)
                .setParameter("color", color)
                .setParameter("status", status)
                .setParameter("attempts", attempts)
                .setParameter("last_attempt_at", lastAttemptAtIst)
                .setParameter("created_at", nowIst)
                .setParameter("updated_at", nowIst)
                .executeUpdate();
    }

    private boolean insertPendingIfAbsent(String mac, String articleId, String vc, String line, String zone,
                                          String trolley, String operator, String color) {
        try {
            insertRow(mac, articleId, vc, line, zone, trolley, operator, color,
                    "PENDING", 0, null);
            return true;
        } catch (Exception ex) {
            String msg = ex.getMessage();
            if (msg != null && msg.toLowerCase().contains("duplicate")) {
                log.info("De-duped PENDING for mac={}, vc={}, trolley={}", mac, vc, trolley);
                return false;
            }
            throw ex;
        }
    }

    private record PendingRow(String mac, String articleId) {}
}
package com.kitting.queue;

import com.kitting.integration.ExternalPickToLightPublisher;
import com.kitting.integration.ExternalQuantityPublisher;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.transaction.Transactional;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.time.OffsetDateTime;
import java.time.ZoneId;
import java.util.List;
import java.util.Map;

@Service
public class MacPickSseHandler {

    private static final Logger log = LoggerFactory.getLogger(MacPickSseHandler.class);
    private static final ZoneId IST = ZoneId.of("Asia/Kolkata");
    private static final String STATION_CODE = "100";

    @PersistenceContext
    private EntityManager em;

    private final ExternalQuantityPublisher quantityPublisher;
    private final ExternalPickToLightPublisher p2lPublisher;

    public MacPickSseHandler(ExternalQuantityPublisher quantityPublisher,
                             ExternalPickToLightPublisher p2lPublisher) {
        this.quantityPublisher = quantityPublisher;
        this.p2lPublisher = p2lPublisher;
    }

    /**
     * Handle BLINK_SUCCESS for a P2L MAC:
     *  - Take head WAITING_BLINK row → ACTIVE; set request/picking millis (from event if present)
     *  - Fire Quantity POST for that (articleId, qty>1 only)
     *  - On failure → mark row FAILED (blocking) per agreed policy
     */
    @Transactional(rollbackOn = Exception.class)
    public void onBlinkSuccess(String mac, Long requestPickingDate, Long pickingDate, String ledColor) {
        // Head row for this MAC in WAITING_BLINK (FIFO by created_at)
        List<Object[]> rows = em.createNativeQuery(
                        "SELECT id, article_id, vc " +
                                "FROM mac_pick_queue " +
                                "WHERE mac_address = :mac AND status = 'WAITING_BLINK' " +
                                "ORDER BY created_at ASC LIMIT 1 FOR UPDATE")
                .setParameter("mac", mac)
                .getResultList();

        if (rows.isEmpty()) {
            log.info("BLINK_SUCCESS ignored for MAC {} (no WAITING_BLINK row).", mac);
            return;
        }

        Object[] r = rows.get(0);
        Long rowId = ((Number) r[0]).longValue();
        String articleId = (String) r[1];
        String vc = (String) r[2];

        OffsetDateTime nowIst = OffsetDateTime.now(IST);

        // Move to ACTIVE + store event millis if provided
        em.createNativeQuery(
                        "UPDATE mac_pick_queue " +
                                "SET status='ACTIVE', " +
                                "    request_picking_date = COALESCE(:rpd, request_picking_date), " +
                                "    picking_date         = COALESCE(:pd,  picking_date), " +
                                "    updated_at           = :now " +
                                "WHERE id = :id")
                .setParameter("rpd", requestPickingDate)
                .setParameter("pd", pickingDate)
                .setParameter("now", nowIst)
                .setParameter("id", rowId)
                .executeUpdate();

        // Fetch PART_NUMBER & QTY from vc_bom_map joined via mac_articleid_kitting (qty as integer)
        Map<String, Object> item = findQuantityItem(vc, articleId);
        if (item == null) {
            // No matched BOM row → treat as qty<=1 (no quantity call)
            log.info("No qty>1 record found for VC={} & articleId={} (skipping Quantity POST).", vc, articleId);
            return;
        }

        String partNumber = (String) item.get("material");
        int qtyInt = ((Number) item.get("qty_int")).intValue();

        if (qtyInt <= 1) {
            log.info("QTY={} for VC={} articleId={} (<=1). Skip Quantity POST.", qtyInt, vc, articleId);
            return;
        }

        try {
            quantityPublisher.publishSingle(STATION_CODE, articleId, partNumber, qtyInt);
            log.info("Quantity POST success for MAC={} articleId={} part={} qty={}", mac, articleId, partNumber, qtyInt);
        } catch (Exception ex) {
            // Per policy: keep blocking for manual/forceful action
            em.createNativeQuery(
                            "UPDATE mac_pick_queue SET status='FAILED', updated_at=:now WHERE id=:id")
                    .setParameter("now", nowIst)
                    .setParameter("id", rowId)
                    .executeUpdate();
            log.error("Quantity POST failed for MAC={} articleId={} → row marked FAILED (blocking). Error={}",
                    mac, articleId, ex.getMessage(), ex);
            // Let txn rollback? No — we persist FAILED state; don't throw.
        }
    }

    /**
     * Handle PICKING_STATUS for a P2L MAC:
     *  - Mark current ACTIVE row as PICKED and capture millis
     *  - Dequeue next PENDING for same MAC → P2L glow (single) → WAITING_BLINK (attempts=1)
     */
    @Transactional(rollbackOn = Exception.class)
    public void onPicked(String mac, Long requestPickingDate, Long pickingDate) {
        OffsetDateTime nowIst = OffsetDateTime.now(IST);

        // 1) Close current ACTIVE (if any)
        int closed = em.createNativeQuery(
                        "UPDATE mac_pick_queue " +
                                "SET status='PICKED', request_picking_date = COALESCE(:rpd, request_picking_date), " +
                                "    picking_date=:pd, updated_at=:now " +
                                "WHERE id = (" +
                                "   SELECT id FROM mac_pick_queue " +
                                "   WHERE mac_address=:mac AND status='ACTIVE' " +
                                "   ORDER BY created_at ASC LIMIT 1 FOR UPDATE" +
                                ")")
                .setParameter("rpd", requestPickingDate)
                .setParameter("pd", pickingDate)
                .setParameter("now", nowIst)
                .setParameter("mac", mac)
                .executeUpdate();

        if (closed == 0) {
            log.info("PICKING_STATUS for MAC {} but no ACTIVE row. Ignored.", mac);
        }

        // 2) Dequeue next PENDING (if any)
        List<Object[]> pend = em.createNativeQuery(
                        "SELECT id, article_id, color " +
                                "FROM mac_pick_queue " +
                                "WHERE mac_address=:mac AND status='PENDING' " +
                                "ORDER BY created_at ASC LIMIT 1 FOR UPDATE")
                .setParameter("mac", mac)
                .getResultList();

        if (pend.isEmpty()) {
            log.info("No PENDING rows for MAC {} to dequeue.", mac);
            return;
        }

        Object[] pr = pend.get(0);
        Long pendingId = ((Number) pr[0]).longValue();
        String nextArticle = (String) pr[1];
        String color = (String) pr[2];

        // Fire single-article P2L glow
        p2lPublisher.publishPickToLights(List.of(nextArticle), color);

        // Move PENDING → WAITING_BLINK (attempts=1)
        em.createNativeQuery(
                        "UPDATE mac_pick_queue " +
                                "SET status='WAITING_BLINK', attempts=1, last_attempt_at=:now, updated_at=:now " +
                                "WHERE id=:id")
                .setParameter("now", nowIst)
                .setParameter("id", pendingId)
                .executeUpdate();

        log.info("Dequeued MAC {} → glowed articleId {} (color={}) and set WAITING_BLINK.", mac, nextArticle, color);
    }

    // ----- helpers -----

    /**
     * Returns {material, qty_int} for the given VC & articleId when qty>1; else null.
     */
    @SuppressWarnings("unchecked")
    private Map<String, Object> findQuantityItem(String vc, String articleId) {
        List<Object[]> list = em.createNativeQuery(
                        "SELECT v.material, CAST(v.quantity AS INTEGER) AS qty_int " +
                                "FROM vc_bom_map v " +
                                "JOIN mac_articleid_kitting m ON v.material = m.item_code " +
                                "WHERE v.vc = :vc AND m.article_id = :aid " +
                                "AND CAST(NULLIF(TRIM(v.quantity),'') AS INTEGER) > 1 " +
                                "LIMIT 1")
                .setParameter("vc", vc)
                .setParameter("aid", articleId)
                .getResultList();

        if (list.isEmpty()) return null;
        Object[] r = list.get(0);
        return Map.of(
                "material", r[0] == null ? "" : r[0].toString(),
                "qty_int",  r[1] == null ? 0  : ((Number) r[1]).intValue()
        );
    }
}
