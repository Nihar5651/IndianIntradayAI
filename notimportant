import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.sql.Timestamp;
import java.time.ZoneId;
import java.time.ZonedDateTime;
import java.util.*;

@Service
public class VinHoldToggleService {

    private static final Logger log = LoggerFactory.getLogger(VinHoldToggleService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");

    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");

    /**
     * Toggle hold/unhold for VIN(s)
     */
    @Transactional
    public Map<String, Object> toggleHold(Map<String, Object> payload) {
        Map<String, Object> response = new LinkedHashMap<>();
        List<Map<String, Object>> processed = new ArrayList<>();
        List<Map<String, Object>> failed = new ArrayList<>();

        try {
            List<String> vins = (List<String>) payload.get("vins");
            if (vins == null || vins.isEmpty()) {
                return Map.of("status", "error", "message", "VIN list is empty or missing.");
            }

            String operator = getLoggedInOperator();

            for (String vin : vins) {
                try {
                    // Check if VIN exists in hold table
                    String selectSql = "SELECT is_hold FROM vin_hold_status WHERE vinnumber = :vin";
                    Query sel = entityManager.createNativeQuery(selectSql);
                    sel.setParameter("vin", vin);
                    List<?> res = sel.getResultList();

                    boolean currentlyHeld = false;
                    if (!res.isEmpty()) currentlyHeld = (boolean) res.get(0);

                    boolean newHoldStatus = !currentlyHeld;
                    String action = newHoldStatus ? "HOLD" : "UNHOLD";

                    ZonedDateTime nowIST = ZonedDateTime.now(IST_ZONE);
                    Timestamp timestamp = Timestamp.from(nowIST.toInstant());

                    if (res.isEmpty()) {
                        // Insert new record
                        String insertSql = "INSERT INTO vin_hold_status (vinnumber, is_hold, updated_at, operatorname) VALUES (:vin, :hold, :time, :op)";
                        Query ins = entityManager.createNativeQuery(insertSql);
                        ins.setParameter("vin", vin);
                        ins.setParameter("hold", newHoldStatus);
                        ins.setParameter("time", timestamp);
                        ins.setParameter("op", operator);
                        ins.executeUpdate();
                    } else {
                        // Update record
                        String updateSql = "UPDATE vin_hold_status SET is_hold = :hold, updated_at = :time, operatorname = :op WHERE vinnumber = :vin";
                        Query upd = entityManager.createNativeQuery(updateSql);
                        upd.setParameter("hold", newHoldStatus);
                        upd.setParameter("time", timestamp);
                        upd.setParameter("op", operator);
                        upd.setParameter("vin", vin);
                        upd.executeUpdate();
                    }

                    // Fetch line-zone status from all kitting tables
                    List<Map<String, Object>> kittingPresence = analyzeVinAcrossLines(vin);

                    processed.add(Map.of(
                            "vin", vin,
                            "newStatus", action,
                            "updatedBy", operator,
                            "updatedAt", timestamp.toString(),
                            "kittingPresence", kittingPresence
                    ));

                } catch (Exception ex) {
                    log.error("Error toggling VIN hold for {} -> {}", vin, ex.getMessage());
                    failed.add(Map.of("vin", vin, "reason", ex.getMessage()));
                }
            }

            response.put("status", "success");
            response.put("message", "VIN hold toggled successfully (partial failures possible).");
            response.put("processedCount", processed.size());
            response.put("failedCount", failed.size());
            response.put("processed", processed);
            response.put("failed", failed);

        } catch (Exception ex) {
            log.error("❌ Fatal error in toggleHold: {}", ex.getMessage());
            response.put("status", "error");
            response.put("message", ex.getMessage());
        }

        return response;
    }

    private String getLoggedInOperator() {
        try {
            return SecurityContextHolder.getContext().getAuthentication().getName();
        } catch (Exception e) {
            return "UnknownOperator";
        }
    }

    private List<Map<String, Object>> analyzeVinAcrossLines(String vin) {
        List<Map<String, Object>> results = new ArrayList<>();

        for (Map.Entry<String, String> entry : KITTING_TABLES.entrySet()) {
            String line = entry.getKey();
            String table = entry.getValue();
            boolean isTwoZone = TWO_ZONE_LINES.contains(line);

            String sql = isTwoZone
                    ? String.format("SELECT isprocessedzone1, isprocessedzone2, isreservedzone1, isreservedzone2 FROM %s WHERE vinnumber = :vin", table)
                    : String.format("SELECT isprocessedzone1, isreservedzone1 FROM %s WHERE vinnumber = :vin", table);

            List<Object[]> list = entityManager.createNativeQuery(sql).setParameter("vin", vin).getResultList();

            for (Object[] r : list) {
                if (isTwoZone) {
                    addZoneAnalysis(results, line, "Z1", (Boolean) r[0], (Boolean) r[2]);
                    addZoneAnalysis(results, line, "Z2", (Boolean) r[1], (Boolean) r[3]);
                } else {
                    addZoneAnalysis(results, line, "Z1", (Boolean) r[0], (Boolean) r[1]);
                }
            }
        }

        return results;
    }

    private void addZoneAnalysis(List<Map<String, Object>> results, String line, String zone,
                                 Boolean processed, Boolean reserved) {
        if (processed == null) processed = false;
        if (reserved == null) reserved = false;

        String status;
        if (processed && reserved) status = "Completed before hold";
        else if (processed && !reserved) status = "Completed before hold";
        else if (reserved && !processed) status = "Kitting in-progress during hold";
        else status = "Kitting can be hold for that line zone";

        results.add(Map.of("line", line, "zone", zone, "status", status));
    }
}
