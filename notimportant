    // 1. Generate display headers based on tableColumn keys
    const headers = ['Sr. No.', ...this.tableColumns.map(col => this.getColumnDisplayName(col))];
    // 2. Build rows sequentially parsing active status maps correctly
    const rows = this.filteredPartDetails.map((item, index) => {
      const rowData = [
        String(index + 1), // Serial Numbers are cleanly incremental for exported entries
        ...this.tableColumns.map(col => {
