import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.sql.Timestamp;
import java.time.Instant;
import java.util.Comparator;
import java.util.List;

/**
 * Vehicle Data Scheduler Service:
 * Transfers data from vehicle_data → all kitting tables.
 * ✅ Ordered purely by RowId (lowest first)
 * ✅ Copies DSN properly
 * ✅ No hardcoded limits or assumptions
 */
@Service
public class VehicleDataService {

    private static final Logger log = LoggerFactory.getLogger(VehicleDataService.class);

    @Autowired
    private VehicleDataRepository vehicleDataRepository;

    @PersistenceContext
    private EntityManager entityManager;

    /**
     * Process all unprocessed vehicles, ordered by RowId ascending.
     */
    @Transactional
    public void processUnprocessedVehicles() {

        // Lock unprocessed rows safely (no parallel conflicts)
        Query lockQuery = entityManager.createNativeQuery(
                "SELECT * FROM vehicle_data WHERE isprocessed = false FOR UPDATE SKIP LOCKED",
                VehicleData.class
        );

        List<VehicleData> unprocessedList = lockQuery.getResultList();

        if (unprocessedList.isEmpty()) {
            log.debug("✅ No new vehicle_data entries found to process.");
            return;
        }

        // ✅ Sort by RowId (lowest first)
        unprocessedList.sort(Comparator.comparingInt(VehicleData::getRowId));

        log.info("📋 Found {} unprocessed vehicles (sorted by RowId).", unprocessedList.size());

        for (VehicleData vehicle : unprocessedList) {
            try {
                log.info("🚗 Processing RowID={} | VIN={} | VC={} | DSN={}",
                        vehicle.getRowId(), vehicle.getVinNumber(), vehicle.getVcNumber(), vehicle.getDsn());

                insertIntoKittingTables(vehicle);

                // ✅ Mark as processed after successful copy
                vehicle.setIsProcessed(true);
                vehicle.setLastModifiedTime(Timestamp.from(Instant.now()));
                vehicleDataRepository.save(vehicle);

                log.info("✅ Successfully processed RowID={} | VIN={} | DSN={}",
                        vehicle.getRowId(), vehicle.getVinNumber(), vehicle.getDsn());
            } catch (Exception ex) {
                log.error("❌ Error processing RowID={} | VIN={} | DSN={}",
                        vehicle.getRowId(), vehicle.getVinNumber(), vehicle.getDsn(), ex);
            }
        }
    }

    /**
     * Inserts each unprocessed vehicle into all respective kitting tables.
     */
    private void insertIntoKittingTables(VehicleData v) {
        Timestamp now = Timestamp.from(Instant.now());

        // Tables having two zones
        String insertTwoZone = """
            INSERT INTO %s ("vinnumber", "vcnumber", "dsn", "rowinserttime", "lastmodifiedtime",
                            "isprocessed", "operatorname", "isprocessedzone1", "isprocessedzone2")
            VALUES (:vin, :vc, :dsn, :rowInsert, :modified, false, null, false, false)
            ON CONFLICT ("vinnumber") DO NOTHING
            """;

        // Tables having one zone
        String insertOneZone = """
            INSERT INTO %s ("vinnumber", "vcnumber", "dsn", "rowinserttime", "lastmodifiedtime",
                            "isprocessed", "operatorname", "isprocessedzone1")
            VALUES (:vin, :vc, :dsn, :rowInsert, :modified, false, null, false)
            ON CONFLICT ("vinnumber") DO NOTHING
            """;

        // Two-zone tables
        for (String table : new String[]{"trim1_kitting_table", "trim2_kitting_table", "door_kitting_table"}) {
            entityManager.createNativeQuery(String.format(insertTwoZone, table))
                    .setParameter("vin", v.getVinNumber())
                    .setParameter("vc", v.getVcNumber())
                    .setParameter("dsn", v.getDsn())
                    .setParameter("rowInsert", v.getRowInsertTime())
                    .setParameter("modified", now)
                    .executeUpdate();
        }

        // One-zone tables
        for (String table : new String[]{"cradle_kitting_table", "cockpit_kitting_table"}) {
            entityManager.createNativeQuery(String.format(insertOneZone, table))
                    .setParameter("vin", v.getVinNumber())
                    .setParameter("vc", v.getVcNumber())
                    .setParameter("dsn", v.getDsn())
                    .setParameter("rowInsert", v.getRowInsertTime())
                    .setParameter("modified", now)
                    .executeUpdate();
        }

        log.info("📦 Inserted VIN={} | DSN={} | RowID={} into all kitting tables.",
                v.getVinNumber(), v.getDsn(), v.getRowId());
    }
}
