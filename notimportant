import { ToastrService } from 'ngx-toastr';
import { MoveVinDialogComponent } from '../../move-vin-dialog/move-vin-dialog.component';
import { MoveVinAnywhereDialogComponent } from '../../move-vin-anywhere-dialog/move-vin-anywhere-dialog.component';
import { MatDialog } from '@angular/material/dialog';
import { MatCheckboxModule } from '@angular/material/checkbox';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatIconModule } from '@angular/material/icon';
// --- NEW IMPORT FOR OUR DRILL-DOWN MODAL ---
// (This will error until we create it in the next step, that is totally fine!)
import { LivePickingModalComponent } from '../../../../shared/components/live-picking-modal/live-picking-modal.component';
interface Kit {
  line: string;
  zone: string;
  vin: string;
  vc: string;
  dsn: number;
  operator: string | null;
  trolleyCode: string | null;
  model: string | null;
  variant: string | null;
  kittingStartTime: string | null;
  ledColor: string | null;
  status: 'PICKING' | 'WAITING' | 'COMPLETED' | 'HOLD';
  completedAt?: string;
  isOnHold?: boolean;
}
interface CountInfo {
  inProgressCount: number;
  upcomingCount: number;
  completedCount: number;
}
@Component({
  standalone: true,
  imports: [
    CommonModule,
    MatTabsModule,
    FormsModule,
    MatTableModule,
    MatPaginatorModule,
    MatSortModule,
    MatCheckboxModule,
    MatFormFieldModule,
    MatInputModule,
    MatIconModule
  ],
  selector: 'app-tr2z2-kitting-status',
  templateUrl: './tr2z2.component.html',
  styleUrls: ['./tr2z2.component.scss'],
})
export class TR2Z2Component implements OnInit, AfterViewInit, OnDestroy {
  currentTime: string = '';
  pageSize: number = 10;
  currentLine: string = 'T2';
  currentZone: string = 'Z2';
  currentPage = 0;
  selectedVin: string = '';
  selectedRows: any[] = [];
  searchTerm: string = '';
  private originalSelectedRows: string[] = [];
  displayedColumns: string[] = [
    'select',
    'serialNo',
    'vin',
    'vc',
    'dsn',
    'operator',
    'trolleyCode',
    'model',
    'variant',
    'kittingStartTime',
    'ledColor',
    'status',
  ];
  dataSource: MatTableDataSource<Kit> = new MatTableDataSource<Kit>();
  originalData: Kit[] = [];
  filteredData: Kit[] = [];
  counts: CountInfo = {
    inProgressCount: 0,
    upcomingCount: 0,
    completedCount: 0,
  };
  @ViewChild('paginator') paginator!: MatPaginator;
  @ViewChild('videoElement') videoElement!: ElementRef<HTMLVideoElement>;
  @ViewChild('canvasElement') canvasElement!: ElementRef<HTMLCanvasElement>;
  @ViewChild('trolleyInput') trolleyInput!: ElementRef<HTMLInputElement>;
  isCameraOpen = false;
  scannedValue = '';
  manualTrolleyCode = '';
  isTrolleyLoading = false;
  isHoldVinLoading = false;
  videoStream: MediaStream | null = null;
  scanInterval: any;
  private dataRefreshInterval: any;
  private manualInputTimeout: any;
  constructor(
    private authService: AuthService,
    private toastr: ToastrService,
    public dialog: MatDialog // Changed to public so it can be accessed if needed
  ) {}
  ngOnInit(): void {
    this.updateCurrentTime();
    setInterval(() => this.updateCurrentTime(), 1000);
    this.loadDataForZone(this.currentLine, this.currentZone);
    this.startDataPolling();
  }
  ngOnDestroy(): void {
    this.stopDataPolling();
    if (this.manualInputTimeout) {
      clearTimeout(this.manualInputTimeout);
    }
  }
  startDataPolling(): void {
    this.dataRefreshInterval = setInterval(() => {
      this.loadDataForZone(this.currentLine, this.currentZone, true);
    }, 10000);
  }
  stopDataPolling(): void {
    if (this.dataRefreshInterval) {
      clearInterval(this.dataRefreshInterval);
    }
  }
  ngAfterViewInit(): void {
    this.dataSource.paginator = this.paginator;
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  updateCurrentTime(): void {
    const now = new Date();
    this.currentTime = now.toLocaleTimeString();
  }
  loadDataForZone(line: string, zone: string, silent: boolean = false): void {
    const url = Global.KITTING_STATUS_API.replace('{line}', line).replace('{zone}', zone);
    this.authService.httpGetRequest(url).subscribe({
      next: (res: any) => {
        const inProgress = (res.inProgress || []).map((k: any) => ({
          ...k,
          status: 'PICKING' as const
        }));
        const upcoming = (res.upcoming || []).map((k: any) => ({
          ...k,
          status: 'WAITING' as const
        }));
        const completed = (res.completed || []).map((k: any) => ({
          ...k,
          status: 'COMPLETED' as const,
          completedAt: k.completedAt || new Date().toISOString()
        }));
        const holdItems = (res.hold || []).map((k: any) => ({
          ...k,
          status: 'HOLD' as const,
          isOnHold: true
        }));
        // completed.sort((a: Kit, b: Kit) => {
        //   const timeA = a.completedAt ? new Date(a.completedAt).getTime() : 0;
        //   const timeB = b.completedAt ? new Date(b.completedAt).getTime() : 0;
        //   return timeB - timeA;
        // });
        const orderedData = this.applySmartOrdering(inProgress, upcoming, completed, holdItems);
        this.originalData = [...orderedData];
        let dataToDisplay = [...orderedData];
        if (this.searchTerm) {
          dataToDisplay = this.applySearchFilter(this.searchTerm, orderedData);
        }
        this.filteredData = dataToDisplay;
        this.dataSource.data = dataToDisplay;
        this.restoreCheckboxSelections();
        this.counts = {
          inProgressCount: res.inProgressCount ?? 0,
          upcomingCount: res.upcomingCount ?? 0,
          completedCount: res.completedCount ?? 0,
        };
        if (!silent) {
          setTimeout(() => this.focusTrolleyInput(), 100);
        }
      },
      error: (err) => {
        console.error(`Error loading ${line}-${zone}`, err);
        if (!silent) {
          setTimeout(() => this.focusTrolleyInput(), 100);
        }
      },
    });
  }
  applySearchFilter(searchTerm: string, data: Kit[]): Kit[] {
    if (!searchTerm) {
      return [...data];
    }
    const filterValue = searchTerm.toLowerCase().trim();
    return data.filter(item => {
      return (
        item.vin?.toLowerCase().includes(filterValue) ||
        item.vc?.toLowerCase().includes(filterValue) ||
        item.dsn?.toString().includes(filterValue) ||
        item.trolleyCode?.toLowerCase().includes(filterValue) ||
        item.model?.toLowerCase().includes(filterValue) ||
        item.variant?.toLowerCase().includes(filterValue) ||
        item.operator?.toLowerCase().includes(filterValue)
      );
    });
  }
  applySmartOrdering(inProgress: Kit[], upcoming: Kit[], completed: Kit[], holdItems: Kit[] = []): Kit[] {
    let orderedData: Kit[] = [...holdItems];
    // The backend sends [200, 199, 1, 2... 198]. 
    // We MUST split it to sandwich the upcoming items.
    const recentCompleted = completed.slice(0, 2); // Grabs 200, 199
    const olderCompleted = completed.slice(2);     // Grabs 1, 2... 198
    if (inProgress.length > 0) {
      orderedData = [
        ...orderedData, 
        ...inProgress,      // 1. Picking
        ...recentCompleted, // 2. Top 2 Completed
        ...upcoming,        // 3. Upcoming (150)
        ...olderCompleted   // 4. Remaining Completed (1 to 198)
      ];
    } else {
      orderedData = [
        ...orderedData, 
        ...recentCompleted, // 1. Top 2 Completed
        ...upcoming,        // 2. Upcoming (150)
        ...olderCompleted   // 3. Remaining Completed (1 to 198)
      ];
    }
    return orderedData;
  }
  getStatusClass(status: string): string {
    switch (status) {
      case 'PICKING':
        return 'status-picking';
      case 'WAITING':
        return 'status-waiting';
      case 'COMPLETED':
        return 'status-completed';
      case 'HOLD':
        return 'status-hold';
      default:
        return '';
    }
  }
  focusTrolleyInput(): void {
    if (this.trolleyInput && this.trolleyInput.nativeElement) {
      this.trolleyInput.nativeElement.focus();
    }
  }
  applyFilter(): void {
    if (!this.searchTerm) {
      this.dataSource.data = [...this.originalData];
      this.filteredData = [...this.originalData];
    } else {
      const filteredData = this.applySearchFilter(this.searchTerm, this.originalData);
      this.dataSource.data = filteredData;
      this.filteredData = filteredData;
    }
    this.updateCheckboxSelectionsAfterFilter();
    if (this.dataSource.paginator) {
      this.dataSource.paginator.firstPage();
    }
  }
  clearSearch(): void {
    this.searchTerm = '';
    this.dataSource.data = [...this.originalData];
    this.filteredData = [...this.originalData];
    this.restoreCheckboxSelections();
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  private storeSelectedRows(): void {
    this.originalSelectedRows = this.selectedRows.map(row => row.vin);
  }
  private restoreCheckboxSelections(): void {
    this.selectedRows = [];
    const currentData = this.dataSource.data || [];
    this.originalSelectedRows.forEach(vin => {
      const row = currentData.find(item => item.vin === vin);
      if (row) {
        this.selectedRows.push(row);
      }
    });
    this.originalSelectedRows = this.selectedRows.map(row => row.vin);
  }
  private updateCheckboxSelectionsAfterFilter(): void {
    const filteredData = this.dataSource.data || [];
    this.selectedRows = this.selectedRows.filter(row =>
      filteredData.some(item => item.vin === row.vin)
    );
    this.storeSelectedRows();
  }
  openCamera() {
    this.isCameraOpen = true;
    navigator.mediaDevices
      .getUserMedia({ video: { facingMode: 'environment' } })
      .then((stream) => {
        this.videoStream = stream;
        this.videoElement.nativeElement.srcObject = stream;
        this.videoElement.nativeElement.play();
        this.startScan();
      })
      .catch(() => {
        this.toastr.error('Unable to access camera');
        this.isCameraOpen = false;
        setTimeout(() => this.focusTrolleyInput(), 100);
      });
  }
  closeCamera() {
    this.isCameraOpen = false;
    if (this.videoStream) {
      this.videoStream.getTracks().forEach((track) => track.stop());
    }
    if (this.scanInterval) {
      clearInterval(this.scanInterval);
    }
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  startScan() {
    const video = this.videoElement.nativeElement;
    const canvas = this.canvasElement.nativeElement;
    const context = canvas.getContext('2d')!;
    this.scanInterval = setInterval(() => {
      if (video.readyState === video.HAVE_ENOUGH_DATA) {
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        context.drawImage(video, 0, 0, canvas.width, canvas.height);
        const imageData = context.getImageData(0, 0, canvas.width, canvas.height);
        const code = jsQR(imageData.data, imageData.width, imageData.height);
        if (code) {
          this.scannedValue = code.data.trim();
          this.closeCamera();
          this.onManualInput();
        }
      }
    }, 300);
  }
  onManualTrolleyChange(): void {
    if (this.manualInputTimeout) {
      clearTimeout(this.manualInputTimeout);
    }
    const code = this.manualTrolleyCode.trim().toUpperCase();
    if (!code) {
      return;
    }
    const pattern = /^(T2)Z(2)T\d{3}$/;
    if (pattern.test(code)) {
      this.manualInputTimeout = setTimeout(() => {
        this.validateTrolleyCode(code);
        this.manualTrolleyCode = '';
      }, 100);
    }
  }
  onManualTrolleyKeyPress(event: KeyboardEvent): void {
    if (event.key === 'Enter') {
      this.onManualTrolleySubmit();
    }
  }
  onManualTrolleySubmit(): void {
    const code = this.manualTrolleyCode.trim().toUpperCase();
    if (!code) {
      this.toastr.warning('Please enter a trolley code.');
      return;
    }
    const pattern = /^(T2)Z(2)T\d{3}$/;
    if (!pattern.test(code)) {
      this.toastr.error('Invalid trolley code format');
      this.manualTrolleyCode = '';
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    this.validateTrolleyCode(code);
    this.manualTrolleyCode = '';
  }
  onManualInput(): void {
    const pattern = /^(T2)Z(2)T\d{3}$/;
    const trolleyCode = this.scannedValue?.trim().toUpperCase();
    if (!trolleyCode) {
      this.toastr.warning('Please scan or enter a trolley code.', 'Warning');
      return;
    }
    if (!pattern.test(trolleyCode)) {
      this.toastr.error('Invalid scanned trolley code format', 'Error');
      this.scannedValue = '';
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    this.validateTrolleyCode(trolleyCode);
    this.scannedValue = '';
  }
  validateTrolleyCode(trolleyCode: string): void {
    const payload = { trolleyCode: trolleyCode.trim().toUpperCase() };
    const apiUrl = Global.TROLLEY_VALIDATION_API;
    this.isTrolleyLoading = true;
    this.authService.httpPostRequest(apiUrl, payload).subscribe({
      next: (response: any) => {
        this.isTrolleyLoading = false;
        if (response?.status?.toLowerCase() === 'success') {
          this.toastr.success(
            response?.message || `Trolley ${trolleyCode} identified successfully. Picking started.`,
            'Success'
          );
          this.loadDataForZone(response?.line || this.currentLine, response?.zone || this.currentZone);
          return;
        }
        if (response?.error) {
          this.toastr.error(response.error, 'Error');
          setTimeout(() => this.focusTrolleyInput(), 100);
          return;
        }
        this.toastr.warning(
          'Unexpected response received while validating trolley.',
          'Warning'
        );
        setTimeout(() => this.focusTrolleyInput(), 100);
      },
      error: (err) => {
        this.isTrolleyLoading = false;
        const backendError =
          err?.error?.error ||
          err?.error?.message ||
          err?.message ||
          'Unknown error occurred while validating trolley.';
        this.toastr.error(backendError, 'Error');
        console.error('Trolley validation error:', err);
        setTimeout(() => this.focusTrolleyInput(), 100);
      },
    });
  }
  onPageChange(event: any): void {
    this.currentPage = event.pageIndex;
    this.pageSize = event.pageSize;
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  // =========================================================================
  // NEW METHOD: OPENS THE P2L DRILL DOWN MODAL WHEN A 'PICKING' VIN IS CLICKED
  // =========================================================================
  openDrillDownModal(row: Kit): void {
    // We strictly only open this for VINs actively picking
    if (row.status !== 'PICKING') {
      return; 
    }
    const dialogRef = this.dialog.open(LivePickingModalComponent, {
      width: '970px', // Nice and wide to fit all the parts
      maxWidth: '95vw',
      maxHeight: '90vh',
      panelClass: 'live-picking-modal-panel', // Custom class for our dark theme
      data: {
        vin: row.vin,
        vc: row.vc,
        line: this.currentLine,
        zone: this.currentZone,
        trolleyCode: row.trolleyCode
      }
    });
    // When the modal closes, make sure the operator's scanner gets focus back immediately
    dialogRef.afterClosed().subscribe(() => {
      setTimeout(() => this.focusTrolleyInput(), 100);
    });
  }
  // =========================================================================
  onMoveAnywhere(): void {
    const currentData = this.dataSource?.data || [];
    const validSelectedRows = this.selectedRows.filter(row =>
      currentData.some(item => item.vin === row.vin)
    );
    if (validSelectedRows.length === 0) {
      this.toastr.warning('Please select one VIN to perform Move Anywhere.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    if (validSelectedRows.length > 1) {
      this.toastr.warning('You can only move one VIN at a time.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const selectedRow = validSelectedRows[0];
    const selectedVIN = selectedRow.vin;
    if (['PICKING', 'IN-PROGRESS', 'COMPLETED', 'HOLD'].includes(selectedRow.status?.toUpperCase() || '')) {
      this.toastr.error(
        'Cannot perform MOVE VIN(s) with COMPLETED or Picking status',
        'Invalid VIN'
      );
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const dialogRef = this.dialog.open(MoveVinAnywhereDialogComponent, {
      width: '500px',
      data: {
        vins: [selectedVIN],
        currentLine: this.currentLine,
        currentZone: this.currentZone
      }
    });
    dialogRef.afterClosed().subscribe(result => {
      if (result === 'refresh') {
        this.loadDataForZone(this.currentLine, this.currentZone);
        this.selectedRows = [];
        this.originalSelectedRows = [];
      }
      setTimeout(() => this.focusTrolleyInput(), 100);
    });
  }
  onHoldVin(): void {
    if (this.selectedRows.length === 0) {
      this.toastr.warning('Please select at least one VIN to perform Hold VIN.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const currentData = this.dataSource?.data || [];
    const validSelectedRows = this.selectedRows.filter(row =>
      currentData.some(item => item.vin === row.vin)
    );
    if (validSelectedRows.length === 0) {
      this.toastr.warning('Please select at least one valid VIN to perform Hold VIN.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const invalidVins = validSelectedRows.filter(row =>
      row.status === 'PICKING' || row.status === 'COMPLETED'
    );
    if (invalidVins.length > 0) {
      const invalidVinNumbers = invalidVins.map(v => v.vin).join(', ');
      this.toastr.error(
        `Cannot hold VIN(s) with PICKING or COMPLETED status`,
      );
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const alreadyOnHoldVins = validSelectedRows.filter(row =>
      row.status === 'HOLD' || row.isOnHold === true
    );
    const vins = validSelectedRows.map(row => row.vin);
    const payload = { vins: vins };
    this.isHoldVinLoading = true;
    this.authService.httpPostRequest(Global.HOLD_VIN_API, payload).subscribe({
      next: (response: any) => {
        this.isHoldVinLoading = false;
        if (response?.status === 'success') {
          const action = alreadyOnHoldVins.length === validSelectedRows.length ?
            'unhold' : (alreadyOnHoldVins.length > 0 ? 'hold/unhold' : 'hold');
          this.toastr.success(
            `${response.message || `VIN(s) ${action} successful. Processed: ${response.processedCount}`}`,
            'Success'
          );
          this.loadDataForZone(this.currentLine, this.currentZone);
          this.selectedRows = [];
          this.originalSelectedRows = [];
        } else {
          this.toastr.error(
            response?.message || 'Hold VIN operation failed.',
            'Error'
          );
          setTimeout(() => this.focusTrolleyInput(), 100);
        }
      },
      error: (error) => {
        this.isHoldVinLoading = false;
        console.error('Hold VIN Error:', error);
        this.toastr.error(
          error?.error?.message || 'Error occurred while performing Hold VIN.',
          'Error'
        );
        setTimeout(() => this.focusTrolleyInput(), 100);
      }
    });
  }
  getHoldButtonText(): string {
    const currentData = this.dataSource?.data || [];
    const validSelectedRows = this.selectedRows.filter(row =>
      currentData.some(item => item.vin === row.vin)
    );
    if (validSelectedRows.length === 0) {
      return 'Hold VIN';
    }
    const allOnHold = validSelectedRows.every(row =>
      row.status === 'HOLD' || row.isOnHold === true
    );
    return allOnHold ? 'Unhold VIN' : 'Hold VIN';
  }
  onMoveVin(): void {
    const currentData = this.dataSource?.data || [];
    const validSelectedRows = this.selectedRows.filter(row =>
      currentData.some(item => item.vin === row.vin)
    );
    if (validSelectedRows.length === 0) {
      this.toastr.warning('Please select one VIN to perform Move VIN.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    if (validSelectedRows.length > 1) {
      this.toastr.warning('You can only move one VIN at a time.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const selectedRow = validSelectedRows[0];
    const selectedVIN = selectedRow.vin;
    if (['PICKING', 'IN-PROGRESS', 'COMPLETED', 'HOLD'].includes(selectedRow.status?.toUpperCase() || '')) {
      this.toastr.error(
        'Cannot perform MOVE VIN(s) with COMPLETED or Picking status',
        'Invalid VIN'
      );
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const dialogRef = this.dialog.open(MoveVinDialogComponent, {
      width: '450px',
      data: {
        vins: [selectedVIN],
        targetLine: 'T2',
        targetZone: 'Z2'
      }
    });
    dialogRef.afterClosed().subscribe(result => {
      if (result === 'refresh') {
        this.loadDataForZone(this.currentLine, this.currentZone);
        this.selectedRows = [];
        this.originalSelectedRows = [];
      }
      setTimeout(() => this.focusTrolleyInput(), 100);
    });
  }
  isSelected(row: any): boolean {
    return this.selectedRows.includes(row);
  }
  toggleSelection(row: any): void {
    const index = this.selectedRows.indexOf(row);
    if (index === -1) {
      this.selectedRows.push(row);
    } else {
      this.selectedRows.splice(index, 1);
    }
    this.storeSelectedRows();
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  isAllSelected(): boolean {
    const currentData = this.dataSource?.data || [];
    return currentData.length > 0 && this.selectedRows.length === currentData.length;
  }
  isIndeterminate(): boolean {
    const currentData = this.dataSource?.data || [];
    return this.selectedRows.length > 0 && this.selectedRows.length < currentData.length;
  }
  toggleSelectAll(event: any): void {
    const currentData = this.dataSource?.data || [];
    if (event.checked) {
      this.selectedRows = [...currentData];
    } else {
      this.selectedRows = [];
    }
    this.storeSelectedRows();
    setTimeout(() => this.focusTrolleyInput(), 100);
  }
  onForceKitting(): void {
    if (!this.selectedRows || this.selectedRows.length === 0) {
      this.toastr.warning('Please select at least one VIN to perform Force Kitting.', 'Warning');
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const completedVins = this.selectedRows.filter(row =>
      row.status === 'COMPLETED'
    );
    if (completedVins.length > 0) {
      const completedVinNumbers = completedVins.map(v => v.vin).join(', ');
      this.toastr.error(
        `Cannot perform Force Kitting on VIN(s) with COMPLETED status`,
      );
      setTimeout(() => this.focusTrolleyInput(), 100);
      return;
    }
    const vins = this.selectedRows.map(row => row.vin);
    const payload =
      vins.length === 1
        ? { line: this.currentLine, zone: this.currentZone, vins: vins[0] }
        : { line: this.currentLine, zone: this.currentZone, vins: vins };
    this.authService.httpPostRequest(Global.LINE_FORCE_KITTING_API, payload).subscribe({
      next: (response: any) => {
        if (response?.status === 'success') {
          this.toastr.success('Force Kitting completed successfully!', 'Success', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
          this.loadDataForZone(this.currentLine, this.currentZone);
        } else {
          const message =
            response?.message || 'Force Kitting failed. Please try again.';
          this.toastr.error(message, 'Error', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
          setTimeout(() => this.focusTrolleyInput(), 100);
        }
        this.selectedRows = [];
        this.originalSelectedRows = [];
      },
      error: (error) => {
        console.error('Force Kitting Error:', error);
        this.toastr.error('Error occurred while performing Force Kitting.', 'Error', {
          timeOut: 3000,
          progressBar: true,
          positionClass: 'toast-bottom-center'
        });
        setTimeout(() => this.focusTrolleyInput(), 100);
      }
    });
  }
