    this.dialog.open(LivePickingModalComponent, {
      width: '970px',
      maxWidth: '95vw',
      maxHeight: '90vh',
      panelClass: 'custom-dialog-container',
      data: {
        vin: row.vin,
        vc: row.vc,
        line: this.currentLine,
        zone: this.currentZone,
