  getKey(line: string, zone: string): string {
    return `${line}_${zone}`;
  }
  createFilter(): (data: Kit, filter: string) => boolean {
    return (data: Kit, filter: string): boolean => {
      if (!filter) return true;
      const searchTerms = filter.toLowerCase().split(' ');
      const dataStr = Object.keys(data).reduce((currentTerm: string, key: string) => {
        const value = data[key as keyof Kit];
        return currentTerm + (value ? value.toString().toLowerCase() + ' ' : '');
      }, '');
      return searchTerms.every(term => dataStr.includes(term));
    };
  }
  applyFilter(): void {
    const filterValue = this.searchTerm.trim().toLowerCase();
    this.lineZones.forEach((z) => {
      const key = this.getKey(z.line, z.zone);
      const dataSource = this.dataSources[key];
      if (dataSource) {
        dataSource.filter = filterValue;
        const paginator = dataSource.paginator;
        if (paginator) {
          paginator.firstPage();
        }
      }
    });
  }
  loadDataForZone(line: string, zone: string): void {
    const url = Global.KITTING_STATUS_API.replace('{line}', line).replace('{zone}', zone);
    this.authService.httpGetRequest(url).subscribe({
      next: (res: any) => {
        const key = this.getKey(line, zone);
        const dataSource = this.dataSources[key];
        if (!dataSource) return;
        const currentFilter = dataSource.filter || '';
        const inProgress = (res.inProgress || []).map((k: any) => ({
          ...k,
          status: 'PICKING' as const,
          completedAt: null
        }));
        const upcoming = (res.upcoming || []).map((k: any) => ({
          ...k,
          status: 'WAITING' as const,
          completedAt: null
        }));
        const completed = (res.completed || []).map((k: any) => ({
          ...k,
          status: 'COMPLETED' as const,
          completedAt: k.completedAt || new Date().toISOString()
        }));
        const sortedCompleted = completed.sort((a: Kit, b: Kit) => {
          const timeA = a.completedAt ? new Date(a.completedAt).getTime() : 0;
          const timeB = b.completedAt ? new Date(b.completedAt).getTime() : 0;
          return timeB - timeA;
        });
        const recentCompleted = sortedCompleted.slice(0, 2);
        const remainingCompleted = sortedCompleted.slice(2);
        let arrangedData: Kit[] = [];
        if (inProgress.length > 0) {
          arrangedData = [...inProgress, ...recentCompleted, ...upcoming, ...remainingCompleted];
        } else {
          arrangedData = [...recentCompleted, ...upcoming, ...remainingCompleted];
        }
        dataSource.data = arrangedData;
        if (currentFilter) {
          dataSource.filter = currentFilter;
        }
        this.counts[key] = {
          inProgressCount: res.inProgressCount ?? 0,
          upcomingCount: res.upcomingCount ?? 0,
          completedCount: res.completedCount ?? 0,
        };
        this.isLoading = false;
      },
      error: (err) => console.error(`Error loading ${line}-${zone}`, err),
    });
  }
  getStatusClass(status: string): string {
    switch (status) {
      case 'PICKING':
        return 'status-picking';
      case 'WAITING':
        return 'status-waiting';
      case 'COMPLETED':
        return 'status-completed';
      case 'HOLD':
        return 'status-hold';
      default:
        return '';
    }
  }
  onTabChange(event: { index: number }): void {
