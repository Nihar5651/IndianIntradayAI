  </ng-container>
  <ng-container matColumnDef="operator">
    <th mat-header-cell *matHeaderCellDef>Operator</th>
    <td mat-cell *matCellDef="let element">{{ element.operator }}</td>
  </ng-container>
  <ng-container matColumnDef="trolleyCode">
    <th mat-header-cell *matHeaderCellDef>Trolley</th>
    <td mat-cell *matCellDef="let element">{{ element.trolleyCode }}</td>
