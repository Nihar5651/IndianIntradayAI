  onForceKitting(): void {
    const selectedRows = this.getSelectedRows();
    if (selectedRows.length === 0) {
      this.toastr.warning('Please select at least one VIN to perform Force Kitting.', 'Warning');
      return;
    }
    const completedVins = selectedRows.filter(row =>
      row.status?.toUpperCase() === 'COMPLETED'
    );
    if (completedVins.length > 0) {
      if (completedVins.length === selectedRows.length) {
        this.toastr.error(`Cannot perform Force Kitting on VIN(s) with COMPLETED status.`, 'Error');
      } else {
        this.toastr.error(`Cannot perform Force Kitting on VIN(s) with COMPLETED status`, 'Error');
      }
      return;
    }
    const vins = selectedRows.map(row => row.vin);
    const payload =
      vins.length === 1
        ? { line: this.currentLine, zone: this.currentZone, vins: vins[0] }
        : { line: this.currentLine, zone: this.currentZone, vins: vins };
    this.authService.httpPostRequest(Global.LINE_FORCE_KITTING_API, payload).subscribe({
      next: (response: any) => {
        if (response?.status === 'success') {
          this.toastr.success('Force Kitting completed successfully!', 'Success', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
          this.loadDataForZone(this.currentLine, this.currentZone);
        } else {
          const message = response?.message || 'Force Kitting failed. Please try again.';
          this.toastr.error(message, 'Error', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
        }
        const currentData = this.dataSources[`${this.currentLine}_${this.currentZone}`]?.data || [];
        currentData.forEach(row => this.selectedVins.delete(row.vin));
      },
      error: (error) => {
        console.error('Force Kitting Error:', error);
        this.toastr.error('Error occurred while performing Force Kitting.', 'Error', {
          timeOut: 3000,
          progressBar: true,
          positionClass: 'toast-bottom-center',
        });
      }
    });
  }
  // =======================================================================
  // 🔥 ADMIN ENDPOINTS: Edit VIN/VC and Reverse Force Kit
  // =======================================================================
  onEditVehicle(): void {
    const selectedRows = this.getSelectedRows();
    if (selectedRows.length === 0) {
      this.toastr.warning('Please select one VIN to Edit.', 'Warning');
      return;
    }
    if (selectedRows.length > 1) {
      this.toastr.warning('You can only edit one vehicle at a time.', 'Warning');
      return;
    }
    const selectedRow = selectedRows[0];
    // Safety check matching the backend: Only edit WAITING vehicles
    if (selectedRow.status?.toUpperCase() !== 'WAITING') {
      this.toastr.error('Cannot edit vehicle. Vehicle must be strictly in WAITING status.', 'Error');
      return;
    }
    // Open the new Angular Material Dialog
    const dialogRef = this.dialog.open(EditVehicleDialogComponent, {
      width: '400px',
      disableClose: true,
      data: {
        line: this.currentLine,
        zone: this.currentZone,
        vin: selectedRow.vin,
        vc: selectedRow.vc
      }
    });
    // Listen for the result when the dialog closes
    dialogRef.afterClosed().subscribe(result => {
      if (result) {
        const payload = {
          line: this.currentLine,
          oldVin: selectedRow.vin,
          newVin: result.newVin.trim(),
          newVc: result.newVc.trim()
        };
        const apiUrl = 'api/kitting/line-status/edit-vehicle';
        this.isLoading = true;
        this.authService.httpPostRequest(apiUrl, payload).subscribe({
          next: (res: any) => {
            this.isLoading = false;
            if (res?.status === 'success') {
              this.toastr.success(res?.message || 'Vehicle edited successfully!', 'Success', {
                timeOut: 3000,
                progressBar: true,
                positionClass: 'toast-bottom-center'
              });
              this.refreshAllZones();
              this.selectedVins.delete(selectedRow.vin);
            } else {
              this.toastr.error(res?.message || 'Failed to edit vehicle.', 'Error');
            }
          },
          error: (err) => {
            this.isLoading = false;
            this.toastr.error(err?.error?.message || 'Error occurred while editing vehicle.', 'Error');
          }
        });
      }
    });
  }
  onReverseKitting(): void {
    const selectedRows = this.getSelectedRows();
    if (selectedRows.length === 0) {
      this.toastr.warning('Please select one VIN to perform Reverse Kitting.', 'Warning');
      return;
    }
    if (selectedRows.length > 1) {
      this.toastr.warning('You can only reverse kitting for one vehicle at a time.', 'Warning');
      return;
    }
    const selectedRow = selectedRows[0];
    // Safety check matching the backend: Only reverse COMPLETED vehicles
    if (selectedRow.status?.toUpperCase() !== 'COMPLETED') {
      this.toastr.error('Cannot reverse kitting. Vehicle must be in COMPLETED status.', 'Error');
      return;
    }
    const confirmReverse = window.confirm(`Are you sure you want to reverse kitting for VIN: ${selectedRow.vin}?`);
    if (!confirmReverse) return;
    const payload = {
      line: this.currentLine,
      zone: this.currentZone,
      vin: selectedRow.vin
    };
    const apiUrl = 'api/kitting/line-status/reverse-force-kit';
    this.isLoading = true;
    this.authService.httpPostRequest(apiUrl, payload).subscribe({
      next: (res: any) => {
        this.isLoading = false;
        if (res?.status === 'success') {
          this.toastr.success(res?.message || 'Kitting reversed successfully!', 'Success', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
          this.refreshAllZones();
          this.selectedVins.delete(selectedRow.vin);
        } else {
          this.toastr.error(res?.message || 'Failed to reverse kitting.', 'Error');
        }
      },
      error: (err) => {
        this.isLoading = false;
        this.toastr.error(err?.error?.message || 'Error occurred while reversing kitting.', 'Error');
      }
    });
  }
