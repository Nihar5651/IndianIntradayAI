import { of } from 'rxjs';
import { RouterModule } from '@angular/router';
import { Global } from 'src/app/shared/constants/Global';
import { AuthService } from 'src/app/shared/services/auth.service';
import * as XLSX from 'xlsx';
interface BomItem {
  [key: string]: any;
}
interface BomResponse {
  content: BomItem[];
  pageable: {
    pageNumber: number;
    pageSize: number;
  };
  totalElements: number;
  totalPages: number;
  first: boolean;
  last: boolean;
  numberOfElements: number;
  number: number;
  size: number;
}
interface UploadResponse {
  message: string;
  processedVcs?: string[];
  totalParts?: number;
  kittingParts?: number;
  sequencingParts?: number;
  notKittingSequencingParts?: number;
  pendingHardwareParts?: number; 
  missingVcs?: string[];
}
@Component({
  selector: 'app-vc-bom-upload',
  standalone: true,
  imports: [CommonModule, FormsModule, RouterModule],
  templateUrl: './vcbomupload.component.html',
  styleUrls: ['./vcbomupload.component.scss'],
})
export class VcBomUploadComponent implements OnInit {
  bomData: BomResponse | null = null;
  searchTerm: string = '';
  classificationFilter: string = '';
  isLoading: boolean = false;
  uploadMessage: string = '';
  uploadError: string = '';
  uploadResult: UploadResponse | null = null;
  missingVcs: string[] = [];
  showSuccessModal: boolean = false;
  showErrorModal: boolean = false;
  modalTitle: string = '';
  modalMessage: string = '';
  modalDetails: any = null;
  currentPage: number = 0;
  itemsPerPage: number = 50;
  tableColumns: string[] = [
    'vc', 'item', 'level', 'material', 'description', 'quantity', 'uom', 
    'bulkInd', 'procurement', 'spProc', 'model', 'variant', 'color', 
    'classification', 'line', 'zone', 'rack', 'row', 'column', 'createdAt', 'updatedAt'
  ];
  filteredContent: BomItem[] = [];
  // Toggles the visibility of the classification filter dropdown menu
  showFilterDropdown: boolean = false;
  constructor(private http: HttpClient, private authService: AuthService) {}
  ngOnInit(): void {
    this.loadBomData();
  }
  loadBomData(): void {
    this.isLoading = true;
    let params = new HttpParams()
      .set('page', this.currentPage.toString())
      .set('size', this.itemsPerPage.toString());
    if (this.searchTerm && this.searchTerm.length >= 3) {
      params = params.set('vc', this.searchTerm);
    }
    if (this.classificationFilter) {
      params = params.set('classification', this.classificationFilter);
    }
    const apiUrl = `${Global['VC_BOM_VIEW']}?page=${this.currentPage}&size=${this.itemsPerPage}`
      + (this.classificationFilter ? `&classification=${this.classificationFilter}` : '');
    this.authService.httpGetRequest(apiUrl)
      .pipe(
        catchError((error) => {
          console.error('Error fetching BOM data:', error);
          this.showError('Load Error', 'Failed to load BOM data');
          return of(null);
        })
      )
      .subscribe({
        next: (data: BomResponse) => {
          this.bomData = data;
          if (data?.content && data.content.length > 0) {
            data.content = data.content.map((item) => this.formatTimestamps(item));
            const availableColumns = Object.keys(data.content[0]);
            const filteredColumns = this.tableColumns.filter((col) => availableColumns.includes(col));
            const additionalColumns = availableColumns.filter((col) => !this.tableColumns.includes(col));
            this.tableColumns = [...filteredColumns, ...additionalColumns];
            this.filteredContent = [...data.content];
          } else {
            this.filteredContent = [];
          }
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error:', error);
          this.isLoading = false;
        },
      });
  }
  loadFullBomDataToSearch(): void {
    this.isLoading = true;
    let params = new HttpParams().set('page', 0).set('size', 100000000);
    if (this.classificationFilter) {
      params = params.set('classification', this.classificationFilter);
    }
    const apiUrl = `${Global['VC_BOM_VIEW']}?page=0&size=100000000`
      + (this.classificationFilter ? `&classification=${this.classificationFilter}` : '');
    this.authService.httpGetRequest(apiUrl)
      .pipe(
        catchError((error) => {
          console.error('Error fetching BOM data:', error);
          this.showError('Load Error', 'Failed to load BOM data');
          return of(null);
        })
      )
      .subscribe({
        next: (data: BomResponse) => {
          this.bomData = data;
          if (data?.content && data.content.length > 0) {
            data.content = data.content.map((item) => this.formatTimestamps(item));
            const availableColumns = Object.keys(data.content[0]);
            const filteredColumns = this.tableColumns.filter((col) => availableColumns.includes(col));
            const additionalColumns = availableColumns.filter((col) => !this.tableColumns.includes(col));
            this.tableColumns = [...filteredColumns, ...additionalColumns];
            this.filteredContent = [...data.content];
          } else {
            this.filteredContent = [];
          }
          this.isLoading = false;
          this.filterCurrentPageData();
        },
        error: (error) => {
          console.error('Error:', error);
          this.isLoading = false;
        },
      });
  }
  formatTimestamps(item: BomItem): BomItem {
    const formattedItem = { ...item };
    if (formattedItem['createdAt']) {
      formattedItem['createdAt'] = this.formatTimestamp(formattedItem['createdAt']);
    }
    if (formattedItem['updatedAt']) {
      formattedItem['updatedAt'] = this.formatTimestamp(formattedItem['updatedAt']);
    }
    return formattedItem;
  }
  formatTimestamp(timestamp: string | number | Date): string {
    if (!timestamp) return '';
    const date = new Date(timestamp);
    if (isNaN(date.getTime())) return String(timestamp);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const seconds = String(date.getSeconds()).padStart(2, '0');
    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  }
  onSearch(): void {
    if (this.searchTerm.length < 3) {
      this.loadBomData();
    } else {
      this.loadFullBomDataToSearch();
    }
  }
  filterCurrentPageData(): void {
    if (!this.bomData?.content) {
      this.filteredContent = [];
      return;
    }
    const searchLower = this.searchTerm.toLowerCase();
    this.filteredContent = this.bomData.content.filter((item) =>
      Object.values(item).some(
        (val) => val && val.toString().toLowerCase().includes(searchLower)
      )
    );
  }
  toggleFilterDropdown(): void {
    this.showFilterDropdown = !this.showFilterDropdown;
  }
  selectClassification(classification: string): void {
    this.classificationFilter = classification;
    this.showFilterDropdown = false;
    this.currentPage = 0;
    if (this.searchTerm.length === 0) {
      this.loadBomData();
    } else {
      this.onSearch();
    }
  }
  clearFilters(): void {
    this.searchTerm = '';
    this.classificationFilter = '';
    this.currentPage = 0;
    this.showFilterDropdown = false;
    this.loadBomData();
  }
  onFileSelected(event: any, isLargeUpload: boolean = false): void {
    const file: File = event.target.files[0];
    if (!file) return;
    if (!file.name.match(/\.(xlsx|xls)$/i)) {
      this.showError('File Format Error', 'Please upload a valid Excel file with Valid Extension');
      event.target.value = '';
      return;
    }
    const maxSize = isLargeUpload ? 50 * 1024 * 1024 : 20 * 1024 * 1024;
    if (file.size > maxSize) {
      this.showError('File Size Error', `File too large. Allowed size is ${isLargeUpload ? '50MB' : '20MB'}`);
      event.target.value = '';
      return;
    }
    this.uploadBomExcel(file, event, isLargeUpload);
  }
  uploadBomExcel(file: File, event: any, isLargeUpload: boolean = false): void {
    this.isLoading = true;
    this.uploadMessage = '';
    this.uploadError = '';
    this.uploadResult = null;
    this.missingVcs = [];
    const formData = new FormData();
    formData.append('file', file);
    const apiEndpoint = isLargeUpload 
        ? Global['VC_BOM_UPLOAD'].replace('/upload', '/upload-large')
        : Global['VC_BOM_UPLOAD'];
    this.authService.httpPostRequest(apiEndpoint, formData)
      .pipe(
        catchError((error) => {
          console.error('Upload error:', error);
          let errorMessage = error.error?.message || 'Upload failed';
          this.missingVcs = error.error?.missingVcs || [];
          this.showError('Upload Failed', errorMessage);
          this.isLoading = false;
          event.target.value = '';
          return of(null);
        })
      )
      .subscribe({
        next: (response) => {
          if (response) {
            this.uploadResult = response;
            if (response.missingVcs && response.missingVcs.length > 0) {
              this.missingVcs = response.missingVcs;
              const errorMessage = `Found ${response.missingVcs.length} VCs that are not configured in VC Details. Please configure these VCs first.`;
              this.showError('Missing VCs', errorMessage);
            } else {
              const successMessage = response.message || 'BOM uploaded successfully';
              const details = {
                processedVcs: response.processedVcs,
                totalParts: response.totalParts,
                kittingParts: response.kittingParts,
                sequencingParts: response.sequencingParts,
                notKittingSequencingParts: response.notKittingSequencingParts,
                pendingHardwareParts: response.pendingHardwareParts 
              };
              this.showSuccess('Upload Successful', successMessage, details);
              this.loadBomData();
            }
          }
          this.isLoading = false;
          event.target.value = '';
        },
        error: (error) => {
          console.error('Upload error:', error);
          let errorMessage = error.error?.message || 'Upload failed';
          this.missingVcs = error.error?.missingVcs || [];
          this.showError('Upload Failed', errorMessage);
          this.isLoading = false;
          event.target.value = '';
        },
      });
  }
  exportToExcel(): void {
    const dataToExport = this.getDisplayData();
    if (!dataToExport || dataToExport.length === 0) {
      this.showError('Export Warning', 'No data available to export.');
      return;
    }
    // Map keys to display names
    const formattedData = dataToExport.map((item, index) => {
      const rowData: { [key: string]: any } = { 'Sr. No.': this.getSerialNumber(index) };
      this.tableColumns.forEach((col) => {
        const displayName = this.getColumnDisplayName(col);
        rowData[displayName] = item[col] !== undefined && item[col] !== null ? item[col] : '';
      });
      return rowData;
    });
    const worksheet: XLSX.WorkSheet = XLSX.utils.json_to_sheet(formattedData);
    const workbook: XLSX.WorkBook = { Sheets: { 'VC BOM Data': worksheet }, SheetNames: ['VC BOM Data'] };
    // Auto-fit column widths using strict parameter configuration ('wch')
    const objectMaxWidth: number[] = [];
    formattedData.forEach((row) => {
      Object.keys(row).forEach((key, colIndex) => {
        const valueLength = row[key] ? row[key].toString().length : 0;
        const keyLength = key.toString().length;
        const maxLength = Math.max(valueLength, keyLength);
        objectMaxWidth[colIndex] = Math.max(objectMaxWidth[colIndex] || 0, maxLength);
      });
    });
    // Fixed TS2322 Type compliance error by mapping to 'wch' instead of 'w'
    worksheet['!cols'] = objectMaxWidth.map(w => ({ wch: w + 3 }));
    XLSX.writeFile(workbook, `VC_BOM_Export_${new Date().toISOString().slice(0,10)}.xlsx`);
  }
  showSuccess(title: string, message: string, details?: any): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.modalDetails = details;
    this.showSuccessModal = true;
  }
  showError(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showErrorModal = true;
  }
  closeSuccessModal(): void {
    this.showSuccessModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
    this.modalDetails = null;
  }
  closeErrorModal(): void {
    this.showErrorModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
    this.missingVcs = [];
  }
  hasData(): boolean { return !!(this.bomData?.content && this.bomData.content.length > 0); }
  hasDisplayData(): boolean { return this.filteredContent.length > 0; }
  getDisplayData(): BomItem[] { return this.searchTerm && this.searchTerm.length >= 3 ? this.filteredContent : this.bomData?.content || []; }
  getColspan(): number { return this.tableColumns.length + 1; }
  getSerialNumber(index: number): number { return this.currentPage * this.itemsPerPage + index + 1; }
  getTotalElements(): number { return this.bomData?.totalElements || 0; }
  getTotalDisplayItems(): number {
    if (this.searchTerm && this.searchTerm.length >= 3) return this.filteredContent.length;
    return this.bomData?.totalElements || 0;
  }
  getDisplayStart(): number {
    if (this.searchTerm && this.searchTerm.length >= 3) return 1;
    const pageNumber = this.bomData?.number || 0;
    return pageNumber * this.itemsPerPage + 1;
  }
  getDisplayEnd(): number {
    if (this.searchTerm && this.searchTerm.length >= 3) return this.filteredContent.length;
    const pageNumber = this.bomData?.number || 0;
    const totalElements = this.bomData?.totalElements || 0;
    const calculatedEnd = (pageNumber + 1) * this.itemsPerPage;
    return calculatedEnd > totalElements ? totalElements : calculatedEnd;
  }
  isFirstPage(): boolean { return this.bomData?.first || this.currentPage === 0; }
  isLastPage(): boolean { return (this.bomData?.last || this.currentPage === (this.bomData?.totalPages ? this.bomData.totalPages - 1 : 0)); }
