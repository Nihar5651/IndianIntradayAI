package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.sql.Timestamp;
import java.time.ZoneId;
import java.time.ZonedDateTime;
import java.util.*;

/**
 * VinUnholdAndMoveService
 *
 * Atomic operation:
 *  - Verify vinToMove is currently on hold
 *  - Pre-validate move eligibility across requested lines/zones
 *  - Lock relevant kitting tables
 *  - Unhold vin (is_hold=false, updated_at IST, operatorname)
 *  - Perform safe reorder for each READY line-zone (by id / idz2)
 *  - If any failure: rollback transaction (unhold reverted)
 *
 * Response:
 *  - On validation failure: status=error, unholdStatus=reverted, details -> all failed line-zones
 *  - On runtime/move failure: status=error, unholdStatus=reverted, details -> reason
 *  - On success: status=success, unholdStatus=success, details -> per line-zone success messages
 */
@Service
public class VinUnholdAndMoveService {

    private static final Logger log = LoggerFactory.getLogger(VinUnholdAndMoveService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");
    private static final Set<String> SINGLE_ZONE_LINES = Set.of("CR", "CP");

    // Large offset used during reorder to avoid PK collisions
    private static final long TEMP_OFFSET = 100000L;

    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");

    /**
     * Main atomic method.
     * Expected payload keys: vinToMove, referenceVin, targetTable (ALL|T1|T2|DR|CR|CP), zones (Zone1|Zone2|Both)
     */
    @Transactional(rollbackFor = Exception.class)
    public Map<String, Object> unholdAndMove(Map<String, Object> payload) {
        Map<String, Object> response = new LinkedHashMap<>();

        // --- Extract & validate basic inputs ---
        final String vinToMove = safeTrim(payload.get("vinToMove"));
        final String referenceVin = safeTrim(payload.get("referenceVin"));
        final String targetTableRaw = safeTrim(payload.getOrDefault("targetTable", "ALL"));
        final String zonesRaw = safeTrim(payload.getOrDefault("zones", "Zone1"));

        if (vinToMove.isEmpty() || referenceVin.isEmpty()) {
            response.put("status", "error");
            response.put("unholdStatus", "reverted");
            response.put("message", "vinToMove and referenceVin are required.");
            return response;
        }

        final String targetTable = targetTableRaw.toUpperCase();
        final Set<String> zonesRequested = parseZones(zonesRaw);

        // Build list of lines to attempt
        List<String> linesToProcess = new ArrayList<>();
        if ("ALL".equals(targetTable)) {
            linesToProcess.addAll(KITTING_TABLES.keySet());
        } else {
            if (!KITTING_TABLES.containsKey(targetTable)) {
                response.put("status", "error");
                response.put("unholdStatus", "reverted");
                response.put("message", "Invalid targetTable. Allowed: ALL, T1, T2, DR, CR, CP");
                return response;
            }
            linesToProcess.add(targetTable);
        }

        // Collect set of actual tables to lock
        Set<String> tablesToLock = new LinkedHashSet<>();
        for (String line : linesToProcess) {
            String tbl = KITTING_TABLES.get(line);
            if (tbl != null) tablesToLock.add(tbl);
        }

        try {
            // --- PRE-VALIDATION STAGE ---
            // 1) Check presence in vin_hold_status and that vinToMove is currently on hold
            if (!isVinPresentInHoldTable(vinToMove)) {
                response.put("status", "error");
                response.put("unholdStatus", "reverted");
                response.put("message", "VIN " + vinToMove + " not present in vin_hold_status.");
                return response;
            }
            if (!isVinCurrentlyOnHold(vinToMove)) {
                response.put("status", "error");
                response.put("unholdStatus", "reverted");
                response.put("message", "VIN " + vinToMove + " is not currently on hold. Operation aborted.");
                return response;
            }

            // 2) Lock target kitting tables BEFORE further validation to ensure consistent reads
            if (!tablesToLock.isEmpty()) {
                lockTables(tablesToLock);
            }

            // 3) Pre-validate all line-zone pairs and collect per-zone info
            Map<String, Map<String, String>> perZoneStatus = new LinkedHashMap<>(); // key -> info map

            for (String line : linesToProcess) {
                String table = KITTING_TABLES.get(line);
                if (table == null) continue;

                Set<String> zonesForLine = new LinkedHashSet<>(zonesRequested);
                if (SINGLE_ZONE_LINES.contains(line)) zonesForLine = Set.of("Zone1");

                for (String zone : zonesForLine) {
                    final String zoneKey = line + "-" + zone;
                    final int zoneNumber = zone.equalsIgnoreCase("Zone2") ? 2 : 1;
                    Map<String, String> info = new LinkedHashMap<>();

                    // Skip invalid zone for single-zone lines
                    if (SINGLE_ZONE_LINES.contains(line) && zoneNumber == 2) {
                        info.put("status", "SKIPPED");
                        info.put("reason", "Line " + line + " supports only Zone1");
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }

                    // Existence checks in kitting table for both VINs
                    if (!vinExistsInTable(table, vinToMove)) {
                        info.put("status", "FAILED");
                        info.put("reason", "vinToMove not found in table " + table);
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }
                    if (!vinExistsInTable(table, referenceVin)) {
                        info.put("status", "FAILED");
                        info.put("reason", "referenceVin not found in table " + table);
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }

                    // Reference VIN must not be on hold
                    if (isVinCurrentlyOnHold(referenceVin)) {
                        info.put("status", "FAILED");
                        info.put("reason", "referenceVin is currently on hold");
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }

                    // Kitting 4-state checks for both VINs
                    String vinToMoveState = getKittingState(table, vinToMove, zoneNumber);
                    String refVinState = getKittingState(table, referenceVin, zoneNumber);

                    info.put("vinToMoveState", vinToMoveState);
                    info.put("referenceVinState", refVinState);

                    if (!"CAN_MOVE".equals(vinToMoveState)) {
                        info.put("status", "FAILED");
                        info.put("reason", "vinToMove not eligible -> " + vinToMoveState);
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }
                    if (!"CAN_MOVE".equals(refVinState)) {
                        info.put("status", "FAILED");
                        info.put("reason", "referenceVin not eligible -> " + refVinState);
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }

                    // Ensure id/idz2 exists
                    Long idToMove = getIdForVin(table, vinToMove, zoneNumber);
                    Long idRef = getIdForVin(table, referenceVin, zoneNumber);
                    if (idToMove == null || idRef == null) {
                        info.put("status", "FAILED");
                        info.put("reason", "id/idz2 missing for one or both VINs");
                        perZoneStatus.put(zoneKey, info);
                        continue;
                    }

                    // If reached here, mark READY
                    info.put("status", "READY");
                    info.put("idToMove", String.valueOf(idToMove));
                    info.put("idRef", String.valueOf(idRef));
                    perZoneStatus.put(zoneKey, info);
                }
            }

            // 4) If any FAILED in pre-validation -> return aggregated error (no DB modifications beyond locks)
            Map<String, Object> failedDetails = new LinkedHashMap<>();
            for (Map.Entry<String, Map<String, String>> e : perZoneStatus.entrySet()) {
                Map<String, String> info = e.getValue();
                if ("FAILED".equals(info.get("status"))) {
                    Map<String, String> fd = new LinkedHashMap<>();
                    fd.put("reason", info.getOrDefault("reason", "unknown"));
                    fd.put("referenceVinStatus", info.getOrDefault("referenceVinState", "UNKNOWN"));
                    fd.put("vinToMoveStatus", info.getOrDefault("vinToMoveState", "UNKNOWN"));
                    failedDetails.put(e.getKey(), fd);
                }
            }
            if (!failedDetails.isEmpty()) {
                response.put("status", "error");
                response.put("unholdStatus", "reverted");
                response.put("message", "Unhold + Move operation aborted due to validation failure.");
                response.put("details", failedDetails);
                return response;
            }

            // --- PERFORM ACTIONS: Unhold + Move for READY zones ---
            String operator = currentOperatorName();

            // Unhold vinToMove (set is_hold = false) BEFORE reordering, while in transaction and with tables locked
            int updated = entityManager.createNativeQuery(
                            "UPDATE vin_hold_status SET is_hold = false, operatorname = :op, updated_at = timezone('Asia/Kolkata', now()) WHERE vinnumber = :vin")
                    .setParameter("op", operator)
                    .setParameter("vin", vinToMove)
                    .executeUpdate();

            if (updated == 0) {
                // Unexpected concurrent change — abort
                throw new IllegalStateException("Failed to unhold VIN " + vinToMove + ". It may have been changed concurrently.");
            }

            // Now reorder for each READY zone
            Map<String, String> successDetails = new LinkedHashMap<>();
            for (Map.Entry<String, Map<String, String>> e : perZoneStatus.entrySet()) {
                String zoneKey = e.getKey();
                Map<String, String> info = e.getValue();
                if (!"READY".equals(info.get("status"))) {
                    // SKIPPED entries: include reason in response as informational
                    if ("SKIPPED".equals(info.get("status"))) {
                        successDetails.put(zoneKey, "SKIPPED: " + info.get("reason"));
                    }
                    continue;
                }

                // parse line & zone number
                String[] parts = zoneKey.split("-", 2);
                String line = parts[0];
                int zoneNumber = zoneKey.endsWith("Zone2") ? 2 : 1;
                String table = KITTING_TABLES.get(line);

                // perform reorder using safe offset approach
                boolean moved = reorderWithOffset(table, vinToMove, referenceVin, zoneNumber);
                if (!moved) {
                    throw new IllegalStateException("Failed to reorder " + zoneKey + " during move.");
                }
                successDetails.put(zoneKey, "SUCCESS: VIN " + vinToMove + " unheld and moved after " + referenceVin);
            }

            // If reached here, all operations succeeded
            response.put("status", "success");
            response.put("unholdStatus", "success");
            response.put("message", "VIN successfully unheld and moved after reference VIN.");
            response.put("details", successDetails);
            return response;

        } catch (Exception ex) {
            log.error("Error in unholdAndMove operation — transaction will be rolled back", ex);
            // Transactional rollback will happen automatically because of exception
            Map<String, Object> err = new LinkedHashMap<>();
            err.put("reason", ex.getMessage());
            response.put("status", "error");
            response.put("unholdStatus", "reverted");
            response.put("message", "Unhold + Move operation rolled back due to move failure.");
            response.put("details", err);
            return response;
        }
    }

    // ----------------- Helper methods -----------------

    private String safeTrim(Object obj) {
        if (obj == null) return "";
        return obj.toString().trim();
    }

    private Set<String> parseZones(String zonesRaw) {
        if (zonesRaw == null) return Set.of("Zone1");
        String s = zonesRaw.trim().toLowerCase();
        if (s.equals("both")) return Set.of("Zone1", "Zone2");
        if (s.equals("zone2")) return Set.of("Zone2");
        return Set.of("Zone1");
    }

    /**
     * Locks a set of tables in exclusive mode.
     * This helps avoid concurrent reads/writes (alot-dsn) getting inconsistent id/idz2 ordering.
     */
    private void lockTables(Set<String> tables) {
        if (tables == null || tables.isEmpty()) return;
        StringBuilder sb = new StringBuilder();
        sb.append("LOCK TABLE ");
        int i = 0;
        for (String t : tables) {
            if (i++ > 0) sb.append(", ");
            sb.append(t);
        }
        sb.append(" IN EXCLUSIVE MODE");
        entityManager.createNativeQuery(sb.toString()).executeUpdate();
        log.info("🔒 Locked tables for unhold+move: {}", tables);
    }

    private boolean isVinPresentInHoldTable(String vin) {
        try {
            String sql = "SELECT 1 FROM vin_hold_status WHERE vinnumber = :vin LIMIT 1";
            Query q = entityManager.createNativeQuery(sql).setParameter("vin", vin);
            return !q.getResultList().isEmpty();
        } catch (Exception ex) {
            log.warn("vin_hold_status table missing or inaccessible: {}", ex.getMessage());
            return false;
        }
    }

    private boolean isVinCurrentlyOnHold(String vin) {
        try {
            String sql = "SELECT is_hold FROM vin_hold_status WHERE vinnumber = :vin LIMIT 1";
            Query q = entityManager.createNativeQuery(sql).setParameter("vin", vin);
            List<?> list = q.getResultList();
            if (list.isEmpty()) return false;
            Object value = list.get(0);
            if (value instanceof Boolean) return (Boolean) value;
            if (value instanceof Number) return ((Number) value).intValue() != 0;
            return "t".equalsIgnoreCase(String.valueOf(value));
        } catch (Exception ex) {
            log.warn("Could not read vin_hold_status for {}: {}", vin, ex.getMessage());
            return false;
        }
    }

    private boolean vinExistsInTable(String table, String vin) {
        try {
            String sql = "SELECT 1 FROM " + table + " WHERE vinnumber = :vin LIMIT 1";
            Query q = entityManager.createNativeQuery(sql).setParameter("vin", vin);
            return !q.getResultList().isEmpty();
        } catch (Exception ex) {
            log.warn("Error checking vin existence in {}: {}", table, ex.getMessage());
            return false;
        }
    }

    /**
     * Returns one of:
     * - "Completed before move"   (processed=true)
     * - "Kitting in-progress during move" (reserved=true && processed=false)
     * - "CAN_MOVE" (reserved=false && processed=false)
     * - "VIN not found"
     */
    private String getKittingState(String table, String vin, int zoneNumber) {
        String resCol = "isreservedzone" + zoneNumber;
        String procCol = "isprocessedzone" + zoneNumber;
        try {
            String sql = String.format("SELECT %s, %s FROM %s WHERE vinnumber = :vin LIMIT 1", resCol, procCol, table);
            Query q = entityManager.createNativeQuery(sql).setParameter("vin", vin);
            List<Object[]> rows = q.getResultList();
            if (rows.isEmpty()) return "VIN not found";
            Object[] r = rows.get(0);
            boolean reserved = r[0] != null && Boolean.TRUE.equals(r[0]);
            boolean processed = r[1] != null && Boolean.TRUE.equals(r[1]);

            if (processed && !reserved) return "Completed before move";
            if (processed && reserved) return "Completed before move";
            if (reserved && !processed) return "Kitting in-progress during move";
            if (!reserved && !processed) return "CAN_MOVE";
            return "Unknown";
        } catch (Exception ex) {
            log.warn("Error reading kitting state from {} for vin {}: {}", table, vin, ex.getMessage());
            return "VIN not found";
        }
    }

    private Long getIdForVin(String table, String vin, int zoneNumber) {
        String idCol = (zoneNumber == 2) ? "idz2" : "id";
        try {
            String sql = String.format("SELECT %s FROM %s WHERE vinnumber = :vin LIMIT 1", idCol, table);
            Object res = entityManager.createNativeQuery(sql).setParameter("vin", vin).getSingleResult();
            if (res == null) return null;
            return ((Number) res).longValue();
        } catch (Exception ex) {
            log.warn("Could not fetch id for vin {} in table {}: {}", vin, table, ex.getMessage());
            return null;
        }
    }

    /**
     * Reorder safely with TEMP_OFFSET to avoid PK collisions.
     * Steps:
     *  1) Read ordered list by id/idz2
     *  2) Recalculate desired order (move vinToMove after referenceVin)
     *  3) Shift all current ids by +TEMP_OFFSET (atomic update)
     *  4) Update rows one-by-one to assign compact 1..N ids per new order
     */
    private boolean reorderWithOffset(String table, String vinToMove, String referenceVin, int zoneNumber) {
        String idCol = (zoneNumber == 2) ? "idz2" : "id";
        try {
            // 1) get ordered list
            String fetchSql = String.format("SELECT vinnumber FROM %s ORDER BY %s ASC", table, idCol);
            @SuppressWarnings("unchecked")
            List<Object> rows = entityManager.createNativeQuery(fetchSql).getResultList();
            List<String> vins = new ArrayList<>();
            for (Object o : rows) {
                if (o != null) vins.add(o.toString());
            }

            if (!vins.contains(vinToMove) || !vins.contains(referenceVin)) {
                log.warn("Either vinToMove or referenceVin not present in table {} zone {}", table, zoneNumber);
                return false;
            }

            // compute new ordering
            vins.remove(vinToMove);
            int refIndex = vins.indexOf(referenceVin);
            if (refIndex == -1) return false;
            vins.add(refIndex + 1, vinToMove);

            // shift existing ids by TEMP_OFFSET
            String shiftSql = String.format("UPDATE %s SET %s = %s + :offset WHERE %s IS NOT NULL", table, idCol, idCol, idCol);
            entityManager.createNativeQuery(shiftSql).setParameter("offset", TEMP_OFFSET).executeUpdate();

            // assign new ids sequentially starting at 1
            long newId = 1L;
            for (String v : vins) {
                String updateSql = String.format("UPDATE %s SET %s = :newId WHERE vinnumber = :vin", table, idCol);
                entityManager.createNativeQuery(updateSql)
                        .setParameter("newId", newId++)
                        .setParameter("vin", v)
                        .executeUpdate();
            }

            // Optional: if sequences exist for id/idz2, caller may want to setval outside of this method.
            log.info("Reordered table={} zone={} successfully (moved {} after {})", table, zoneNumber, vinToMove, referenceVin);
            return true;
        } catch (Exception ex) {
            log.error("Error while reordering {} zone {} : {}", table, zoneNumber, ex.getMessage(), ex);
            return false;
        }
    }

    private String currentOperatorName() {
        try {
            return SecurityContextHolder.getContext().getAuthentication().getName();
        } catch (Exception ex) {
            return "UnknownOperator";
        }
    }

