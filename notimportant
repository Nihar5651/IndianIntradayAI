  // ---------------- Original Actions (Hold, Move, Force Kit) ----------------
  onHoldVin(): void {
    const selectedRows = this.getSelectedRows();
    if (selectedRows.length === 0) {
      this.toastr.warning('Please select at least one VIN to perform Hold VIN.', 'Warning');
      return;
    }
    const vins = selectedRows.map(row => row.vin);
    const invalidVins = selectedRows.filter(row =>
      ['PICKING','COMPLETED'].includes(row.status?.toUpperCase() || '')
    );
    if (invalidVins.length > 0) {
      const invalidStatuses = [...new Set(invalidVins.map(v => v.status?.toUpperCase()))]
        .filter(status => status)
        .join(' or ');
      this.toastr.error(`Cannot hold VINs with status: ${invalidStatuses}. Only WAITING Vins can be hold.`);
      return;
    }
    const payload = { vins: vins };
    this.isLoading = true;
    this.authService.httpPostRequest(Global.HOLD_VIN_API, payload).subscribe({
      next: (response: any) => {
        this.isLoading = false;
        if (response?.status === 'success') {
          this.toastr.success(response?.message || 'VIN hold toggled successfully!', 'Success', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
          this.refreshAllZones();
          this.selectedVins.clear(); 
        } else {
          const message = response?.message || 'Hold VIN operation failed. Please try again.';
          this.toastr.error(message, 'Error', {
            timeOut: 3000,
            progressBar: true,
            positionClass: 'toast-bottom-center'
          });
        }
      },
      error: (error) => {
        this.isLoading = false;
        console.error('Hold VIN Error:', error);
        const errorMessage = error?.error?.message || 'Error occurred while performing Hold VIN operation.';
        this.toastr.error(errorMessage, 'Error', {
          timeOut: 3000,
          progressBar: true,
          positionClass: 'toast-bottom-center',
        });
      }
    });
  }
  onMoveVin(): void {
    const selectedRows = this.getSelectedRows();
    const key = `${this.currentLine}_${this.currentZone}`;
    const dataSource = this.dataSources[key];
    const currentData = dataSource?.data || [];
    const validSelectedRows = selectedRows.filter(row =>
      currentData.some(item => item.vin === row.vin)
    );
    if (validSelectedRows.length === 0) {
      this.toastr.warning('Please select one VIN to perform Move VIN.', 'Warning');
      return;
    }
    if (validSelectedRows.length > 1) {
      this.toastr.warning('You can only move one VIN at a time.', 'Warning');
      return;
    }
    const selectedRow = validSelectedRows[0];
    const selectedVIN = selectedRow.vin;
    if (['PICKING', 'IN-PROGRESS', 'COMPLETED'].includes(selectedRow.status?.toUpperCase() || '')) {
      this.toastr.error(
        'This VIN is not applicable as the status is In-Progress or Completed.',
        'Invalid VIN'
      );
      return;
    }
    const dialogRef = this.dialog.open(MoveVinDialogComponent, {
      width: '450px',
      data: { vins: [selectedVIN] }
