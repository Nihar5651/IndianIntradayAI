/**
 * SSE listener for P2L/ESL acknowledgements.
 *
 * - Trust-all SSE client (matches other external publishers).
 * - Distinguishes TAB (trolley) vs P2L by checking ptl_mac_address in trolley mapping tables.
 * - On P2L BLINK_SUCCESS calls QuantityUpdateService.handleBlinkSuccess(mac).
 * - On P2L PICKING_STATUS calls PickToLightPickService.handlePicking(mac).
 * - Reconnects quickly after any connection failure. Default reconnect delay is 10 ms.
 * - Handles multi-line 'data:' accumulation and robust JSON logging.
 */
@Component
public class PickToLightSseListener implements Runnable {

    private static final Logger log = LoggerFactory.getLogger(PickToLightSseListener.class);

    private final ObjectMapper mapper = new ObjectMapper();
    private final SseEventWriter sseEventWriter;
    private final QuantityUpdateService quantityUpdateService;
    private final PickToLightPickService pickToLightPickService;
    private final EntityManager entityManager;

    @Value("${p2l.sse.url:https://172.25.86.106:9002/link/core/sse/100}")
    private String sseUrl;

    @Value("${p2l.sse.read-timeout-ms:300000}")
    private int readTimeoutMs;

    @Value("${p2l.sse.reconnect-delay-ms:10}")
    private int reconnectDelayMillis;

    private volatile RestTemplate restTemplate; // lazy init
    private Thread runner;
    private volatile boolean started = false;

    private static final String[] TROLLEY_MAP_TABLES = new String[]{
            "trim1_trolly_mac_mapping",
            "trim2_trolly_mac_mapping",
            "door_trolly_mac_mapping",
            "cradle_trolly_mac_mapping",
            "cockpit_trolly_mac_mapping"
    };

    public PickToLightSseListener(SseEventWriter sseEventWriter,
                                  QuantityUpdateService quantityUpdateService,
                                  PickToLightPickService pickToLightPickService,
                                  EntityManager entityManager) {
        this.sseEventWriter = sseEventWriter;
        this.quantityUpdateService = quantityUpdateService;
        this.pickToLightPickService = pickToLightPickService;
        this.entityManager = entityManager;
    }

    @PostConstruct
    public void start() {
        if (started) return;
        started = true;
        runner = new Thread(this, "p2l-sse-listener");
        runner.setDaemon(true);
        runner.start();
        log.info("PickToLightSseListener started. SSE URL={}, readTimeoutMs={}, reconnectDelayMs={}",
                sseUrl, readTimeoutMs, reconnectDelayMillis);
    }

    @PreDestroy
    public void stop() {
        started = false;
        if (runner != null) runner.interrupt();
    }

    @Override
    public void run() {
        final int reconnectDelay = Math.max(1, reconnectDelayMillis);
        while (started && !Thread.currentThread().isInterrupted()) {
            try {
                getClient().execute(
                        sseUrl,
                        HttpMethod.GET,
                        request -> request.getHeaders().setAccept(MediaType.parseMediaTypes("text/event-stream")),
                        (ClientHttpResponse response) -> {
                            int code = response.getRawStatusCode();
                            log.info("SSE connect → HTTP {}", code);
                            if (code / 100 != 2) {
                                throw new IllegalStateException("Non-2xx from SSE endpoint: " + code);
                            }
                            try (BufferedReader br = new BufferedReader(
                                    new InputStreamReader(response.getBody(), StandardCharsets.UTF_8))) {
                                readStream(br);
                            }
                            return null;
                        }
                );
            } catch (Exception e) {
                if (isCausedBySocketTimeout(e)) {
                    log.info("SSE read timed out/idle ({}). Reconnecting in {} ms.", e.getMessage(), reconnectDelay);
                } else {
                    log.warn("SSE loop exception: {}. Reconnecting in {} ms.", e.getMessage(), reconnectDelay);
                }
                try {
                    Thread.sleep(reconnectDelay);
                } catch (InterruptedException ie) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
        }
        log.info("PickToLightSseListener stopped.");
    }

    /**
     * Robust read loop: accumulate multiple 'data:' lines into one JSON string.
     */
    private void readStream(BufferedReader br) throws IOException {
        String line;
        String lastEventId = null;
        String event = null;
        StringBuilder dataBuf = null;    // accumulate data: lines
        String comments = null;

        try {
            while ((line = br.readLine()) != null) {
                if (line.isEmpty()) {
                    String data = (dataBuf == null) ? null : dataBuf.toString();
                    if (data != null || comments != null || event != null || lastEventId != null) {
                        processEvent(lastEventId, event, data, comments);
                    }
                    lastEventId = null;
                    event = null;
                    dataBuf = null;
                    comments = null;
                    continue;
                }

                log.debug("[SSE RAW] {}", line);

                if (line.startsWith("id:")) {
                    lastEventId = line.substring(3).trim();
                } else if (line.startsWith("event:")) {
                    event = line.substring(6).trim();
                } else if (line.startsWith("data:")) {
                    String payloadPart = line.substring(5);
                    if (dataBuf == null) dataBuf = new StringBuilder(payloadPart);
                    else dataBuf.append('\n').append(payloadPart);
                } else if (line.startsWith(":")) {
                    comments = line.substring(1).trim();
                }
            }
            log.info("SSE input stream closed by server.");
        } catch (SocketTimeoutException ste) {
            throw ste;
        } catch (IOException ioe) {
            throw ioe;
        } catch (Exception ex) {
            log.error("Unexpected error while reading SSE stream: {}", ex.getMessage(), ex);
        }
    }

    private void processEvent(String sseId, String event, String dataJson, String comments) {
        try {
            if (dataJson == null) {
                log.warn("SSE event with no data (id={} event={}) - ignoring.", sseId, event);
                return;
            }

            String trimmed = dataJson.trim();
            JsonNode root;
            try {
                root = mapper.readTree(trimmed);
            } catch (Exception je) {
                log.warn("Failed to parse SSE data JSON. sseId={}, event={}, raw='{}'. Error: {}",
                        sseId, event, safePreview(trimmed), je.getMessage());
                try {
                    sseEventWriter.write(sseId, event, null, null, null, null, null, null, trimmed);
                } catch (Exception ex) {
                    log.warn("Failed to persist raw SSE after JSON parse failure: {}", ex.getMessage(), ex);
                }
                return;
            }

            String stationCode = nodeText(root, "stationCode");
            JsonNode slabel = root.path("slabel");
            String macRaw = nodeText(slabel, "code");
            String mac = normalizeMac(macRaw);
            JsonNode status = slabel.path("pickingStatus");
            String pickingLinkStatus = nodeText(status, "pickingLinkStatus"); // BLINK_SUCCESS / PICKING / etc.
            String ledColor = nodeText(status, "ledColor");
            Long requestPickingDate = nodeLong(status, "requestPickingDate");
            Long pickingDate = nodeLong(status, "pickingDate");

            // Persist event to DB (always)
            try {
                sseEventWriter.write(
                        sseId,
                        event,
                        stationCode,
                        mac,
                        pickingLinkStatus,
                        ledColor,
                        requestPickingDate,
                        pickingDate,
                        trimmed
                );
            } catch (Exception ex) {
                log.warn("Failed to persist SSE event (non-fatal). sseId={}, mac={}, err={}", sseId, mac, ex.getMessage());
            }

            if (mac == null || mac.isBlank()) {
                log.warn("SSE event missing mac address after normalization. sseId={}, event={}", sseId, event);
                return;
            }

            // Distinguish TAB vs P2L by checking trolley mapping tables (ptl_mac_address):
            boolean isTab = isTabMac(mac);

            if (isTab) {
                log.debug("SSE for mac {} treated as TAB ack (ignored for P2L). event={}, pickingStatus={}",
                        mac, event, pickingLinkStatus);
                return;
            }

            // P2L ack handling:
            // P2L ack handling:
            if ("BLINK_STATUS".equalsIgnoreCase(event) && "BLINK_SUCCESS".equalsIgnoreCase(pickingLinkStatus)) {
                try {
                    quantityUpdateService.handleBlinkSuccess(mac);
                } catch (Exception ex) {
                    log.error("QuantityUpdateService.handleBlinkSuccess failed for mac {} : {}", mac, ex.getMessage(), ex);
                }
            } else if ("PICKING_STATUS".equalsIgnoreCase(event)) {
                try {
                    pickToLightPickService.handlePicking(mac);
                } catch (Exception ex) {
                    log.error("PickToLightPickService.handlePicking failed for mac {} : {}", mac, ex.getMessage(), ex);
                }
            }
            // ✅ PHASE 2 CORE FIX: Catch the BLINK_FAIL and trigger the Exponential Backoff
            else if ("BLINK_STATUS".equalsIgnoreCase(event) && "BLINK_FAIL".equalsIgnoreCase(pickingLinkStatus)) {
                try {
                    pickToLightPickService.handleBlinkFail(mac);
                } catch (Exception ex) {
                    log.error("PickToLightPickService.handleBlinkFail failed for mac {} : {}", mac, ex.getMessage(), ex);
                }
            }
            else {
                log.debug("P2L event for mac {}: event={} pickingStatus={}", mac, event, pickingLinkStatus);
            }

        } catch (Exception e) {
            log.error("Error handling SSE event: {}", e.getMessage(), e);
        }
    }

    @Transactional(readOnly = true)
    protected boolean isTabMac(String mac) {
        if (mac == null || mac.isBlank()) return false;
        try {
            for (String table : TROLLEY_MAP_TABLES) {
                String sql = String.format("SELECT 1 FROM %s WHERE ptl_mac_address = :mac LIMIT 1", table);
                Query q = entityManager.createNativeQuery(sql);
                q.setParameter("mac", mac);
                if (!q.getResultList().isEmpty()) return true;
            }
        } catch (Exception ex) {
            log.warn("Failed to check trolley mapping tables for mac {}: {}. Assuming not a TAB mac.", mac, ex.getMessage());
        }
        return false;
    }

    private RestTemplate getClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;
            try {
                SSLContext sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                var sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                SocketConfig socketConfig = SocketConfig.custom()
                        .setSoKeepAlive(true)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .setDefaultSocketConfig(socketConfig)
                        .build();

                RequestConfig.Builder reqBuilder = RequestConfig.custom();
                if (readTimeoutMs > 0) {
                    reqBuilder.setResponseTimeout(org.apache.hc.core5.util.Timeout.ofMilliseconds(readTimeoutMs));
                }
                reqBuilder.setConnectTimeout(org.apache.hc.core5.util.Timeout.ofMilliseconds(10_000));
                reqBuilder.setConnectionRequestTimeout(org.apache.hc.core5.util.Timeout.ofMilliseconds(10_000));
                RequestConfig requestConfig = reqBuilder.build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .setDefaultRequestConfig(requestConfig)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);
                if (readTimeoutMs > 0) {
                    factory.setConnectTimeout(readTimeoutMs);
                    factory.setReadTimeout(readTimeoutMs);
                }

                restTemplate = new RestTemplate(factory);
                log.info("SSE client built (trust-all SSL + no hostname verification). readTimeoutMs={}", readTimeoutMs);
            } catch (Exception e) {
                log.error("Failed to build trust-all SSE client. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private boolean isCausedBySocketTimeout(Throwable e) {
        if (e == null) return false;
        if (e instanceof SocketTimeoutException) return true;
        if (e.getCause() != null) return isCausedBySocketTimeout(e.getCause());
        return false;
    }

    private String nodeText(JsonNode n, String field) {
        JsonNode v = n.path(field);
        return v.isMissingNode() || v.isNull() ? null : v.asText(null);
    }

    private Long nodeLong(JsonNode n, String field) {
        JsonNode v = n.path(field);
        return v.isMissingNode() || v.isNull() ? null : v.asLong();
    }

    private String normalizeMac(String raw) {
        if (raw == null) return null;
        return raw.replaceAll("[^A-Fa-f0-9]", "").toUpperCase();
    }

    private String safePreview(String s) {
        if (s == null) return null;
        return (s.length() <= 400) ? s : (s.substring(0, 400) + "...(truncated)");
    }
}
