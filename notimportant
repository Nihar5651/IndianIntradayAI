        String reserveFlag  = getDynamicZoneFlag("isreservedzone", zoneNumber);
        String processedFlag= getDynamicZoneFlag("isprocessedzone", zoneNumber);
        String opCol        = isZone2 ? "operatornamez2"      : "operatorname";
        String ledCol       = isZone2 ? "assignedledcolorz2"  : "assignedledcolor";
