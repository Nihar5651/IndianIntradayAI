import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.*;

/**
 * KittingMoveVinService
 *
 * Safely moves a VIN after a reference VIN in kitting tables.
 * - Supports ALL or single line targets (T1,T2,DR,CR,CP)
 * - Supports Zone1 / Zone2 / Both (CP/CR only Zone1)
 * - Ensures VINs are not on hold and are eligible (per 4-state logic)
 * - Locks affected tables with "LOCK TABLE ... IN EXCLUSIVE MODE" before reordering
 * - Uses a temporary offset (+100000) to avoid primary-key collisions while reassigning IDs
 */
@Service
public class KittingMoveVinService {

    private static final Logger log = LoggerFactory.getLogger(KittingMoveVinService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");
    private static final Set<String> SINGLE_ZONE_LINES = Set.of("CR", "CP");

    private static final long TEMP_OFFSET = 100000L; // large offset to avoid collisions

    /**
     * payload keys:
     * - vinToMove (String)
     * - referenceVin (String)
     * - targetTable ("ALL" or one of T1,T2,DR,CR,CP)
     * - zones ("Zone1", "Zone2", "Both")
     *
     * Returns a map:
     * {
     *   status: "success" | "error",
     *   message: "...",
     *   details: { "T1-Zone1": "SUCCESS: ...", "DR-Zone2": "FAILED: reason", ... }
     * }
     */
    @Transactional
    public Map<String, Object> moveVin(Map<String, Object> payload) {
        String vinToMove = Objects.toString(payload.get("vinToMove"), "").trim();
        String referenceVin = Objects.toString(payload.get("referenceVin"), "").trim();
        String targetTable = Objects.toString(payload.get("targetTable"), "ALL").trim().toUpperCase();
        String zonesRaw = Objects.toString(payload.get("zones"), "Zone1").trim();

        Map<String, Object> response = new LinkedHashMap<>();
        Map<String, String> details = new LinkedHashMap<>();

        if (vinToMove.isEmpty() || referenceVin.isEmpty()) {
            response.put("status", "error");
            response.put("message", "vinToMove and referenceVin are required.");
            return response;
        }

        // determine target lines
        List<String> linesToProcess = new ArrayList<>();
        if ("ALL".equalsIgnoreCase(targetTable)) {
            linesToProcess.addAll(KITTING_TABLES.keySet());
        } else {
            if (!KITTING_TABLES.containsKey(targetTable)) {
                response.put("status", "error");
                response.put("message", "Invalid targetTable. Allowed: ALL, T1, T2, DR, CR, CP");
                return response;
            }
            linesToProcess.add(targetTable);
        }

        // zones parsing
        Set<String> zonesToProcess = parseZones(zonesRaw);

        // Before modifying, lock all involved tables to prevent concurrent readers/writers.
        // Determine unique tables that will be touched (respect CP/CR single-zone behavior)
        Set<String> tablesToLock = new LinkedHashSet<>();
        for (String line : linesToProcess) {
            if (!KITTING_TABLES.containsKey(line)) continue;
            tablesToLock.add(KITTING_TABLES.get(line));
        }

        // Lock all tables in one go
        if (!tablesToLock.isEmpty()) {
            lockTables(tablesToLock);
        }

        // Process each line independently (each uses a cloned zone set to avoid mutation)
        for (String line : linesToProcess) {
            String table = KITTING_TABLES.get(line);
            if (table == null) continue;

            Set<String> zonesForThisLine = new LinkedHashSet<>(zonesToProcess);
            if (SINGLE_ZONE_LINES.contains(line)) {
                zonesForThisLine = Set.of("Zone1"); // force Zone1 only for CP/CR
            }

            for (String zone : zonesForThisLine) {
                String key = line + "-" + zone;
                int zoneNumber = zone.equalsIgnoreCase("Zone2") ? 2 : 1;

                try {
                    if (SINGLE_ZONE_LINES.contains(line) && zoneNumber == 2) {
                        details.put(key, "SKIPPED: " + line + " supports only Zone1");
                        continue;
                    }

                    // existence checks
                    if (!vinExistsInTable(table, vinToMove)) {
                        details.put(key, "FAILED: vinToMove not found in " + line);
                        continue;
                    }
                    if (!vinExistsInTable(table, referenceVin)) {
                        details.put(key, "FAILED: referenceVin not found in " + line);
                        continue;
                    }

                    // hold checks
                    if (isVinOnHold(vinToMove)) {
                        details.put(key, "FAILED: vinToMove is currently on hold");
                        continue;
                    }
                    if (isVinOnHold(referenceVin)) {
                        details.put(key, "FAILED: referenceVin is currently on hold");
                        continue;
                    }

                    // eligibility (4-state)
                    String stMove = getKittingState(table, vinToMove, zoneNumber);
                    String stRef = getKittingState(table, referenceVin, zoneNumber);

                    if (!"CAN_MOVE".equals(stMove)) {
                        details.put(key, "FAILED: vinToMove not eligible -> " + stMove);
                        continue;
                    }
                    if (!"CAN_MOVE".equals(stRef)) {
                        details.put(key, "FAILED: referenceVin not eligible -> " + stRef);
                        continue;
                    }

                    // perform reorder safely
                    boolean success = reorderWithOffset(table, vinToMove, referenceVin, zoneNumber);
                    if (success) {
                        details.put(key, "SUCCESS: moved after " + referenceVin);
                    } else {
                        details.put(key, "FAILED: reorder operation returned false");
                    }

                } catch (Exception ex) {
                    log.error("Error in move for {} -> {}", key, ex.getMessage(), ex);
                    details.put(key, "FAILED: " + (ex.getMessage() == null ? ex.toString() : ex.getMessage()));
                }
            }
        }

        response.put("status", "success");
        response.put("message", "Move attempt completed. See details per line-zone.");
        response.put("details", details);
        return response;
    }

    // ---------------- Helper & DB methods ----------------

    private Set<String> parseZones(String zonesRaw) {
        if (zonesRaw == null) return Set.of("Zone1");
        String s = zonesRaw.trim().toLowerCase();
        if (s.equals("both")) return Set.of("Zone1", "Zone2");
        if (s.equals("zone2")) return Set.of("Zone2");
        return Set.of("Zone1");
    }

    /**
     * Lock provided tables together with an exclusive lock to block readers/writers.
     * Uses single LOCK TABLE ... IN EXCLUSIVE MODE statement listing all tables.
     */
    private void lockTables(Set<String> tables) {
        if (tables.isEmpty()) return;
        StringBuilder sb = new StringBuilder();
        sb.append("LOCK TABLE ");
        int i = 0;
        for (String t : tables) {
            if (i++ > 0) sb.append(", ");
            sb.append(t);
        }
        sb.append(" IN EXCLUSIVE MODE");
        String sql = sb.toString();
        log.info("🔒 Locking tables for move operation: {}", tables);
        entityManager.createNativeQuery(sql).executeUpdate();
        // lock held until transaction ends/commits
    }

    private boolean vinExistsInTable(String table, String vin) {
        String sql = "SELECT 1 FROM " + table + " WHERE vinnumber = :vin LIMIT 1";
        Query q = entityManager.createNativeQuery(sql);
        q.setParameter("vin", vin);
        return !q.getResultList().isEmpty();
    }

    private boolean isVinOnHold(String vin) {
        try {
            String sql = "SELECT 1 FROM vin_hold_status WHERE vinnumber = :vin AND is_hold = true LIMIT 1";
            Query q = entityManager.createNativeQuery(sql);
            q.setParameter("vin", vin);
            return !q.getResultList().isEmpty();
        } catch (Exception ex) {
            log.warn("Could not check vin_hold_status for {}: {}", vin, ex.getMessage());
            return false;
        }
    }

    /**
     * Returns one of:
     * - "Completed before move"  (isprocessed=true)
     * - "Kitting in-progress during move" (isreserved=true && isprocessed=false)
     * - "CAN_MOVE" (isreserved=false && isprocessed=false)
     * - "VIN not found" or "Unknown"
     */
    private String getKittingState(String table, String vin, int zoneNumber) {
        String resCol = "isreservedzone" + zoneNumber;
        String procCol = "isprocessedzone" + zoneNumber;

        // Some single-zone tables may not actually have zone2 columns; caller ensures zone2 isn't used for CP/CR.
        String sql = String.format("SELECT %s, %s FROM %s WHERE vinnumber = :vin", resCol, procCol, table);
        Query q = entityManager.createNativeQuery(sql);
        q.setParameter("vin", vin);
        @SuppressWarnings("unchecked")
        List<Object[]> list = q.getResultList();
        if (list.isEmpty()) return "VIN not found";
        Object[] row = list.get(0);
        boolean reserved = row[0] != null && Boolean.TRUE.equals(row[0]);
        boolean processed = row[1] != null && Boolean.TRUE.equals(row[1]);

        if (processed && !reserved) return "Completed before move";
        if (processed && reserved) return "Completed before move";
        if (reserved && !processed) return "Kitting in-progress during move";
        if (!reserved && !processed) return "CAN_MOVE";
        return "Unknown";
    }

    /**
     * Safe reorder:
     * 1) fetch ordered vinnumbers by id/idz2
     * 2) reorder in-memory (remove vinToMove, insert after referenceVin)
     * 3) add TEMP_OFFSET to the id column for all rows (prevents PK collisions)
     * 4) assign new sequential ids (1..N) using the ordered list
     */
    private boolean reorderWithOffset(String table, String vinToMove, String referenceVin, int zoneNumber) {
        String idCol = (zoneNumber == 2) ? "idz2" : "id";

        // 1) fetch vinnumbers ordered by id/idz2
        String fetchSql = String.format("SELECT vinnumber, %s FROM %s ORDER BY %s ASC", idCol, table, idCol);
        @SuppressWarnings("unchecked")
        List<Object[]> rows = entityManager.createNativeQuery(fetchSql).getResultList();
        if (rows.isEmpty()) return false;

        List<String> vins = new ArrayList<>();
        for (Object[] r : rows) {
            String v = (r[0] == null) ? null : r[0].toString();
            if (v != null) vins.add(v);
        }

        if (!vins.contains(vinToMove) || !vins.contains(referenceVin)) return false;

        // 2) reorder
        vins.remove(vinToMove);
        int refIndex = vins.indexOf(referenceVin);
        if (refIndex == -1) return false;
        vins.add(refIndex + 1, vinToMove);

        // 3) temp shift all ids by big offset to avoid PK collisions
        String tempShiftSql = String.format("UPDATE %s SET %s = %s + :offset WHERE %s IS NOT NULL", table, idCol, idCol, idCol);
        entityManager.createNativeQuery(tempShiftSql)
                .setParameter("offset", TEMP_OFFSET)
                .executeUpdate();

        // 4) assign new sequential IDs (1..N)
        long seq = 1L;
        for (String v : vins) {
            String updateSql = String.format("UPDATE %s SET %s = :newId WHERE vinnumber = :vin", table, idCol);
            entityManager.createNativeQuery(updateSql)
                    .setParameter("newId", seq++)
                    .setParameter("vin", v)
                    .executeUpdate();
        }

        log.info("Reordered table={} zone={} successfully (total {}).", table, zoneNumber, vins.size());
        return true;
    }
}
package com.kitting.service;

import com.kitting.entity.LineAllowedHierarchy;
import com.kitting.repositories.LineAllowedHierarchyRepository;
import org.springframework.stereotype.Service;

import java.util.*;
import java.util.stream.Collectors;

@Service
public class LineHierarchyService {

    private final LineAllowedHierarchyRepository repo;

    public LineHierarchyService(LineAllowedHierarchyRepository repo) {
        this.repo = repo;
    }

    public Map<String, Object> getHierarchyTree(String lineDenotion, String zone, String rack, String rowNo) {
        List<LineAllowedHierarchy> data = repo.findAll();

        // ✅ Apply filters if params present
        if (lineDenotion != null && !lineDenotion.isBlank()) {
            data = data.stream()
                    .filter(d -> d.getLineDenotion() != null &&
                            d.getLineDenotion().equalsIgnoreCase(lineDenotion))
                    .collect(Collectors.toList());
        }
        if (zone != null && !zone.isBlank()) {
            data = data.stream()
                    .filter(d -> d.getZone() != null &&
                            d.getZone().equalsIgnoreCase(zone))
                    .collect(Collectors.toList());
        }
        if (rack != null && !rack.isBlank()) {
            data = data.stream()
                    .filter(d -> d.getRack() != null &&
                            d.getRack().equalsIgnoreCase(rack))
                    .collect(Collectors.toList());
        }
        if (rowNo != null && !rowNo.isBlank()) {
            data = data.stream()
                    .filter(d -> d.getRowNo() != null &&
                            d.getRowNo().equalsIgnoreCase(rowNo))
                    .collect(Collectors.toList());
        }

        // ✅ Group into hierarchy tree
        Map<String, List<LineAllowedHierarchy>> byLine = data.stream()
                .collect(Collectors.groupingBy(l -> safeUpper(l.getLineDenotion())));

        List<Map<String, Object>> lines = new ArrayList<>();
        for (String lineDen : byLine.keySet().stream().sorted().collect(Collectors.toList())) {
            Map<String, Object> lineMap = new LinkedHashMap<>(); // preserve order

            // ✅ Add lineName first, then lineDenotion
            String lineName = byLine.get(lineDen).stream()
                    .map(LineAllowedHierarchy::getLine)
                    .filter(Objects::nonNull)
                    .findFirst()
                    .orElse("");
            lineMap.put("lineName", lineName);
            lineMap.put("lineDenotion", lineDen);

            Map<String, List<LineAllowedHierarchy>> byZone =
                    byLine.get(lineDen).stream().collect(Collectors.groupingBy(l -> safeUpper(l.getZone())));

            List<Map<String, Object>> zones = new ArrayList<>();
            for (String z : byZone.keySet().stream().sorted().collect(Collectors.toList())) {
                Map<String, Object> zoneMap = new LinkedHashMap<>();
                zoneMap.put("zone", z);

                Map<String, List<LineAllowedHierarchy>> byRack =
                        byZone.get(z).stream().collect(Collectors.groupingBy(l -> safeUpper(l.getRack())));

                List<Map<String, Object>> racks = new ArrayList<>();
                for (String r : byRack.keySet().stream().sorted().collect(Collectors.toList())) {
                    Map<String, Object> rackMap = new LinkedHashMap<>();
                    rackMap.put("rack", r);

                    Map<String, List<LineAllowedHierarchy>> byRow =
                            byRack.get(r).stream().collect(Collectors.groupingBy(l -> safeUpper(l.getRowNo())));

                    List<Map<String, Object>> rows = new ArrayList<>();
                    for (String row : byRow.keySet().stream().sorted().collect(Collectors.toList())) {
                        Map<String, Object> rowMap = new LinkedHashMap<>();
                        rowMap.put("row", row);

                        List<String> columns = byRow.get(row).stream()
                                .map(LineAllowedHierarchy::getColumnNo)
                                .filter(Objects::nonNull)
                                .map(String::toUpperCase)
                                .distinct()
                                .sorted()
                                .collect(Collectors.toList());

                        rowMap.put("columns", columns);
                        rowMap.put("columnCount", columns.size());
                        rows.add(rowMap);
                    }

                    rackMap.put("rows", rows);
                    rackMap.put("rowCount", rows.size());
                    racks.add(rackMap);
                }

                zoneMap.put("racks", racks);
                zoneMap.put("rackCount", racks.size());
                zones.add(zoneMap);
            }

            lineMap.put("zones", zones);
            lineMap.put("zoneCount", zones.size());
            lines.add(lineMap);
        }

        Map<String, Object> result = new LinkedHashMap<>();
        result.put("lines", lines);
        return result;
    }

    private String safeUpper(String val) {
        return val == null ? "" : val.trim().toUpperCase();
    }
}
package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query; // Added for the Admin updates
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.sql.Timestamp;
import java.time.Duration;
import java.time.Instant;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;

/**
 * Updated Line Kitting Status Service
 * ✅ Supports explicit zone input
 * ✅ Converts timestamps (reservedat / reservedatz2) to IST
 * ✅ Perfected Sorting Logic (200, 199, 1, 2... 198) with ID Tie-Breakers
 * ✅ Calculates Total Kitting Time
 * ✅ NULLS LAST fix applied to prevent old blank records from surfacing
 * ✅ Admin overrides for Edit VIN/VC and Reverse Force Kitting
 */
@Service
public class LineKittingStatusService {
    private static final Logger log = LoggerFactory.getLogger(LineKittingStatusService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");
    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");
    private static final DateTimeFormatter FORMATTER =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").withZone(IST_ZONE);

    @Transactional(readOnly = true)
    public Map<String, Object> getLineKittingStatus(String line, String zone) {
        Map<String, Object> response = new LinkedHashMap<>();
        // Validate line
        if (!KITTING_TABLES.containsKey(line)) {
            response.put("status", "error");
            response.put("message", "Invalid line. Allowed: T1, T2, DR, CR, CP");
            return response;
        }

        boolean isTwoZone = TWO_ZONE_LINES.contains(line);
        String table = KITTING_TABLES.get(line);

        // Zone validation
        int zoneNumber = resolveZoneNumber(line, zone, isTwoZone, response);
        if (zoneNumber == -1) return response;

        log.info("📊 Fetching Line={} | Zone={} | Table={}", line, zone, table);

        try {
            // 1. Fetch exactly 200 Completed vehicles (DB returns: 200, 199, 198... 1)
            List<Map<String, Object>> completed = fetchVehicles(table, zoneNumber, "completed", isTwoZone);

            // 🔥 THE PERFECTED SORTING LOGIC FOR THE FRONTEND 🔥
            if (completed.size() > 2) {
                // Get the absolute newest 2: [200, 199] (Do NOT reverse these)
                List<Map<String, Object>> top2 = new ArrayList<>(completed.subList(0, 2));

                // Get the remaining: [198, 197... 1]
                List<Map<String, Object>> remaining = new ArrayList<>(completed.subList(2, completed.size()));

                // Reverse the remaining to make them ascending: [1, 2, 3... 198]
                Collections.reverse(remaining);

                // Stitch them back together: [200, 199, 1, 2... 198]
                top2.addAll(remaining);
                completed = top2;
            }

            // --------------------------------------------------
            // 2. Fetch up to 150 In-Progress (Active) vehicles (FIFO order)
            List<Map<String, Object>> inProgress = fetchVehicles(table, zoneNumber, "inprogress", isTwoZone);

            // 3. Fetch up to 150 Upcoming (Waiting) vehicles (FIFO order)
            List<Map<String, Object>> upcoming = fetchVehicles(table, zoneNumber, "upcoming", isTwoZone);

            response.put("status", "success");
            response.put("message", "Line kitting status fetched successfully.");
            response.put("line", line);
            response.put("zone", "Z" + zoneNumber);

            // Return the clean, simplified payload to Angular
            response.put("completed", completed);
            response.put("inProgress", inProgress);
            response.put("upcoming", upcoming);

            // Counts
            response.put("completedCount", completed.size());
            response.put("inProgressCount", inProgress.size());
            response.put("upcomingCount", upcoming.size());

        } catch (Exception e) {
            log.error("❌ Error fetching line status for {} {}", line, zone, e);
            response.put("status", "error");
            response.put("message", e.getMessage());
        }
        return response;
    }

    /**
     * Fetch vehicles based on zone, type, and 1-zone vs 2-zone database rules.
     */
    private List<Map<String, Object>> fetchVehicles(String table, int zone, String type, boolean isTwoZone) {
        boolean isZone2 = (zone == 2);

        // Select appropriate base columns
        String operatorCol = isZone2 ? "operatornamez2" : "operatorname";
        String trolleyCol = isZone2 ? "trolleycodez2" : "trolleycode";
        String ledCol = isZone2 ? "assignedledcolorz2" : "assignedledcolor";
        String startTimeCol = isZone2 ? "reservedatz2" : "reservedat";

        // -------------------------------------------------------------
        // DYNAMIC LOGIC: Handle 1-Zone vs 2-Zone column names perfectly
        // -------------------------------------------------------------
        String completedTimeCol;
        String processedFlag;
        String reservedFlag = isZone2 ? "isreservedzone2" : "isreservedzone1";
        String idCol = isZone2 ? "idz2" : "id";

        if (!isTwoZone) {
            // Single-zone lines (CR, CP) use the general columns
            completedTimeCol = "kitting_completed_at";
            processedFlag = "isprocessed";
        } else {
            // Two-zone lines (T1, T2, DR) use strict zone-specific columns
            completedTimeCol = isZone2 ? "kitting_completed_at_z2" : "kitting_completed_at_z1";
            processedFlag = isZone2 ? "isprocessedzone2" : "isprocessedzone1";
        }

        // 🔥 FIX: Added NULLS LAST and lastmodifiedtime DESC to prevent old blank records from floating to the top
        // 🔥 FIX: Added LIMIT 200 for completed vehicles
        String sqlCondition = switch (type) {
            case "completed" ->
                    String.format("WHERE %s = true ORDER BY %s DESC NULLS LAST, lastmodifiedtime DESC, %s DESC LIMIT 200", processedFlag, completedTimeCol, idCol);
            case "inprogress" ->
                    String.format("WHERE %s = true AND %s = false ORDER BY %s ASC NULLS LAST, %s ASC LIMIT 150", reservedFlag, processedFlag, startTimeCol, idCol);
            case "upcoming" ->
                    String.format("WHERE %s = false AND %s = false ORDER BY %s ASC LIMIT 150", processedFlag, reservedFlag, idCol);
            default -> "";
        };

        // If completed, select BOTH start and completion time. Otherwise, select the reserved time.
        String sql = String.format("""
                SELECT k.vinnumber, k.vcnumber, k.dsn,
                       k.%s AS operator, k.%s AS trolley,
                       k.%s AS ledcolor, k.%s AS starttime, k.%s AS endtime,
                       v.model, v.variant
                FROM %s k
                LEFT JOIN vc_details v ON TRIM(k.vcnumber)=TRIM(v.vc)
                %s
                """, operatorCol, trolleyCol, ledCol, startTimeCol, completedTimeCol, table, sqlCondition);

        List<Object[]> rows = entityManager.createNativeQuery(sql).getResultList();
        List<Map<String, Object>> list = new ArrayList<>();

        for (Object[] r : rows) {
            Map<String, Object> m = new LinkedHashMap<>();
            m.put("vin", r[0]);
            m.put("vc", r[1]);
            m.put("dsn", r[2]);
            m.put("operator", r[3]);
            m.put("trolleyCode", r[4]);
            m.put("ledColor", r[5]);

            Object rawStartTime = r[6];
            Object rawEndTime = r[7];

            m.put("kittingStartTime", convertToIST(rawStartTime));

            if (type.equals("completed")) {
                m.put("kittingCompletedTime", convertToIST(rawEndTime));
                // 🔥 Calculate Total Kitting Time
                m.put("totalKittingTime", calculateDuration(rawStartTime, rawEndTime));
            }

            m.put("model", r[8]);
            m.put("variant", r[9]);
            list.add(m);
        }
        return list;
    }

    private int resolveZoneNumber(String line, String zone, boolean isTwoZone, Map<String, Object> response) {
        if (!isTwoZone) {
            if (!zone.equalsIgnoreCase("Z1")) {
                log.warn("⚠️ Line {} supports only Z1. Defaulting to Z1.", line);
            }
            return 1;
        } else {
            if (zone.equalsIgnoreCase("Z1")) return 1;
            if (zone.equalsIgnoreCase("Z2")) return 2;
            response.put("status", "error");
            response.put("message", "Invalid zone for line " + line + ". Allowed: Z1 or Z2.");
            return -1;
        }
    }

    // Helper to calculate time difference
    private String calculateDuration(Object startObj, Object endObj) {
        if (startObj == null || endObj == null) return "N/A";
        try {
            Instant start = extractInstant(startObj);
            Instant end = extractInstant(endObj);
            if (start == null || end == null) return "N/A";
            long seconds = Duration.between(start, end).getSeconds();
            if (seconds < 0) return "0s"; // Failsafe for weird data
            long minutes = seconds / 60;
            long remainder = seconds % 60;
            if (minutes > 0) {
                return minutes + "m " + remainder + "s";
            } else {
                return remainder + "s";
            }
        } catch (Exception e) {
            return "N/A";
        }
    }

    private Instant extractInstant(Object timestampObj) {
        if (timestampObj == null) return null;
        if (timestampObj instanceof Timestamp) {
            return ((Timestamp) timestampObj).toInstant();
        } else if (timestampObj instanceof java.util.Date) {
            return ((java.util.Date) timestampObj).toInstant();
        } else if (timestampObj instanceof Instant) {
            return (Instant) timestampObj;
        } else if (timestampObj instanceof LocalDateTime) {
            return ((LocalDateTime) timestampObj).atZone(ZoneId.systemDefault()).toInstant();
        } else if (timestampObj instanceof String) {
            String timeStr = (String) timestampObj;
            if (timeStr.endsWith("Z")) {
                return Instant.parse(timeStr);
            } else {
                return Timestamp.valueOf(timeStr).toInstant();
            }
        }
        return null;
    }

    private String convertToIST(Object timestampObj) {
        if (timestampObj == null) return null;
        try {
            Instant utcInstant = extractInstant(timestampObj);
            if (utcInstant != null) {
                return FORMATTER.format(utcInstant.atZone(IST_ZONE));
            } else {
                return timestampObj.toString(); // Fallback
            }
        } catch (Exception e) {
            log.warn("⚠️ Failed to parse timestamp format: {}", timestampObj);
            return timestampObj.toString(); // Fallback
        }
    }

