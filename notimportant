    @Transactional
    public void handleBlinkSuccess(String macAddress) {
        if (macAddress == null || macAddress.trim().isEmpty()) {
            log.warn("handleBlinkSuccess called with empty macAddress - ignoring.");
            return;
        }

        try {
            Object[] row = claimWaitingBlink(macAddress);
            if (row == null) {
                log.info("BLINK_SUCCESS for mac {} but no mac_pick_queue row in WAITING_BLINK found. Ignoring.", macAddress);
                return;
            }

            Long id = (row[0] instanceof Number) ? ((Number) row[0]).longValue() : Long.valueOf(String.valueOf(row[0]));
            String articleId = row[2] == null ? null : String.valueOf(row[2]);
            String vc = row[3] == null ? null : String.valueOf(row[3]);
            String itemCode = fetchItemCodeForArticle(articleId);

            Integer qtyInt = fetchQtyFromBom(itemCode);

            if (qtyInt != null && qtyInt > 1) {

                // 🔥 THE FIX: NO MORE EXTERNAL API CALLS TO AIMS 🔥
                // We mark it successful in your local DB so the queue clears.
                // But we DO NOT call AIMS. AIMS will never generate the image!
                log.info("✅ BYPASS: Skipped external QTY update for mac={} article={} to prevent gateway crash.", macAddress, articleId);
                markQuantitySuccess(id);

            } else if (qtyInt != null && qtyInt == 0) {
                // Ghost pick logic remains intact
                log.info("🚀 Ghost Pick Detected! Quantity is 0 for id={}. Auto-completing pick.", id);
                pickToLightPickService.handlePicking(macAddress);
            }

        } catch (Exception ex) {
            log.error("Unhandled error in handleBlinkSuccess for mac {}: {}", macAddress, ex.getMessage(), ex);
        }
    }

    private Object[] claimWaitingBlink(String mac) {
        String sql = ""
                + "WITH candidate AS ( "
                + "  SELECT id FROM mac_pick_queue "
                + "  WHERE mac_address = :mac AND status = 'WAITING_BLINK' "
                + "  ORDER BY created_at ASC "
                + "  FOR UPDATE SKIP LOCKED LIMIT 1 "
                + ") "
                + "UPDATE mac_pick_queue m "
                + "SET last_attempt_at = now(), "
                + "    attempts = COALESCE(attempts,0) + 1, "
                + "    updated_at = now() "
                + "FROM candidate c "
                + "WHERE m.id = c.id "
                + "RETURNING m.id, m.mac_address, m.article_id, m.vc, m.line, m.zone, m.trolley_code, m.status, m.created_at;";

        Query q = em.createNativeQuery(sql);
        q.setParameter("mac", mac);
        @SuppressWarnings("unchecked")
        List<Object[]> rows = q.getResultList();
        if (rows.isEmpty()) return null;
        return rows.get(0);
    }

    private String fetchItemCodeForArticle(String articleId) {
        if (articleId == null) return null;
        String s = "SELECT item_code FROM mac_articleid_kitting WHERE article_id = :articleId LIMIT 1";
        Query q = em.createNativeQuery(s);
        q.setParameter("articleId", articleId);
        @SuppressWarnings("unchecked")
        List<Object> rows = q.getResultList();
        if (rows.isEmpty() || rows.get(0) == null) return null;
        return String.valueOf(rows.get(0));
    }

    private Integer fetchQtyFromBom(String itemCode) {
        if (itemCode == null) return null;
        String s = "SELECT quantity FROM vc_bom_map WHERE material = :mat LIMIT 1";
        Query q = em.createNativeQuery(s);
        q.setParameter("mat", itemCode);
        @SuppressWarnings("unchecked")
        List<Object> rows = q.getResultList();
        if (rows.isEmpty() || rows.get(0) == null) return null;
        Object o = rows.get(0);
        if (o instanceof Number) {
            BigDecimal bd = (o instanceof BigDecimal) ? (BigDecimal) o : new BigDecimal(String.valueOf(o));
            return bd.setScale(0, RoundingMode.CEILING).intValue();
        } else {
            try {
                BigDecimal bd = new BigDecimal(String.valueOf(o));
                return bd.setScale(0, RoundingMode.CEILING).intValue();
            } catch (Exception ex) {
                return null;
            }
        }
    }

    private void markQuantitySuccess(Long id) {
        String s = "UPDATE mac_pick_queue SET quantity_update_attempted = true, quantity_update_success_at = now(), updated_at = now() WHERE id = :id";
        Query q = em.createNativeQuery(s);
        q.setParameter("id", id);
        q.executeUpdate();
    }
