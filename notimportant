                            "SELECT count(1) FROM vin_hold_status WHERE vinnumber = :vin AND is_hold = true")
                    .setParameter("vin", vin)
                    .getSingleResult();
            return cnt != null && cnt.intValue() > 0;
        } catch (Exception ex) {
            log.warn("Could not check vin_hold_status: {}. Assuming not held.", ex.getMessage());
            return false;
        }
    }

