    private String getDynamicZoneFlag(String base, String zoneNumber) {
        if (zoneNumber == null || zoneNumber.isEmpty() || "1".equals(zoneNumber)) {
            return (base + "1").toLowerCase();
        }
        return (base + "2").toLowerCase();
    }

    private String getDynamicZoneData(String base, String zoneNumber) {
        if (zoneNumber == null || zoneNumber.isEmpty() || "1".equals(zoneNumber)) {
            return base.toLowerCase();
        }
        if (base.equalsIgnoreCase("trolleycode"))      return "trolleycodez2";
        if (base.equalsIgnoreCase("assignedledcolor")) return "assignedledcolorz2";
        if (base.equalsIgnoreCase("reservedat"))       return "reservedatz2";
        if (base.equalsIgnoreCase("operatorname"))     return "operatornamez2";
        return (base + "z2").toLowerCase();
    }

    private String joinModelVariant(String model, String variant) {
        model = model == null ? "" : model.trim();
        variant = variant == null ? "" : variant.trim();
        if (model.isEmpty() && variant.isEmpty()) return "";
        if (variant.isEmpty()) return model;
        if (model.isEmpty()) return variant;
        return model + "-" + variant;
    }

