  filteredKittingRecords: KittingRecord[] = [];
  searchTerm: string = '';
  // Specific Column Filters
  selectedLineDenotion: string = '';
  selectedZone: string = '';
  // Filter Options arrays
  lineDenotionOptions: string[] = [];
  zoneOptions: string[] = [];
  isLoading: boolean = false;
  uploadMessage: string = '';
  uploadError: string = '';
  // Modal properties
  showSuccessModal: boolean = false;
  showErrorModal: boolean = false;
  modalTitle: string = '';
  modalMessage: string = '';
  // Pagination
  currentPage: number = 1;
  itemsPerPage: number = 10;
  totalItems: number = 0;
  // Table columns (will be dynamically determined)
  tableColumns: string[] = [];
  Math: any;
  // Column width configuration
  columnWidths: { [key: string]: string } = {};
  constructor(
    private http: HttpClient,
    private authService: AuthService,
  ) {}
  ngOnInit(): void {
    this.loadKittingRecords();
  }
  ngAfterViewInit(): void {
    // Recalculate column widths after view initialization
    setTimeout(() => {
      this.calculateColumnWidths();
    }, 100);
  }
  loadKittingRecords(): void {
    this.isLoading = true;
    this.authService
      .httpGetRequest(`${Global['MAC_KITTING_VIEW_ALL']}`)
      .subscribe({
        next: (res: KittingRecord[]) => {
          // Format the uploadTimestamp for each item
          this.kittingRecords = res.map(item => ({
            ...item,
            uploadTimestamp: this.formatTimestamp(item.uploadTimestamp)
          }));
          // Generate unique list choices from data attributes for the UI filters
          this.extractFilterOptions();
          // Apply initial filters
          this.applyFilters();
          // Dynamically determine columns from first item
          if (res.length > 0) {
            this.tableColumns = Object.keys(res[0]);
            // Calculate column widths after a brief delay to ensure DOM is ready
            setTimeout(() => {
              this.calculateColumnWidths();
            }, 0);
          }
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error fetching MAC-ArticleID kitting records:', error);
          this.showError('Load Error', 'Failed to load MAC-ArticleID kitting records');
          this.isLoading = false;
        }
      });
  }
  extractFilterOptions(): void {
    const denotions = new Set<string>();
    const zones = new Set<string>();
    this.kittingRecords.forEach(item => {
      if (item.lineDenotion) denotions.add(item.lineDenotion.toString().trim());
      if (item.zone) zones.add(item.zone.toString().trim());
    });
    this.lineDenotionOptions = Array.from(denotions).sort();
    this.zoneOptions = Array.from(zones).sort();
  }
  applyFilters(): void {
    let tempRecords = [...this.kittingRecords];
    // 1. Text global input field assessment (minimum 3 characters matching logic)
    if (this.searchTerm && this.searchTerm.length >= 3) {
      const searchLower = this.searchTerm.toLowerCase();
      tempRecords = tempRecords.filter((item) =>
        Object.values(item).some(
          (val) => val && val.toString().toLowerCase().includes(searchLower)
        )
      );
    }
    // 2. Line Denotion strict value check 
    if (this.selectedLineDenotion) {
      tempRecords = tempRecords.filter(item => 
        item.lineDenotion && item.lineDenotion.toString().trim() === this.selectedLineDenotion
      );
    }
    // 3. Zone strict value check
    if (this.selectedZone) {
      tempRecords = tempRecords.filter(item => 
        item.zone && item.zone.toString().trim() === this.selectedZone
      );
    }
    this.filteredKittingRecords = tempRecords;
    this.totalItems = this.filteredKittingRecords.length;
    this.currentPage = 1; // Return to index page 1 on adjustment triggers
    setTimeout(() => {
      this.calculateColumnWidths();
    }, 0);
  }
  // Triggered via (input) or (change) from standard inputs
  onFilterChange(): void {
    this.applyFilters();
  }
  // Backwards compatibility handling fallback for search buttons
  onSearch(): void {
    this.applyFilters();
  }
  exportToExcel(): void {
    if (this.filteredKittingRecords.length === 0) {
      this.showError('Export Warning', 'No filtered data available to export.');
      return;
    }
    // Build human-readable formatted tracking data reflecting active layout columns
    const excelRows = this.filteredKittingRecords.map((item, idx) => {
      const rowData: { [key: string]: any } = {
        'Sr. No.': idx + 1
      };
      this.tableColumns.forEach(col => {
        const readableHeader = this.getColumnDisplayName(col);
        rowData[readableHeader] = item[col] !== null && item[col] !== undefined ? item[col] : '';
      });
      return rowData;
    });
    // Generate Sheet parsing processing
    const worksheet: WorkSheet = utils.json_to_sheet(excelRows);
    const workbook: WorkBook = utils.book_new();
    utils.book_append_sheet(workbook, worksheet, 'Kitting Records');
    // Create tracking timestamp title suffix output
    const timestampStr = new Date().toISOString().slice(0, 10);
    writeFile(workbook, `MAC_ArticleID_Filtered_Report_${timestampStr}.xlsx`);
  }
  // Format timestamp to YYYY-MM-DD HH:mm:ss
  formatTimestamp(timestamp: string | null | undefined): string {
    if (!timestamp) return '';
    try {
      const date = new Date(timestamp);
      if (isNaN(date.getTime())) {
        return timestamp; 
      }
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      const seconds = String(date.getSeconds()).padStart(2, '0');
      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
    } catch (error) {
      console.error('Error formatting timestamp:', error);
      return timestamp || '';
    }
  }
  calculateColumnWidths(): void {
    if (!this.dataTable || this.kittingRecords.length === 0) return;
    this.columnWidths = {};
    this.tableColumns.forEach(column => {
      const columnName = this.getColumnDisplayName(column);
      let maxContentWidth = this.calculateMaxContentWidth(column);
      const calculatedWidth = Math.max(120, maxContentWidth + 20);
      const finalWidth = Math.min(400, calculatedWidth);
      this.columnWidths[column] = `${finalWidth}px`;
    });
  }
  calculateMaxContentWidth(column: string): number {
    const headerWidth = this.getColumnDisplayName(column).length * 8;
    let maxContentWidth = headerWidth;
    this.paginatedItems.forEach(item => {
      const value = item[column];
      if (value) {
        const contentWidth = value.toString().length * 7; 
        maxContentWidth = Math.max(maxContentWidth, contentWidth);
      }
    });
    return maxContentWidth;
  }
  getColumnWidth(column: string): string {
    return this.columnWidths[column] || 'auto';
  }
  onFileSelected(event: any): void {
    const file: File = event.target.files[0];
    if (!file) return;
    if (!file.name.match(/\.(xlsx|xls)$/i)) {
      this.showError('File Format Error', 'Please upload a valid Excel file');
      event.target.value = "";
      return;
    }
    this.uploadExcel(file, event);
  }
  uploadExcel(file: File, event: any): void {
    this.isLoading = true;
    this.uploadMessage = '';
    this.uploadError = '';
    const reader: FileReader = new FileReader();
    reader.readAsArrayBuffer(file);
    reader.onload = (e: any) => {
      const binarystr: string = e.target.result;
      const wb: WorkBook = read(binarystr, { type: 'binary' });
      const wsname: string = wb.SheetNames[0];
      const ws: WorkSheet = wb.Sheets[wsname];
      const data = utils.sheet_to_json(ws);
      const requiredHeaders = ['ArticleId', 'PTLMacAddress 4.3', 'ITEM_CODE', 'Line', 'LineDenotion', 'Zone'];
      const actualHeaders = Object.keys(data[0] || {});
      const missingHeaders = requiredHeaders.filter(header => 
        !actualHeaders.some(actual => actual.toLowerCase() === header.toLowerCase())
      );
      if (missingHeaders.length > 0) {
        this.showError('Validation Error', `Missing required headers: ${missingHeaders.join(', ')}`);
        this.isLoading = false;
        event.target.value = "";
        return;
      }
      const blankArticleIds: number[] = [];
      const articleIdSet = new Set<string>();
      const duplicateArticleIds: string[] = [];
      data.forEach((record: any, index: number) => {
        const articleId = record.ArticleId || record.articleId;
        const rowNumber = index + 2; 
        if (!articleId || articleId.toString().trim() === '') {
          blankArticleIds.push(rowNumber);
        } else if (articleIdSet.has(articleId.toString())) {
          duplicateArticleIds.push(articleId.toString());
        } else {
          articleIdSet.add(articleId.toString());
        }
      });
      if (blankArticleIds.length > 0) {
        this.showError('Validation Error', `Blank ArticleId found in rows: ${blankArticleIds.join(', ')}`);
        this.isLoading = false;
        event.target.value = "";
        return;
      }
      if (duplicateArticleIds.length > 0) {
        this.showError('Validation Error', `Duplicate ArticleId found: ${duplicateArticleIds.slice(0, 5).join(', ')}${duplicateArticleIds.length > 5 ? '...' : ''}`);
        this.isLoading = false;
        event.target.value = "";
        return;
      }
      const formData = new FormData();
      formData.append('file', file);
      this.authService
        .httpPostRequest(`${Global['MAC_KITTING_UPLOAD']}`, formData, {
          responseType: 'text'
        })
        .pipe(
          catchError((error) => {
            console.error('Upload error:', error);
            const errorMessage = error.error?.errors ? error.error.errors.join('\n') : 'Upload failed';
            this.showError('Upload Failed', errorMessage);
            this.isLoading = false;
            event.target.value = "";
            return of('');
          })
        )
        .subscribe({
          next: (response: any) => {
            const parsedResponse = typeof response === 'string' ? JSON.parse(response) : response;
            if (parsedResponse.success) {
              let successMessage = 'Upload completed successfully!\n\n';
              if (parsedResponse.summary) {
                successMessage += `Total Inserted: ${parsedResponse.summary.totalInserted}\n`;
                successMessage += `Total Updated: ${parsedResponse.summary.totalUpdated}\n\n`;
                Object.entries(parsedResponse.summary.details).forEach(([area, zones]) => {
                  Object.entries(zones as any).forEach(([zone, stats]: [string, any]) => {
                    successMessage += `${area} - ${zone}: Inserted ${stats.inserted}, Updated ${stats.updated}\n`;
                  });
                });
              }
              this.showSuccess('Upload Successful', successMessage);
              this.loadKittingRecords(); 
            } else {
              const errorMessage = parsedResponse.errors ? parsedResponse.errors.join('\n') : 'Upload failed';
              this.showError('Upload Failed', errorMessage);
            }
            this.isLoading = false;
            const fileInput = document.getElementById('excelFile') as HTMLInputElement;
            if (fileInput) fileInput.value = '';
          },
          error: (error) => {
            console.error('Upload error:', error);
            this.isLoading = false;
            event.target.value = "";
          },
        });
    };
  }
  // Modal methods
  showSuccess(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showSuccessModal = true;
  }
  showError(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showErrorModal = true;
  }
  closeSuccessModal(): void {
    this.showSuccessModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  closeErrorModal(): void {
    this.showErrorModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  getSerialNumber(index: number): number {
    return (this.currentPage - 1) * this.itemsPerPage + index + 1;
  }
  // Pagination methods
  get paginatedItems(): KittingRecord[] {
    const startIndex = (this.currentPage - 1) * this.itemsPerPage;
    return this.filteredKittingRecords.slice(startIndex, startIndex + this.itemsPerPage);
  }
  get totalPages(): number {
    return Math.ceil(this.totalItems / this.itemsPerPage);
  }
  goToPage(page: number): void {
    if (page >= 1 && page <= this.totalPages) {
      this.currentPage = page;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  previousPage(): void {
    if (this.currentPage > 1) {
      this.currentPage--;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  nextPage(): void {
    if (this.currentPage < this.totalPages) {
      this.currentPage++;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  getPageNumbers(): number[] {
    const pages = [];
    const maxVisiblePages = 5;
    let startPage = Math.max(1, this.currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(this.totalPages, startPage + maxVisiblePages - 1);
    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }
    for (let i = startPage; i <= endPage; i++) {
      pages.push(i);
    }
    return pages;
  }
  minimum(a: any, b: any): any {
    return Math.min(a, b);
  }
  getColumnDisplayName(column: string): string {
    const columnDisplayMap: { [key: string]: string } = {
       'itemCode':'Part No',
       'uploadTimestamp': 'Upload Timestamp',
       'ptlMacAddress': 'PTL MAC Address',
       'lineDenotion': 'Line Denotion',
       'articleId': 'Article ID'
    };
    if (columnDisplayMap[column]) {
      return columnDisplayMap[column];
    }
    const result = column
      .replace(/([A-Z])/g, ' $1')
      .replace(/([A-Z])([A-Z][a-z])/g, '$1 $2')
      .replace(/^./, str => str.toUpperCase())
      .trim();
    const specialCases: { [key: string]: string } = {
      'Row No': 'Row',
      'Column No': 'Column',
    };
    return specialCases[result] || result;
  }
}<div class="top-header">
  <span class="home-link" routerLink="/main-dashboard">
    Home <span class="chevron-right"> &gt; </span>
  </span>
  <span class="active-link">Trolley MAC-ArticleID Kitting Upload</span>
</div>
<div class="dispatch-container">
  <div class="header-section">
    <div class="search-section">
      <div class="search-container">
        <input
          type="text"
          [(ngModel)]="searchTerm"
          (input)="onSearch()"
          placeholder="Please enter a minimum of 3 characters"
          class="search-input"
        />
        <button (click)="onSearch()" class="search-btn">Search</button>
      </div>
    </div>
    <div class="upload-section">
      <input
        type="file"
        id="excelFile"
        (change)="onFileSelected($event)"
        accept=".xlsx,.xls"
        style="display: none"
      />
      <label for="excelFile" class="upload-btn">
        Upload Trolley MAC Excel
      </label>
      <button 
        (click)="exportToExcel()" 
        class="export-btn" 
        [disabled]="filteredTrolleyMacRecords.length === 0"
      >
        Export to Excel
      </button>
    </div>
  </div>
  <div *ngIf="!isLoading" class="table-section">
    <table class="vc-table">
      <thead>
        <tr>
          <th *ngIf="filteredTrolleyMacRecords.length !== 0" class="table-header">
            Sr. No.
          </th>
          <th *ngFor="let column of tableColumns" class="table-header">
            <div class="header-with-filter">
              <span>{{ getColumnDisplayName(column) }}</span>
              <div *ngIf="column === 'lineDenotion' || column === 'zoneDenotion'" class="filter-container">
                <button
                  class="filter-btn"
                  (click)="column === 'lineDenotion' ? toggleLineFilter($event) : toggleZoneFilter($event)"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                  </svg>
                </button>
                <div *ngIf="column === 'lineDenotion' && showLineFilter" class="filter-dropdown">
                  <div class="filter-header">
                    <span>Filter by Line</span>
                    <button class="clear-filter" (click)="clearLineFilter()">Clear</button>
                  </div>
                  <div class="filter-options">
                    <div
                      *ngFor="let line of availableLines"
                      class="filter-option"
                      [class.active]="lineFilter === line"
                      (click)="applyLineFilter(line)"
                    >
                      {{ line }}
                    </div>
                  </div>
                </div>
                <div *ngIf="column === 'zoneDenotion' && showZoneFilter" class="filter-dropdown">
                  <div class="filter-header">
                    <span>Filter by Zone</span>
                    <button class="clear-filter" (click)="clearZoneFilter()">Clear</button>
                  </div>
                  <div class="filter-options">
                    <div
                      *ngFor="let zone of availableZones"
                      class="filter-option"
                      [class.active]="zoneFilter === zone"
                      (click)="applyZoneFilter(zone)"
                    >
                      {{ zone }}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr
          *ngFor="let item of paginatedItems; let i = index"
          class="table-row"
        >
          <td class="table-cell">{{ getSerialNumber(i) }}</td>
          <td *ngFor="let column of tableColumns" class="table-cell">
            {{ column === 'createdTime' ? formatTimestamp(item[column]) : item[column] }}
          </td>
        </tr>
        <tr *ngIf="filteredTrolleyMacRecords.length === 0">
          <td [attr.colspan]="tableColumns.length + 1" class="no-data">
            No data available
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div *ngIf="isLoading" class="loading-section">
    <div class="spinner"></div>
    <span>Loading...</span>
  </div>
  <div *ngIf="totalItems > 0 && !isLoading" class="pagination-section">
    <div class="pagination-info">
      Showing {{ (currentPage - 1) * itemsPerPage + 1 }} to
      {{ minimum(currentPage * itemsPerPage, totalItems) }} of
      {{ totalItems }} entries
    </div>
    <div class="pagination-controls">
      <button
        (click)="previousPage()"
        [disabled]="currentPage === 1"
        class="pagination-btn"
      >
        Previous
      </button>
      <div class="page-numbers">
        <button
          *ngFor="let page of getPageNumbers()"
          (click)="goToPage(page)"
          [class.active]="page === currentPage"
          class="page-btn"
        >
          {{ page }}
        </button>
      </div>
      <button
        (click)="nextPage()"
        [disabled]="currentPage === totalPages"
        class="pagination-btn"
      >
        Next
      </button>
    </div>
  </div>
</div>
<div *ngIf="showLineFilter || showZoneFilter" class="filter-overlay" (click)="closeAllFilters()"></div>
<div *ngIf="showSuccessModal" class="modal-overlay" (click)="closeSuccessModal()">
  <div class="modal-content success-modal" (click)="$event.stopPropagation()">
    <div class="modal-header success-header">
      <h3 class="modal-title">{{ modalTitle }}</h3>
      <button class="modal-close-btn" (click)="closeSuccessModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-icon success-icon">✓</div>
      <p class="modal-message">{{ modalMessage }}</p>
    </div>
    <div class="modal-footer">
      <button class="modal-btn success-btn" (click)="closeSuccessModal()">OK</button>
    </div>
  </div>
</div>
<div *ngIf="showErrorModal" class="modal-overlay" (click)="closeErrorModal()">
  <div class="modal-content error-modal" (click)="$event.stopPropagation()">
    <div class="modal-header error-header">
      <h3 class="modal-title">{{ modalTitle }}</h3>
      <button class="modal-close-btn" (click)="closeErrorModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-icon error-icon">⚠</div>
      <p class="modal-message">{{ modalMessage }}</p>
    </div>
    <div class="modal-footer">
      <button class="modal-btn error-btn" (click)="closeErrorModal()">OK</button>
    </div>
  </div>
