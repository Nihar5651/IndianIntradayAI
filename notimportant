<div class="dispatch-container">
  <div class="header-section">
    <div class="search-section">
      <div class="search-container">
        <input
          type="text"
          [(ngModel)]="searchTerm"
          (input)="onSearch()"
          placeholder="Please enter a minimum of 3 characters"
          class="search-input"
        />
        <button (click)="onSearch()" class="search-btn">Search</button>
      </div>
    </div>
    <div class="upload-section">
      <input
        type="file"
        id="excelFile"
        (change)="onFileSelected($event)"
        accept=".xlsx,.xls"
        style="display: none"
        #fileInput
      />
      <label for="excelFile" class="upload-btn">
        Upload Kitting Parts Excel
      </label>
      <button 
        (click)="exportToExcel()" 
        class="export-btn" 
        [disabled]="filteredPartDetails.length === 0"
      >
        Export to Excel
      </button>
    </div>
  </div>
  <div *ngIf="hasActiveFilters()" class="filter-clear-section">
    <button (click)="clearAllFilters()" class="clear-all-filters-btn">
      Clear All Filters
    </button>
  </div>
  <div *ngIf="!isLoading" class="table-section">
    <div class="table-container">
      <table class="vc-table" #dataTable>
        <thead>
          <tr>
            <th class="table-header serial-header">Sr. No.</th>
            <th *ngFor="let column of tableColumns" class="table-header" [style.min-width]="getColumnWidth(column)">
              <div class="column-header-container">
                <span>{{ getColumnDisplayName(column) }}</span>
                <span 
                  *ngIf="isFilterColumn(column)" 
                  class="filter-icon"
                  (click)="toggleFilterDropdown(column, $event)"
                  [class.active]="isFilterActive(column)"
                >
                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                </span>
              </div>
              <div 
                *ngIf="showFilterDropdown && activeFilterColumn === column" 
                class="filter-dropdown"
                (click)="$event.stopPropagation()"
              >
                <div class="filter-options">
                  <label *ngFor="let option of filterOptions[activeFilterColumn]" class="filter-option">
                    <input
                      type="checkbox"
                      [value]="option"
                      [checked]="getSelectedFiltersForColumn(activeFilterColumn).includes(option)"
                      (change)="onFilterChange(activeFilterColumn!, option, $event)"
                    />
                    <span class="checkmark"></span>
                    {{ getFilterDisplayValue(activeFilterColumn!, option) }}
                  </label>
                </div>
                <div class="filter-actions">
                  <button 
                    class="clear-filter-btn"
                    (click)="clearFilter(activeFilterColumn!, $event)"
                  >
                    Clear
                  </button>
                </div>
              </div>
            </th>
            <th class="table-header actions-header">Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr *ngFor="let item of paginatedItems; let i = index" class="table-row">
            <td class="table-cell serial-cell">{{ getSerialNumber(i) }}</td>
            <td *ngFor="let column of tableColumns" class="table-cell" [style.min-width]="getColumnWidth(column)">
              <div class="cell-content" [title]="item[column]">{{ item[column] }}</div>
            </td>
            <td class="table-cell actions-cell">
              <button 
                *ngIf="item.partNumber"
                (click)="toggleActiveStatus(item.partNumber, item.isActive)"
                [disabled]="isToggleLoading(item.partNumber)"
                [class.active]="item.isActive === '1'"
                [class.inactive]="item.isActive === '0'"
                class="toggle-btn"
              >
                <span *ngIf="isToggleLoading(item.partNumber)" class="toggle-spinner"></span>
                {{ item.isActive === '1' ? 'Active' : 'Inactive' }}
              </button>
              <span *ngIf="!item.partNumber" class="no-part-number">N/A</span>
            </td>
          </tr>
          <tr *ngIf="filteredPartDetails.length === 0">
            <td [attr.colspan]="tableColumns.length + 2" class="no-data">
              No data available
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div *ngIf="totalItems > 0 && !isLoading" class="pagination-section">
    <div class="pagination-info">
      Showing {{ (currentPage - 1) * itemsPerPage + 1 }} to
      {{ minimum(currentPage * itemsPerPage, totalItems) }} of
      {{ totalItems }} entries
    </div>
    <div class="pagination-controls">
      <button
        (click)="previousPage()"
        [disabled]="currentPage === 1"
        class="pagination-btn"
      >
        Previous
      </button>
      <div class="page-numbers">
        <button
          *ngFor="let page of getPageNumbers()"
          (click)="goToPage(page)"
          [class.active]="page === currentPage"
          class="page-btn"
        >
          {{ page }}
        </button>
      </div>
      <button
        (click)="nextPage()"
        [disabled]="currentPage === totalPages"
        class="pagination-btn"
      >
        Next
      </button>
    </div>
  </div>
</div>
<div *ngIf="showSuccessModal" class="modal-overlay" (click)="closeSuccessModal()">
  <div class="modal-content" (click)="$event.stopPropagation()">
