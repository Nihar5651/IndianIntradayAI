@Service
public class Trim2TrolleyContinuityService {

    @PersistenceContext
    private EntityManager entityManager;

    /**
     * Save trolley serial for VIN (called in T2 Z1 only)
     */
    @Transactional
    public void saveIfAbsent(String vin, String trolleyCode) {
        if (vin == null || trolleyCode == null) return;

        String serial = extractSerial(trolleyCode);

        String sql = """
                INSERT INTO trim2_trolley_continuity (vinnumber, trolley_serial)
                VALUES (:vin, :serial)
                ON CONFLICT (vinnumber) DO NOTHING
                """;

        entityManager.createNativeQuery(sql)
                .setParameter("vin", vin)
                .setParameter("serial", serial)
                .executeUpdate();
    }

    /**
     * Get reconstructed Zone-2 trolley code
     */
    @Transactional(readOnly = true)
    public String getZone1Trolley(String vin) {
        String sql = """
                SELECT trolley_serial
                FROM trim2_trolley_continuity
                WHERE vinnumber = :vin
                """;

        Query q = entityManager.createNativeQuery(sql)
                .setParameter("vin", vin);

        Object res = q.getResultStream().findFirst().orElse(null);
        if (res == null) return null;

        return "T2Z1" + res.toString();
    }

    private String extractSerial(String trolleyCode) {
        int idx = trolleyCode.lastIndexOf('T');
        if (idx < 0) throw new IllegalArgumentException("Invalid trolley code");
        return trolleyCode.substring(idx); // T001
    }
}
