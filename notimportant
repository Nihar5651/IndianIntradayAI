import java.util.Map;

/**
 * External Articles Publisher (trust-all SSL).
 * Sends the new schema containing LINE, STATUS, DSN, VIN, VC, MODEL, ArticleColor, color.
 * Throws on any non-2xx response so caller can rollback.
 */
@Service
public class ExternalArticlePublisher {

    private static final Logger log = LoggerFactory.getLogger(ExternalArticlePublisher.class);

    @Value("${external.articles.url:https://172.25.86.106:9002/articles}")
    private String endpointUrl;

    private static final String FIXED_STATION_CODE = "100";
    private static final boolean TRUST_ALL_SSL = true;

    private volatile RestTemplate restTemplate; // lazy init
    private final ObjectMapper objectMapper = new ObjectMapper();

    /**
     * Publish the article payload.
     *
     * @param trolleyId      e.g. "T1Z1T008"
     * @param vin            allocated VIN
     * @param vc             allocated VC
     * @param modelText      e.g. "MJ-Tiago"
     * @param articleColor   allocated LED color (e.g. "GREEN")
     * @param sapColor       colortosap from vc_details
     * @param lineZoneLabel  e.g. "TRIM1 ZONE1"
     * @param status         "PICKING" or "COMPLETED"
     * @param dsn            DSN as string (e.g. "172")
     */
    public ResponseEntity<String> publish(String trolleyId,
                                          String vin,
                                          String vc,
                                          String modelText,
                                          String articleColor,
                                          String sapColor,
                                          String lineZoneLabel,
                                          String status,
                                          String dsn) {

        // Build EXACT nested map per required schema
        Map<String, Object> data = new LinkedHashMap<>();
        data.put("LINE", nz(lineZoneLabel));
        data.put("STATUS", nz(status));
        data.put("DSN", nz(dsn));
        data.put("VIN", nz(vin));
        data.put("VC", nz(vc));
        data.put("MODEL", nz(modelText));
        data.put("ArticleColor", nz(articleColor));
        data.put("COLOR", nz(sapColor));

        Map<String, Object> item = new LinkedHashMap<>();
        item.put("stationCode", FIXED_STATION_CODE);
        item.put("id", nz(trolleyId));
        item.put("data", data);

        Map<String, Object> root = new LinkedHashMap<>();
        root.put("dataList", List.of(item));

        String jsonBody = toJson(root);

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
        headers.setAccept(List.of(MediaType.APPLICATION_JSON));

        HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);

        // Exact logs
        log.info("▶️ External POST {}", endpointUrl);
        log.info("▶️ Headers: {}", headers);
        log.info("▶️ Body: {}", jsonBody);

        try {
            ResponseEntity<String> resp = getClient().exchange(endpointUrl, HttpMethod.POST, entity, String.class);
            log.info("◀️ Status: {}", resp.getStatusCode().value());
            log.info("◀️ Response Headers: {}", resp.getHeaders());
            log.info("◀️ Response Body: {}", resp.getBody() == null ? "<empty>" : resp.getBody());

            if (!resp.getStatusCode().is2xxSuccessful()) {
                throw new RuntimeException("External POST failed with status " + resp.getStatusCode().value()
                        + ", body: " + (resp.getBody() == null ? "<empty>" : resp.getBody()));
            }
            return resp;
        } catch (RestClientException ex) {
            log.error("❌ External POST error: {}", ex.getMessage(), ex);
            throw new RuntimeException("External POST error: " + ex.getMessage(), ex);
        }
    }

    // ---------- internals ----------

    private RestTemplate getClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;

            if (!TRUST_ALL_SSL) {
                restTemplate = new RestTemplate();
                return restTemplate;
            }

            try {
                SSLContext sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);
                log.warn("ExternalArticlePublisher: INSECURE SSL ENABLED (trust-all + no hostname verification).");
            } catch (Exception e) {
                log.error("Failed to build insecure SSL client. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private String toJson(Object obj) {
        try {
            return objectMapper.writeValueAsString(obj);
        } catch (JsonProcessingException e) {
            log.warn("Failed to serialize JSON for log/body, falling back: {}", e.getMessage());
            return String.valueOf(obj);
        }
    }

    private String nz(String s) { return (s == null) ? "" : s; }
}
