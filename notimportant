import com.kitting.integration.ExternalPickToLightPublisher;
import jakarta.annotation.PostConstruct;
import jakarta.annotation.PreDestroy;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.LinkedBlockingQueue;

/**
 * ✅ PHASE 3 CORE: The Asynchronous Hardware Pacer
 * Takes outbound P2L requests from fast database threads, splits large lists into
 * small chunks (max 5), and feeds them to the RF hardware at a strict, safe pace (200ms)
 * to prevent network drops and gateway crashes.
 */
@Service
public class P2LAsyncWorker {
    private static final Logger log = LoggerFactory.getLogger(P2LAsyncWorker.class);
    private final ExternalPickToLightPublisher p2lPublisher;
    // The Thread-Safe Memory Queue (now holds full lists instead of single items)
    private final LinkedBlockingQueue<BlinkBatchTask> queue = new LinkedBlockingQueue<>();
    private Thread workerThread;
    private volatile boolean running = true;
    // Configuration for batching
    private static final int BATCH_SIZE = 3;
    // 🔥 UPDATED: 200ms delay for maximum gateway stability
    private static final int THROTTLE_DELAY_MS = 300;
    public P2LAsyncWorker(ExternalPickToLightPublisher p2lPublisher) {
        this.p2lPublisher = p2lPublisher;
    }
    // A container for the batch task data
    private static class BlinkBatchTask {
        List<String> articleIds;
        String color;
        BlinkBatchTask(List<String> articleIds, String color) {
            this.articleIds = articleIds;
            this.color = color;
        }
    }
    /**
     * Called by the API threads to instantly dump a LIST of tasks and return to the user.
     */

    public void queueBlinkTask(List<String> articleIds, String color) {
        if (articleIds == null || articleIds.isEmpty()) return;
        queue.offer(new BlinkBatchTask(articleIds, color));
        log.debug("📥 Batch queued for {} Articles. Total batches in queue: {}", articleIds.size(), queue.size());
    }
    /**
     * Starts the background worker when Spring Boot boots up.
     */
    @PostConstruct
    public void startWorker() {
        workerThread = new Thread(() -> {
            log.info("🚀 P2L Async Worker started. Chunking payload at {} items per {}ms.", BATCH_SIZE, THROTTLE_DELAY_MS);
            while (running && !Thread.currentThread().isInterrupted()) {
                try {
                    // .take() will gracefully sleep and wait if the queue is empty (0 CPU usage)
                    BlinkBatchTask task = queue.take();
                    // 1. Split the large list (e.g., 24 parts) into smaller chunks of 5
                    List<List<String>> chunks = chunkList(task.articleIds, BATCH_SIZE);
                    // 2. Loop through each chunk and fire it
                    for (int i = 0; i < chunks.size(); i++) {
                        List<String> chunk = chunks.get(i);
                        // Fire the external API for this specific chunk
                        p2lPublisher.publishPickToLights(chunk, task.color);
                        log.info("📤 Async Worker fired chunk {}/{} ({} parts) for color {}.",
                                i + 1, chunks.size(), chunk.size(), task.color);
                        // 3. THE THROTTLE: Force a 200ms pause to let the hardware gateway breathe
                        // Skip the sleep on the very last chunk for maximum speed
                        if (i < chunks.size() - 1) {
                            Thread.sleep(THROTTLE_DELAY_MS);
                        }
                    }
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    log.info("P2L Async Worker interrupted and shutting down.");
                    break;
                } catch (Exception e) {
                    log.error("❌ Error in P2L Async Worker: {}", e.getMessage(), e);
                }
            }
        }, "p2l-async-worker-thread");
        workerThread.start();
    }
    /**
     * Safely shuts down the worker if the server stops.
     */
    @PreDestroy
    public void stopWorker() {
        running = false;
        if (workerThread != null) {
            workerThread.interrupt();
        }
    }
    /**
     * Helper method to split a large list into smaller sublists.
     */
    private List<List<String>> chunkList(List<String> list, int chunkSize) {
        List<List<String>> chunks = new ArrayList<>();
        for (int i = 0; i < list.size(); i += chunkSize) {
            chunks.add(list.subList(i, Math.min(list.size(), i + chunkSize)));
        }
        return chunks;
    }
}
package com.kitting.service;

import com.kitting.dto.UploadResult;
import com.kitting.entity.PartMaster;
import com.kitting.entity.LineAllowedHierarchy;
import com.kitting.repositories.PartMasterRepository;
import com.kitting.repositories.LineAllowedHierarchyRepository;
import org.apache.poi.ss.usermodel.*;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import jakarta.transaction.Transactional;
import java.io.InputStream;
import java.time.LocalDateTime;
import java.util.*;

@Service
public class PartMasterUploadService {

    private final PartMasterRepository partMasterRepository;
    private final LineAllowedHierarchyRepository lineAllowedHierarchyRepository;

    public PartMasterUploadService(PartMasterRepository partMasterRepository,
                                   LineAllowedHierarchyRepository lineAllowedHierarchyRepository) {
        this.partMasterRepository = partMasterRepository;
        this.lineAllowedHierarchyRepository = lineAllowedHierarchyRepository;
    }

    @Transactional
    public UploadResult uploadExcel(MultipartFile file, String uploadedBy) {
        List<String> violations = new ArrayList<>();
        List<PartMaster> toSave = new ArrayList<>();

        try (InputStream inputStream = file.getInputStream();
             Workbook workbook = WorkbookFactory.create(inputStream)) {

            // ✅ Preload valid Line+Zone combinations into a HashSet
            Set<String> validCombos = new HashSet<>();
            for (LineAllowedHierarchy lah : lineAllowedHierarchyRepository.findAll()) {
                String combo = normalize(lah.getLineDenotion()) + "|" + normalize(lah.getZone());
                validCombos.add(combo);
            }

            // ✅ Preload all existing partNumbers into a Map (for instant lookup)
            Map<String, PartMaster> existingParts = new HashMap<>();
            for (PartMaster existing : partMasterRepository.findAll()) {
                existingParts.put(normalize(existing.getPartNumber()), existing);
            }

            Sheet sheet = workbook.getSheetAt(0);
            Iterator<Row> rows = sheet.iterator();

            if (rows.hasNext()) rows.next(); // Skip header row

            // ✅ Track duplicates INSIDE this specific Excel file
            Set<String> partsInThisFile = new HashSet<>();
            int rowNum = 1;

            while (rows.hasNext()) {
                rowNum++;
                Row row = rows.next();

                String partNumber = normalize(getCellValue(row.getCell(0)));
                String description = getCellValue(row.getCell(1));
                String type = getCellValue(row.getCell(2));
                String isActive = getCellValue(row.getCell(3));
                String line = normalize(getCellValue(row.getCell(4)));
                String zone = normalize(getCellValue(row.getCell(5)));
                String rack = getCellValue(row.getCell(6));
                String rowNo = getCellValue(row.getCell(7));
                String columnNo = getCellValue(row.getCell(8));

                // 1️⃣ Validate: Is this part duplicated inside this Excel file?
                if (partsInThisFile.contains(partNumber)) {
                    // 🔥 DOOR EXCEPTION: If they list the same part for Z1 and Z2, silently ignore the second row
                    // to prevent duplicate key crashes, since the MAC upload handles the multi-zone mapping.
                    if ("DR".equals(line)) {
                        continue;
                    } else {
                        violations.add("Row " + rowNum + ": Duplicate PartNumber found inside the Excel file: " + partNumber);
                        continue;
                    }
                }
                partsInThisFile.add(partNumber);

                // 2️⃣ Validate: Is this Line + Zone combo legal?
                String comboKey = line + "|" + zone;
                if (!validCombos.contains(comboKey)) {
                    violations.add("Row " + rowNum + ": Invalid combination for PartNumber: " + partNumber +
                            " → [LineDenotion=" + line + ", Zone=" + zone + "]");
                    continue;
                }

                // 3️⃣ Validate: Database-Level Zone Locking
                PartMaster existing = existingParts.get(partNumber);
                if (existing != null) {
                    String existingLine = normalize(existing.getLine());
                    String existingZone = normalize(existing.getZone());

                    // 🔥 DOOR EXCEPTION: Allow zone changes if both old and new lines are "DR"
                    boolean isDoorException = "DR".equals(existingLine) && "DR".equals(line);

                    if (!isDoorException && (!existingLine.equals(line) || !existingZone.equals(zone))) {
                        violations.add("Row " + rowNum + " - ILLEGAL ZONE CHANGE: Part " + partNumber +
                                " is already assigned to [" + existing.getLine() + " / " + existing.getZone() +
                                "] in the DB. You cannot upload it to [" + line + " / " + zone + "].");
                        continue;
                    }

                    // Safe to update non-location fields
                    existing.setPartDescription(description);
                    existing.setType(type);
                    existing.setIsActive(isActive);
                    // Update location fields safely
                    existing.setLine(line);
                    existing.setZone(zone);
                    existing.setRack(rack);
                    existing.setRowNo(rowNo);
                    existing.setColumnNo(columnNo);
                    existing.setUploadTimestamp(LocalDateTime.now());
                    existing.setUploadedBy(uploadedBy);
                    toSave.add(existing);
                } else {
                    // Brand new part
                    PartMaster newPart = new PartMaster();
                    newPart.setPartNumber(partNumber);
                    newPart.setPartDescription(description);
                    newPart.setType(type);
                    newPart.setIsActive(isActive);
                    newPart.setLine(line);
                    newPart.setZone(zone);
                    newPart.setRack(rack);
                    newPart.setRowNo(rowNo);
                    newPart.setColumnNo(columnNo);
                    newPart.setUploadTimestamp(LocalDateTime.now());
                    newPart.setUploadedBy(uploadedBy);
                    toSave.add(newPart);
                }
            }

            // ❌ If ANY validation issues exist, reject the entire file
            if (!violations.isEmpty()) {
                return new UploadResult(violations, 0);
            }

            // ✅ Save everything in one batch if perfectly clean
            partMasterRepository.saveAll(toSave);
            return new UploadResult(Collections.emptyList(), toSave.size());

        } catch (Exception e) {
            throw new RuntimeException("Failed to process Excel file: " + e.getMessage(), e);
        }
    }

    private String getCellValue(Cell cell) {
        if (cell == null) return "";
        if (cell.getCellType() == CellType.STRING) return cell.getStringCellValue().trim();
        if (cell.getCellType() == CellType.NUMERIC) return String.valueOf((long) cell.getNumericCellValue());
        if (cell.getCellType() == CellType.BOOLEAN) return String.valueOf(cell.getBooleanCellValue());
        return "";
    }

    private String normalize(String value) {
        if (value == null) return "";
        return value.trim().toUpperCase();
    }
