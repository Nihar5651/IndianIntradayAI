 * ExternalEslLedPublisher (defensive)
 *
 * - Same semantics as before (trust-all SSL, lazy RestTemplate).
 * - If arguments are passed swapped (stationCode in first param), it auto-corrects.
 * - Enqueues retry rows into external_api_retry_queue on non-2xx / exceptions.
 */
@Service
public class ExternalEslLedPublisher {

    private static final Logger log = LoggerFactory.getLogger(ExternalEslLedPublisher.class);

    @Value("${external.led.url:https://172.25.86.106:9002/labels/contents/led/article}")
    private String endpointUrl;

    private static final boolean TRUST_ALL_SSL = true;
    private volatile RestTemplate restTemplate; // lazy init
    private final ObjectMapper objectMapper = new ObjectMapper();

    private final EntityManager em;

    public ExternalEslLedPublisher(EntityManager em) {
        this.em = em;
    }

    /**
     * Defensive publishLed: accepts parameters in expected order but will auto-detect & swap
     * if caller passed stationCode as first param accidentally.
     *
     * @param trolleyId   expected articleId / trolley (e.g. "CPZ1T009") — but may be stationCode if args swapped
     * @param color       color string
     * @param stationCode expected station code (e.g. "100") — but may be trolleyId if args swapped
     */
    public ResponseEntity<String> publishLed(String trolleyId, String color, String stationCode) {
        // Defensive detection & swap:
        // If first param looks numeric (station code) and third param looks like a trolley (letters + 'T'), swap.
        if (looksLikeStationCode(trolleyId) && looksLikeTrolleyCode(stationCode)) {
            log.warn("Detected swapped args in publishLed — swapping internally (received trolleyId='{}', stationCode='{}')",
                    trolleyId, stationCode);
            String tmp = trolleyId;
            trolleyId = stationCode;
            stationCode = tmp;
        }

        Map<String, Object> item = new LinkedHashMap<>();
        item.put("color", nz(color));
        item.put("duration", "0");
        item.put("patternId", 1);
        item.put("stationCode", nz(stationCode));
        item.put("articleId", nz(trolleyId));

        List<Map<String, Object>> root = List.of(item);
        String jsonBody = toJson(root);

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
        headers.setAccept(List.of(MediaType.APPLICATION_JSON));

        HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);

        log.info("▶️ External PUT {}", endpointUrl);
        log.info("▶️ Headers: {}", headers);
        log.info("▶️ Body: {}", jsonBody);

        try {
            ResponseEntity<String> resp = getClient().exchange(endpointUrl, HttpMethod.PUT, entity, String.class);

            log.info("◀️ Status: {}", resp.getStatusCodeValue());
            log.debug("◀️ Response headers: {}", resp.getHeaders());
            log.debug("◀️ Response body: {}", resp.getBody() == null ? "<empty>" : resp.getBody());

            if (!resp.getStatusCode().is2xxSuccessful()) {
                String err = "External PUT failed with status " + resp.getStatusCodeValue() + " body=" + (resp.getBody() == null ? "<empty>" : resp.getBody());
                log.error("❌ {}", err);
                enqueueRetry(endpointUrl, "PUT", jsonBody, headers, err);
                throw new RuntimeException(err);
            }
            return resp;

        } catch (RestClientException ex) {
            log.error("❌ Failed to publish ESL LED for trolley {} : {}", trolleyId, ex.getMessage(), ex);
            try {
                enqueueRetry(endpointUrl, "PUT", jsonBody, headers, ex.getMessage());
            } catch (Exception enqueueEx) {
                log.error("Failed to insert retry row into external_api_retry_queue : {}", enqueueEx.getMessage(), enqueueEx);
            }
            throw new RuntimeException("I/O error on PUT request for \"" + endpointUrl + "\": " + ex.getMessage(), ex);
        } catch (RuntimeException re) {
            throw re;
        }
    }

    private boolean looksLikeStationCode(String s) {
        if (s == null) return false;
        return s.matches("^\\d{2,5}$"); // 2-5 digits typical (e.g. "100")
    }

    private boolean looksLikeTrolleyCode(String s) {
        if (s == null) return false;
        // basic check: letters + 'Z' + digit + 'T' e.g. CPZ1T001 or presence of 'T' plus letters
        return s.matches("^[A-Z]{1,4}Z?\\d.*T.*") || s.toUpperCase().contains("T");
    }

    // enqueueRetry identical to previous behavior, inserts into external_api_retry_queue
    private void enqueueRetry(String endpoint, String method, String payloadJson, HttpHeaders headers, String lastError) {
        try {
            String headersJson = toJson(headers.toSingleValueMap());
            String sql = "INSERT INTO external_api_retry_queue " +
                    "(endpoint, method, payload, headers, attempts, last_error, next_attempt_at, created_at, updated_at) " +
                    "VALUES (?, ?, cast(? as jsonb), cast(? as jsonb), 0, ?, now(), now(), now())";

            Query q = em.createNativeQuery(sql);
            q.setParameter(1, endpoint);
            q.setParameter(2, method);
            q.setParameter(3, payloadJson);
            q.setParameter(4, headersJson);
            q.setParameter(5, lastError);
            q.executeUpdate();

            log.info("Enqueued retry for endpoint={} method={}", endpoint, method);
        } catch (Exception ex) {
            log.error("Failed to enqueue retry into external_api_retry_queue : {}", ex.getMessage(), ex);
            throw new RuntimeException("Failed to enqueue retry: " + ex.getMessage(), ex);
        }
    }

    private RestTemplate getClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;

            if (!TRUST_ALL_SSL) {
                restTemplate = new RestTemplate();
                return restTemplate;
            }

            try {
                SSLContext sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);
                log.warn("ExternalEslLedPublisher: INSECURE SSL ENABLED (trust-all + no hostname verification).");
            } catch (Exception e) {
                log.error("Failed to build insecure SSL client. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private String toJson(Object obj) {
        try {
            return objectMapper.writeValueAsString(obj);
        } catch (JsonProcessingException e) {
            log.warn("Failed to serialize JSON for log/body: {}", e.getMessage());
            return String.valueOf(obj);
        }
