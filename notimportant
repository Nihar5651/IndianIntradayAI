package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.sql.Timestamp;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;
import java.util.*;

/**
 * Audit service to list vehicles that were forcefully kitted for a given line+zone.
 *
 * Uses the dedicated forceful flag columns:
 *  - single-zone:  forcefulkitting
 *  - two-zone:     forcefulkittingz1 / forcefulkittingz2
 *
 * Returns similar payload shape as existing audit endpoint.
 */
@Service
public class ForceKittingAuditService {

    private static final Logger log = LoggerFactory.getLogger(ForceKittingAuditService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");
    private static final Set<String> SINGLE_ZONE_LINES = Set.of("CR", "CP");

    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");
    private static final DateTimeFormatter IST_FORMAT =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").withZone(IST_ZONE);

    /**
     * GET audit for forceful kitting.
     * Returns list of records where the appropriate forceful column is true.
     */
    @Transactional(readOnly = true)
    public Map<String, Object> getForcefullyCompletedVINs(String line, String zone) {
        Map<String, Object> response = new LinkedHashMap<>();

        if (line == null || zone == null) {
            response.put("status", "error");
            response.put("message", "Both line and zone must be provided.");
            return response;
        }

        String upperLine = line.trim().toUpperCase();
        String upperZone = zone.trim().toUpperCase();

        if (!KITTING_TABLES.containsKey(upperLine)) {
            response.put("status", "error");
            response.put("message", "Invalid line. Allowed: T1, T2, DR, CR, CP.");
            return response;
        }

        if (SINGLE_ZONE_LINES.contains(upperLine) && !"Z1".equals(upperZone)) {
            response.put("status", "error");
            response.put("message", "Line " + upperLine + " supports only Zone Z1.");
            return response;
        }

        boolean isTwoZone = TWO_ZONE_LINES.contains(upperLine);
        int zoneNumber = extractZoneNumber(upperZone);

        String table = KITTING_TABLES.get(upperLine);

        // forceful flag column
        final String forcefulCol = isTwoZone
                ? (zoneNumber == 2 ? "forcefulkittingz2" : "forcefulkittingz1")
                : "forcefulkitting";

        // zone-specific columns
        final String operatorCol = (zoneNumber == 2) ? "operatornamez2" : "operatorname";
        final String trolleyCol = (zoneNumber == 2) ? "trolleycodez2" : "trolleycode";

        // We'll use lastmodifiedtime as the timestamp when the force flag was recorded (most reliable)
        final String timeCol = "lastmodifiedtime";

        String sql = String.format("""
                SELECT k.vinnumber,
                       k.vcnumber,
                       k.dsn,
                       k.%s AS operatorname,
                       k.%s AS trolleycode,
                       k.%s AS forced_at,
                       v.model,
                       v.variant
                FROM %s k
                LEFT JOIN vc_details v ON TRIM(k.vcnumber) = TRIM(v.vc)
                WHERE coalesce(k.%s,false) = true
                ORDER BY k.%s ASC
                """, operatorCol, trolleyCol, timeCol, table, forcefulCol, timeCol);

        @SuppressWarnings("unchecked")
        List<Object[]> rows = entityManager.createNativeQuery(sql).getResultList();

        List<Map<String, Object>> records = new ArrayList<>();

        for (Object[] r : rows) {
            Map<String, Object> rec = new LinkedHashMap<>();
            rec.put("vin", r[0]);
            rec.put("vc", r[1]);
            rec.put("dsn", r[2]);
            rec.put("operator", r[3]);
            rec.put("trolleyCode", r[4]);

            if (r[5] instanceof Timestamp ts) {
                rec.put("forcedAt", IST_FORMAT.format(ts.toInstant().atZone(IST_ZONE)));
            } else {
                rec.put("forcedAt", null);
            }

            rec.put("model", r[6]);
            rec.put("variant", r[7]);
            records.add(rec);
        }

        response.put("status", "success");
        response.put("message", records.isEmpty()
                ? "No forcefully completed VINs found for " + upperLine + " " + upperZone
                : "Forcefully completed VINs fetched successfully.");
        response.put("line", upperLine);
        response.put("zone", upperZone);
        response.put("count", records.size());
        response.put("records", records);

        log.info("🔍 Force-complete audit: {} records found for {} {}", records.size(), upperLine, upperZone);
        return response;
    }

    private int extractZoneNumber(String zone) {
        try {
            return Integer.parseInt(zone.replaceAll("[^0-9]", ""));
        } catch (Exception e) {
            throw new IllegalArgumentException("Invalid zone. Expected Z1 or Z2");
        }
    }
}
package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.apache.hc.client5.http.classic.HttpClient;
import org.apache.hc.client5.http.impl.classic.HttpClients;
import org.apache.hc.client5.http.impl.io.PoolingHttpClientConnectionManagerBuilder;
import org.apache.hc.client5.http.ssl.NoopHostnameVerifier;
import org.apache.hc.client5.http.ssl.SSLConnectionSocketFactory;
import org.apache.hc.client5.http.ssl.SSLConnectionSocketFactoryBuilder;
import org.apache.hc.client5.http.ssl.TrustAllStrategy;
import org.apache.hc.core5.ssl.SSLContextBuilder;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.*;
import org.springframework.http.client.HttpComponentsClientHttpRequestFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.client.RestTemplate;

import javax.net.ssl.SSLContext;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.*;

/**
 * Used by ForceKittingService for VINs that were already "in kitting".
 */
@Service
public class ForceKittingP2LCompletionService {

    private static final Logger log = LoggerFactory.getLogger(ForceKittingP2LCompletionService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private static final String STATION_CODE = "100";

    @Value("${external.picktolight.url:https://172.25.86.106:9002/labels/contents/led/article}")
    private String p2lEndpointUrl;

    private static final boolean TRUST_ALL_SSL = true;
    private volatile RestTemplate restTemplate;

    /**
     * Simulate missing P2L acks for all pending entries for a given
     * line/zone/vc/trolley/color and:
     *  - mark them as PICKED
     *  - insert fake SSE events
     *  - trigger next blink per MAC if any non-PICKED entry remains
     *  - if no next entry exists for a MAC => send OFF to P2L for the last article on that MAC.
     */
    @Transactional
    public void simulateMissingP2LAcksAndTurnOff(String line,
                                                 String zone,
                                                 String vc,
                                                 String trolleyCode,
                                                 String color) {

        String upperLine = line == null ? null : line.trim().toUpperCase();
        String upperZone = zone == null ? null : zone.trim().toUpperCase();
        String upColor   = color == null ? null : color.trim().toUpperCase();

        if (upperLine == null || upperZone == null || vc == null || trolleyCode == null || upColor == null) {
            log.warn("simulateMissingP2LAcksAndTurnOff called with nulls: line={}, zone={}, vc={}, trolley={}, color={}",
                    line, zone, vc, trolleyCode, color);
            return;
        }

        String selectSql = """
                SELECT id, mac_address, article_id, color
                FROM mac_pick_queue
                WHERE vc = :vc
                  AND line = :line
                  AND zone = :zone
                  AND trolley_code = :trolley
                  AND color = :color
                  AND status <> 'PICKED'
                ORDER BY created_at ASC
                """;

        Query q = entityManager.createNativeQuery(selectSql);
        q.setParameter("vc", vc);
        q.setParameter("line", upperLine);
        q.setParameter("zone", upperZone);
        q.setParameter("trolley", trolleyCode);
        q.setParameter("color", upColor);

        @SuppressWarnings("unchecked")
        List<Object[]> pending = q.getResultList();

        if (pending.isEmpty()) {
            log.info("No pending mac_pick_queue rows to compensate for vc={}, line={}, zone={}, trolley={}, color={}",
                    vc, upperLine, upperZone, trolleyCode, upColor);
            return;
        }

        long nowEpochMs = Instant.now().toEpochMilli();
        Timestamp nowTs = Timestamp.from(Instant.now());

        log.info("Compensating {} pending P2L picks for vc={}, line={}, zone={}, trolley={}, color={}",
                pending.size(), vc, upperLine, upperZone, trolleyCode, upColor);

        Set<String> affectedMacs = new HashSet<>();
        // last articleId + color per MAC (needed to send OFF if no next entry exists)
        Map<String, String[]> lastBlinkByMac = new HashMap<>();

        for (Object[] row : pending) {
            Long id = ((Number) row[0]).longValue();
            String mac = row[1].toString();
            String articleId = row[2].toString();
            String rowColor = row[3] == null ? upColor : row[3].toString();

            affectedMacs.add(mac);
            lastBlinkByMac.put(mac, new String[]{articleId, rowColor});

            try {
                long requestPickEpoch = nowEpochMs;
                long pickingEpoch = nowEpochMs;

                insertSseEvent(
                        mac,
                        "BLINK_STATUS",
                        "BLINK_SUCCESS",
                        rowColor,
                        requestPickEpoch,
                        pickingEpoch
                );

                insertSseEvent(
                        mac,
                        "PICKING_STATUS",
                        "PICKED",
                        rowColor,
                        requestPickEpoch,
                        pickingEpoch
                );

                insertSseEvent(
                        mac,
                        "PICKING_STATUS",
                        "PICKING_SUCCESS",
                        rowColor,
                        requestPickEpoch,
                        pickingEpoch
                );

                String updateSql = """
                        UPDATE mac_pick_queue
                        SET status = 'PICKED',
                            attempts = COALESCE(attempts,0) + 1,
                            last_attempt_at = :nowTs,
                            request_picking_date = :reqEp,
                            picking_date = :pickEp,
                            updated_at = :nowTs
                        WHERE id = :id
                        """;

                Query uq = entityManager.createNativeQuery(updateSql);
                uq.setParameter("nowTs", nowTs);
                uq.setParameter("reqEp", requestPickEpoch);
                uq.setParameter("pickEp", pickingEpoch);
                uq.setParameter("id", id);
                int updated = uq.executeUpdate();

                log.info("Force-kitting P2L compensation: mac={} article={} id={} updatedRows={}",
                        mac, articleId, id, updated);

            } catch (Exception ex) {
                log.error("Error compensating P2L for mac={} article={} (vc={}, line={}, zone={}, trolley={}, color={}): {}",
                        mac, articleId, vc, upperLine, upperZone, trolleyCode, upColor,
                        ex.getMessage(), ex);
            }
        }

        for (String mac : affectedMacs) {
            String[] last = lastBlinkByMac.get(mac);
            String lastArticleId = (last != null ? last[0] : null);
            String lastColor = (last != null ? last[1] : null);
            try {
                triggerNextBlinkForMac(mac, lastArticleId, lastColor);
            } catch (Exception ex) {
                log.error("Error triggering next blink for MAC {} after force-kitting: {}", mac,
                        ex.getMessage(), ex);
            }
        }
    }

    private void insertSseEvent(String mac,
                                String event,
                                String pickingStatus,
                                String ledColor,
                                long requestPickEpoch,
                                long pickingEpoch) {

        String sseId = UUID.randomUUID().toString();

        String rawJson = buildRawJson(
                sseId,
                event,
                STATION_CODE,
                mac,
                pickingStatus,
                ledColor,
                requestPickEpoch,
                pickingEpoch
        );

        String insertSql = """
                INSERT INTO sse_pick_events
                    (sse_id, event, station_code, mac_address,
                     picking_link_status, led_color,
                     request_picking_date, picking_date,
                     raw_data, received_at)
                VALUES
                    (:sseId, :event, :station, :mac,
                     :pickStatus, :ledColor,
                     :reqEp, :pickEp,
                     cast(:raw as jsonb), now())
                """;

        Query iq = entityManager.createNativeQuery(insertSql);
        iq.setParameter("sseId", sseId);
        iq.setParameter("event", event);
        iq.setParameter("station", STATION_CODE);
        iq.setParameter("mac", mac);
        iq.setParameter("pickStatus", pickingStatus);
        iq.setParameter("ledColor", ledColor);
        iq.setParameter("reqEp", requestPickEpoch);
        iq.setParameter("pickEp", pickingEpoch);
        iq.setParameter("raw", rawJson);
        iq.executeUpdate();

        log.debug("Inserted sse_pick_events: mac={} event={} status={}", mac, event, pickingStatus);
    }

    /**
     * IMPORTANT:
     *  - When triggering the next blink for a MAC, we set status='WAITING_BLINK'
     *    for that queue row so that BLINK_SUCCESS/PICKING_STATUS handlers can match it.
     *  - If NO next non-PICKED entry exists for this MAC, we send one OFF command
     *    (duration=0) for the last articleId/color we just compensated.
     */
    private void triggerNextBlinkForMac(String mac, String lastArticleId, String lastColor) {
        String selectNextSql = """
                SELECT id, article_id, color
                FROM mac_pick_queue
                WHERE mac_address = :mac
                  AND status <> 'PICKED'
                ORDER BY created_at ASC
                LIMIT 1
                """;

        Query nq = entityManager.createNativeQuery(selectNextSql);
        nq.setParameter("mac", mac);

        @SuppressWarnings("unchecked")
        List<Object[]> rows = nq.getResultList();
        if (rows.isEmpty()) {
            // No next candidate => explicit OFF for the last article on this MAC
            if (lastArticleId != null) {
                String offColor = (lastColor == null || lastColor.isBlank()) ? "WHITE" : lastColor;
                log.info("No next non-PICKED entry for MAC {}; sending OFF to P2L for last article={} color={}",
                        mac, lastArticleId, offColor);
                sendP2LOff(lastArticleId, offColor);
            } else {
                log.info("No next non-PICKED entry for MAC {}; nothing to blink/off (no last articleId).", mac);
            }
            return;
        }

        Object[] r = rows.get(0);
        Long id = ((Number) r[0]).longValue();
        String articleId = r[1].toString();
        String color = r[2].toString();

        log.info("Triggering next P2L blink for MAC {} -> queue id={} article={} color={}",
                mac, id, articleId, color);

        // 1) Send real P2L blink
        sendP2LBlink(articleId, color);

        // 2) Mark this row as WAITING_BLINK and bump attempts / timestamps.
        long nowEpochMs = Instant.now().toEpochMilli();
        Timestamp nowTs = Timestamp.from(Instant.now());

        String updateSql = """
                UPDATE mac_pick_queue
                SET status = 'WAITING_BLINK',
                    attempts = COALESCE(attempts,0) + 1,
                    last_attempt_at = :nowTs,
                    request_picking_date = :reqEp,
                    updated_at = :nowTs
                WHERE id = :id
                """;

        Query uq = entityManager.createNativeQuery(updateSql);
        uq.setParameter("nowTs", nowTs);
        uq.setParameter("reqEp", nowEpochMs);
        uq.setParameter("id", id);
        int updated = uq.executeUpdate();

        log.info("Next P2L blink queued (status=WAITING_BLINK): mac={} id={} article={} color={} updatedRows={}",
                mac, id, articleId, color, updated);
    }

    private void sendP2LBlink(String articleId, String color) {
        try {
            RestTemplate client = getP2LClient();

            Map<String, Object> item = new LinkedHashMap<>();
            item.put("stationCode", STATION_CODE);
            item.put("articleId", articleId);
            item.put("color", color);
            item.put("duration", "60m");
            item.put("patternId", 1);

            List<Map<String, Object>> root = List.of(item);

            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
            headers.setAccept(List.of(MediaType.APPLICATION_JSON));

            HttpEntity<List<Map<String, Object>>> entity = new HttpEntity<>(root, headers);

            log.info("▶️ ForceKitting P2L next-blink PUT {} body={}", p2lEndpointUrl, root);
            ResponseEntity<String> resp =
                    client.exchange(p2lEndpointUrl, HttpMethod.PUT, entity, String.class);
            log.info("◀️ ForceKitting P2L next-blink status={} body={}",
                    resp.getStatusCodeValue(),
                    resp.getBody() == null ? "<empty>" : resp.getBody());
        } catch (Exception ex) {
            log.error("❌ Error sending P2L next blink for articleId={} color={}: {}",
                    articleId, color, ex.getMessage(), ex);
        }
    }

    /**
     * Sends a "turn OFF" command to P2L for a given article.
     * Convention: duration = "0" and reuse the color (vendor usually ignores color on OFF).
     */
    private void sendP2LOff(String articleId, String color) {
        try {
            RestTemplate client = getP2LClient();

            Map<String, Object> item = new LinkedHashMap<>();
            item.put("stationCode", STATION_CODE);
            item.put("articleId", articleId);
            item.put("color", color);
            item.put("duration", "0");
            item.put("patternId", 1);

            List<Map<String, Object>> root = List.of(item);

            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
            headers.setAccept(List.of(MediaType.APPLICATION_JSON));

            HttpEntity<List<Map<String, Object>>> entity = new HttpEntity<>(root, headers);

            log.info("▶️ ForceKitting P2L OFF PUT {} body={}", p2lEndpointUrl, root);
            ResponseEntity<String> resp =
                    client.exchange(p2lEndpointUrl, HttpMethod.PUT, entity, String.class);
            log.info("◀️ ForceKitting P2L OFF status={} body={}",
                    resp.getStatusCodeValue(),
                    resp.getBody() == null ? "<empty>" : resp.getBody());
        } catch (Exception ex) {
            log.error("❌ Error sending P2L OFF for articleId={} color={}: {}",
                    articleId, color, ex.getMessage(), ex);
        }
    }

    private RestTemplate getP2LClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;

            if (!TRUST_ALL_SSL) {
                restTemplate = new RestTemplate();
                return restTemplate;
            }

            try {
                SSLContext sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);
                log.warn("ForceKittingP2LCompletionService: INSECURE SSL ENABLED (trust-all + no hostname verification).");
            } catch (Exception e) {
                log.error("Failed to build insecure SSL client for P2L. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private String buildRawJson(String sseId,
                                String event,
                                String stationCode,
                                String mac,
                                String pickingStatus,
                                String ledColor,
                                long requestPickEpoch,
                                long pickingEpoch) {

        return "{"
                + "\"event\":\"" + escape(event) + "\","
                + "\"sseId\":\"" + escape(sseId) + "\","
                + "\"stationCode\":\"" + escape(stationCode) + "\","
                + "\"macAddress\":\"" + escape(mac) + "\","
                + "\"pickingLinkStatus\":\"" + escape(pickingStatus) + "\","
                + "\"ledColor\":\"" + escape(ledColor) + "\","
                + "\"requestPickingDate\":" + requestPickEpoch + ","
                + "\"pickingDate\":" + pickingEpoch
                + "}";
    }

    private String escape(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("\"", "\\\"");
    }
