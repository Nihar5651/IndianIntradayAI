  goToPage(page: number): void {
    if (page >= 0 && page < this.totalPages) {
      this.currentPage = page;
      this.loadBomData();
    }
  }
  previousPage(): void { if (this.currentPage > 0) { this.currentPage--; this.loadBomData(); } }
  nextPage(): void { if (this.currentPage < this.totalPages - 1) { this.currentPage++; this.loadBomData(); } }
  getPageNumbers(): number[] {
    const pages = [];
    const maxVisiblePages = 5;
    const totalPages = this.totalPages;
    if (totalPages <= maxVisiblePages) {
      for (let i = 0; i < totalPages; i++) pages.push(i);
    } else {
      let startPage = Math.max(0, this.currentPage - Math.floor(maxVisiblePages / 2));
      let endPage = Math.min(totalPages - 1, startPage + maxVisiblePages - 1);
      if (endPage - startPage + 1 < maxVisiblePages) {
        startPage = Math.max(0, endPage - maxVisiblePages + 1);
      }
      for (let i = startPage; i <= endPage; i++) pages.push(i);
    }
    return pages;
  }
  getColumnDisplayName(column: string): string {
    const columnDisplayMap: { [key: string]: string } = {
      vc: 'VC', item: 'Item', level: 'Level', material: 'Part No', 
      description: 'Part Description', quantity: 'Quantity', uom: 'UOM',
      bulkInd: 'Bulk Indicator', procurement: 'Procurement', spProc: 'SP Procurement',
      model: 'Model', variant: 'Variant', color: 'Color', classification: 'Classification',
      line: 'Line', zone: 'Zone', rack: 'Rack', row: 'Row', column: 'Column',
      createdAt: 'Created At', updatedAt: 'Updated At',
    };
    if (columnDisplayMap[column]) return columnDisplayMap[column];
    const result = column.replace(/([A-Z])/g, ' $1').replace(/([A-Z])([A-Z][a-z])/g, '$1 $2').replace(/^./, (str) => str.toUpperCase()).trim();
    const specialCases: { [key: string]: string } = { 'Row No': 'Row', 'Column No': 'Column' };
    return specialCases[result] || result;
  }
