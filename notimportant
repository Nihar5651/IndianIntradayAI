@Component({
  selector: 'app-live-picking-modal',
  standalone: true,
  imports: [CommonModule, MatDialogModule, MatIconModule],
  templateUrl: './live-picking-modal.component.html',
  styleUrls: ['./live-picking-modal.component.scss']
})
export class LivePickingModalComponent implements OnInit, OnDestroy {
  partsList: P2LPart[] = [];
  isLoading: boolean = true;
  errorMessage: string = '';
  totalParts: number = 0;
  pickedParts: number = 0;
  progressPercentage: number = 0;
  private pollingInterval: any;
  constructor(
    public dialogRef: MatDialogRef<LivePickingModalComponent>,
    @Inject(MAT_DIALOG_DATA) public data: { vin: string, vc: string, line: string, zone: string, trolleyCode: string },
    private authService: AuthService,
    private toastr: ToastrService
  ) {}
  ngOnInit(): void {
    this.fetchDrillDownData(false);
    this.startPolling();
  }
  ngOnDestroy(): void {
    this.stopPolling();
  }
  startPolling(): void {
    this.pollingInterval = setInterval(() => {
      this.fetchDrillDownData(true);
    }, 5000);
  }
  stopPolling(): void {
    if (this.pollingInterval) {
      clearInterval(this.pollingInterval);
    }
  }
  fetchDrillDownData(isBackgroundSync: boolean): void {
    if (!isBackgroundSync) {
      this.isLoading = true;
    }
    this.authService
      .getLiveP2LDrillDown(this.data.vin, this.data.vc, this.data.line, this.data.zone)
      .subscribe({
        next: (response: P2LPart[]) => {
          const newData = response || [];
          if (isBackgroundSync && this.partsList.length > 0 && newData.length === 0) {
            this.stopPolling();
            this.dialogRef.close(true);
            return; 
          }
          if (this.partsList.length === 0 || !isBackgroundSync) {
            this.partsList = newData;
          } else {
            // ✅ Sync status AND blink icons
            newData.forEach(newPart => {
              const existingPart = this.partsList.find(p => p.partNumber === newPart.partNumber);
              if (existingPart) {
                existingPart.status = newPart.status;
                existingPart.blinkIcon = newPart.blinkIcon; // Update blink icon
              }
            });
          }
          this.calculateProgress();
          this.isLoading = false;
        },
        error: (err) => {
          console.error('Error fetching P2L Drilldown:', err);
          if (!isBackgroundSync) {
            this.toastr.error('Failed to load P2L details', 'Error');
            this.isLoading = false;
          }
        }
      });
  }
  calculateProgress(): void {
    if (!this.partsList || this.partsList.length === 0) return;
    this.totalParts = this.partsList.length;
    this.pickedParts = this.partsList.filter(part => part.status === 'PICKED').length;
    this.progressPercentage = Math.round((this.pickedParts / this.totalParts) * 100);
    if (this.progressPercentage === 100) {
      this.stopPolling();
      setTimeout(() => this.dialogRef.close(true), 1500); // Small delay to let user see 100%
    }
  }
  trackByPartNum(index: number, part: P2LPart): string {
    return part.partNumber;
  }
  closeModal(): void {
    this.dialogRef.close();
  }
