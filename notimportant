/**
 * Trolley DSN Allotment Service (orchestrates reservation + 2 external calls here,
 * then persistent MAC-queue gating for P2L via MacPickQueueService).
 * External calls in this method (must succeed or rollback):
 * 1) ExternalArticlePublisher  (POST /articles  => expect 200)
 * 2) ExternalLedPublisher      (PUT  /labels/contents/led/article [single trolley] => expect 202)
 * P2L + Quantity are now handled via persistent queue + SSE (later steps).
 * Here we only resolve P2L articleIds and pass to MacPickQueueService, which:
 * - triggers immediate P2L for free MACs and inserts WAITING_BLINK rows,
 * - queues PENDING rows for busy MACs,
 * - throws on immediate P2L failure so we rollback & free LED.
 * Rescan of same trolley returns same assignment if not processed yet.
 */
@Service
public class TrolleyDsnAllotmentService {

    private static final Logger log = LoggerFactory.getLogger(TrolleyDsnAllotmentService.class);

    @PersistenceContext
    private EntityManager entityManager;

    private final ExternalArticlePublisher externalArticlePublisher;
    private final ExternalLedPublisher externalLedPublisher;
    private final MacPickQueueService macPickQueueService;
    private final Trim2TrolleyContinuityService trim2TrolleyContinuityService;
    // 🔥 ADDED: Door Continuity Service Injection
    private final DoorTrolleyContinuityService doorTrolleyContinuityService;

    public TrolleyDsnAllotmentService(
            ExternalArticlePublisher externalArticlePublisher,
            ExternalLedPublisher externalLedPublisher,
            MacPickQueueService macPickQueueService,
            Trim2TrolleyContinuityService trim2TrolleyContinuityService,
            // 🔥 ADDED: Door Continuity Service Injection
            DoorTrolleyContinuityService doorTrolleyContinuityService
    ) {
        this.externalArticlePublisher = externalArticlePublisher;
        this.externalLedPublisher = externalLedPublisher;
        this.macPickQueueService = macPickQueueService;
        this.trim2TrolleyContinuityService = trim2TrolleyContinuityService;
        // 🔥 ADDED: Door Continuity Service Assignment
        this.doorTrolleyContinuityService = doorTrolleyContinuityService;
    }

    // In-Memory Debounce Lock
    private final Set<String> processingTrolleys = ConcurrentHashMap.newKeySet();

    // Dynamic dependency ordering map
    private static final Map<String, List<String>> LINE_ZONE_ORDER = Map.of(
//            "T1", List.of("Z1", "Z2"),
            "DR", List.of("Z2", "Z1"), // DOOR: Zone 1 first, then Zone 2
            "T2", List.of("Z2", "Z1")  // TRIM2: Zone 2 first, then Zone 1
    );

    private static final Map<String, String> TROLLEY_MAP_TABLES = Map.of(
            "T1", "trim1_trolly_mac_mapping",
            "T2", "trim2_trolly_mac_mapping",
            "DR", "door_trolly_mac_mapping",
            "CR", "cradle_trolly_mac_mapping",
            "CP", "cockpit_trolly_mac_mapping"
    );

    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");

    private static final List<String> LED_COLORS =
            List.of("RED", "GREEN", "BLUE", "MAGENTA", "YELLOW", "CYAN", "WHITE");

    private final Map<String, ActiveAssignment> activeAssignments = new ConcurrentHashMap<>();
    private final Map<String, Set<String>> usedLedColorsPerLineZone = new ConcurrentHashMap<>();

    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");
    private static final DateTimeFormatter IST_FORMAT =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").withZone(IST_ZONE);

    /**
     * Payload: { "trolleyCode": "CPZ1T008" }
     */
    @Transactional(rollbackFor = Exception.class)
    public Map<String, Object> alotDSN(Map<String, Object> payload) {
        log.info("alotDSN called with payload: {}", payload);

        String originalTrolleyCode = extractTrolleyCode(payload);

        // Prevent concurrent double-taps for the exact same trolley
        if (!processingTrolleys.add(originalTrolleyCode)) {
            log.warn("🚨 Rejecting concurrent request for trolley {}. Already processing.", originalTrolleyCode);
            throw new IllegalStateException("Trolley " + originalTrolleyCode + " is currently being processed. Please wait a moment.");
        }

        // Track if the transaction took control of the lock
        boolean lockHandledByTransaction = false;

        try {
            // Tell Spring to release the lock ONLY after Postgres actually commits!
            if (TransactionSynchronizationManager.isSynchronizationActive()) {
                TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
                    @Override
                    public void afterCompletion(int status) {
                        processingTrolleys.remove(originalTrolleyCode);
                    }
                });
                lockHandledByTransaction = true;
            }

            String trolleyCode = originalTrolleyCode;
            String operatorName = extractOperatorName();

            DecodedTrolley decoded = decodeTrolleyCode(trolleyCode);
            String line = decoded.line();
            String zone = decoded.zone();           // "Z1" or "Z2"
            String zoneNumber = zone.replaceAll("[^0-9]", "");

            validateTrolleyExists(line, zone, trolleyCode);
            validateZoneAllowed(line, zone);

            // 1. Check if this exact trolley is already assigned and just needs to return existing data
            ActiveAssignment existing = fetchExistingReservationFromDB(line, zoneNumber, trolleyCode);
            if (existing != null) {
                log.info("♻️ Returning same VIN {} for rescanned trolley {}", existing.vin, trolleyCode);
                return buildSuccessResponse(existing);
            }

            // 2. Fetch the vehicle ONCE (Now includes the DB ID)
            Vehicle candidate = fetchNextAvailableVehicle(line, zoneNumber);
            if (candidate == null) {
                throw new IllegalArgumentException("No available (unreserved/unprocessed) vehicles for " + line + " " + zone);
            }
            if (isVinOnHold(candidate.vin())) {
                throw new IllegalArgumentException("Selected VIN is on HOLD. Please rescan.");
            }

            // 🔥 UPDATED: Door Line Sequence Check (Zone 2 must complete before Zone 1 can scan)
            // Now securely uses the primary key ID for checking database status
            if ("DR".equals(line) && "1".equals(zoneNumber)) {
                doorTrolleyContinuityService.validateZone1Prerequisite(candidate.id(), candidate.dsn());
            }

            // 3. Strict Continuity Logic for Trim 2
            if ("T2".equals(line) && "1".equals(zoneNumber)) {
                String requiredTrolley = trim2TrolleyContinuityService.getZone1Trolley(candidate.vin());

                // If Zone 2 already used a trolley for this VIN, enforce that Zone 1 uses the matching trolley
                if (requiredTrolley != null && !requiredTrolley.equals(trolleyCode)) {
                    throw new IllegalArgumentException(
                            "Wrong Trolley! This VIN used " + requiredTrolley + " in Zone 2. You must scan " + requiredTrolley
                    );
                }
            }

            String ledColor = assignLedColor(line, zone);
            if (ledColor == null) {
                throw new IllegalArgumentException("No LED colors available currently for " + line + " " + zone + ". Please wait.");
            }

            boolean reserved = tryReserveVehicleConditional(line, zoneNumber, candidate.vin(),
                    operatorName, ledColor, trolleyCode);
            if (!reserved) {
                freeLed(line, zone, ledColor);
                throw new IllegalStateException("Failed to reserve vehicle (race). Please try again.");
            }

            // 4. Continuity Logic: Save the first scanned trolley into the continuity side-tables
            // Trim2 scans Zone 2 first
            if ("T2".equals(line) && "2".equals(zoneNumber)) {
                trim2TrolleyContinuityService.saveIfAbsent(candidate.vin(), trolleyCode);
            }

            // NOTE: Door line no longer saves to a side-table because we decoupled the physical trolley match.

            Instant reservedAt = fetchReservedAtFromDB(line, zoneNumber, candidate.vin());

            ActiveAssignment assignment = new ActiveAssignment(
                    trolleyCode, line, zone, candidate.vin(), candidate.vc(), candidate.dsn(),
                    ledColor, operatorName, reservedAt
            );
            activeAssignments.put(trolleyCode, assignment);

            // ---------- External calls (both must succeed) ----------

            // ---------- External calls (both must succeed) ----------

            VcMeta vcMeta = fetchVcMeta(candidate.vc());
            LineMeta meta = buildLineMeta(line, zone);

            // 1) PUT single LED glow (expects 202) - 🔥 MOVED TO FIRST
            try {
                externalLedPublisher.publish(assignment.trolleyCode, assignment.ledColor);
            } catch (Exception ex) {
                freeLed(line, zone, assignment.ledColor);
                throw ex;
            }

            // 🔥 THE 1-SECOND BREATHER DELAY 🔥
            // Gives the Gateway time to clear the LED command before processing the heavy screen update.
            try {
                Thread.sleep(1000);
            } catch (InterruptedException ie) {
                Thread.currentThread().interrupt();
                freeLed(line, zone, assignment.ledColor);
                throw new RuntimeException("Interrupted during 1-second gateway delay", ie);
            }

            // 2) POST /articles (status=PICKING) - 🔥 MOVED TO SECOND
            try {
                externalArticlePublisher.publish(
                        assignment.trolleyCode,
                        assignment.vin,
                        assignment.vc,
                        nz(vcMeta.modelVariant),
                        assignment.ledColor,
                        nz(vcMeta.colorToSap),
                        meta.display,
                        "PICKING",
                        nz(assignment.dsn)
                );
            } catch (Exception ex) {
                freeLed(line, zone, assignment.ledColor);
                throw ex;
            }

            // ---------- P2L gating (DB-backed) ----------
            try {
                List<String> p2lArticles = fetchP2LArticleIds(assignment.vc, line, zone);
                log.info("🧩 P2L articles count for VC {} in {} {} : {}", assignment.vc, line, zone, p2lArticles.size());
                if (!p2lArticles.isEmpty()) {
                    macPickQueueService.enqueueAndMaybeTrigger(
                            assignment.vc, line, zone, assignment.trolleyCode, assignment.operator, assignment.ledColor, p2lArticles
                    );
                } else {
                    log.info("No P2L articleIds found for VC {} in {} {}. Queue not updated.", assignment.vc, line, zone);
                }
            } catch (Exception ex) {
                freeLed(line, zone, assignment.ledColor);
                throw ex;
            }

            log.info("✅ Assigned VIN={} | VC={} | DSN={} | LED={} to trolley {} and enqueued P2L gating.",
                    assignment.vin, assignment.vc, assignment.dsn, assignment.ledColor, assignment.trolleyCode);

            return buildSuccessResponse(assignment);

        } finally {
            // Only release manually if the transaction hook failed to register (safety net)
            if (!lockHandledByTransaction) {
                processingTrolleys.remove(originalTrolleyCode);
            }
        }
    }
    // ----------------------- helpers -----------------------

    private String extractTrolleyCode(Map<String, Object> payload) {
        if (payload == null || !payload.containsKey("trolleyCode"))
            throw new IllegalArgumentException("TrolleyCode missing in request payload.");
        return payload.get("trolleyCode").toString().trim().toUpperCase();
    }

    private String extractOperatorName() {
        try {
            return SecurityContextHolder.getContext().getAuthentication().getName();
        } catch (Exception e) {
            return "UnknownOperator";
        }
    }

    private DecodedTrolley decodeTrolleyCode(String trolleyCode) {
        if (trolleyCode.length() < 6)
            throw new IllegalArgumentException("Invalid TrolleyCode format. Expected like CPZ1T005.");

        String line = findLinePrefix(trolleyCode);
        if (line == null) throw new IllegalArgumentException("Unknown line prefix in TrolleyCode.");

        String remaining = trolleyCode.substring(line.length());
        int tIndex = remaining.indexOf('T');
        if (tIndex <= 0) throw new IllegalArgumentException("Invalid TrolleyCode (missing 'T').");

        String zone = remaining.substring(0, tIndex);
        String serial = remaining.substring(tIndex);

        if (!zone.matches("Z\\d+")) throw new IllegalArgumentException("Invalid Zone format in trolley code.");
        if (!serial.matches("T\\d{3}")) throw new IllegalArgumentException("Invalid Serial format in trolley code.");

        return new DecodedTrolley(line, zone, serial);
    }

    private String findLinePrefix(String trolleyCode) {
        for (String prefix : TROLLEY_MAP_TABLES.keySet())
            if (trolleyCode.startsWith(prefix)) return prefix;
        return null;
    }

