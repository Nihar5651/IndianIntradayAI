import { Injectable } from '@angular/core';
import {
  HttpRequest,
  HttpHandler,
  HttpEvent,
  HttpInterceptor,
  HttpErrorResponse
} from '@angular/common/http';
import { Observable, catchError, throwError } from 'rxjs';
import { ToastrMsgService } from './toastr-msg.service';
import { AuthService } from './auth.service';
@Injectable()
export class AuthInterceptor implements HttpInterceptor {
  constructor(
    private toastrMsgService: ToastrMsgService,
    private authService: AuthService
  ) {}
  intercept(
    request: HttpRequest<unknown>,
    next: HttpHandler
  ): Observable<HttpEvent<unknown>> {
    const authToken: any = sessionStorage.getItem('tokenKey');
    let token: any;
    if (authToken) {
      let tokenParsed = JSON.parse(authToken);
      token = tokenParsed.jwtTokem;
    }
    let req: HttpRequest<unknown> = request;
    if (token) {
      // Clone the request and set the Authorization header
      req = request.clone({
        setHeaders: {
          Authorization: `Bearer ${token}`
        }
      });
    }
    return next.handle(req).pipe(
      catchError((error: HttpErrorResponse) => {
        // You can handle the error here or rethrow it
        if (error.status == 401) {
          this.toastrMsgService.showErrorMsg(
            error.error.message ? error.error.message : error.error
          );
          this.authService.logOut();
        }
        // } else if ([302, 400, 500].includes(error.status)) {
        //   this.toastrMsgService.showErrorMsg(error.error.message);
        // } else if ([404].includes(error.status)) {
        //   this.toastrMsgService.showWarningMsg(error.error.message);
        // } else {
        //   this.toastrMsgService.showErrorMsg('Something went wrong!');
        // }
        return throwError(() => error);
      })
    );
  }
}
