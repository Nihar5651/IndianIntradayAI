import { Component, Inject } from '@angular/core';
import { FormGroup, FormBuilder, Validators, ReactiveFormsModule } from '@angular/forms';
import { MatDialogRef, MAT_DIALOG_DATA, MatDialog, MatDialogModule } from '@angular/material/dialog';
import { AuthService } from 'src/app/shared/services/auth.service';
import { Global } from 'src/app/shared/constants/Global';
import { CommonModule } from '@angular/common';
import { MatButtonModule } from '@angular/material/button';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { ToastrService } from 'ngx-toastr';
import { ConfirmDialogComponent } from '../confirm-dialog.component'; 
@Component({
  selector: 'app-move-vin-dialog',
  standalone: true,
  imports: [
    CommonModule,
    ReactiveFormsModule,
    MatDialogModule,
    MatFormFieldModule,
    MatInputModule,
    MatSelectModule,
    MatButtonModule
  ],
  templateUrl: './move-vin-dialog.component.html',
  styleUrls: ['./move-vin-dialog.component.scss']
})
export class MoveVinDialogComponent {
  moveVinForm: FormGroup;
  lines = ['ALL', 'T1', 'T2', 'DR', 'CR', 'CP'];
  zones = ['Zone1', 'Zone2', 'Both'];
  selectedVins: string[];
  existingVin: string;
  constructor(
    private fb: FormBuilder,
    private dialogRef: MatDialogRef<MoveVinDialogComponent>,
    @Inject(MAT_DIALOG_DATA) public data: any,
    private authService: AuthService,
    private toastr: ToastrService,
    private dialog: MatDialog
  ) {
    this.selectedVins = data?.vins || [];
    this.existingVin = Array.isArray(this.selectedVins)
      ? this.selectedVins.join(', ')
      : this.selectedVins;
    this.moveVinForm = this.fb.group({
      referenceVin: ['', Validators.required],
      targetLine: ['', Validators.required],
      zones: ['Zone1', Validators.required]
    });
  }
  confirmMove() {
    if (this.moveVinForm.invalid) {
      this.toastr.warning('Please fill all required fields before proceeding.');
      return;
    }
    const { referenceVin, targetLine, zones } = this.moveVinForm.value;
    const vinToMove = this.selectedVins[0]; 
    const confirmRef = this.dialog.open(ConfirmDialogComponent, {
      width: '400px',
      data: {
        message: `You are about to move VIN '${vinToMove}' after '${referenceVin}'. Proceed?`
      },
      panelClass: 'confirm-dialog-container'
    });
    confirmRef.afterClosed().subscribe(result => {
      if (result === true) {
        const payload = {
          vinToMove: vinToMove,
          referenceVin: referenceVin,
          targetTable: targetLine,
          zones: zones
        };
        this.authService.httpPostRequest(Global.KITTING_MOVE_VIN_API, payload).subscribe({
          next: (response: any) => {
            if (response?.status === 'success') {
              const details = response.details || {};
              Object.keys(details).forEach(zone => {
                const msg = `${zone}: ${details[zone]}`;
                if (details[zone].toLowerCase().includes('success')) {
                  this.toastr.success(msg);
                } else {
                  this.toastr.error(msg);
                }
              });
              this.dialogRef.close('refresh');
            } else {
              this.toastr.error(response?.message || 'VIN move failed.');
            }
          },
          error: () => {
            this.toastr.error('Error occurred while moving VIN. Please try again.');
          }
        });
      } else {
        this.toastr.info('VIN move cancelled.');
      }
    });
  }
  cancel() {
    this.dialogRef.close();
  }
}
