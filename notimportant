    const dataSource = this.dataSources[key];
    const currentData = dataSource?.data || [];
    if (currentData.length === 0) return false;
    return currentData.every(row => this.selectedVins.has(row.vin));
  }
  isIndeterminate(): boolean {
    const key = `${this.currentLine}_${this.currentZone}`;
    const dataSource = this.dataSources[key];
    const currentData = dataSource?.data || [];
    const selectedInCurrentData = currentData.filter(row => this.selectedVins.has(row.vin)).length;
    return selectedInCurrentData > 0 && selectedInCurrentData < currentData.length;
  }
  toggleSelectAll(event: any): void {
    const key = `${this.currentLine}_${this.currentZone}`;
    const dataSource = this.dataSources[key];
    const currentData = dataSource?.data || [];
    if (event.checked) {
      currentData.forEach(row => this.selectedVins.add(row.vin));
    } else {
      currentData.forEach(row => this.selectedVins.delete(row.vin));
