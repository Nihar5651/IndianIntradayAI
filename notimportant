import com.kitting.service.TrolleyDsnAllotmentService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;

@RestController
@RequestMapping("/api/identify-trolley")
public class TrolleyDsnAllotmentController {

    private static final Logger log = LoggerFactory.getLogger(TrolleyDsnAllotmentController.class);

    @Autowired
    private TrolleyDsnAllotmentService service;

    // Thread-safe map to store the last scan time for each zone (e.g., "DRZ1" -> 1679001000)
    private final ConcurrentHashMap<String, Long> zoneScanLocks = new ConcurrentHashMap<>();

    // The cooldown period in milliseconds (3 seconds)
    private static final long SCAN_COOLDOWN_MS = 3000;

    /**
     * POST /api/identify-trolley/alot-dsn
     */
    @PostMapping("/alot-dsn")
    public ResponseEntity<?> alotDsn(@RequestBody Map<String, Object> payload) {
        try {
            // 1. Extract the trolley code to figure out which zone this is
            String trolleyCode = (String) payload.get("trolleyCode");

            if (trolleyCode != null && trolleyCode.length() >= 4) {
                // e.g., "DRZ1T005" -> We lock "DRZ1"
                String zoneKey = trolleyCode.substring(0, 4).toUpperCase();
                long now = System.currentTimeMillis();
                long lastScanTime = zoneScanLocks.getOrDefault(zoneKey, 0L);

                // 2. Check if the cooldown has passed
                if (now - lastScanTime < SCAN_COOLDOWN_MS) {
                    long waitTimeSeconds = (SCAN_COOLDOWN_MS - (now - lastScanTime)) / 1000 + 1;
                    log.warn("🚦 Scanner Flood Blocked: Zone {} scanned too quickly. Rejecting.", zoneKey);

                    // Return HTTP 429 (Too Many Requests) to the frontend
                    return ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS)
                            .body(Map.of("error", "Please wait " + waitTimeSeconds + " seconds before scanning the next trolley in this zone."));
                }

                // 3. Update the lock with the current time
                zoneScanLocks.put(zoneKey, now);
            } else {
                log.warn("Invalid or missing trolleyCode in payload: {}", payload);
            }

            // 4. Proceed to standard processing if the lock is cleared
            Map<String, Object> result = service.alotDSN(payload);
            return ResponseEntity.ok(result);

        } catch (Exception e) {
            log.error("❌ Error during DSN allotment", e);
            return ResponseEntity.badRequest().body(Map.of("error", e.getMessage()));
        }
    }
