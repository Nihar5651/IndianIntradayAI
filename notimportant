        [checked]="isAllSelected()"
        [indeterminate]="isIndeterminate()">
      </mat-checkbox>
    </th>
    <td mat-cell *matCellDef="let row">
      <mat-checkbox (change)="toggleSelection(row)" [checked]="isSelected(row)">
