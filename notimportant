  groupPartNumber: string;
  childPartNumber: string;
  quantity: number;
  line: string;
  zone: string;
  uploadTime: string | Date;
  createdAt: string | Date;
  updatedAt: string | Date;
  [key: string]: any;
}
interface GroupPartResponse extends Array<GroupPart> {}
interface CreateGroupPartRequest {
  groupPartNumber: string;
  childPartNumber: string;
  quantity: number;
  line: string;
  zone: string;
}
// Extended interface for dialog with optional id
interface DialogData extends CreateGroupPartRequest {
  id?: number;
}
@Component({
  selector: 'app-group-part-details',
  standalone: true,
  imports: [CommonModule, FormsModule, RouterModule],
  templateUrl: './grouppartdetails.component.html',
  styleUrls: ['./grouppartdetails.component.scss'],
})
export class GroupPartDetailsComponent implements OnInit {
  groupParts: GroupPart[] = [];
  searchTerm: string = '';
  lineFilter: string = '';
  zoneFilter: string = '';
  isLoading: boolean = false;
  // Line-Zone mapping based on requirements
  lineZoneMapping: { [key: string]: string[] } = {
    'CP': ['Z1'],
    'CR': ['Z1'],
    'T1': ['Z1', 'Z2'],
    'T2': ['Z1', 'Z2'],
    'DR': ['Z1', 'Z2']
  };
  availableLines: string[] = ['CP', 'CR', 'T1', 'T2', 'DR'];
  // Dialog properties
  showDialog: boolean = false;
  showDeleteDialog: boolean = false;
  isEditMode: boolean = false;
  dialogData: DialogData = this.getEmptyDialogData();
  deleteItem: GroupPart | null = null;
  // Modal properties
  showSuccessModal: boolean = false;
  showErrorModal: boolean = false;
  modalTitle: string = '';
  modalMessage: string = '';
  // Pagination
  currentPage: number = 0;
  itemsPerPage: number = 50;
  totalElements: number = 0;
  // Table columns
  tableColumns: string[] = [
    'id',
    'groupPartNumber',
    'childPartNumber',
    'quantity',
    'line',
    'zone',
    'uploadTime',
    'createdAt',
    'updatedAt'
  ];
  // Client-side filtered data
  filteredContent: GroupPart[] = [];
  constructor(
    private http: HttpClient,
    private authService: AuthService,
  ) {}
  ngOnInit(): void {
    this.loadGroupParts();
  }
  getEmptyDialogData(): DialogData {
    return {
      groupPartNumber: '',
      childPartNumber: '',
      quantity: 1,
      line: '',
      zone: ''
    };
  }
  loadGroupParts(): void {
    this.isLoading = true;
    let apiUrl = `${Global['GROUP_PARTS_VIEW']}`;
    const params = new URLSearchParams();
    if (this.lineFilter) {
      params.append('line', this.lineFilter);
    }
    if (this.zoneFilter) {
      params.append('zone', this.zoneFilter);
    }
    if (params.toString()) {
      apiUrl = `${Global['GROUP_PARTS_FILTER']}?${params.toString()}`;
    }
    this.authService.httpGetRequest(apiUrl)
      .pipe(
        catchError((error) => {
          console.error('Error fetching group parts:', error);
          this.showError('Load Error', 'Failed to load group parts');
          return of([]);
        })
      )
      .subscribe({
        next: (data: GroupPart[]) => {
          // Sort by updatedAt DESC (latest first)
          this.groupParts = data.sort((a, b) => 
            new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
          );
          // Format timestamps
          this.groupParts = this.groupParts.map(item => this.formatGroupPartTimestamps(item));
          this.totalElements = this.groupParts.length;
          this.filteredContent = [...this.groupParts];
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error:', error);
          this.isLoading = false;
        },
      });
  }
  formatGroupPartTimestamps(item: GroupPart): GroupPart {
    const formattedItem = { ...item };
    ['uploadTime', 'createdAt', 'updatedAt'].forEach(field => {
      if (formattedItem[field]) {
        formattedItem[field] = this.formatTimestamp(formattedItem[field]);
      }
    });
    return formattedItem;
  }
  formatTimestamp(timestamp: string | number | Date | undefined | null): string {
    if (!timestamp) return '';
    const date = new Date(timestamp);
    if (isNaN(date.getTime())) {
      return String(timestamp);
    }
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const seconds = String(date.getSeconds()).padStart(2, '0');
    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  }
  onSearch(): void {
    if (!this.searchTerm.trim()) {
      this.filteredContent = [...this.groupParts];
      return;
    }
    const searchLower = this.searchTerm.toLowerCase().trim();
    this.filteredContent = this.groupParts.filter((item) =>
      item.groupPartNumber?.toLowerCase().includes(searchLower) ||
      item.childPartNumber?.toLowerCase().includes(searchLower)
    );
  }
  onLineFilterChange(): void {
    this.zoneFilter = '';
    this.onFilterChange();
  }
  onFilterChange(): void {
    this.currentPage = 0;
  }
  clearFilters(): void {
    this.searchTerm = '';
    this.lineFilter = '';
    this.zoneFilter = '';
    this.currentPage = 0;
    this.loadGroupParts();
  }
  getAvailableZones(): string[] {
    if (!this.lineFilter || !this.lineZoneMapping[this.lineFilter]) {
      return [];
    }
    return this.lineZoneMapping[this.lineFilter];
  }
  // Dialog methods
  openCreateDialog(): void {
    this.isEditMode = false;
    this.dialogData = this.getEmptyDialogData();
    this.showDialog = true;
  }
  openUpdateDialog(item: GroupPart): void {
    this.isEditMode = true;
    this.dialogData = {
      groupPartNumber: item.groupPartNumber,
      childPartNumber: item.childPartNumber,
      quantity: item.quantity,
      line: item.line,
      zone: item.zone,
      id: item.id
    };
    this.showDialog = true;
  }
  onDialogLineChange(): void {
    this.dialogData.zone = '';
  }
  getDialogAvailableZones(): string[] {
    if (!this.dialogData.line || !this.lineZoneMapping[this.dialogData.line]) {
      return [];
    }
    return this.lineZoneMapping[this.dialogData.line];
  }
  closeDialog(): void {
    this.showDialog = false;
    this.dialogData = this.getEmptyDialogData();
  }
  createGroupPart(): void {
    this.isLoading = true;
    this.authService.httpPostRequest(`${Global['GROUP_PARTS_CREATE']}`, this.dialogData)
      .pipe(
        catchError((error) => {
          console.error('Error creating group part:', error);
          this.showError('Create Failed', error.error?.message || 'Failed to create group part');
          this.isLoading = false;
          return of(null);
        })
      )
      .subscribe({
        next: (response: GroupPart) => {
          this.showSuccess('Success', 'Group part created/updated successfully');
          this.closeDialog();
          this.loadGroupParts();
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error:', error);
          this.showError('Create Failed', error.error?.message || 'Failed to create group part');
          this.isLoading = false;
        },
      });
  }
  updateGroupPart(): void {
    const id = this.dialogData.id;
    if (!id) {
      this.showError('Update Failed', 'Group part ID is required for update');
      return;
    }
    this.isLoading = true;
    let { id: _, ...updateData}:any = this.dialogData; // Remove ID from update data
    this.authService.httpPutRequest(`${Global['GROUP_PARTS_UPDATE']}/${id}`, updateData)
      .pipe(
        catchError((error) => {
          console.error('Error updating group part:', error);
          this.showError('Update Failed', error.error?.message || 'Failed to update group part');
          this.isLoading = false;
          return of(null);
        })
      )
      .subscribe({
        next: (response: GroupPart) => {
          this.showSuccess('Success', 'Group part updated successfully');
          this.closeDialog();
          this.loadGroupParts();
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error:', error);
          this.showError('Update Failed', error.error?.message || 'Failed to update group part');
          this.isLoading = false;
        },
      });
  }
  // Delete methods
  openDeleteConfirmation(item: GroupPart): void {
    this.deleteItem = item;
    this.showDeleteDialog = true;
  }
  closeDeleteDialog(): void {
    this.showDeleteDialog = false;
    this.deleteItem = null;
  }
  confirmDelete(): void {
    if (!this.deleteItem) return;
    this.isLoading = true;
    // For DELETE requests with body, pass it as an option
    const options = {
      body: { id: this.deleteItem.id }
    };
    this.authService.httpDeleteRequest(`${Global['GROUP_PARTS_DELETE']}/${this.deleteItem.id}`, options)
      .pipe(
        catchError((error) => {
          console.error('Error deleting group part:', error);
          this.showError('Delete Failed', error.error?.message || 'Failed to delete group part');
          this.isLoading = false;
          return of(null);
        })
      )
      .subscribe({
        next: () => {
          this.showSuccess('Success', 'Group part deleted successfully');
          this.closeDeleteDialog();
          this.loadGroupParts();
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error:', error);
          this.showError('Delete Failed', error.error?.message || 'Failed to delete group part');
          this.isLoading = false;
        },
      });
  }
  // Modal methods
  showSuccess(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showSuccessModal = true;
  }
  showError(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showErrorModal = true;
  }
  closeSuccessModal(): void {
    this.showSuccessModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  closeErrorModal(): void {
    this.showErrorModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  // Table helper methods
  hasData(): boolean {
    return this.groupParts.length > 0;
  }
  hasDisplayData(): boolean {
    return this.filteredContent.length > 0;
  }
  getDisplayData(): GroupPart[] {
    if (this.searchTerm.trim()) {
      return this.filteredContent.slice(
        this.currentPage * this.itemsPerPage,
        (this.currentPage + 1) * this.itemsPerPage
      );
    }
    return this.groupParts.slice(
      this.currentPage * this.itemsPerPage,
      (this.currentPage + 1) * this.itemsPerPage
    );
  }
  getColspan(): number {
    return this.tableColumns.length + 2; // +1 for serial number, +1 for actions
  }
  getSerialNumber(index: number): number {
    return this.currentPage * this.itemsPerPage + index + 1;
  }
  getTotalDisplayItems(): number {
    if (this.searchTerm.trim()) {
      return this.filteredContent.length;
    }
    return this.totalElements;
  }
  getDisplayStart(): number {
    return this.currentPage * this.itemsPerPage + 1;
  }
  getDisplayEnd(): number {
    const calculatedEnd = (this.currentPage + 1) * this.itemsPerPage;
    const total = this.getTotalDisplayItems();
    return calculatedEnd > total ? total : calculatedEnd;
  }
  isFirstPage(): boolean {
    return this.currentPage === 0;
  }
  isLastPage(): boolean {
    const totalPages = Math.ceil(this.getTotalDisplayItems() / this.itemsPerPage);
    return this.currentPage >= totalPages - 1;
  }
  // Pagination methods
  get totalPages(): number {
    return Math.ceil(this.getTotalDisplayItems() / this.itemsPerPage);
  }
  goToPage(page: number): void {
    if (page >= 0 && page < this.totalPages) {
      this.currentPage = page;
    }
  }
  previousPage(): void {
    if (this.currentPage > 0) {
      this.currentPage--;
    }
  }
  nextPage(): void {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++;
    }
  }
  getPageNumbers(): number[] {
    const pages = [];
    const maxVisiblePages = 5;
    const totalPages = this.totalPages;
    if (totalPages <= maxVisiblePages) {
      for (let i = 0; i < totalPages; i++) {
        pages.push(i);
      }
    } else {
      let startPage = Math.max(
        0,
        this.currentPage - Math.floor(maxVisiblePages / 2)
      );
      let endPage = Math.min(totalPages - 1, startPage + maxVisiblePages - 1);
      if (endPage - startPage + 1 < maxVisiblePages) {
        startPage = Math.max(0, endPage - maxVisiblePages + 1);
      }
      for (let i = startPage; i <= endPage; i++) {
        pages.push(i);
      }
    }
    return pages;
  }
  getColumnDisplayName(column: string): string {
    const columnDisplayMap: { [key: string]: string } = {
      id:'Id',
      groupPartNumber: 'Group Part',
      childPartNumber: 'Child Part',
      quantity: 'Quantity',
      line: 'Line',
      zone: 'Zone',
      uploadTime: 'Upload Time',
      createdAt: 'Created At',
      updatedAt: 'Updated At'
    };
    return columnDisplayMap[column] || column;
  }
