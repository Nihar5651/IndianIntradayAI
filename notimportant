/**
 * Handles P2L + ESL side-effects when a VIN is forcefully completed
 * WHILE it was "in-kitting".
 *
 * NEW: For all affected P2L articles we also send a LED-OFF command
 * (duration = "0") so that the next light can glow.
 */
@Service
public class ForceKittingP2LHandler {

    private static final Logger log = LoggerFactory.getLogger(ForceKittingP2LHandler.class);

    @PersistenceContext
    private EntityManager entityManager;

    private final ExternalArticlePublisher externalArticlePublisher;
    private final ExternalEslLedPublisher externalEslLedPublisher;

    private static final String STATION_CODE = "100";

    // P2L endpoint (same as other LED API)
    @Value("${external.p2l.url:https://172.25.86.106:9002/labels/contents/led/article}")
    private String p2lEndpointUrl;

    // trust-all SSL like other external publishers
    private volatile RestTemplate restTemplate;
    private final ObjectMapper objectMapper = new ObjectMapper();
    private static final boolean TRUST_ALL_SSL = true;

    public ForceKittingP2LHandler(ExternalArticlePublisher externalArticlePublisher,
                                  ExternalEslLedPublisher externalEslLedPublisher) {
        this.externalArticlePublisher = externalArticlePublisher;
        this.externalEslLedPublisher = externalEslLedPublisher;
    }

    /**
     * Called from ForceKittingService ONLY for VINs that were in-kitting.
     */
    public void handleAfterForceCompleteInKitting(String line,
                                                  int zoneNumber,
                                                  String vin,
                                                  String vc,
                                                  String dsn,
                                                  String trolleyCode,
                                                  String color,
                                                  String operator) {

        if (vc == null || trolleyCode == null || color == null) {
            log.warn("ForceKittingP2LHandler: missing vc/trolley/color for VIN={} line={} zone={}",
                    vin, line, zoneNumber);
        }

        try {
            int updated = simulateMissingP2LAcksAndTurnOff(vc, trolleyCode, color);
            log.info("ForceKittingP2LHandler: simulated P2L acks for VIN={} vc={} trolley={} color={} -> {} rows updated",
                    vin, vc, trolleyCode, color, updated);
        } catch (Exception ex) {
            log.error("ForceKittingP2LHandler: error while simulating P2L acks for VIN={} : {}",
                    vin, ex.getMessage(), ex);
        }

        try {
            sendEslStatusAndLedOff(line, zoneNumber, vin, vc, dsn, trolleyCode, color);
        } catch (Exception ex) {
            log.error("ForceKittingP2LHandler: ESL status/LED calls failed for VIN={} trolley={} : {}",
                    vin, trolleyCode, ex.getMessage(), ex);
        }
    }

    /**
     * Simulate missing P2L acks and ALSO send LED-OFF (duration=0) to P2L
     * for all pending articles of this VC/trolley/color.
     */
    @SuppressWarnings("unchecked")
    private int simulateMissingP2LAcksAndTurnOff(String vc, String trolleyCode, String color) {
        if (vc == null || trolleyCode == null || color == null) {
            return 0;
        }

        String selectSql = """
                SELECT id, mac_address, article_id, status, request_picking_date, picking_date
                FROM mac_pick_queue
                WHERE vc = :vc
                  AND trolley_code = :trolley
                  AND color = :color
                  AND status IN ('QUEUED','WAITING_BLINK','WAITING_PICK')
                FOR UPDATE
                """;

        Query q = entityManager.createNativeQuery(selectSql);
        q.setParameter("vc", vc);
        q.setParameter("trolley", trolleyCode);
        q.setParameter("color", color);
        List<Object[]> rows = q.getResultList();

        if (rows.isEmpty()) {
            log.info("ForceKittingP2LHandler: no pending mac_pick_queue rows for vc={} trolley={} color={}",
                    vc, trolleyCode, color);
            return 0;
        }

        Timestamp nowTs = Timestamp.from(Instant.now());
        long nowEpoch = nowTs.getTime();

        int updatedCount = 0;
        // collect all articleIds whose LEDs must be turned OFF
        Set<String> articlesToTurnOff = new LinkedHashSet<>();

        for (Object[] r : rows) {
            Number idNum = (Number) r[0];
            Long id = (idNum == null) ? null : idNum.longValue();
            String mac = r[1] == null ? null : r[1].toString();
            String articleId = r[2] == null ? null : r[2].toString();
            String status = r[3] == null ? null : r[3].toString();
            Number reqPickNum = (Number) r[4];
            Number pickDateNum = (Number) r[5];

            long requestPickEpoch = (reqPickNum == null) ? nowEpoch : reqPickNum.longValue();
            long pickingEpoch = (pickDateNum == null) ? nowEpoch : pickDateNum.longValue();

            articlesToTurnOff.add(articleId);

            insertSseEvent(mac, "BLINK_STATUS",
                    (status == null || "QUEUED".equals(status) || "WAITING_BLINK".equals(status))
                            ? "BLINK_SUCCESS" : "BLINK_SUCCESS",
                    color, requestPickEpoch, pickingEpoch);

            insertSseEvent(mac, "PICKING_STATUS",
                    "PICKED",
                    color, requestPickEpoch, pickingEpoch);

            String updSql = """
                    UPDATE mac_pick_queue
                    SET status = 'PICKED',
                        picking_date = :pickEpoch,
                        attempts = COALESCE(attempts,0) + 1,
                        last_attempt_at = :now,
                        updated_at = :now
                    WHERE id = :id
                    """;
            Query uq = entityManager.createNativeQuery(updSql);
            uq.setParameter("pickEpoch", pickingEpoch);
            uq.setParameter("now", nowTs);
            uq.setParameter("id", id);
            updatedCount += uq.executeUpdate();
        }

        // 🔴 NEW: explicitly turn OFF LEDs for these articles on the P2Ls
        try {
            sendP2LLedOff(new ArrayList<>(articlesToTurnOff), color);
        } catch (Exception ex) {
            log.error("ForceKittingP2LHandler: failed to send P2L LED-OFF for vc={} trolley={} color={} : {}",
                    vc, trolleyCode, color, ex.getMessage(), ex);
        }

        return updatedCount;
    }

    private void insertSseEvent(String mac,
                                String event,
                                String pickingLinkStatus,
                                String color,
                                long requestPickingDate,
                                long pickingDate) {
        if (mac == null) return;

        String rawJson = "{\"source\":\"FORCE_KITTING\"}";

        String insertSql = """
                INSERT INTO sse_pick_events
                    (sse_id, event, station_code, mac_address,
                     picking_link_status, led_color,
                     request_picking_date, picking_date, raw_data)
                VALUES
                    (:sseId, :event, :station, :mac,
                     :pls, :color,
                     :reqDate, :pickDate, cast(:raw as jsonb))
                """;

        Query iq = entityManager.createNativeQuery(insertSql);
        iq.setParameter("sseId", UUID.randomUUID().toString());
        iq.setParameter("event", event);
        iq.setParameter("station", STATION_CODE);
        iq.setParameter("mac", mac);
        iq.setParameter("pls", pickingLinkStatus);
        iq.setParameter("color", color);
        iq.setParameter("reqDate", requestPickingDate);
        iq.setParameter("pickDate", pickingDate);
        iq.setParameter("raw", rawJson);
        iq.executeUpdate();
    }

    /**
     * Turn OFF LEDs on P2L for given articleIds by sending duration = "0".
     */
    private void sendP2LLedOff(List<String> articleIds, String color) {
        if (articleIds == null || articleIds.isEmpty() || color == null) {
            return;
        }

        List<Map<String, Object>> payload = new ArrayList<>();
        for (String articleId : articleIds) {
            if (articleId == null || articleId.isBlank()) continue;

            Map<String, Object> item = new LinkedHashMap<>();
            item.put("color", color);
            item.put("duration", "0");
            item.put("patternId", 1);
            item.put("stationCode", STATION_CODE);
            item.put("articleId", articleId);
            payload.add(item);
        }

        if (payload.isEmpty()) return;

        String jsonBody = toJson(payload);

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
        headers.setAccept(List.of(MediaType.valueOf("application/json;charset=UTF-8")));

        HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);

        log.info("▶️ P2L LED-OFF PUT {} body={}", p2lEndpointUrl, jsonBody);
        try {
            ResponseEntity<String> resp =
                    getClient().exchange(p2lEndpointUrl, HttpMethod.PUT, entity, String.class);
            log.info("◀️ P2L LED-OFF status={} body={}",
                    resp.getStatusCode().value(),
                    resp.getBody() == null ? "<empty>" : resp.getBody());
        } catch (RestClientException ex) {
            log.error("❌ P2L LED-OFF error: {}", ex.getMessage(), ex);
        }
    }

    /**
     * Sends ESL status = COMPLETE and turns off ESL LED for this trolley.
     */
    private void sendEslStatusAndLedOff(String line,
                                        int zoneNumber,
                                        String vin,
                                        String vc,
                                        String dsn,
                                        String trolleyCode,
                                        String color) {

        if (trolleyCode == null) {
            log.warn("ForceKittingP2LHandler: trolleyCode is null, skipping ESL calls.");
            return;
        }

        String modelText = "";
        String sapColor = "";
        if (vc != null) {
            try {
                String vcSql = """
                        SELECT model, colortosap
                        FROM vc_details
                        WHERE TRIM(vc) = TRIM(:vc)
                        LIMIT 1
                        """;
                Query vq = entityManager.createNativeQuery(vcSql);
                vq.setParameter("vc", vc);
                @SuppressWarnings("unchecked")
                List<Object[]> vrows = vq.getResultList();
                if (!vrows.isEmpty()) {
                    Object[] vr = vrows.get(0);
                    if (vr[0] != null) modelText = vr[0].toString();
                    if (vr[1] != null) sapColor = vr[1].toString();
                }
            } catch (Exception ex) {
                log.warn("ForceKittingP2LHandler: failed to fetch vc_details for vc={} : {}",
                        vc, ex.getMessage());
            }
        }

        String lineZoneLabel = line + " ZONE" + zoneNumber;
        String status = "COMPLETE";

        try {
            externalArticlePublisher.publish(
                    trolleyCode,
                    vin,
                    vc,
                    modelText,
                    color != null ? color : "",
                    sapColor,
                    lineZoneLabel,
                    status,
                    dsn
            );
            log.info("ForceKittingP2LHandler: ESL status COMPLETE sent for trolley={} vin={} vc={}",
                    trolleyCode, vin, vc);
        } catch (Exception ex) {
            log.error("ForceKittingP2LHandler: ESL status COMPLETE failed for trolley={} : {}",
                    trolleyCode, ex.getMessage(), ex);
        }

        try {
            externalEslLedPublisher.publishLed(trolleyCode, color, "100");
            log.info("ForceKittingP2LHandler: ESL LED OFF published for trolley={} color={}",
                    trolleyCode, color);
        } catch (Exception ex) {
            log.error("ForceKittingP2LHandler: ESL LED OFF failed for trolley={} : {}",
                    trolleyCode, ex.getMessage(), ex);
        }
    }

    // ---------- RestTemplate (trust-all SSL) ----------

    private RestTemplate getClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;

            if (!TRUST_ALL_SSL) {
                restTemplate = new RestTemplate();
                return restTemplate;
            }

            try {
                var sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);
                log.warn("ForceKittingP2LHandler: INSECURE SSL ENABLED (trust-all + no hostname verification).");
            } catch (Exception e) {
                log.error("ForceKittingP2LHandler: Failed to build insecure SSL client. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private String toJson(Object o) {
        try {
            return objectMapper.writeValueAsString(o);
        } catch (JsonProcessingException e) {
            log.warn("ForceKittingP2LHandler: JSON serialization failed, falling back to toString(): {}", e.getMessage());
            return String.valueOf(o);
        }
    }
}
