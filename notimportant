<div class="top-header">
  <span class="home-link" routerLink="/main-dashboard">
    Home <span class="chevron-right"> &gt; </span>
  </span>
  <span class="active-link">Deki Master Upload</span>
</div>
<div class="dispatch-container">
  <div class="header-section">
    <div class="header-title">
      <h2>Deki Master Data Synchronization</h2>
    </div>
    <div class="action-container">
      <div class="search-container">
        <input
          type="text"
          [(ngModel)]="searchTerm"
          (input)="onSearch()"
          placeholder="Please enter a minimum of 3 characters"
          class="search-input"
        />
        <button (click)="onSearch()" class="search-btn">Search</button>
        <button (click)="exportToExcel()" class="export-btn" [disabled]="filteredPartDetails.length === 0">
          Export Excel
        </button>
      </div>
      <div class="upload-section">
        <input
          type="file"
          id="excelFile"
          (change)="onFileSelected($event)"
          accept=".xlsx,.xls"
          style="display: none"
          #fileInput
        />
        <label for="excelFile" class="upload-btn" [class.disabled]="isUploading">
          <span *ngIf="isUploading" class="toggle-spinner"></span>
          {{ isUploading ? 'Processing Upload...' : 'Upload Deki Excel' }}
        </label>
      </div>
    </div>
  </div>
  <div *ngIf="hasActiveFilters()" class="filter-clear-section">
    <button (click)="clearAllFilters()" class="clear-all-filters-btn">
      Clear All Filters
    </button>
  </div>
  <div *ngIf="isGridLoading" class="loading-section">
    <div class="spinner"></div>
    <span>Loading grid data...</span>
  </div>
  <div *ngIf="!isGridLoading" class="table-section">
    <div class="table-container">
      <table class="vc-table">
        <thead>
          <tr>
            <th class="table-header text-center">Sr. No.</th>
            <th class="table-header">Article ID</th>
            <th class="table-header">MAC Address</th>
            <th class="table-header">Part Number</th>
            <th class="table-header">Part Description</th>
            <th *ngFor="let col of filterableColumns" class="table-header">
              <div class="column-header-container">
                <span>{{ col.label }}</span>
                <span class="filter-icon" (click)="toggleFilterDropdown(col.key, $event)" [class.active]="isFilterActive(col.key)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                  </svg>
                </span>
              </div>
              <div *ngIf="showFilterDropdown && activeFilterColumn === col.key" class="filter-dropdown" (click)="$event.stopPropagation()">
                <div class="filter-options">
                  <label *ngFor="let option of filterOptions[col.key]" class="filter-option">
                    <input type="checkbox" [value]="option" [checked]="getSelectedFiltersForColumn(col.key).includes(option)" (change)="onFilterChange(col.key, option, $event)"/>
                    <span class="checkmark"></span>
                    {{ option }}
                  </label>
                </div>
                <div class="filter-actions">
                  <button class="clear-filter-btn" (click)="clearFilter(col.key, $event)">Clear</button>
                </div>
              </div>
            </th>
            <th class="table-header">Rack</th>
            <th class="table-header">Row</th>
            <th class="table-header">Column</th>
          </tr>
        </thead>
        <tbody>
          <tr *ngFor="let item of paginatedItems; let i = index" class="table-row">
            <td class="table-cell text-center">{{ getSerialNumber(i) }}</td>
            <td class="table-cell font-weight-bold">{{ item.articleId }}</td>
            <td class="table-cell font-weight-bold" style="color: #007bff;">{{ item.macAddress }}</td>
            <td class="table-cell font-weight-bold">{{ item.partNumber || 'NA' }}</td>
            <td class="table-cell">{{ item.partDescription }}</td>
            <td class="table-cell">{{ item.type }}</td>
            <td class="table-cell">{{ item.isActive }}</td>
            <td class="table-cell">{{ item.line }}</td>
            <td class="table-cell">{{ item.zone }}</td>
            <td class="table-cell">{{ item.rack || 'NA' }}</td>
            <td class="table-cell">{{ item.rowNo || 'NA' }}</td>
            <td class="table-cell">{{ item.columnNo || 'NA' }}</td>
          </tr>
          <tr *ngIf="filteredPartDetails.length === 0">
            <td colspan="12" class="no-data">No data available</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div *ngIf="totalItems > 0 && !isGridLoading" class="pagination-section">
    <div class="pagination-info">
      Showing {{ (currentPage - 1) * itemsPerPage + 1 }} to {{ minimum(currentPage * itemsPerPage, totalItems) }} of {{ totalItems }} entries
    </div>
    <div class="pagination-controls">
      <button (click)="previousPage()" [disabled]="currentPage === 1" class="pagination-btn">Previous</button>
      <div class="page-numbers">
        <button *ngFor="let page of getPageNumbers()" (click)="goToPage(page)" [class.active]="page === currentPage" class="page-btn">
          {{ page }}
        </button>
      </div>
      <button (click)="nextPage()" [disabled]="currentPage === totalPages" class="pagination-btn">Next</button>
    </div>
  </div>
  <div *ngIf="isUploading" class="modal-overlay">
    <div class="loading-card">
      <div class="spinner"></div>
      <span style="margin-left: 15px; font-weight: bold;">Synchronizing master data...</span>
    </div>
  </div>
  <div *ngIf="showSuccessModal" class="modal-overlay" (click)="closeSuccessModal()">
    <div class="modal-content" (click)="$event.stopPropagation()">
      <div class="modal-header success-header">
        <h3 class="modal-title">{{ modalTitle }}</h3>
        <button class="modal-close-btn" (click)="closeSuccessModal()">&times;</button>
      </div>
      <div class="modal-body">
        <div class="modal-icon success-icon">✓</div>
        <p class="modal-message" style="font-weight: 500;">{{ modalMessage }}</p>
      </div>
      <div class="modal-footer">
        <button class="modal-btn success-btn" (click)="closeSuccessModal()">OK</button>
      </div>
    </div>
  </div>
  <div *ngIf="showErrorModal" class="modal-overlay" (click)="closeErrorModal()">
    <div class="modal-content error-modal-content" (click)="$event.stopPropagation()">
      <div class="modal-header error-header">
        <h3 class="modal-title">{{ modalTitle }}</h3>
        <button class="modal-close-btn" (click)="closeErrorModal()">&times;</button>
      </div>
      <div class="modal-body error-modal-body">
        <div class="modal-icon error-icon">⚠</div>
        <div class="error-message-container">
          <p class="modal-message">{{ modalMessage }}</p>
          <div *ngIf="violationsList && violationsList.length > 0" class="violations-container">
            <h4>Validation Errors:</h4>
            <ul class="violations-list">
              <li *ngFor="let violation of violationsList">{{ violation }}</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="modal-btn error-btn" (click)="closeErrorModal()">Close</button>
      </div>
    </div>
  </div>
</div>/* deki-master-upload.component.scss */
