    private Vehicle fetchNextAvailableVehicle(String line, String zoneNumber) {
        String table = KITTING_TABLES.get(line);
        String reserveCol  = getDynamicZoneFlag("isreservedzone", zoneNumber);
        String processCol  = getDynamicZoneFlag("isprocessedzone", zoneNumber);

        String orderBy = "id";
        if ("2".equals(zoneNumber) && TWO_ZONE_LINES.contains(line)) orderBy = "idz2";

        // 🔥 MODIFIED: Added 'id' to SELECT query to pass it to the Vehicle record
        String sql = String.format(
                "SELECT id, vinnumber, vcnumber, dsn FROM %s " +
                        "WHERE %s = false AND %s = false " +
                        "AND vinnumber NOT IN (SELECT vinnumber FROM vin_hold_status WHERE is_hold = true) " +
                        "ORDER BY %s ASC LIMIT 1 FOR UPDATE SKIP LOCKED",
                table, reserveCol, processCol, orderBy
        );

        List<Object[]> list = entityManager.createNativeQuery(sql).getResultList();
        if (list.isEmpty()) return null;

        String currentZone = "Z" + zoneNumber;

        for (Object[] r : list) {
            // 🔥 MODIFIED: Extracting ID and updating array indices
            Long id = ((Number) r[0]).longValue();
            String vin = r[1].toString();

            // Dependency logic seamlessly integrated
            if (!isPreviousZoneCompleted(line, currentZone, vin)) {
                String prevZone = LINE_ZONE_ORDER.get(line).get(LINE_ZONE_ORDER.get(line).indexOf(currentZone) - 1);
                throw new IllegalStateException(
                        "Complete " + prevZone + " first before proceeding to " + currentZone + " for VIN " + vin
                );
            }

            return new Vehicle(
                    id, // 🔥 MODIFIED: Passing ID to record
                    vin,
                    r[2] == null ? null : r[2].toString(),
                    r[3] == null ? null : r[3].toString()
            );
        }

        return null;
    }

