  }
  // Pagination methods
  get paginatedItems(): PartDetail[] {
    const startIndex = (this.currentPage - 1) * this.itemsPerPage;
    return this.filteredPartDetails.slice(
      startIndex,
      startIndex + this.itemsPerPage
    );
  }
  get totalPages(): number {
    return Math.ceil(this.totalItems / this.itemsPerPage);
  }
  getPageNumbers(): number[] {
    const pages = [];
    const maxVisiblePages = 5;
    let startPage = Math.max(
      1,
      this.currentPage - Math.floor(maxVisiblePages / 2)
    );
    let endPage = Math.min(this.totalPages, startPage + maxVisiblePages - 1);
    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }
    for (let i = startPage; i <= endPage; i++) {
      pages.push(i);
    }
    return pages;
  }
  goToPage(page: number): void {
    if (page >= 1 && page <= this.totalPages) {
      this.currentPage = page;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  previousPage(): void {
    if (this.currentPage > 1) {
      this.currentPage--;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  nextPage(): void {
    if (this.currentPage < this.totalPages) {
      this.currentPage++;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  getSerialNumber(index: number): number {
    return (this.currentPage - 1) * this.itemsPerPage + index + 1;
  }
  minimum(a: number, b: number): number {
    return Math.min(a, b);
  }
  // Utility methods
  formatTimestamp(timestamp: any): string {
    if (!timestamp) return '';
    try {
      const date = new Date(timestamp);
      return date.toLocaleString('en-US', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true
      });
    } catch (error) {
      return String(timestamp);
    }
  }
  getColumnDisplayName(column: string): string {
    const displayNames: { [key: string]: string } = {
      partNumber: 'Part Number',
      partDescription: 'Part Description',
      type: 'Type',
      line: 'Line',
      zone: 'Zone',
      rack: 'Rack',
      rowNo: 'Row No',
      columnNo: 'Column No',
      uploadTimestamp: 'Upload Timestamp',
      uploadedBy: 'Uploaded By',
      isActive: 'Status'
    };
    return displayNames[column] || column.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase());
  }
  getColumnWidth(column: string): string {
    if (this.columnWidths[column]) {
      return this.columnWidths[column];
    }
    const defaultWidths: { [key: string]: string } = {
      partNumber: '150px',
      partDescription: '200px',
      type: '100px',
      line: '80px',
      zone: '80px',
      rack: '80px',
      rowNo: '80px',
      columnNo: '100px',
      uploadTimestamp: '180px',
      uploadedBy: '120px',
      isActive: '100px'
    };
    return defaultWidths[column] || '120px';
  }
  calculateColumnWidths(): void {
    if (!this.dataTable?.nativeElement) return;
    const table = this.dataTable.nativeElement;
    const headers = table.querySelectorAll('thead th');
    const newWidths: { [key: string]: string } = {};
    headers.forEach((header: HTMLElement, index: number) => {
      if (index === 0) {
        newWidths['serial'] = '80px';
        return;
      }
      if (index === headers.length - 1) {
        newWidths['actions'] = '120px';
        return;
      }
      const columnName = this.tableColumns[index - 1];
      if (columnName) {
        const contentWidth = header.scrollWidth;
        const minWidth = this.getColumnWidth(columnName);
        const calculatedWidth = Math.max(contentWidth, parseInt(minWidth)) + 'px';
        newWidths[columnName] = calculatedWidth;
      }
    });
    this.columnWidths = { ...this.columnWidths, ...newWidths };
  }
