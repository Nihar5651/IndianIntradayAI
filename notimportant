  constructor(private authService: AuthService, private toastr: ToastrService, private dialog: MatDialog) {}
  ngOnInit(): void {
    this.updateCurrentTime();
    setInterval(() => this.updateCurrentTime(), 1000);
    this.lineZones.forEach((z) => {
      const key = this.getKey(z.line, z.zone);
      this.dataSources[key] = new MatTableDataSource<Kit>();
      this.dataSources[key].filterPredicate = this.createFilter();
      this.counts[key] = { inProgressCount: 0, upcomingCount: 0, completedCount: 0 };
      this.loadDataForZone(z.line, z.zone);
    });
    if (this.lineZones.length > 0) {
      this.currentLine = this.lineZones[0].line;
      this.currentZone = this.lineZones[0].zone;
