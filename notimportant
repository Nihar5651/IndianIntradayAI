import com.kitting.integration.ExternalPickToLightPublisher;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import jakarta.persistence.EntityManager;
import jakarta.persistence.Query;
import java.time.Instant;
import java.util.List;

/**
 * Handles PICKING_STATUS events.
 *
 * After marking the current WAITING_BLINK row as PICKED, this service:
 *  - Attempts kitting completion.
 *  - Then finds the next job for the SAME MAC (FIFO) and triggers its P2L blink.
 */
@Service
public class PickToLightPickService {

    private static final Logger log = LoggerFactory.getLogger(PickToLightPickService.class);

    private final EntityManager entityManager;
    private final ExternalPickToLightPublisher p2lPublisher;
    private final KittingCompletionService kittingCompletionService;
    private final TrolleyDsnAllotmentService trolleyDsnAllotmentService;
    private final P2LAsyncWorker p2lAsyncWorker;

    public PickToLightPickService(EntityManager entityManager,
                                  ExternalPickToLightPublisher p2lPublisher,
                                  KittingCompletionService kittingCompletionService,
                                  TrolleyDsnAllotmentService trolleyDsnAllotmentService,
                                  P2LAsyncWorker p2lAsyncWorker) {
        this.entityManager = entityManager;
        this.p2lPublisher = p2lPublisher;
        this.kittingCompletionService = kittingCompletionService;
        this.trolleyDsnAllotmentService = trolleyDsnAllotmentService;
        this.p2lAsyncWorker = p2lAsyncWorker;
    }

    /**
     * Handle a PICKING_STATUS for the given mac (normalized MAC expected).
     *
     * This method is transactional and concurrency-safe.
     *
     * @param macAddress normalized mac (e.g. uppercase, no separators)
     */
    @Transactional(rollbackFor = Exception.class)
    public void handlePicking(String macAddress) {
        if (macAddress == null || macAddress.isBlank()) {
            log.warn("handlePicking called with empty mac - ignoring");
            return;
        }

        try {
            // 1) Find current WAITING_BLINK row for this mac (lock it)
            String findCurrentSql =
                    "SELECT id, article_id, vc, line, zone, trolley_code, color " +
                            "FROM mac_pick_queue " +
                            "WHERE mac_address = :mac AND status = 'WAITING_BLINK' " +
                            "ORDER BY created_at ASC " +
                            "LIMIT 1 FOR UPDATE";

            @SuppressWarnings("unchecked")
            List<Object[]> currentRows = entityManager.createNativeQuery(findCurrentSql)
                    .setParameter("mac", macAddress)
                    .getResultList();

            if (currentRows.isEmpty()) {
                log.info("PICKING_STATUS for mac {}: no mac_pick_queue row with status=WAITING_BLINK found. Ignoring.", macAddress);
                return;
            }

            Object[] cur = currentRows.get(0);
            Number curId = (Number) cur[0];
            String articleId = cur[1] == null ? null : cur[1].toString();
            String vc = cur[2] == null ? null : cur[2].toString();
            String line = cur[3] == null ? null : cur[3].toString();
            String zone = cur[4] == null ? null : cur[4].toString();
            String trolleyCode = cur[5] == null ? null : cur[5].toString();
            String curColor = cur[6] == null ? null : cur[6].toString();

            log.info("Picking: marking mac_pick_queue id={} (mac={}) as PICKED (article={}, vc={}, line={}, zone={}, trolley={})",
                    curId, macAddress, articleId, vc, line, zone, trolleyCode);

            // 2) Mark current as PICKED and set picking_date (epoch millis) + updated_at
            long pickingMillis = Instant.now().toEpochMilli();
            String updatePickedSql = "UPDATE mac_pick_queue " +
                    "SET status = 'PICKED', picking_date = :pickingMillis, updated_at = now() " +
                    "WHERE id = :id";
            entityManager.createNativeQuery(updatePickedSql)
                    .setParameter("pickingMillis", pickingMillis)
                    .setParameter("id", curId.longValue())
                    .executeUpdate();

            // 3) Determine zone number string "1" or "2"
            String zoneNumber = "1";
            if (zone != null && zone.matches(".*\\d+.*")) {
                zoneNumber = zone.replaceAll("[^0-9]", "");
                if (zoneNumber.isBlank()) zoneNumber = "1";
            }

            boolean completed;
            try {
                completed = kittingCompletionService.attemptCompletion(line, zoneNumber, trolleyCode, curColor, vc);
            } catch (Exception ex) {
                log.error("Error while checking/completing kitting for mac_pick_queue id={} : {}",
                        curId, ex.getMessage(), ex);
                completed = false;
            }

            if (completed) {
                // free in-memory color to make it available for future allocations
                try {
                    trolleyDsnAllotmentService.freeLed(line, "Z" + zoneNumber, curColor);
                    log.info("Freed in-memory LED color (line={}, zone=Z{} , color={}) after kitting completion.",
                            line, zoneNumber, curColor);
                } catch (Exception ex) {
                    log.warn("Failed to free in-memory LED color after DB completion: {}", ex.getMessage());
                }
            }

            // 4) Find next candidate FOR THE SAME MAC (FIFO across all VCs/trolleys)
            String findNextSql =
                    "SELECT id, mac_address, article_id, vc, line, zone, trolley_code, color " +
                            "FROM mac_pick_queue " +
                            "WHERE mac_address = :mac " +
                            "  AND status IN ('QUEUED','PENDING') " +
                            "ORDER BY created_at ASC " +
                            "LIMIT 1 FOR UPDATE SKIP LOCKED";

            @SuppressWarnings("unchecked")
            List<Object[]> nextRows = entityManager.createNativeQuery(findNextSql)
                    .setParameter("mac", macAddress)
                    .getResultList();

            if (nextRows.isEmpty()) {
                log.debug("No next candidate found for mac={} after pick of article={} (vc={}, line={}, zone={})",
                        macAddress, articleId, vc, line, zone);
                return;
            }

            Object[] next = nextRows.get(0);
            Number nextId = (Number) next[0];
            String nextMac = next[1] == null ? null : next[1].toString();
            String nextArticle = next[2] == null ? null : next[2].toString();
            String nextVc = next[3] == null ? null : next[3].toString();
            String nextLine = next[4] == null ? null : next[4].toString();
            String nextZone = next[5] == null ? null : next[5].toString();
            String nextTrolley = next[6] == null ? null : next[6].toString();
            String nextColor = next[7] == null ? null : next[7].toString();

            // 5) Atomically claim the candidate by setting status = 'WAITING_BLINK' and update updated_at
            String claimSql = "UPDATE mac_pick_queue " +
                    "SET status = 'WAITING_BLINK', updated_at = now() " +
                    "WHERE id = :id AND status IN ('QUEUED','PENDING')";
            int updated = entityManager.createNativeQuery(claimSql)
                    .setParameter("id", nextId.longValue())
                    .executeUpdate();

            if (updated != 1) {
                log.info("Candidate id={} for mac={} was already claimed by another worker.",
                        nextId, nextMac);
                return;
            }

            log.info("Claimed next candidate id={} (mac={}) -> sending P2L blink with color={} for article={} vc={} line={} zone={} trolley={}",
                    nextId, nextMac, nextColor, nextArticle, nextVc, nextLine, nextZone, nextTrolley);

            // 6) Trigger LED for the claimed candidate (single article)
            // 6) Trigger LED for the claimed candidate (single article)
            try {
                // ✅ PHASE 3 CORE FIX: Hand the task to the queue instead of waiting for the hardware
                p2lAsyncWorker.queueBlinkTask(List.of(nextArticle), nextColor);
                log.info("P2L blink queued for mac={} (article={}) color={}", nextMac, nextArticle, nextColor);
            } catch (Exception ex) {
                log.error("Failed to queue P2L blink for claimed candidate id={} (mac={}, article={}) - reverting status. error={}",
                        nextId, nextMac, nextArticle, ex.getMessage(), ex);
                String revertSql = "UPDATE mac_pick_queue SET status = 'QUEUED', updated_at = now() WHERE id = :id";
                entityManager.createNativeQuery(revertSql)
                        .setParameter("id", nextId.longValue())
                        .executeUpdate();
                throw ex;
            }

            // success -> status remains WAITING_BLINK and transaction commits
        } catch (Exception e) {
            log.error("Error in handlePicking for mac {}: {}", macAddress, e.getMessage(), e);
            throw e;
        }
    }

    /**
     * ✅ PHASE 2 CORE FIX: The Exponential Backoff Hardware Failure Handler
     * Handles BLINK_FAIL events. Retries with escalating delays (200ms -> 500ms -> 1000ms).
     * If all 3 retries fail, it auto-bypasses the broken light to keep the line moving.
     */
    @Transactional(rollbackFor = Exception.class)
    public void handleBlinkFail(String macAddress) {
        if (macAddress == null || macAddress.isBlank()) return;

        try {
            // 1) Find the currently stuck row
            String findCurrentSql =
                    "SELECT id, article_id, color, attempts " +
                            "FROM mac_pick_queue " +
                            "WHERE mac_address = :mac AND status = 'WAITING_BLINK' " +
                            "ORDER BY created_at ASC LIMIT 1 FOR UPDATE";

            @SuppressWarnings("unchecked")
            List<Object[]> currentRows = entityManager.createNativeQuery(findCurrentSql)
                    .setParameter("mac", macAddress)
                    .getResultList();

            if (currentRows.isEmpty()) {
                log.info("BLINK_FAIL for mac {}: no row in WAITING_BLINK found. Ignoring.", macAddress);
                return;
            }

            Object[] cur = currentRows.get(0);
            Number curId = (Number) cur[0];
            String articleId = cur[1] == null ? null : cur[1].toString();
            String color = cur[2] == null ? null : cur[2].toString();
            int attempts = cur[3] == null ? 1 : ((Number) cur[3]).intValue();

            // Attempt Logic:
            // Original send sets attempts = 1.
            if (attempts == 1) {
                log.warn("Hardware BLINK_FAIL on MAC {} (Article: {}). Strike 1 of 3. Letting RF hardware reset. Retrying in 200ms...", macAddress, articleId);
                triggerRetry(curId.longValue(), articleId, color, 200);
            }
            else if (attempts == 2) {
                log.warn("Hardware BLINK_FAIL on MAC {} (Article: {}). Strike 2 of 3. Possible network congestion. Retrying in 500ms...", macAddress, articleId);
                triggerRetry(curId.longValue(), articleId, color, 500);
            }
            else if (attempts == 3) {
                log.warn("Hardware BLINK_FAIL on MAC {} (Article: {}). Strike 3 of 3. Final attempt before bypass. Retrying in 1000ms...", macAddress, articleId);
                triggerRetry(curId.longValue(), articleId, color, 1000);
            }
            else {
                // Strike 4 (Failed 3 retries)
                log.error("🚨 CRITICAL HARDWARE ERROR: MAC {} failed to blink after 3 retries. The physical light bulb or controller is unresponsive.", macAddress);
                log.info("🚀 Auto-Bypassing broken MAC {}. Simulating pick success to unblock the assembly line.", macAddress);

                // Auto-Bypass: Force the system to close the task and move to the next trolley
                this.handlePicking(macAddress);
            }

        } catch (Exception e) {
            log.error("Error in handleBlinkFail for mac {}: {}", macAddress, e.getMessage(), e);
            throw e;
        }
    }

    /**
     * Helper method to execute the DB update, thread sleep, and P2L publish safely.
     */
    private void triggerRetry(long id, String articleId, String color, long delayMs) {
        // Increment attempt counter in DB
        entityManager.createNativeQuery("UPDATE mac_pick_queue SET attempts = attempts + 1, updated_at = now() WHERE id = :id")
                .setParameter("id", id)
                .executeUpdate();

        // Pause thread for the specified backoff delay
        try {
            Thread.sleep(delayMs);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }

        // Fire the exact same light command again
        p2lPublisher.publishPickToLights(List.of(articleId), color);
    }
}
package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

/**
 * Small helper bean that performs the DB 'claim' operation inside a real transactional proxy.
 * This avoids self-invocation problems and provides a small CandidateRow DTO that callers can use.
 */
@Service
public class QuantityClaimService {

    private static final Logger log = LoggerFactory.getLogger(QuantityClaimService.class);
    private final EntityManager em;

    public QuantityClaimService(EntityManager em) {
        this.em = em;
    }

    /**
     * DTO returned by claimWaitingBlink.
     */
    public static class CandidateRow {
        public long id;
        public String macAddress;
        public String articleId;
        public String vc;
        public String line;
        public String zone;
        public String trolleyCode;
        public String status;
        public String createdAt;

        @Override
        public String toString() {
            return "CandidateRow{" +
                    "id=" + id +
                    ", macAddress='" + macAddress + '\'' +
                    ", articleId='" + articleId + '\'' +
                    ", vc='" + vc + '\'' +
                    ", line='" + line + '\'' +
                    ", zone='" + zone + '\'' +
                    ", trolleyCode='" + trolleyCode + '\'' +
                    ", status='" + status + '\'' +
                    ", createdAt='" + createdAt + '\'' +
                    '}';
        }
    }

    /**
     * Claim the earliest WAITING_BLINK row for the given mac (locks the row).
     * Returns a CandidateRow or null if none found.
     */
    @Transactional
    public CandidateRow claimWaitingBlink(String mac) {
        String sql = "SELECT id, mac_address, article_id, vc, line, zone, trolley_code, status, created_at " +
                "FROM mac_pick_queue " +
                "WHERE mac_address = :mac AND status = 'WAITING_BLINK' " +
                "ORDER BY created_at ASC LIMIT 1 FOR UPDATE SKIP LOCKED";

        Query q = em.createNativeQuery(sql);
        q.setParameter("mac", mac);
        @SuppressWarnings("unchecked")
        List<Object[]> rows = q.getResultList();
        if (rows.isEmpty()) return null;

        Object[] r = rows.get(0);
        CandidateRow c = new CandidateRow();
        c.id = ((Number) r[0]).longValue();
        c.macAddress = r[1] == null ? null : r[1].toString();
        c.articleId = r[2] == null ? null : r[2].toString();
        c.vc = r[3] == null ? null : r[3].toString();
        c.line = r[4] == null ? null : r[4].toString();
        c.zone = r[5] == null ? null : r[5].toString();
        c.trolleyCode = r[6] == null ? null : r[6].toString();
        c.status = r[7] == null ? null : r[7].toString();
        c.createdAt = r[8] == null ? null : r[8].toString();

        // update last_attempt_at and increment attempts in same transaction
        try {
            Query u = em.createNativeQuery("UPDATE mac_pick_queue SET last_attempt_at = now(), attempts = COALESCE(attempts,0) + 1, updated_at = now() WHERE id = :id");
            u.setParameter("id", c.id);
            u.executeUpdate();
        } catch (Exception ex) {
            log.warn("Failed to update last_attempt_at/attempts for mac_pick_queue id={}: {}", c.id, ex.getMessage());
        }

        return c;
    }

    /**
     * Mark mac_pick_queue row as quantity update success (sets flags + timestamps).
     */
    @Transactional
    public void markQueueQuantitySuccess(long queueId) {
        Query q = em.createNativeQuery(
                "UPDATE mac_pick_queue SET quantity_update_attempted = true, quantity_update_success_at = now(), last_attempt_at = now(), updated_at = now() WHERE id = :id");
        q.setParameter("id", queueId);
        q.executeUpdate();
    }
}

