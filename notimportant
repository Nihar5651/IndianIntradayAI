  onFileSelected(event: any): void {
    const file: File = event.target.files[0];
    if (!file) return;
    // Check if file is Excel format
    if (!file.name.match(/\.(xlsx|xls)$/i)) {
      this.showError('File Format Error', 'Please upload a valid Excel file');
      event.target.value = "";
      return;
    }
    this.uploadExcel(file, event);
  }
  uploadExcel(file: File, event: any): void {
    this.isLoading = true;
    this.uploadMessage = '';
    this.uploadError = '';
    const reader: FileReader = new FileReader();
    reader.readAsArrayBuffer(file);
    reader.onload = (e: any) => {
      const binarystr: string = e.target.result;
      const wb: WorkBook = read(binarystr, { type: 'binary' });
      /* selected the first sheet */
      const wsname: string = wb.SheetNames[0];
      const ws: WorkSheet = wb.Sheets[wsname];
      // Convert sheet to JSON
      const data = utils.sheet_to_json(ws);
      // Validate required fields
      const requiredHeaders = ['ArticleId', 'PTLMacAddress', 'Box'];
      const actualHeaders = Object.keys(data[0] || {});
      const missingHeaders = requiredHeaders.filter(header =>
        !actualHeaders.some(actual => actual.toLowerCase() === header.toLowerCase())
      );
      if (missingHeaders.length > 0) {
        this.showError('Validation Error', `Missing required headers: ${missingHeaders.join(', ')}`);
        this.isLoading = false;
        event.target.value = "";
        return;
      }
      // Upload part using AuthService
      const formData = new FormData();
      formData.append('file', file);
      this.authService
        .httpPostRequest(`${Global['TROLLEY_MAC_UPLOAD']}`, formData, {
          responseType: 'text'
        })
        .pipe(
          catchError((error) => {
            console.error('Upload error:', error);
            this.showError('Upload Failed', error.error || 'Upload failed');
            this.isLoading = false;
            event.target.value = "";
            return of('');
          })
        )
        .subscribe({
          next: (response: any) => {
            console.log(response);
            const parsedResponse = typeof response === 'string' ? JSON.parse(response) : response;
            let message = `${parsedResponse.message}\n\n`;
            message += `Inserted: ${parsedResponse.inserted}\n`;
            message += `Updated: ${parsedResponse.updated}\n`;
            message += `Failed: ${parsedResponse.failed}\n`;
            if (parsedResponse.failedRecords && parsedResponse.failedRecords.length > 0) {
              message += `\nFailed Records:\n`;
              parsedResponse.failedRecords.forEach((record: any) => {
                message += `Row ${record.rowNumber} (${record.articleId}): ${record.reason}\n`;
              });
            }
            if (parsedResponse.failed === 0) {
              this.showSuccess('Upload Successful', message);
            } else {
              this.showError('Upload Completed with Errors', message);
