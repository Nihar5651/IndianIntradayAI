import { DatePipe } from '@angular/common';
import { Component, OnInit, ViewChild } from '@angular/core';
import { MatPaginator, PageEvent } from '@angular/material/paginator';
import { MatTableDataSource } from '@angular/material/table';
import { Global } from 'src/app/shared/constants/Global';
import { AuthService } from 'src/app/shared/services/auth.service';
import { ToastrMsgService } from 'src/app/shared/services/toastr-msg.service';
import { NgbModal } from '@ng-bootstrap/ng-bootstrap';
import {
  FormBuilder,
  FormControl,
  FormGroup,
  Validators
} from '@angular/forms';
@Component({
  selector: 'app-user-management',
  templateUrl: './user-management.component.html',
  styleUrls: ['./user-management.component.scss']
})
export class UserManagementComponent implements OnInit {
  userList: any[] = [];
  displayedColumns: string[] = [
    'SrNo',
    'name',
    'Creation_Time',
    'manage_access',
    'isDeleted'
  ];
  sidebarForm = new FormControl('', Validators.required);
  isPasswordVisible = false;
  dataSource = new MatTableDataSource<any>();
  @ViewChild(MatPaginator, { static: true }) paginator!: MatPaginator;
  pageEvent!: PageEvent;
  length = 50;
  pageSize = 50;
  pageIndex = 0;
  pageSizeOptions: number[] = [50, 100, 150, 200];
  createUser!: FormGroup;
  // Manage Access
  displayedManageAccessColumns: string[] = ['Tab'];
  manageAccessDataSource = new MatTableDataSource<any>();
  userManageAccessList: any[] = [];
  searchedVCNumber: string = '';
  pullDataList: any = [];
  selectedTabIds: any[] = [];
  pullVCData: any[] = [];
  // selectedVCEvent: boolean = false;
  selectedUserDataRow: any = [];
  Status!: boolean;
  userId: any;
  modifiedUserData: any[] = [];
  searchTerm: string = '';
  constructor(
    private authService: AuthService,
    private toastrMsgService: ToastrMsgService,
    private datePipe: DatePipe,
    public modalService: NgbModal,
    private fb: FormBuilder
  ) {}
  ngOnInit(): void {
    this.getUsersDetails();
    this.createUserForm();
  }
  createUserForm() {
    this.createUser = this.fb.group({
      name: ['', [Validators.required, Validators.minLength(5)]],
      password: ['', [Validators.required, Validators.minLength(5)]]
    });
  }
  onSubmitUser() {
    this.authService
      .httpPostRequest(
        Global['USER_MANAGEMENT_CREATE_USER'],
        this.createUser.value
      )
      .subscribe({
        next: (res: any) => {
          if (res.status == 200) {
            this.toastrMsgService.showSuccessMsg(res.message);
            this.getUsersDetails();
            this.modalService.dismissAll();
            this.createUser.reset();
          }
        }
      });
  }
  getUsersDetails() {
    this.authService
      .httpGetRequest(Global.USER_MANAGEMENT_VIEW_USERS_DETAILS)
      .subscribe({
        next: (res) => {
          // Modify the property names to remove whitespace
          this.userList = res.map((user: any) => {
            return {
              user_id: user.user_id,
              name: user.name,
              Creation_Time: this.datePipe.transform(
                user.creation_time,
                'dd/MM/yyyy, hh:mm:ss a'
              ),
              isDeleted: user.isDeleted,
              SrNo: user['Sr No'] // Adjusted property name without whitespace
            };
          });
          this.dataSource = new MatTableDataSource(this.userList);
          this.length = this.userList.length;
          this.dataSource.paginator = this.paginator;
        }
      });
  }
  enableDisableUser(userData: any) {
    let enableDisable = userData.isDeleted == true ? 0 : 1;
    let userObj = {
      user_id: userData.user_id,
      isDeleted: enableDisable,
      username: userData.name
    };
    this.authService
      .httpPostRequest(Global['USER_MANAGEMENT_ENABLE_DISABLE'], userObj)
      .subscribe({
        next: (res) => {
          this.toastrMsgService.showSuccessMsg(res.message);
          this.getUsersDetails();
        }
      });
  }
  openNewUserModal(content: any) {
    this.modalService.open(content, { ariaLabelledBy: 'modal-basic-title' });
  }
  // user manageaccess modal popup
  openManageAccessModal(content: any, userData: any) {
    this.userId = userData.user_id;
    this.selectedTabIds = [];
    let userId = {
      UID: userData.user_id
    };
    this.modalService.open(content, { ariaLabelledBy: 'modal-basic-title' });
    this.authService
      .httpPostRequest(Global['USER_MANAGEMENT_GET_TAB_ACCESS'], userId)
      .subscribe({
        next: (res) => {
          this.userManageAccessList = res;
          this.manageAccessDataSource = new MatTableDataSource(
            this.userManageAccessList
          );
        }
      });
  }
  onSelectTab(event: any, userData: any) {
    let selectedTabRow = userData;
    this.Status = event;
    // Find the index of the selected object in the array
    let index = this.userManageAccessList.findIndex(
      (tab) => tab.tab_id === selectedTabRow.tab_id
    );
    // If the index is found, update the status of the corresponding object in the array
    if (index !== -1) {
      this.userManageAccessList[index].Status = selectedTabRow.Status;
    }
    this.selectedTabIds = this.userManageAccessList
      .filter((tab) => tab.Status === true)
      .map((tab) => tab.tab_id);
  }
  onSaveSelectedTab() {
    let tabAccessObj = {
      userId: this.userId,
      tabIds: this.selectedTabIds
    };
    this.authService
      .httpPostRequest(
        Global['USER_MANAGEMENT_AUTH_UPDATE_USER_TABS'],
        tabAccessObj
      )
      .subscribe({
        next: (res) => {
          this.toastrMsgService.showSuccessMsg(res.message);
          this.selectedTabIds = [];
          this.getUsersDetails();
          this.modalService.dismissAll();
        }
      });
  }
  openNewSidebarNavModal(content: any) {
    this.modalService.open(content, { ariaLabelledBy: 'modal-basic-title' });
  }
  onSubmitSidenav() {
    const tabObj = {
      tab_name: this.sidebarForm.value
    };
    this.authService
      .httpPostRequest(Global['USER_MANAGEMENT_ADD_TABS'], tabObj)
      .subscribe({
        next: (res) => {
          this.toastrMsgService.showSuccessMsg(res.message);
          this.modalService.dismissAll();
          this.sidebarForm.reset();
        }
      });
  }
  onSearchInputChange(event: Event) {
    const inputElement = event.target as HTMLInputElement;
    this.searchTerm = inputElement.value;
    if (this.searchTerm.trim().length >= 3) {
      this.dataSource.filter = this.searchTerm.trim().toLowerCase();
      if (this.dataSource.filteredData.length === 0) {
        this.toastrMsgService.showErrorMsg('No data found.');
      }
    } else if (this.searchTerm.trim() === '') {
      this.clearFilter();
    }
  }
  clearFilter() {
    this.dataSource.filter = '';
  }
}
