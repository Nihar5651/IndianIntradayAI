/**
 * External ESL status publisher (POST /articles) for updating trolley STATUS -> COMPLETE.
 *
 * Behaviour:
 *  - Uses pooled trust-all RestTemplate (same pattern as ExternalArticlePublisher).
 *  - On success: logs and returns true.
 *  - On failure: enqueues retry into external_retry_queue and returns false.
 *
 * Important: This class will NOT throw exceptions to caller (so DB processed state is not reverted).
 */
@Service
public class ExternalEslStatusPublisher {

    private static final Logger log = LoggerFactory.getLogger(ExternalEslStatusPublisher.class);

    public static final String KEY = "ESL_STATUS_UPDATE";

    @Value("${external.articles.url:https://172.25.86.106:9002/articles}")
    private String endpointUrl;

    private volatile RestTemplate restTemplate;
    private final ObjectMapper objectMapper = new ObjectMapper();
    private final EntityManager em;

    public ExternalEslStatusPublisher(EntityManager em) {
        this.em = em;
    }

    /**
     * Publish COMPLETE status for trolley (trolleyCode as article id).
     * Returns true on 2xx/204; false otherwise (and enqueues retry).
     */
    public boolean publishComplete(String stationCode, String trolleyCode) {
        Map<String, Object> item = new LinkedHashMap<>();
        item.put("stationCode", stationCode);
        item.put("id", trolleyCode);
        item.put("data", Map.of("STATUS", "COMPLETE"));

        Map<String, Object> root = new LinkedHashMap<>();
        root.put("dataList", List.of(item));

        String jsonBody = toJson(root);

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));
        headers.setAccept(List.of(MediaType.APPLICATION_JSON));
        HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);

        log.info("▶️ External ESL STATUS POST {}", endpointUrl);
        log.debug("▶️ Headers: {}", headers);
        log.debug("▶️ Body: {}", jsonBody);

        try {
            ResponseEntity<String> resp = getClient().exchange(endpointUrl, HttpMethod.POST, entity, String.class);
            log.info("◀️ ESL STATUS response: {}", resp.getStatusCodeValue());
            log.debug("◀️ Response Headers: {}", resp.getHeaders());
            log.debug("◀️ Response Body: {}", resp.getBody() == null ? "<empty>" : resp.getBody());

            if (resp.getStatusCode().is2xxSuccessful() || resp.getStatusCode() == HttpStatus.NO_CONTENT) {
                return true;
            } else {
                String err = "non-2xx:" + resp.getStatusCodeValue();
                enqueueRetry(endpointUrl, "POST", root, headers, err);
                return false;
            }

        } catch (ResourceAccessException rae) {
            String msg = rae.getMessage();
            log.error("ESL STATUS POST ResourceAccessException: {}", msg);
            enqueueRetry(endpointUrl, "POST", root, headers, msg);
            return false;
        } catch (RestClientException rce) {
            String msg = rce.getMessage();
            log.error("ESL STATUS POST RestClientException: {}", msg, rce);
            enqueueRetry(endpointUrl, "POST", root, headers, msg);
            return false;
        } catch (Exception ex) {
            String msg = ex.getMessage();
            log.error("ESL STATUS POST unexpected error: {}", msg, ex);
            enqueueRetry(endpointUrl, "POST", root, headers, msg);
            return false;
        }
    }

    // ---------- retry enqueue (safe, non-throwing) ----------
    private void enqueueRetry(String endpoint, String method, Object payload, HttpHeaders headers, String lastError) {
        try {
            String payloadJson = toJson(payload);
            String headersJson = headers == null ? "{}" : toJson(headers.toSingleValueMap());

            String sql = "INSERT INTO external_retry_queue (endpoint, method, payload, headers, attempts, last_error, next_attempt_at, created_at, updated_at) " +
                    "VALUES (:endpoint, :method, cast(:payload as jsonb), cast(:headers as jsonb), 0, :err, now(), now(), now())";

            Query q = em.createNativeQuery(sql);
            q.setParameter("endpoint", endpoint);
            q.setParameter("method", method);
            q.setParameter("payload", payloadJson);
            q.setParameter("headers", headersJson);
            q.setParameter("err", lastError == null ? "" : lastError);
            q.executeUpdate();

            log.info("Enqueued ESL status retry for trolley (endpoint={}, method={})", endpoint, method);
        } catch (Exception e) {
            log.error("Failed to insert retry row into external_retry_queue : {}", e.getMessage(), e);
        }
    }

    // ---------- helper: lazy trust-all RestTemplate (pooled) ----------
    private RestTemplate getClient() {
        RestTemplate rt = restTemplate;
        if (rt != null) return rt;

        synchronized (this) {
            if (restTemplate != null) return restTemplate;
            try {
                var sslContext = SSLContextBuilder.create()
                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)
                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()
                        .setSslContext(sslContext)
                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)
                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()
                        .setSSLSocketFactory(sslSocketFactory)
                        .build();

                HttpClient httpClient = HttpClients.custom()
                        .setConnectionManager(connMgr)
                        .build();

                HttpComponentsClientHttpRequestFactory factory =
                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);
                log.warn("ExternalEslStatusPublisher: INSECURE SSL ENABLED (trust-all + no hostname verification).");
            } catch (Exception e) {
                log.error("Failed to build insecure SSL client. Falling back to default RestTemplate.", e);
                restTemplate = new RestTemplate();
            }
            return restTemplate;
        }
    }

    private String toJson(Object obj) {
        try {
            return objectMapper().writeValueAsString(obj);
        } catch (JsonProcessingException e) {
            log.warn("Failed to serialize JSON: {}", e.getMessage());
            return String.valueOf(obj);
        }
    }

    private ObjectMapper objectMapper() { return objectMapper; }
