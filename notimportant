            // vins can be array or single string
            List<String> vinsList = new ArrayList<>();
            Object vinsObj = payload.get("vins");
            if (vinsObj instanceof String s) {
                vinsList.add(s);
            } else if (vinsObj instanceof Collection<?>) {
                for (Object o : (Collection<?>) vinsObj) {
                    if (o != null) vinsList.add(o.toString());
                }
            } else if (payload.get("vin") != null) {
                vinsList.add(payload.get("vin").toString());
            }

            // Extract current logged-in operator
            String operator;
            try {
                operator = SecurityContextHolder.getContext().getAuthentication().getName();
            } catch (Exception e) {
                operator = "UnknownOperator";
            }

            return forceKittingService.forceComplete(line, zone, vinsList, operator);
        } catch (Exception ex) {
            Map<String, Object> err = new LinkedHashMap<>();
            err.put("status", "error");
            err.put("message", ex.getMessage() != null ? ex.getMessage() : "unknown error");
            return err;
        }
    }
}
