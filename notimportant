    const exportData = this.filteredTrolleyMacRecords.map((record, index) => ({
      'Sr. No.': index + 1,
      'Article ID': record.articleId || '',
      'MAC Address': record.ptlMacAddress || '',
      'Line': record.lineDenotion || '',
      'Zone': record.zoneDenotion || '',
      'Created Time': record.createdTime || '',
      'Source Table': record.sourceTable || ''
    }));
    // Generate sheet structures using utils
    const worksheet: WorkSheet = utils.json_to_sheet(exportData);
    const workbook: WorkBook = utils.book_new();
    utils.book_append_sheet(workbook, worksheet, 'Trolley MAC Details');
    // Setup an automated explicit timestamp format filename suffix
    const currentTimestamp = new Date().toISOString().replace(/T/, '_').replace(/\..+/, '').replace(/:/g, '-');
