import com.kitting.entity.TrolleyMacMapping;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.apache.poi.ss.usermodel.*;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.multipart.MultipartFile;

import java.io.InputStream;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.*;

@Service
public class TrolleyMacMappingService {

    private static final Logger log = LoggerFactory.getLogger(TrolleyMacMappingService.class);

    // Prefix → Table mapping
    private static final Map<String, String> PREFIX_TO_TABLE = Map.of(
            "T1", "trim1_trolly_mac_mapping",
            "T2", "trim2_trolly_mac_mapping",
            "DR", "door_trolly_mac_mapping",
            "CR", "cradle_trolly_mac_mapping",
            "CP", "cockpit_trolly_mac_mapping"
    );

    @PersistenceContext
    private EntityManager em;

    /**
     * Reads Excel, validates rows, detects line from ArticleId, validates zone,
     * and upserts records into respective trolly_mac_mapping tables.
     * Returns detailed response with failed rows and reasons.
     */
    @Transactional
    public Map<String, Object> processUpload(MultipartFile file) throws Exception {
        int inserted = 0, updated = 0, failed = 0;
        List<Map<String, String>> failedRecords = new ArrayList<>();

        try (InputStream is = file.getInputStream(); Workbook wb = WorkbookFactory.create(is)) {
            Sheet sheet = wb.getSheetAt(0);
            if (sheet == null) throw new IllegalArgumentException("Excel file has no sheets");

            Iterator<Row> rows = sheet.rowIterator();
            if (!rows.hasNext()) throw new IllegalArgumentException("Excel sheet is empty");

            // header row
            Row header = rows.next();
            Map<String, Integer> colIndex = new HashMap<>();
            for (Cell c : header) {
                String h = Optional.ofNullable(c.getStringCellValue()).orElse("").trim();
                colIndex.put(h, c.getColumnIndex());
            }

            if (!colIndex.containsKey("ArticleId") || !colIndex.containsKey("PTLMacAddress")) {
                throw new IllegalArgumentException("Excel headers must include 'ArticleId' and 'PTLMacAddress'");
            }

            while (rows.hasNext()) {
                Row r = rows.next();
                try {
                    TrolleyMacMapping dto = parseRow(r, colIndex);

                    // Basic validation
                    if (dto.getArticleId() == null || dto.getArticleId().isBlank())
                        throw new IllegalArgumentException("ArticleId empty");
                    if (dto.getPtlMacAddress() == null || dto.getPtlMacAddress().isBlank())
                        throw new IllegalArgumentException("PTLMacAddress empty");

                    String article = dto.getArticleId().trim();
                    if (article.length() != 8)
                        throw new IllegalArgumentException("ArticleId must be exactly 8 characters");

                    String prefix = findPrefix(article);
                    if (prefix == null)
                        throw new IllegalArgumentException("Unknown line prefix in ArticleId");

                    // Remaining part e.g. Z1T001
                    String remaining = article.substring(prefix.length());
                    int tIndex = remaining.indexOf('T');
                    if (tIndex <= 0)
                        throw new IllegalArgumentException("ArticleId must contain 'T' separating zone and serial");

                    String zone = remaining.substring(0, tIndex);
                    String serial = remaining.substring(tIndex + 1);

                    if (!zone.matches("Z\\d+"))
                        throw new IllegalArgumentException("Zone must be like 'Z1' or 'Z2'");
                    if (!serial.matches("\\d{3}"))
                        throw new IllegalArgumentException("Serial must be 3 digits");

                    String lineDenotion = prefix;
                    if (!isZoneAllowed(lineDenotion, zone)) {
                        throw new IllegalArgumentException("Zone '" + zone + "' not allowed for line '" + lineDenotion + "'");
                    }

                    dto.setLineDenotion(lineDenotion);
                    dto.setZoneDenotion(zone);

                    String targetTable = PREFIX_TO_TABLE.get(prefix);
                    if (targetTable == null)
                        throw new IllegalArgumentException("No table mapping for prefix: " + prefix);

                    boolean exists = checkExists(targetTable, dto.getArticleId());
                    boolean ok;
                    if (exists) {
                        ok = updateMapping(targetTable, dto);
                        if (ok) updated++; else failed++;
                    } else {
                        ok = insertMapping(targetTable, dto);
                        if (ok) inserted++; else failed++;
                    }

                } catch (Exception exRow) {
                    failed++;
                    log.warn("Skipping row {} due to error: {}", r.getRowNum() + 1, exRow.getMessage());

                    // record failure details
                    Map<String, String> failDetail = new LinkedHashMap<>();
                    failDetail.put("rowNumber", String.valueOf(r.getRowNum() + 1));
                    failDetail.put("articleId", getCellString(r.getCell(colIndex.get("ArticleId"))));
                    failDetail.put("reason", exRow.getMessage());
                    failedRecords.add(failDetail);
                }
            }
        }

        // build result
        Map<String, Object> result = new LinkedHashMap<>();
        result.put("inserted", inserted);
        result.put("updated", updated);
        result.put("failed", failed);
        result.put("failedRecords", failedRecords);
        result.put("message", "Trolley MAC mapping upload completed successfully.");
        return result;
    }

    private TrolleyMacMapping parseRow(Row r, Map<String, Integer> colIndex) {
        TrolleyMacMapping dto = new TrolleyMacMapping();
        Cell articleCell = r.getCell(colIndex.get("ArticleId"));
        if (articleCell != null) dto.setArticleId(getCellString(articleCell));

        Cell macCell = r.getCell(colIndex.get("PTLMacAddress"));
        if (macCell != null) dto.setPtlMacAddress(getCellString(macCell));

        if (colIndex.containsKey("Box")) {
            Cell boxCell = r.getCell(colIndex.get("Box"));
            if (boxCell != null) {
                try { dto.setBox((int) boxCell.getNumericCellValue()); } catch (Exception e) { /* ignore */ }
            }
        }
        return dto;
    }

    private String getCellString(Cell cell) {
        switch (cell.getCellType()) {
            case STRING: return cell.getStringCellValue().trim();
            case NUMERIC: return String.valueOf((long) cell.getNumericCellValue());
            case BOOLEAN: return String.valueOf(cell.getBooleanCellValue());
            default: return "";
        }
    }

    private String findPrefix(String article) {
        for (String p : PREFIX_TO_TABLE.keySet()) {
            if (article.startsWith(p)) return p;
        }
        return null;
    }

    private boolean checkExists(String table, String articleId) {
        String sql = String.format("SELECT 1 FROM %s WHERE article_id = :article LIMIT 1", table);
        Query q = em.createNativeQuery(sql);
        q.setParameter("article", articleId);
        return !q.getResultList().isEmpty();
    }

    private boolean insertMapping(String table, TrolleyMacMapping dto) {
        String sql = String.format(
                "INSERT INTO %s (article_id, ptl_mac_address, line_denotion, zone_denotion, created_time) " +
                        "VALUES (:article, :mac, :line, :zone, :ctime)", table);
        Query q = em.createNativeQuery(sql);
        q.setParameter("article", dto.getArticleId());
        q.setParameter("mac", dto.getPtlMacAddress());
        q.setParameter("line", dto.getLineDenotion());
        q.setParameter("zone", dto.getZoneDenotion());
        q.setParameter("ctime", Timestamp.from(Instant.now()));
        return q.executeUpdate() > 0;
    }

    private boolean updateMapping(String table, TrolleyMacMapping dto) {
        String sql = String.format(
                "UPDATE %s SET ptl_mac_address = :mac, line_denotion = :line, zone_denotion = :zone, created_time = :ctime WHERE article_id = :article",
                table);
        Query q = em.createNativeQuery(sql);
        q.setParameter("mac", dto.getPtlMacAddress());
        q.setParameter("line", dto.getLineDenotion());
        q.setParameter("zone", dto.getZoneDenotion());
        q.setParameter("ctime", Timestamp.from(Instant.now()));
        q.setParameter("article", dto.getArticleId());
        return q.executeUpdate() > 0;
    }

    // ✅ Fixed column name for zone check
    private boolean isZoneAllowed(String lineDenotion, String zoneDenotion) {
        String sql = "SELECT 1 FROM line_allowed_hierarchy WHERE line_denotion = :line AND zone = :zone LIMIT 1";
        Query q = em.createNativeQuery(sql);
        q.setParameter("line", lineDenotion);
        q.setParameter("zone", zoneDenotion);
        return !q.getResultList().isEmpty();
    }
}
package com.kitting.service;

import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.util.*;

@Service
public class TrolleyMacMappingViewService {

    private static final Logger log = LoggerFactory.getLogger(TrolleyMacMappingViewService.class);

    private static final Map<String, String> PREFIX_TO_TABLE = Map.of(
            "T1", "trim1_trolly_mac_mapping",
            "T2", "trim2_trolly_mac_mapping",
            "DR", "door_trolly_mac_mapping",
            "CR", "cradle_trolly_mac_mapping",
            "CP", "cockpit_trolly_mac_mapping"
    );

    @PersistenceContext
    private EntityManager em;

    /**
     * Fetch all trolley MAC mappings based on optional line/zone filters.
     */
    public List<Map<String, Object>> fetchAll(String line, String zone) {
        List<Map<String, Object>> results = new ArrayList<>();

        // 1️⃣ Determine target tables
        List<String> tablesToQuery = new ArrayList<>();
        if (line != null && PREFIX_TO_TABLE.containsKey(line.toUpperCase())) {
            tablesToQuery.add(PREFIX_TO_TABLE.get(line.toUpperCase()));
        } else {
            tablesToQuery.addAll(PREFIX_TO_TABLE.values()); // all lines
        }

        // 2️⃣ Query each table
        for (String table : tablesToQuery) {
            StringBuilder sql = new StringBuilder(
                    String.format("SELECT article_id, ptl_mac_address, line_denotion, zone_denotion, created_time FROM %s", table)
            );
            if (zone != null && !zone.isBlank()) {
                sql.append(" WHERE zone_denotion = :zone");
            }
            Query q = em.createNativeQuery(sql.toString());

            if (zone != null && !zone.isBlank()) {
                q.setParameter("zone", zone);
            }

            List<Object[]> rows = q.getResultList();
            for (Object[] row : rows) {
                Map<String, Object> record = new LinkedHashMap<>();
                record.put("articleId", row[0]);
                record.put("ptlMacAddress", row[1]);
                record.put("lineDenotion", row[2]);
                record.put("zoneDenotion", row[3]);
                record.put("createdTime", row[4]);
                record.put("sourceTable", table);
                results.add(record);
            }
        }

        log.info("📋 Retrieved {} trolley MAC mapping records", results.size());
        return results;
    }
}
