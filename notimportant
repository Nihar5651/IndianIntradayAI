    private static final int BATCH_SIZE = 20;

    public QuantityRetryScheduler(EntityManager em, ExternalQuantityPublisher externalQuantityPublisher) {
        this.em = em;
        this.externalQuantityPublisher = externalQuantityPublisher;
    }

    @Scheduled(fixedDelayString = "${quantity.retry.scheduler.delay-ms:30000}")
    public void runRetryBatch() {
        List<RetryRow> rows = fetchRetryBatch();
        if (rows.isEmpty()) return;

        for (RetryRow r : rows) {
            try {
                // call external API
                log.info("Retry attempt id={} article={} attempts={} nextAttemptAt={}", r.id, r.articleId, r.attempts, r.nextAttemptAt);
                externalQuantityPublisher.publishList(List.of(r.payloadAsMap()));

                // on success: delete retry row and update mac_pick_queue as succeeded if possible
                deleteRetryRow(r.id);
                markQueueQuantitySuccessForArticleAndMac(r.articleId, r.macAddress);
                log.info("Retry success id={} article={} deleted and queue updated if present.", r.id, r.articleId);

            } catch (Exception ex) {
                log.error("Retry failed id={} article={} attempts={} error={}", r.id, r.articleId, r.attempts, ex.getMessage());
                updateRetryBackoff(r.id, r.attempts + 1, ex.getMessage());
            }
        }
    }

    @Transactional
    protected List<RetryRow> fetchRetryBatch() {
        String sql = "SELECT id, mac_address, article_id, vc, item_code, qty, payload, attempts, last_error, next_attempt_at FROM quantity_retry_queue WHERE next_attempt_at <= now() ORDER BY attempts ASC, created_at ASC LIMIT :batch FOR UPDATE SKIP LOCKED";
        Query q = em.createNativeQuery(sql);
        q.setParameter("batch", BATCH_SIZE);
        @SuppressWarnings("unchecked")
        List<Object[]> rows = q.getResultList();
        List<RetryRow> out = new ArrayList<>();
        for (Object[] r : rows) {
            RetryRow rr = new RetryRow();
            rr.id = ((Number) r[0]).longValue();
            rr.macAddress = (String) r[1];
            rr.articleId = (String) r[2];
            rr.vc = (String) r[3];
            rr.itemCode = (String) r[4];
            rr.qty = ((Number) r[5]).intValue();
            rr.payloadJson = (String) r[6];
            rr.attempts = ((Number) r[7]).intValue();
            rr.lastError = (String) r[8];
            rr.nextAttemptAt = r[9] == null ? null : r[9].toString();
            out.add(rr);
        }
        return out;
    }

    @Transactional
    protected void deleteRetryRow(long id) {
        Query q = em.createNativeQuery("DELETE FROM quantity_retry_queue WHERE id = :id");
        q.setParameter("id", id);
        q.executeUpdate();
    }

    @Transactional
    protected void markQueueQuantitySuccessForArticleAndMac(String articleId, String mac) {
        // Be conservative: update any mac_pick_queue rows for that article+mac that are not yet marked.
        Query q = em.createNativeQuery("UPDATE mac_pick_queue SET quantity_update_attempted = true, quantity_update_success_at = now(), updated_at = now() WHERE article_id = :articleId AND mac_address = :mac AND quantity_update_attempted = false");
        q.setParameter("articleId", articleId);
        q.setParameter("mac", mac);
        q.executeUpdate();
    }

    @Transactional
    protected void updateRetryBackoff(long id, int attempts, String lastError) {
        // compute next_attempt_at based on attempts
        String nextInterval = computeBackoffSqlInterval(attempts);
        Query q = em.createNativeQuery("UPDATE quantity_retry_queue SET attempts = :attempts, last_error = :lastError, next_attempt_at = now() + (" + nextInterval + "), updated_at = now() WHERE id = :id");
        q.setParameter("attempts", attempts);
        q.setParameter("lastError", lastError);
        q.setParameter("id", id);
        q.executeUpdate();
    }

    // backoff schedule as SQL interval fragment (safe and readable)
    protected String computeBackoffSqlInterval(int attempts) {
        if (attempts <= 1) return "interval '30 seconds'"; // already used on insert but safe
        if (attempts == 2) return "interval '2 minutes'";
        if (attempts == 3) return "interval '10 minutes'";
        if (attempts == 4) return "interval '30 minutes'";
        return "interval '1 hour'"; // 5+
    }

    /**
     * Holder for retry rows fetched from DB
     */
    protected static class RetryRow {
        long id;
        String macAddress;
        String articleId;
        String vc;
        String itemCode;
        int qty;
        String payloadJson;
        int attempts;
        String lastError;
        String nextAttemptAt;

        Map<String, Object> payloadAsMap() {
            try {
                ObjectMapper m = new ObjectMapper();
                JsonNode node = m.readTree(payloadJson);
                // The ExternalQuantityPublisher.publishList expects a List<Map<String,Object>> where each item is a map containing stationCode,id,data
                // We'll convert payloadJson -> Map and return the first dataList element.
                if (node.has("dataList") && node.get("dataList").isArray() && node.get("dataList").size() > 0) {
                    JsonNode first = node.get("dataList").get(0);
                    return m.convertValue(first, Map.class);
                }
            } catch (Exception ex) {
                log.warn("Failed to parse payloadJson for retry id={}: {}", id, ex.getMessage());
            }
            // Fallback minimal payload
            Map<String, Object> item = new HashMap<>();
            item.put("stationCode", "100");
            item.put("id", articleId);
            Map<String, Object> data = new HashMap<>();
            data.put("QTY", qty);
            data.put("PART_NUMBER", itemCode);
            item.put("data", data);
            return item;
        }
    }
