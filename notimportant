  }
  toggleSelection(row: any): void {
    const vin = row.vin;
    if (this.selectedVins.has(vin)) {
      this.selectedVins.delete(vin);
    } else {
      this.selectedVins.add(vin);
    }
  }
  getSelectedRows(): any[] {
    const key = `${this.currentLine}_${this.currentZone}`;
    const dataSource = this.dataSources[key];
    const currentData = dataSource?.data || [];
    return currentData.filter(row => this.selectedVins.has(row.vin));
