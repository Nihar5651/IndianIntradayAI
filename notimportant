    private List<String> fetchP2LArticleIds(String vc, String line, String zone) {
        // 🔥 UPDATED SQL:
        // We added `p.is_active = '1'` to prevent deactivated parts from
        // sending a signal to the physical MAC address on the line.
        String sql =
                "SELECT m.article_id " +
                        "FROM vc_bom_map v " +
                        "JOIN part_master_list p ON v.material = p.part_number " +
                        "JOIN mac_articleid_kitting m ON p.part_number = m.item_code " +
                        "WHERE v.vc = :vc " +
                        "  AND p.type = 'P2L' " +
                        "  AND p.is_active = '1' " + // 🔥 THE CRITICAL FIX: Soft-Delete Shield
                        "  AND p.line = :line " +
                        "  AND m.line_denotion = :line " +
                        "  AND m.zone = :zone";

        @SuppressWarnings("unchecked")
        List<Object> raw = entityManager.createNativeQuery(sql)
                .setParameter("vc", vc)
                .setParameter("line", line)
                .setParameter("zone", zone)
                .getResultList();

        List<String> articleIds = new ArrayList<>();
        for (Object o : raw) {
            if (o != null) articleIds.add(o.toString());
        }
        return articleIds;
    }

    private String assignLedColor(String line, String zone) {
        String key = line + "#" + zone;
        usedLedColorsPerLineZone.putIfAbsent(key, ConcurrentHashMap.newKeySet());
        Set<String> used = usedLedColorsPerLineZone.get(key);

        List<String> available = new ArrayList<>(LED_COLORS);
        available.removeAll(used);
        if (available.size() <= 1) return null;

        String chosen = available.get(new Random().nextInt(available.size()));
        used.add(chosen);
        return chosen;
    }

    public void freeLed(String line, String zone, String color) {
        try {
            String key = line + "#" + zone;
            Set<String> set = usedLedColorsPerLineZone.get(key);
            if (set != null) set.remove(color);
        } catch (Exception ignored) {}
    }

