    // 🔥 ADMIN OVERRIDES: EDIT VIN/VC AND REVERSE FORCE KIT (WITH GUARDS)
    // =======================================================================

    @Transactional
    public Map<String, Object> editVehicleVinAndVc(String line, String oldVin, String newVin, String newVc) {
        Map<String, Object> response = new LinkedHashMap<>();
        String table = KITTING_TABLES.get(line.toUpperCase());
        boolean isTwoZone = TWO_ZONE_LINES.contains(line.toUpperCase());

        if (table == null) {
            response.put("status", "error");
            response.put("message", "Invalid Line.");
            return response;
        }

        try {
            // 1. SAFETY CHECK: Ensure vehicle is strictly WAITING (Not processing, not completed)
            String checkSql = isTwoZone
                    ? String.format("SELECT coalesce(isprocessedzone1, false), coalesce(isreservedzone1, false), coalesce(isprocessedzone2, false), coalesce(isreservedzone2, false) FROM %s WHERE vinnumber = :vin", table)
                    : String.format("SELECT coalesce(isprocessedzone1, false), coalesce(isreservedzone1, false) FROM %s WHERE vinnumber = :vin", table);

            Query checkQuery = entityManager.createNativeQuery(checkSql);
            checkQuery.setParameter("vin", oldVin);

            @SuppressWarnings("unchecked")
            List<Object[]> rows = checkQuery.getResultList();

            if (rows.isEmpty()) {
                response.put("status", "error");
                response.put("message", "Vehicle not found on this line.");
                return response;
            }

            Object[] statusRow = rows.get(0);
            boolean isZ1Processed = (Boolean) statusRow[0];
            boolean isZ1Reserved = (Boolean) statusRow[1];
            boolean isZ2Processed = isTwoZone && (Boolean) statusRow[2];
            boolean isZ2Reserved = isTwoZone && (Boolean) statusRow[3];

            if (isZ1Processed || isZ1Reserved || isZ2Processed || isZ2Reserved) {
                response.put("status", "error");
                response.put("message", "Cannot edit VIN/VC. Vehicle is currently PROCESSING or COMPLETED on this line.");
                return response;
            }

            // 2. EXECUTE EDIT (Isolated to this table only)
            log.warn("🚨 ADMIN OVERRIDE: Changing VIN '{}' to '{}' and VC to '{}' on table {}", oldVin, newVin, newVc, table);

            String updateSql = String.format(
                    "UPDATE %s SET vinnumber = :newVin, vcnumber = :newVc, lastmodifiedtime = now() WHERE vinnumber = :oldVin",
                    table
            );

            Query query = entityManager.createNativeQuery(updateSql);
            query.setParameter("newVin", newVin);
            query.setParameter("newVc", newVc);
            query.setParameter("oldVin", oldVin);

            int updated = query.executeUpdate();

            if (updated > 0) {
                response.put("status", "success");
                response.put("message", "Vehicle updated successfully. Changes applied only to " + line);
            } else {
                response.put("status", "error");
                response.put("message", "Failed to update vehicle.");
            }
        } catch (Exception e) {
            log.error("Failed to edit vehicle details: ", e);
            response.put("status", "error");
            response.put("message", "Database error during update.");
        }
        return response;
    }

    @Transactional
    public Map<String, Object> reverseForceKitting(String line, String zone, String vin) {
        Map<String, Object> response = new LinkedHashMap<>();
        String table = KITTING_TABLES.get(line.toUpperCase());
        boolean isTwoZone = TWO_ZONE_LINES.contains(line.toUpperCase());

        if (table == null) {
            response.put("status", "error");
            response.put("message", "Invalid Line.");
            return response;
        }

        try {
            int zoneNumber = zone.toUpperCase().contains("Z2") ? 2 : 1;

            // 1. SAFETY CHECK: Ensure the specific zone is actually COMPLETED
            String checkProcessedCol = (isTwoZone && zoneNumber == 2) ? "isprocessedzone2" : "isprocessedzone1";
            String checkSql = String.format("SELECT coalesce(%s, false) FROM %s WHERE vinnumber = :vin", checkProcessedCol, table);

            Query checkQuery = entityManager.createNativeQuery(checkSql);
            checkQuery.setParameter("vin", vin);

            @SuppressWarnings("unchecked")
            List<Boolean> checkRows = checkQuery.getResultList();

            if (checkRows.isEmpty()) {
                response.put("status", "error");
                response.put("message", "Vehicle not found on this line.");
                return response;
            }

            if (!checkRows.get(0)) {
                response.put("status", "error");
                response.put("message", "Cannot reverse. This zone is not currently COMPLETED.");
                return response;
            }

            // 2. EXECUTE REVERSAL
            log.info("⏪ REVERSING KITTING for VIN={} on Line={} Zone={}", vin, line, zone);
            String updateSql;

            if (!isTwoZone) {
                // SINGLE ZONE (Cockpit/Cradle) - Revert everything
                updateSql = String.format("""
                        UPDATE %s 
                        SET isprocessed = false, 
                            isprocessedzone1 = false, 
                            forcefulkitting = false, 
                            operatorname = null, 
                            kitting_completed_at = null,
                            lastmodifiedtime = now()
                        WHERE vinnumber = :vin
                        """, table);
            } else {
                // TWO ZONE (Trim/Door) - Revert the specific zone AND the global completion flag
                String processedCol = zoneNumber == 2 ? "isprocessedzone2" : "isprocessedzone1";
                String forceCol = zoneNumber == 2 ? "forcefulkittingz2" : "forcefulkittingz1";
                String operatorCol = zoneNumber == 2 ? "operatornamez2" : "operatorname";
                String timeCol = zoneNumber == 2 ? "kitting_completed_at_z2" : "kitting_completed_at_z1";

                updateSql = String.format("""
                        UPDATE %s 
                        SET isprocessed = false, 
                            kitting_completed_at = null, 
                            %s = false, 
                            %s = false, 
                            %s = null, 
                            %s = null,
                            lastmodifiedtime = now()
                        WHERE vinnumber = :vin
                        """, table, processedCol, forceCol, operatorCol, timeCol);
            }

            Query query = entityManager.createNativeQuery(updateSql);
            query.setParameter("vin", vin);
            int updated = query.executeUpdate();

            if (updated > 0) {
                response.put("status", "success");
                response.put("message", "Kitting reversed successfully. Vehicle is back in queue.");
            } else {
                response.put("status", "error");
                response.put("message", "Failed to reverse kitting.");
            }

        } catch (Exception e) {
            log.error("Failed to reverse force kit: ", e);
            response.put("status", "error");
            response.put("message", "Database error during reversal.");
        }
        return response;
    }
