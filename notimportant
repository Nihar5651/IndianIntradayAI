import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { catchError } from 'rxjs/operators';
import { of } from 'rxjs';
import { read, utils, writeFile, WorkBook, WorkSheet } from 'xlsx';
import { AuthService } from 'src/app/shared/services/auth.service';
import { Global } from 'src/app/shared/constants/Global';
@Component({
  selector: 'app-deki-master-upload',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './deki-master-upload.component.html',
  styleUrls: ['./deki-master-upload.component.scss'],
})
export class DekiMasterUploadComponent implements OnInit {
  @ViewChild('fileInput') fileInput!: ElementRef;
  isUploading: boolean = false;
  isGridLoading: boolean = false;
  // Modals
  showSuccessModal: boolean = false;
  showErrorModal: boolean = false;
  modalTitle: string = '';
  modalMessage: string = '';
  violationsList: string[] = [];
  // Grid Data
  partDetails: any[] = [];
  filteredPartDetails: any[] = [];
  searchTerm: string = '';
  // Pagination
  currentPage: number = 1;
  itemsPerPage: number = 10;
  totalItems: number = 0;
  // Filters Configuration
  filterableColumns = [
    { key: 'type', label: 'Type' },
    { key: 'isActive', label: 'Status' },
    { key: 'line', label: 'Line' },
    { key: 'zone', label: 'Zone' }
  ];
  showFilterDropdown: boolean = false;
  activeFilterColumn: string | null = null;
  filterOptions: { [key: string]: string[] } = { type: [], isActive: [], line: [], zone: [] };
  selectedFilters: { [key: string]: string[] } = { type: [], isActive: [], line: [], zone: [] };
  constructor(private authService: AuthService) {}
  ngOnInit(): void {
    this.loadGridData();
  }
  // ======================
  // Grid & Data Loading
  // ======================
  loadGridData(): void {
    this.isGridLoading = true;
    this.authService.httpGetRequest(Global.DEKI_MASTER_VIEW)
      .pipe(catchError(err => {
        console.error("Failed to load grid", err);
        return of([]);
      }))
      .subscribe((data: any[]) => {
        this.partDetails = data || [];
        this.filteredPartDetails = [...this.partDetails];
        this.totalItems = this.filteredPartDetails.length;
        this.initializeFilterOptions();
        this.isGridLoading = false;
      });
  }
  // ======================
  // Upload Logic
  // ======================
  onFileSelected(event: any): void {
    const file: File = event.target.files[0];
    if (file) {
      this.uploadDekiFile(file);
      event.target.value = ''; // Reset input
    }
  }
  uploadDekiFile(file: File): void {
    this.isUploading = true;
    this.violationsList = [];
    const formData = new FormData();
    formData.append('file', file);
    this.authService.httpPostRequest(Global.DEKI_MASTER_UPLOAD, formData)
      .pipe(catchError((error) => {
        this.isUploading = false;
        let errorMessage = 'Failed to upload Deki Master file.';
        try {
          const errorObj = typeof error.error === 'string' ? JSON.parse(error.error) : error.error;
          if (errorObj.violations && Array.isArray(errorObj.violations)) {
            this.violationsList = errorObj.violations;
            errorMessage = 'Validation failed. Please check the error list below.';
          } else if (errorObj.message) {
            errorMessage = errorObj.message;
          }
        } catch (e) {
          errorMessage = error.error || errorMessage;
        }
        this.showError('Upload Failed', errorMessage);
        return of(null);
      }))
      .subscribe({
        next: (response: any) => {
          if (response && response.status === 'SUCCESS') {
            const successMsg = `Successfully uploaded ${response.partsSaved} parts in Part Master and ${response.macsSaved} in MAC Article ID.`;
            this.showSuccess('Upload Complete', successMsg);
            this.loadGridData();
          }
          this.isUploading = false;
        },
        error: () => this.isUploading = false
      });
  }
  // ======================
  // Export Excel Logic
  // ======================
exportToExcel(): void {
    if (this.filteredPartDetails.length === 0) {
      this.showError('Export Warning', 'No data available to export.');
      return;
    }
    // Map keys to readable uppercase display headers as specified
    const exportData = this.filteredPartDetails.map(item => {
      return {
        'STORE_CODE': 100,                                     // Always 100
        'ARTICLE_ID': item.articleId || '',
        'BARCODE': '',                                         // Always doesn't contain any value
        'ITEM_NAME': item.partDescription  || '',                     // Contains Article Id data
        'QR': '',                                              // Always doesn't contain any value
        'COLUMN': '',                                          // Always doesn't contain any value
        'ROW': '',                                             // Always doesn't contain any value
        'RACK': '',                                            // Always doesn't contain any value
        'PART_DESC': item.partDescription || '',               // Contains Part description data
        'TAG_ID': item.articleId || '',                        // Contains Article Id data
        'STATUS': '',                                          // Always doesn't contain any value
        'DSN': '',                                             // Always doesn't contain any value
        'PART_NUMBER': item.partNumber || '',                  // Contains Part Number data
        'QTY': 1,                                              // Hardcoded to 1 as per your specification
        'TROLLET_ID': '',                                      // Always doesn't contain any value
        'MODEL': '',                                           // Always doesn't contain any value
        'VC': '',                                              // Always doesn't contain any value
        'VIN': '',                                             // Always doesn't contain any value
        'COLOR': '',                                           // Always doesn't contain any value
        'LINE': '',                                            // Always doesn't contain any value
        'VAR1': '',                                            // Always doesn't contain any value
        'VAR2': item.macAddress || ''                          // Contains Mac Address data
      };
    });
    // Create a new sheet and workbook configuration
    const worksheet: WorkSheet = utils.json_to_sheet(exportData);
    const workbook: WorkBook = utils.book_new();
    utils.book_append_sheet(workbook, worksheet, 'Deki Master Export');
    // Trigger explicit download package action in true .xlsx format
    const fileName = `Deki_Master_Export_${new Date().getTime()}.xlsx`;
    writeFile(workbook, fileName);
  }
  // ======================
  // Filtering Logic
  // ======================
  initializeFilterOptions(): void {
    ['type', 'isActive', 'line', 'zone'].forEach(col => {
      const uniqueVals = [...new Set(this.partDetails.map(item => item[col]).filter(val => val !== null && val !== undefined))];
      this.filterOptions[col] = uniqueVals.sort();
    });
  }
  toggleFilterDropdown(colKey: string, event: MouseEvent): void {
    event.stopPropagation();
    if (this.activeFilterColumn === colKey && this.showFilterDropdown) {
      this.showFilterDropdown = false;
      this.activeFilterColumn = null;
    } else {
      this.activeFilterColumn = colKey;
      this.showFilterDropdown = true;
    }
  }
  @HostListener('document:click')
  onDocumentClick(): void {
    this.showFilterDropdown = false;
    this.activeFilterColumn = null;
  }
  onFilterChange(column: string, value: string, event: any): void {
    if (event.target.checked) {
      if (!this.selectedFilters[column].includes(value)) this.selectedFilters[column].push(value);
    } else {
      this.selectedFilters[column] = this.selectedFilters[column].filter(val => val !== value);
    }
    this.applyFilters();
  }
  clearFilter(column: string, event: MouseEvent): void {
    event.stopPropagation();
    this.selectedFilters[column] = [];
    this.applyFilters();
    this.showFilterDropdown = false;
  }
  clearAllFilters(): void {
    this.selectedFilters = { type: [], isActive: [], line: [], zone: [] };
    this.searchTerm = '';
    this.applyFilters();
  }
  hasActiveFilters(): boolean {
    return Object.values(this.selectedFilters).some(arr => arr.length > 0) || this.searchTerm.length >= 3;
  }
  isFilterActive(column: string): boolean {
    return this.selectedFilters[column].length > 0;
  }
  getSelectedFiltersForColumn(column: string): string[] {
    return this.selectedFilters[column];
  }
  onSearch(): void {
    if (this.searchTerm.length >= 3 || this.searchTerm.length === 0) {
      this.applyFilters();
    }
  }
  applyFilters(): void {
    let data = [...this.partDetails];
    if (this.searchTerm.length >= 3) {
      const term = this.searchTerm.toLowerCase();
      data = data.filter(item => Object.values(item).some(val => val && String(val).toLowerCase().includes(term)));
    }
    ['type', 'isActive', 'line', 'zone'].forEach(col => {
      if (this.selectedFilters[col].length > 0) {
        data = data.filter(item => this.selectedFilters[col].includes(String(item[col])));
