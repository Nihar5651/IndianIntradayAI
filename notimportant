import com.github.pjfanning.xlsx.StreamingReader;

import com.kitting.entity.VcBomRaw;

import com.kitting.repositories.VcBomRawRepository;

import org.apache.poi.ss.usermodel.*;

import org.slf4j.Logger;

import org.slf4j.LoggerFactory;

import org.springframework.stereotype.Service;

import org.springframework.transaction.annotation.Transactional;

import org.springframework.web.multipart.MultipartFile;

import java.io.InputStream;

import java.math.BigDecimal;

import java.util.*;
@Service
public class FullBomStagingService {
    private static final Logger log = LoggerFactory.getLogger(FullBomStagingService.class);
    private final VcBomRawRepository rawRepo;
    // Process 5000 rows at a time to prevent memory crashes with 6 Lakh rows
    private static final int BATCH_SIZE = 5000;
    public FullBomStagingService(VcBomRawRepository rawRepo) {
        this.rawRepo = rawRepo;
    }
    /**
     * Uploads the FULL BOM (e.g., 6 Lakh rows) into the staging table.
     * No filtering. No mapping checks. Just pure data dumping.
     */
    @Transactional
    public String uploadFullRawBom(MultipartFile file, String uploadedBy) {
        log.info("🚀 STARTING RAW FULL BOM UPLOAD. Uploaded By: {}", uploadedBy);
        try (InputStream is = file.getInputStream();
             Workbook workbook = StreamingReader.builder()
                     .rowCacheSize(100)
                     .bufferSize(8192) // Slightly larger buffer for faster disk reads
                     .open(is)) {
            Sheet sheet = workbook.getSheetAt(0);
            if (sheet == null) throw new IllegalArgumentException("Excel sheet missing");
            Iterator<Row> rows = sheet.iterator();
            if (!rows.hasNext()) throw new IllegalArgumentException("Empty sheet");
            // --- Header Mapping ---
            Row headerRow = rows.next();
            DataFormatter fmt = new DataFormatter();
            Map<String, Integer> colIndex = new HashMap<>();
            for (int c = 0; c < headerRow.getLastCellNum(); c++) {
                Cell cell = headerRow.getCell(c);
                if (cell == null) continue;
                String raw = fmt.formatCellValue(cell);
                if (raw != null && !raw.isBlank()) {
                    colIndex.put(raw.trim().toLowerCase().replace(" ", "_"), c);
                }
            }
            String vcKey = colIndex.containsKey("vc") ? "vc" : "vc";
            String materialKey = colIndex.containsKey("material") ? "material" : "part_number";
            // List to hold our batch. We will clear this every 5000 rows.
            List<VcBomRaw> batchInsertList = new ArrayList<>();
            Set<String> processedVcs = new HashSet<>();
            int totalInserted = 0;
            log.info("⏳ Starting to stream and save rows directly to DB...");
            while (rows.hasNext()) {
                Row r = rows.next();
                if (r == null) continue;
                String vc = safeFmt(r, colIndex, vcKey, fmt);
                if (vc.isBlank()) continue;
                processedVcs.add(vc);
                // Map directly to your raw entity
                VcBomRaw rawEntity = new VcBomRaw();
                rawEntity.setVc(vc);
                rawEntity.setItem(safeFmt(r, colIndex, "item", fmt));
                rawEntity.setLevel(safeFmt(r, colIndex, "level", fmt));
                rawEntity.setMaterial(safeFmt(r, colIndex, materialKey, fmt));
                rawEntity.setDescription(safeFmt(r, colIndex, "description", fmt));
                String q = safeFmt(r, colIndex, "quantity", fmt);
                try {
                    rawEntity.setQuantity(q.isBlank() ? BigDecimal.ZERO : new BigDecimal(q.trim()));
                } catch (Exception e) {
                    rawEntity.setQuantity(BigDecimal.ZERO);
                }
                rawEntity.setUom(safeFmt(r, colIndex, "uom", fmt));
                rawEntity.setBulkInd(safeFmt(r, colIndex, "bulk_ind", fmt));
                rawEntity.setProcurement(safeFmt(r, colIndex, "procurement", fmt));
                rawEntity.setSpProc(safeFmt(r, colIndex, "sp_proc", fmt));
                rawEntity.setModel(safeFmt(r, colIndex, "model", fmt));
                rawEntity.setVariant(safeFmt(r, colIndex, "variant", fmt));
                rawEntity.setColor(safeFmt(r, colIndex, "color", fmt));
                batchInsertList.add(rawEntity);
                // ✅ MEMORY SAVER: Once we hit 5000, save to DB and clear the list
                if (batchInsertList.size() >= BATCH_SIZE) {
                    // Optional: If you want to overwrite existing VCs, do a delete here first
                    rawRepo.saveAll(batchInsertList);
                    totalInserted += batchInsertList.size();
                    log.info("... Saved {} rows to staging table so far ...", totalInserted);
                    batchInsertList.clear(); // FREE UP RAM
                }
            }
            // Save any remaining rows in the final batch
            if (!batchInsertList.isEmpty()) {
                rawRepo.saveAll(batchInsertList);
                totalInserted += batchInsertList.size();
            }
            log.info("✅ SUCCESS! Full Raw BOM Upload complete. Total Rows Saved: {}", totalInserted);
            return "Successfully saved " + totalInserted + " rows to the Full BOM staging table.";
        } catch (Exception ex) {
            log.error("❌ CRITICAL ERROR DURING FULL RAW BOM UPLOAD: ", ex);
            throw new RuntimeException("Upload failed: " + ex.getMessage());
        }
    }
    private String safeFmt(Row r, Map<String, Integer> colIndex, String key, DataFormatter fmt) {
        Integer idx = colIndex.get(key);
        if (idx == null) return "";
        Cell c = r.getCell(idx, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL);
        return c == null ? "" : fmt.formatCellValue(c).trim();
    }
}
package com.kitting.service;

import com.kitting.entity.GroupPart;
import com.kitting.repositories.GroupPartRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.List;

@Service
public class GroupPartService {

    private static final ZoneId IST = ZoneId.of("Asia/Kolkata");

    private final GroupPartRepository repository;

    public GroupPartService(GroupPartRepository repository) {
        this.repository = repository;
    }

    /**
     * UPSERT:
     * Same groupPart + childPart + line + zone
     * → UPDATE
     * Else → INSERT
     */
    @Transactional
    public GroupPart create(GroupPart incoming) {

        LocalDateTime now = LocalDateTime.now(IST);

        return repository
                .findByGroupPartNumberAndChildPartNumberAndLineAndZone(
                        incoming.getGroupPartNumber(),
                        incoming.getChildPartNumber(),
                        incoming.getLine(),
                        incoming.getZone()
                )
                .map(existing -> {
                    existing.setQuantity(incoming.getQuantity());
                    existing.setUpdatedAt(now);
                    return repository.save(existing);
                })
                .orElseGet(() -> {
                    incoming.setUpdatedAt(now);
                    return repository.save(incoming);
                });
    }

    public GroupPart update(Long id, GroupPart updated) {
        GroupPart existing = repository.findById(id)
                .orElseThrow(() -> new RuntimeException("GroupPart not found"));

        LocalDateTime now = LocalDateTime.now(IST);

        existing.setGroupPartNumber(updated.getGroupPartNumber());
        existing.setChildPartNumber(updated.getChildPartNumber());
        existing.setQuantity(updated.getQuantity());
        existing.setLine(updated.getLine());
        existing.setZone(updated.getZone());
        existing.setUpdatedAt(now);

        return repository.save(existing);
    }

    public void deletePermanent(Long id) {
        repository.deleteById(id);
    }

    public List<GroupPart> getAll() {
        return repository.findAll();
    }

    public List<GroupPart> getByLineZone(String line, String zone) {
        return repository.findAll()
                .stream()
                .filter(g -> g.getLine().equals(line) && g.getZone().equals(zone))
                .toList();
    }
}
package com.kitting.service;
import com.kitting.integration.ExternalEslLedPublisher;
import com.kitting.integration.ExternalEslStatusPublisher;
import jakarta.persistence.EntityManager;
import jakarta.persistence.Query;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import java.util.List;
import java.util.Map;
import java.util.Set;
/**
 * KittingCompletionService (updated)
 *
 * - Keeps original logic for selecting kitting row (by assigned led + trolley) and counting mac_pick_queue remaining parts.
 * - Performs DB updates to mark zone/isprocessed and sets kitting_completed_at = now().
 * - After DB update calls ExternalEslStatusPublisher and ExternalEslLedPublisher.
 * - External API failures will be logged; DB changes are NOT reverted on those failures.
 */
@Service
public class KittingCompletionService {
    private static final Logger log = LoggerFactory.getLogger(KittingCompletionService.class);
    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );
    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");
    private final EntityManager em;
    private final ExternalEslStatusPublisher eslStatusPublisher;
    private final ExternalEslLedPublisher eslLedPublisher;
    public KittingCompletionService(EntityManager em,
                                    ExternalEslStatusPublisher eslStatusPublisher,
                                    ExternalEslLedPublisher eslLedPublisher) {
        this.em = em;
        this.eslStatusPublisher = eslStatusPublisher;
        this.eslLedPublisher = eslLedPublisher;
    }
    /**
     * Attempt to complete kitting for the kitting-row identified by color + trolleycode (zone-specific).
     *
     * @param line       Line code e.g. "CP", "T1", "DR"
     * @param zoneNumber "1" or "2"
     * @param trolleyCode full trolley code e.g. "CPZ1T001"
     * @param color      assigned LED color
     * @param vc         VC from mac_pick_queue (optional - used as fallback)
     * @return true if completion was performed and caller should free the color in-memory
     */
    @Transactional
    public boolean attemptCompletion(String line, String zoneNumber, String trolleyCode, String color, String vc) {
        try {
            String table = KITTING_TABLES.get(line);
            if (table == null) {
                log.warn("Unknown line '{}' when attempting kitting completion.", line);
                return false;
            }
            boolean isTwoZoneLine = TWO_ZONE_LINES.contains(line);
            boolean zone2 = "2".equals(zoneNumber);
            String assignedLedCol = zone2 ? "assignedledcolorz2" : "assignedledcolor";
            String trolleyCol = zone2 ? "trolleycodez2" : "trolleycode";
            String isProcessedZoneCol = zone2 ? "isprocessedzone2" : "isprocessedzone1";
            String isReservedZoneCol = zone2 ? "isreservedzone2" : "isreservedzone1";
            // 🔥 NEW: Capture exact zone completion time
            String zoneCompletedAtCol = zone2 ? "kitting_completed_at_z2" : "kitting_completed_at_z1";
            // Select the active kitting row for this led+trolley; careful about single vs two-zone tables
            String selectKittingSql;
            if (isTwoZoneLine) {
                selectKittingSql = String.format(
                        "SELECT id, vinnumber, vcnumber, isprocessed, isprocessedzone1, isprocessedzone2 " +
                                "FROM %s " +
                                "WHERE %s = :color AND %s = :tcode AND (coalesce(%s,false) = false) " +
                                "ORDER BY id ASC LIMIT 1 FOR UPDATE",
                        table, assignedLedCol, trolleyCol, isProcessedZoneCol
                );
            } else {
                selectKittingSql = String.format(
                        "SELECT id, vinnumber, vcnumber, isprocessed, isprocessedzone1 " +
                                "FROM %s " +
                                "WHERE %s = :color AND %s = :tcode AND (coalesce(%s,false) = false) " +
                                "ORDER BY id ASC LIMIT 1 FOR UPDATE",
                        table, assignedLedCol, trolleyCol, isProcessedZoneCol
                );
            }
            Query q = em.createNativeQuery(selectKittingSql);
            q.setParameter("color", color);
            q.setParameter("tcode", trolleyCode);
            @SuppressWarnings("unchecked")
            List<Object[]> rows = q.getResultList();
            if (rows.isEmpty()) {
                log.debug("No active kitting row found for line={}, zone={}, trolley={}, color={}.",
                        line, zoneNumber, trolleyCode, color);
                return false;
            }
            Object[] r = rows.get(0);
            Number kittingIdNum = (Number) r[0];
            Long kittingId = kittingIdNum.longValue();
            String vinnumber = r[1] == null ? null : r[1].toString();
            String vcnumber = r[2] == null ? null : r[2].toString();
            Boolean isProcessed = r[3] == null ? Boolean.FALSE : (Boolean) r[3];
            Boolean isProcessedZ1 = false;
            Boolean isProcessedZ2 = false;
            if (isTwoZoneLine) {
                isProcessedZ1 = r[4] == null ? Boolean.FALSE : (Boolean) r[4];
                isProcessedZ2 = r[5] == null ? Boolean.FALSE : (Boolean) r[5];
            } else {
                isProcessedZ1 = r[4] == null ? Boolean.FALSE : (Boolean) r[4];
            }
            log.info("Kitting candidate id={} vin={} vc={} isprocessed={} z1={} z2={} (line={},zone={},trolley={},color={})",
                    kittingId, vinnumber, vcnumber, isProcessed, isProcessedZ1, isProcessedZ2, line, zoneNumber, trolleyCode, color);
            // decide which VC to use to filter mac_pick_queue
            String effectiveVc = (vc == null || vc.isBlank()) ? vcnumber : vc;
            if (effectiveVc == null || effectiveVc.isBlank()) {
                log.warn("No VC available to count mac_pick_queue rows for kittingId={} — skipping completion.", kittingId);
                return false;
            }
            // Count remaining non-PICKED parts for this VC + trolley + color
            String countSql = "SELECT count(*) FROM mac_pick_queue WHERE vc = :vc AND trolley_code = :tcode AND color = :color AND status <> 'PICKED'";
            Query cq = em.createNativeQuery(countSql);
            cq.setParameter("vc", effectiveVc);
            cq.setParameter("tcode", trolleyCode);
            cq.setParameter("color", color);
            Number cntNum = (Number) cq.getSingleResult();
            long remaining = (cntNum == null) ? 0L : cntNum.longValue();
            log.info("Remaining non-PICKED parts for vc={}, trolley={}, color={} => {}", effectiveVc, trolleyCode, color, remaining);
            if (remaining > 0) {
                // still parts remaining; nothing to do
                return false;
            }
            // Proceed to mark zone processed and clear reservation fields (atomic DB updates)
            if (!isTwoZoneLine) {
                // single-zone: mark zone1 and final processed
                String updateSql = String.format(
                        "UPDATE %s SET isprocessedzone1 = true, isprocessed = true, kitting_completed_at = now(), lastmodifiedtime = now(), %s = false, %s = NULL, %s = NULL WHERE id = :id",
                        table, isReservedZoneCol, assignedLedCol, trolleyCol
                );
                Query uq = em.createNativeQuery(updateSql);
                uq.setParameter("id", kittingId);
                int u = uq.executeUpdate();
                log.info("Kitting update (single-zone) affected rows: {}", u);
            } else {
                // two-zone: mark specific zone processed; clear reservation for that zone
                // 🔥 FIX: Now explicitly sets the zone completion time (kitting_completed_at_z1 or z2)
                String updZoneSql = String.format(
                        "UPDATE %s SET %s = true, %s = now(), lastmodifiedtime = now(), %s = false, %s = NULL, %s = NULL WHERE id = :id",
                        table, isProcessedZoneCol, zoneCompletedAtCol, isReservedZoneCol, assignedLedCol, trolleyCol
                );
                Query uq1 = em.createNativeQuery(updZoneSql);
                uq1.setParameter("id", kittingId);
                int u1 = uq1.executeUpdate();
                log.info("Kitting update (zone) affected rows: {}", u1);
                // finalize if both zones are true
                String finalizeSql = String.format(
                        "UPDATE %s SET isprocessed = true, kitting_completed_at = now(), lastmodifiedtime = now() " +
                                "WHERE id = :id AND coalesce(isprocessedzone1,false) = true AND coalesce(isprocessedzone2,false) = true",
                        table
                );
                Query uq2 = em.createNativeQuery(finalizeSql);
                uq2.setParameter("id", kittingId);
                int u2 = uq2.executeUpdate();
                log.info("Kitting finalize (both zones) affected rows: {}", u2);
            }
            log.info("Kitting completion recorded (kittingId={}, line={}, zone={}, trolley={}, color={}).",
                    kittingId, line, zoneNumber, trolleyCode, color);
            // ----- call external APIs BUT DO NOT rollback DB on failure -----
            try {
                // set ESL status to COMPLETE (articles API)
                eslStatusPublisher.publishComplete("100", trolleyCode);
            } catch (Exception ex) {
                log.error("ESL STATUS update failed for trolley {} : {}", trolleyCode, ex.getMessage());
                // do not revert DB
            }
            try {
                // turn LED for trolley tab (labels/contents/led/article)
                eslLedPublisher.publishLed(trolleyCode, color,"100");
            } catch (Exception ex) {
                log.error("ESL LED off publish failed for trolley {} : {}", trolleyCode, ex.getMessage());
                // do not revert DB
            }
            return true;
        } catch (RuntimeException ex) {
            log.error("Error while attempting kitting completion: {}", ex.getMessage(), ex);
            throw ex;
        }
    }
}
package com.kitting.service;

import com.kitting.dto.P2LDrillDownDto;
import com.kitting.dto.VcP2lMappingDto;
import com.kitting.repositories.VcBomMapRepository;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.math.BigDecimal;
import java.sql.Timestamp;
import java.time.*;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.stream.Collectors;

/**
 * Kitting live status service (strict zone columns — NO FALLBACK).
 *
 * - For T1, T2, DR (two-zone lines):
 * - Z1 uses: operatorname, trolleycode, assignedledcolor, reservedat
 * - Z2 uses: operatornamez2, trolleycodez2, assignedledcolorz2, reservedatz2
 *
 * - For CR and CP (single-zone lines): use operatorname, trolleycode, assignedledcolor, reservedat
 *
 * - All rows where isreservedzoneX = true AND isprocessedzoneX = false are included in the response.
 * - kittingStartTime is formatted to IST "yyyy-MM-dd HH:mm:ss".
 */
@Service
public class KittingLiveStatusService {

    @PersistenceContext
    private EntityManager entityManager;

    @Autowired
    private VcBomMapRepository vcBomMapRepository;

    // Mapping of line to respective kitting table
    private static final Map<String, String> KITTING_TABLES = Map.of(
            "T1", "trim1_kitting_table",
            "T2", "trim2_kitting_table",
            "DR", "door_kitting_table",
            "CR", "cradle_kitting_table",
            "CP", "cockpit_kitting_table"
    );

    // Lines with 2 zones
    private static final Set<String> TWO_ZONE_LINES = Set.of("T1", "T2", "DR");

    // IST timezone conversion
    private static final ZoneId IST_ZONE = ZoneId.of("Asia/Kolkata");
    private static final DateTimeFormatter FORMATTER =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss").withZone(IST_ZONE);

    /**
     * Returns live kitting data with summary for each line and zone.
     * Strict: Z2 uses Z2 columns only; Z1 and single-zone use Z1 columns only.
     */
    public Map<String, Object> getLiveKittingStatusWithSummary() {
        List<Map<String, Object>> allLive = new ArrayList<>();
        Map<String, Map<String, Integer>> summary = new LinkedHashMap<>();

        for (Map.Entry<String, String> entry : KITTING_TABLES.entrySet()) {
            String line = entry.getKey();
            String table = entry.getValue();

            int maxZones = TWO_ZONE_LINES.contains(line) ? 2 : 1;
            Map<String, Integer> zoneSummary = new LinkedHashMap<>();

            for (int z = 1; z <= maxZones; z++) {
                // columns to use are strictly zone-specific
                String reservedFlagCol = "isreservedzone" + z;
                String processedCol = "isprocessedzone" + z;
                String sql;

                boolean useZone2Cols = (z == 2) && TWO_ZONE_LINES.contains(line);

                if (useZone2Cols) {
                    // Z2 for multi-zone tables: use the Z2 specific columns (no fallback)
                    sql = String.format(
                            "SELECT vinnumber, vcnumber, dsn, " +
                                    "operatornamez2, trolleycodez2, assignedledcolorz2, reservedatz2 " +
                                    "FROM %s " +
                                    "WHERE %s = true AND %s = false " +
                                    "ORDER BY reservedatz2 ASC",
                            table, reservedFlagCol, processedCol
                    );
                } else {
                    // Z1 (or single-zone lines): use base columns
                    sql = String.format(
                            "SELECT vinnumber, vcnumber, dsn, " +
                                    "operatorname, trolleycode, assignedledcolor, reservedat " +
                                    "FROM %s " +
                                    "WHERE %s = true AND %s = false " +
                                    "ORDER BY reservedat ASC",
                            table, reservedFlagCol, processedCol
                    );
                }

                @SuppressWarnings("unchecked")
                List<Object[]> result = entityManager.createNativeQuery(sql).getResultList();

                for (Object[] r : result) {
                    Map<String, Object> row = new LinkedHashMap<>();
                    row.put("line", line);
                    row.put("zone", "Z" + z);

                    Object vinObj = r[0];
                    Object vcObj = r[1];
                    Object dsnObj = r[2];
                    Object operatorObj = r[3];
                    Object trolleyObj = r[4];
                    Object ledObj = r[5];
                    Object reservedObj = r[6];

                    row.put("vin", vinObj == null ? null : vinObj.toString());
                    row.put("vc", vcObj == null ? null : vcObj.toString());
                    row.put("dsn", dsnObj);
                    row.put("operator", operatorObj == null ? null : operatorObj.toString());
                    row.put("trolleyCode", trolleyObj == null ? null : trolleyObj.toString());
                    row.put("ledColor", ledObj == null ? null : ledObj.toString());

                    // 🔥 THE FIX: Bomb-proof timestamp parsing handles Strings, Instants, Dates, and Timestamps
                    if (reservedObj != null) {
                        try {
                            Instant utcInstant = null;

                            if (reservedObj instanceof Timestamp) {
                                utcInstant = ((Timestamp) reservedObj).toInstant();
                            } else if (reservedObj instanceof java.util.Date) {
                                utcInstant = ((java.util.Date) reservedObj).toInstant();
                            } else if (reservedObj instanceof Instant) {
                                utcInstant = (Instant) reservedObj;
                            } else if (reservedObj instanceof LocalDateTime) {
                                utcInstant = ((LocalDateTime) reservedObj).atZone(ZoneId.systemDefault()).toInstant();
                            } else if (reservedObj instanceof String) {
                                String timeStr = (String) reservedObj;
                                // Parse ISO String returned by Postgres (e.g. "2026-04-03T05:01:30.096822Z")
                                if (timeStr.endsWith("Z")) {
                                    utcInstant = Instant.parse(timeStr);
                                } else {
                                    utcInstant = Timestamp.valueOf(timeStr).toInstant();
                                }
                            }

                            if (utcInstant != null) {
                                String istTime = FORMATTER.format(utcInstant.atZone(IST_ZONE));
                                row.put("kittingStartTime", istTime);
                            } else {
                                row.put("kittingStartTime", reservedObj.toString());
                            }
                        } catch (Exception ex) {
                            // If parsing fails entirely, gracefully fallback to the raw string
                            row.put("kittingStartTime", reservedObj.toString());
                        }
                    } else {
                        row.put("kittingStartTime", null);
                    }

                    allLive.add(row);
                }

                // zone summary count
                zoneSummary.put("Z" + z, result.size());
            }

            summary.put(line, zoneSummary);
        }

        Map<String, Object> response = new LinkedHashMap<>();
        response.put("status", "success");
        response.put("message", allLive.isEmpty()
                ? "No active kitting in progress."
                : "Active kitting vehicles fetched successfully.");
        response.put("summary", summary);
        response.put("count", allLive.size());
        response.put("data", allLive);

        return response;
    }


    /**
     * Helper method to query the specific kitting table to see if the zone is processed.
     * UPDATED to accurately check 1-zone vs 2-zone table columns.
     */
    private boolean checkZoneStatus(String vin, String line, String zone) {
        String tableName = KITTING_TABLES.get(line);
        if (tableName == null || zone == null) {
            return false;
        }

        boolean isTwoZone = TWO_ZONE_LINES.contains(line);
        String processColumn;

        if (!isTwoZone) {
            processColumn = "isprocessed"; // 1-zone lines (CR, CP)
        } else {
            String zoneNum = zone.toUpperCase().replace("Z", "");
            processColumn = "isprocessedzone" + zoneNum; // 2-zone lines (T1, T2, DR)
        }

        String sql = String.format("SELECT %s FROM %s WHERE vinnumber = :vin", processColumn, tableName);

        try {
            Boolean isProcessed = (Boolean) entityManager.createNativeQuery(sql)
                    .setParameter("vin", vin)
                    .getSingleResult();
            return isProcessed != null && isProcessed;
        } catch (Exception e) {
            return false;
        }
    }

    // 🔥 NEW HELPER: Fetches the exact LED color assigned to this VIN
    private String fetchLedColorForVin(String vin, String line, String zone) {
        try {
            String table = KITTING_TABLES.get(line);
            if (table == null) return null;

            boolean isTwoZone = TWO_ZONE_LINES.contains(line);
            String colorColumn = "assignedledcolor"; // Default for Z1 or single-zone

            if (isTwoZone && "Z2".equalsIgnoreCase(zone)) {
                colorColumn = "assignedledcolorz2";
            }

            String sql = "SELECT " + colorColumn + " FROM " + table + " WHERE vinnumber = :vin LIMIT 1";
            Object result = entityManager.createNativeQuery(sql)
                    .setParameter("vin", vin)
                    .getSingleResult();

            return result != null ? result.toString() : null;
        } catch (Exception e) {
            return null;
        }
    }


    /**
     * Fetches the mapped parts. If the zone is already marked complete in the DB,
     * it forces all parts to PICKED so the frontend UI can hit 100% and auto-close.
     */
    public List<P2LDrillDownDto> getDrillDownDetails(String vin, String vc, String line, String zone) {
        // 1. Get the static required parts from the God Query
        List<Object[]> rawData = vcBomMapRepository.findStaticP2LMapping(vc, line, zone);
        List<P2LDrillDownDto> resultList = new ArrayList<>();

        if (rawData == null || rawData.isEmpty()) {
            return resultList;
        }

        // 🚨 THE FIX: Check if the database already marked this zone as complete!
        boolean isZoneCompleted = checkZoneStatus(vin, line, zone);

        // 2. Extract all MACs into a list for our fast query
        List<String> macList = new ArrayList<>();
        for (Object[] row : rawData) {
            if (row[1] != null && !row[1].toString().trim().isEmpty()) {
                macList.add(row[1].toString().trim());
            }
        }

        // 3. Fetch Live Part-by-Part Statuses
        Map<String, String> liveStatuses = new HashMap<>();
        Map<String, String> blinkStatuses = new HashMap<>();

        if (!isZoneCompleted && !macList.isEmpty()) {
            // Fetch picking status
            liveStatuses = getLiveMacStatuses(vin, vc, line, zone);

            // 🔥 THE FIX: Get the color for this specific VIN first!
            String currentLedColor = fetchLedColorForVin(vin, line, zone);

            // 🔥 Pass the color into the query so it ONLY fetches hardware events for THIS car
            blinkStatuses = getLiveBlinkStatuses(macList, currentLedColor);
        }

        // 4. Map to DTO
        for (Object[] row : rawData) {
            P2LDrillDownDto dto = new P2LDrillDownDto();
            dto.setP2lRackId(row[0] != null ? row[0].toString() : "");

            String macAddress = row[1] != null ? row[1].toString().trim() : "";
            dto.setMacAddress(macAddress);
            dto.setPartNumber(row[2] != null ? row[2].toString() : "");
            dto.setDescription(row[3] != null ? row[3].toString() : "");

            // Safely parse quantity
            if (row[4] != null) {
                try {
                    dto.setQuantity(new BigDecimal(row[4].toString().trim()));
                } catch (Exception e) {
                    dto.setQuantity(BigDecimal.ZERO);
                }
            } else {
                dto.setQuantity(BigDecimal.ZERO);
            }

            // --- THE MAGIC: Assign status and icons part-by-part ---
            if (isZoneCompleted) {
                dto.setStatus("PICKED");
                dto.setBlinkIcon("✅"); // If zone is complete, all blinks were successful
            } else {
                // Set the Picking Status (WAITING / PICKED)
                String partStatus = liveStatuses.getOrDefault(macAddress, "WAITING");
                if (partStatus.equalsIgnoreCase("PICKED")) {
                    dto.setStatus("PICKED");
                } else {
                    dto.setStatus("WAITING");
                }

                // 🔥 Set the Beautiful Blink Icons based on the specific hardware event
                String blinkStatus = blinkStatuses.get(macAddress);

                if ("BLINK_SUCCESS".equalsIgnoreCase(blinkStatus)) {
                    dto.setBlinkIcon("✅"); // Green checkmark
                } else if ("BLINK_FAIL".equalsIgnoreCase(blinkStatus)) {
                    dto.setBlinkIcon("❌"); // Red cross
                } else {
                    dto.setBlinkIcon("➖"); // Dash for Null/Waiting/Unknown
                }
            }

            resultList.add(dto);
        }

        return resultList;
    }


    /**
     * Highly Optimized Live Blink Status Query
     * Fetches the absolute latest hardware event per MAC FOR A SPECIFIC COLOR.
     */
    public Map<String, String> getLiveBlinkStatuses(List<String> macAddresses, String ledColor) {
        // 🔥 THE FIX: Now safely handles null ledColor to avoid SQL errors
        if (macAddresses == null || macAddresses.isEmpty() || ledColor == null) {
            return new HashMap<>();
        }

        // 🔥 THE 3.5 MILLION ROW SPEED HACK 🔥
        // Added led_color = :color to prevent cross-car status contamination
        String sql =
                "SELECT DISTINCT ON (mac_address) mac_address, picking_link_status " +
                        "FROM sse_pick_events " +
                        "WHERE mac_address IN (:macs) " +
                        "  AND led_color = :color " +
                        "  AND received_at >= NOW() - INTERVAL '24 hours' " +
                        "ORDER BY mac_address, received_at DESC";

        @SuppressWarnings("unchecked")
        List<Object[]> rows = entityManager.createNativeQuery(sql)
                .setParameter("macs", macAddresses)
                .setParameter("color", ledColor)
                .getResultList();

        Map<String, String> resultMap = new HashMap<>();
        for (Object[] row : rows) {
            String mac = row[0] != null ? row[0].toString() : "";
            String status = row[1] != null ? row[1].toString() : "";
            resultMap.put(mac, status);
        }

        return resultMap;
    }


    /**
     * Helper method to grab the trolley_code for the VIN, then fetch all active part statuses from mac_pick_queue.
     */
    private Map<String, String> getLiveMacStatuses(String vin, String vc, String line, String zone) {
        Map<String, String> statusMap = new HashMap<>();

        try {
            // A. Find the currently active Trolley Code for this VIN
            String tableName = KITTING_TABLES.get(line);
            String zoneNum = zone.toUpperCase().replace("Z", "");
            boolean isMultiZone = TWO_ZONE_LINES.contains(line);

            String trolleyCol = (isMultiZone && "2".equals(zoneNum)) ? "trolleycodez2" : "trolleycode";
            String tSql = String.format("SELECT %s FROM %s WHERE vinnumber = :vin", trolleyCol, tableName);

            Object trolleyObj = entityManager.createNativeQuery(tSql)
                    .setParameter("vin", vin)
                    .getSingleResult();

            if (trolleyObj == null) {
                return statusMap;
            }

            String trolleyCode = trolleyObj.toString();

            // B. Use DISTINCT ON to get only the LATEST row for each MAC Address
            String qSql = "SELECT DISTINCT ON (mac_address) mac_address, status " +
                    "FROM mac_pick_queue " +
                    "WHERE vc = :vc AND line = :line AND zone = :zone AND trolley_code = :trolleyCode " +
                    "ORDER BY mac_address, id DESC"; // id DESC ensures we get the newest row

            @SuppressWarnings("unchecked")
            List<Object[]> queueData = entityManager.createNativeQuery(qSql)
                    .setParameter("vc", vc)
                    .setParameter("line", line)
                    .setParameter("zone", zone)
                    .setParameter("trolleyCode", trolleyCode)
                    .getResultList();

            // C. Map the results. Treat "WAITING_BLINK" as "WAITING" for the UI.
            for (Object[] row : queueData) {
                if (row[0] != null && row[1] != null) {
                    String mac = row[0].toString();
                    String rawStatus = row[1].toString().toUpperCase();

                    if (rawStatus.contains("WAITING")) {
                        statusMap.put(mac, "WAITING");
                    } else {
                        statusMap.put(mac, rawStatus);
                    }
                }
            }
        } catch (Exception e) {
            System.err.println("Error fetching live MAC statuses: " + e.getMessage());
        }

        return statusMap;
    }

    public List<VcP2lMappingDto> getVcPartsMapping(String vc) {
        List<Object[]> rawResults = vcBomMapRepository.findAllLinesAndZonesP2LMapping(vc);

        return rawResults.stream().map(row -> new VcP2lMappingDto(
                (String) row[0],                                    // lineName
                (String) row[1],                                    // zoneName
                (String) row[2],                                    // p2lRackId
                (String) row[3],                                    // macAddress
                (String) row[4],                                    // partNumber
                (String) row[5],                                    // description
                row[6] != null ? ((Number) row[6]).intValue() : 0,  // quantity (safely cast to int)
                (String) row[7],                                    // rack
                (String) row[8],                                    // rowNo
                (String) row[9]                                     // columnNo
        )).collect(Collectors.toList());
    }
