package com.kitting.appender;

import org.apache.log4j.FileAppender;
import org.apache.log4j.helpers.OptionConverter;
import org.apache.log4j.spi.LoggingEvent;

import java.io.File;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.concurrent.TimeUnit;

public class DailyFolderRollingAppender extends FileAppender {
    private long maxFileSizeInBytes = 10 * 1024 * 1024;
    private int maxBackupDays = 10;
    private String datePattern = "yyyy-MM-dd";
    private SimpleDateFormat sdf;
    private String currentLogFolder;
  
    public void setMaxFileSizeInBytes(String value) {
        maxFileSizeInBytes = OptionConverter.toFileSize(value, maxFileSizeInBytes);
    }

    public void setMaxBackupDays(int maxBackupDays) {
        this.maxBackupDays = maxBackupDays;
    }

    @Override
    public void activateOptions() {
        sdf = new SimpleDateFormat(datePattern);
        deleteOldFolders();
        createNewLogFolder();
        super.activateOptions(); // Ensure superclass options are activated
    }


    @Override
    protected void subAppend(LoggingEvent event) {
        try {
            if (shouldCreateNewFolder()) {
                deleteOldFolders(); // Delete before creating new folder
                createNewLogFolder();
            }

            File logFile = new File(getFile());
            if (logFile.length() >= maxFileSizeInBytes) {
                rollOverBySize();
            }
        } catch (Exception e) {
            System.err.println("Error in subAppend: " + e.getMessage());
        }

        super.subAppend(event);
    }


    private boolean shouldCreateNewFolder() {
        String newFolder = sdf.format(new Date());
        return !newFolder.equals(currentLogFolder);
    }

    private void createNewLogFolder() {
        currentLogFolder = sdf.format(new Date());
        File logDir = new File("logs/" + currentLogFolder);
        if (!logDir.exists()) {
            logDir.mkdirs();
        }

        String newFileName = logDir.getPath() + "/Kitting.log";
        try {
            setFile(newFileName, true, bufferedIO, bufferSize);
        } catch (IOException e) {
            errorHandler.error("Error setting new log file after folder rollover.", e, 0);
        }
    }

    private void rollOverBySize() {
        this.closeFile(); // Close current log file

        String newFileName;
        int fileIndex = 1;
        do {
            newFileName = String.format("logs/%s/Kitting%d.log", currentLogFolder, fileIndex++);
        } while (new File(newFileName).exists());

        try {
            setFile(newFileName, true, bufferedIO, bufferSize);
        } catch (IOException e) {
            errorHandler.error("Error setting new log file after size rollover.", e, 0);
        }
    }


    private void deleteOldFolders() {
        File logDir = new File("logs");
        File[] files = logDir.listFiles();
        if (files != null) {
            long cutoff = System.currentTimeMillis() - TimeUnit.DAYS.toMillis(maxBackupDays);
            Date cutoffDate = new Date(cutoff);

            for (File file : files) {
                if (file.isDirectory()) {
                    String folderName = file.getName();
                    try {
                        Date folderDate = sdf.parse(folderName);
                        if (folderDate.before(cutoffDate)) {
//                            if (currentLogFolder.equals(folderName)) {
//                                this.closeFile(); // Close the current log file if it's being deleted
//                            }
                            deleteDirectory(file);
                        }
                    } catch (Exception e) {
                        System.err.println("Unable to parse folder name: " + folderName);
                    }
                }
            }
        }
    }

    private void deleteDirectory(File directory) {
        File[] files = directory.listFiles();
        if (files != null) {
            for (File file : files) {
                if (file.isDirectory()) {
                    deleteDirectory(file);
                } else {
                    System.out.println("Deleting file: " + file.getPath());
                    if (!file.delete()) {
                        System.err.println("Failed to delete file: " + file.getPath());
                    }
                }
            }
        }

        // Attempt to delete the directory itself
        System.out.println("Deleting directory: " + directory.getPath());
        if (!directory.delete()) {
            System.err.println("Failed to delete directory: " + directory.getPath());
        }
    }

}
