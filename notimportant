            // Calculate column widths after a brief delay to ensure DOM is ready
            setTimeout(() => {
              this.calculateColumnWidths();
            }, 0);
          }
          this.isLoading = false;
        },
        error: (error) => {
          console.error('Error fetching VC details:', error);
          this.showError('Load Error', 'Failed to load VC details');
          this.isLoading = false;
        }
      });
  }
  // Format timestamp to YYYY-MM-DD HH:mm:ss
  formatTimestamp(timestamp: string | null | undefined): string {
    if (!timestamp) return '';
    try {
      const date = new Date(timestamp);
      // Check if date is valid
      if (isNaN(date.getTime())) {
        return timestamp; // Return original if invalid date
      }
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      const hours = String(date.getHours()).padStart(2, '0');
      const minutes = String(date.getMinutes()).padStart(2, '0');
      const seconds = String(date.getSeconds()).padStart(2, '0');
      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
    } catch (error) {
      console.error('Error formatting timestamp:', error);
      return timestamp || '';
    }
  }
  calculateColumnWidths(): void {
    if (!this.dataTable || this.vcDetails.length === 0) return;
    this.columnWidths = {};
    this.tableColumns.forEach(column => {
      const columnName = this.getColumnDisplayName(column);
      // Calculate width based on content analysis
      let maxContentWidth = this.calculateMaxContentWidth(column);
      // Add some padding and ensure minimum width
      const calculatedWidth = Math.max(120, maxContentWidth + 20);
      // Set a reasonable maximum to prevent extremely wide columns
      const finalWidth = Math.min(400, calculatedWidth);
      this.columnWidths[column] = `${finalWidth}px`;
    });
  }
  calculateMaxContentWidth(column: string): number {
    // Base width from column header
    const headerWidth = this.getColumnDisplayName(column).length * 8;
    // Calculate maximum content width from actual data
    let maxContentWidth = headerWidth;
    // Check current page items for content length
    this.paginatedItems.forEach(item => {
      const value = item[column];
      if (value) {
        const contentWidth = value.toString().length * 7; // Approximate character width
        maxContentWidth = Math.max(maxContentWidth, contentWidth);
      }
    });
    return maxContentWidth;
  }
  getColumnWidth(column: string): string {
    return this.columnWidths[column] || 'auto';
  }
  onSearch(): void {
    if (this.searchTerm.length < 3) {
      this.filteredVcDetails = [...this.vcDetails];
    } else {
      const searchLower = this.searchTerm.toLowerCase();
      this.filteredVcDetails = this.vcDetails.filter((item) =>
        Object.values(item).some(
          (val) => val && val.toString().toLowerCase().includes(searchLower)
        )
      );
    }
    this.totalItems = this.filteredVcDetails.length;
    this.currentPage = 1; // Reset to first page on new search
    // Recalculate column widths after search/filter
    setTimeout(() => {
      this.calculateColumnWidths();
    }, 0);
  }
  onFileSelected(event: any): void {
    const file: File = event.target.files[0];
    if (!file) return;
    // Check if file is Excel format
    if (!file.name.match(/\.(xlsx|xls)$/i)) {
      this.showError('File Format Error', 'Please upload a valid Excel file');
      event.target.value = "";
      return;
    }
    this.uploadExcel(file, event);
  }
  uploadExcel(file: File, event: any): void {
    this.isLoading = true;
    this.uploadMessage = '';
    this.uploadError = '';
    const reader: FileReader = new FileReader();
    reader.readAsArrayBuffer(file);
    reader.onload = (e: any) => {
      const binarystr: string = e.target.result;
      const wb: WorkBook = read(binarystr, { type: 'binary' });
      /* selected the first sheet */
      const wsname: string = wb.SheetNames[0];
      const ws: WorkSheet = wb.Sheets[wsname];
      // Convert sheet to JSON
      const data = utils.sheet_to_json(ws);
      // Validate VC field length
      const invalidVCs = data.filter((record: any) => {
        const vc = record.VC || record.vc;
        return !vc || vc.toString().length !== 12;
      });
      if (invalidVCs.length > 0) {
        this.showError('Validation Error', 'All VC values must be exactly 12 characters long');
        this.isLoading = false;
        event.target.value = "";
        return;
      }
      // Check for duplicate entries
      let VCS = data.flatMap<string>((record: any) =>
        record.VC ? [record.VC] : []
      );
      console.log(VCS);
      const uniques = new Set<string>();
      for (let VC of VCS) {
        if (uniques.has(VC)) {
          this.showError('Duplicate VC Found', `Found duplicate VC in excel: ${VC}`);
          this.isLoading = false;
          event.target.value = "";
          return;
        }
        uniques.add(VC);
      }
      // Upload part using AuthService with variable endpoint
      const formData = new FormData();
      formData.append('file', file);
      this.authService
        .httpPostRequest(`${Global['VC_UPLOAD_DETAILS']}`, formData, {
          responseType: 'text'
        })
        .pipe(
          catchError((error) => {
            console.error('Upload error:', error);
            this.showError('Upload Failed', error.error || 'Upload failed');
            this.isLoading = false;
            event.target.value = "";
            return of('');
          })
        )
        .subscribe({
          next: (response: any) => {
            console.log(response);
            const parsedResponse = typeof response === 'string' ? JSON.parse(response) : response;
            this.showSuccess('Upload Successful', parsedResponse.message);
            this.loadVCDetails(); // Refresh the data after upload
            this.isLoading = false;
            // Clear file input
            const fileInput = document.getElementById(
              'excelFile'
            ) as HTMLInputElement;
            if (fileInput) fileInput.value = '';
          },
          error: (error) => {
            console.error('Upload error:', error);
            this.isLoading = false;
            event.target.value = "";
          },
        });
    };
  }
  // Export to Excel Functionality
  exportToExcel(): void {
    if (this.vcDetails.length === 0) {
      this.showError('Export Warning', 'No data available to export.');
      return;
    }
    // Map keys to readable display headers using your existing getColumnDisplayName mapping logic
    const exportData = this.vcDetails.map((item, index) => {
      const formattedRow: { [key: string]: any } = {
        'Sr. No.': index + 1
      };
      this.tableColumns.forEach(column => {
        const displayName = this.getColumnDisplayName(column);
        formattedRow[displayName] = item[column] ?? '';
      });
      return formattedRow;
    });
    // Create a new sheet and workbook configuration
    const worksheet: WorkSheet = utils.json_to_sheet(exportData);
    const workbook: WorkBook = utils.book_new();
    utils.book_append_sheet(workbook, worksheet, 'VC Details');
    // Trigger explicit download package action
    const fileName = `VC_Details_Export_${new Date().toISOString().split('T')[0]}.xlsx`;
    writeFile(workbook, fileName);
  }
  // Modal methods
  showSuccess(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showSuccessModal = true;
  }
  showError(title: string, message: string): void {
    this.modalTitle = title;
    this.modalMessage = message;
    this.showErrorModal = true;
  }
  closeSuccessModal(): void {
    this.showSuccessModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  closeErrorModal(): void {
    this.showErrorModal = false;
    this.modalTitle = '';
    this.modalMessage = '';
  }
  // Get serial number based on current page and index
  getSerialNumber(index: number): number {
    return (this.currentPage - 1) * this.itemsPerPage + index + 1;
  }
  // Pagination methods
  get paginatedItems(): VCDetail[] {
    const startIndex = (this.currentPage - 1) * this.itemsPerPage;
    return this.filteredVcDetails.slice(
      startIndex,
      startIndex + this.itemsPerPage
    );
  }
  get totalPages(): number {
    return Math.ceil(this.totalItems / this.itemsPerPage);
  }
  goToPage(page: number): void {
    if (page >= 1 && page <= this.totalPages) {
      this.currentPage = page;
      // Recalculate column widths after page change
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  previousPage(): void {
    if (this.currentPage > 1) {
      this.currentPage--;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  nextPage(): void {
    if (this.currentPage < this.totalPages) {
      this.currentPage++;
      setTimeout(() => {
        this.calculateColumnWidths();
      }, 0);
    }
  }
  getPageNumbers(): number[] {
    const pages = [];
    const maxVisiblePages = 5;
    let startPage = Math.max(
      1,
      this.currentPage - Math.floor(maxVisiblePages / 2)
    );
    let endPage = Math.min(this.totalPages, startPage + maxVisiblePages - 1);
    if (endPage - startPage + 1 < maxVisiblePages) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }
    for (let i = startPage; i <= endPage; i++) {
      pages.push(i);
    }
    return pages;
  }
  minimum(a: any, b: any): any {
    return Math.min(a, b);
  }
  getColumnDisplayName(column: string): string {
    // Special mapping for column names to display names
    const columnDisplayMap: { [key: string]: string } = {
       'vc':'VC',
       'vcShortDesc':'VC Short Description',
       'colortosap':'Color to SAP',
       'uploadTimestamp': 'Upload Timestamp'
    };
    // Return mapped display name or convert to title case
    if (columnDisplayMap[column]) {
      return columnDisplayMap[column];
    }
    // Fallback: Convert camelCase to Title Case with spaces
    const result = column
      .replace(/([A-Z])/g, ' $1')
      .replace(/([A-Z])([A-Z][a-z])/g, '$1 $2')
      .replace(/^./, str => str.toUpperCase())
      .trim();
    // Special case handling for common abbreviations
    const specialCases: { [key: string]: string } = {
      'Row No': 'Row',
      'Column No': 'Column',
    };
    return specialCases[result] || result;
  }
