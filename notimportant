        try {
            String sql = "SELECT * FROM Console_Tabs_List";
            List<Map<String, Object>> tabs = jdbcTemplate.queryForList(sql);
            List<Map<String, Object>> formattedTabs = formatTabs(tabs);
            Map<String, Object> response = new HashMap<>();
            response.put("status", 200);
            response.put("message", "Tabs List");
            response.put("data", formattedTabs);
            return ResponseEntity.ok(response);
        } catch (Exception e) {
            e.printStackTrace();
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(null);
        }
    }

    private List<Map<String, Object>> formatTabs(List<Map<String, Object>> tabs) {
        List<Map<String, Object>> formattedTabs = new ArrayList<>();
        Map<String, List<Map<String, Object>>> reportsMap = new HashMap<>();

        for (Map<String, Object> tab : tabs) {
            String tabName = (String) tab.get("tab_name");
            int tabId = (int) tab.get("tab_id");

            if (tabName.startsWith("Reports")) {
                String category = "Reports";
                reportsMap.putIfAbsent(category, new ArrayList<>());
                List<Map<String, Object>> categoryTabs = reportsMap.get(category);
                Map<String, Object> reportTab = new HashMap<>();
                reportTab.put("label", tabName.substring(tabName.indexOf(":") + 2));
                reportTab.put("tab_id", tabId);
                categoryTabs.add(reportTab);
            } else {
                Map<String, Object> tabMap = new HashMap<>();
                tabMap.put("label", tabName);
                tabMap.put("tab_id", tabId);
                formattedTabs.add(tabMap);
            }
        }

        if (!reportsMap.isEmpty()) {
            Map<String, Object> reportsCategory = new HashMap<>();
            reportsCategory.put("label", "Reports");
            reportsCategory.put("children", reportsMap.get("Reports"));
            formattedTabs.add(reportsCategory);
        }

        return formattedTabs;
    }

    @PostMapping("/addTab")
    public ResponseEntity<?> addTab(@RequestBody Map<String, String> requestBody) {
        String tabName = requestBody.get("tab_name");
        try (Connection connection = DataSourceUtils.getConnection(PostgresDataSource);) {
            // Insert tab into Console_Tabs_List
            logger.info("Tab Name: " + tabName);
            String insertTabQuery = "INSERT INTO Console_Tabs_List (tab_name) VALUES (?)";
            try (PreparedStatement preparedStatement = connection.prepareStatement(insertTabQuery)) {
                preparedStatement.setString(1, tabName);
                int rowsAffected = preparedStatement.executeUpdate();
                if (rowsAffected == 0) {
                    return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Failed to add tab.");
                }
            }

            // Check and insert tab into Console_User_Access_Management for missing users
            String checkUserAccessQuery = "SELECT DISTINCT user_id FROM Console_User_Access_Management";
            try (PreparedStatement preparedStatement = connection.prepareStatement(checkUserAccessQuery)) {
                ResultSet resultSet = preparedStatement.executeQuery();
                while (resultSet.next()) {
                    int userId = resultSet.getInt("user_id");
                    String insertUserAccessQuery = "INSERT INTO Console_User_Access_Management (user_id, tab_id) " +
                            "SELECT ?, tab_id FROM Console_Tabs_List WHERE tab_name = ? " +
                            "AND NOT EXISTS (SELECT 1 FROM Console_User_Access_Management WHERE user_id = ? AND tab_id = Console_Tabs_List.tab_id)";

                    try (PreparedStatement insertStatement = connection.prepareStatement(insertUserAccessQuery)) {
                        insertStatement.setInt(1, userId);
                        insertStatement.setString(2, tabName);
                        insertStatement.setInt(3, userId);
                        int rowsInserted = insertStatement.executeUpdate();
                        if (rowsInserted == 0) {
                            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("{\"status\": 500, \"message\": \"Failed to add tab access for user " + userId + "\"}");
                        }
                    }
                }
            }

            return ResponseEntity.ok("{\"status\": 200, \"message\": \"Tab added successfully\"}");
        } catch (SQLException e) {
            e.printStackTrace();
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("{\"status\": 500, \"message\": \"Error adding tab\"}");
        }
    }

}

