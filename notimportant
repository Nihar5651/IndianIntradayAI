  // Helper methods to collapse children when parent is collapsed
  private collapseAllChildren(line: Line): void {
    line.zones.forEach(zone => {
      const zoneKey = this.getZoneKey(zone, line);
      this.expandedZones.delete(zoneKey);
      this.collapseZoneChildren(zone, line);
    });
  }
  private collapseZoneChildren(zone: Zone, line: Line): void {
    zone.racks.forEach(rack => {
      const rackKey = this.getRackKey(rack, zone, line);
      this.expandedRacks.delete(rackKey);
      this.collapseRackChildren(rack, zone, line);
    });
  }
  private collapseRackChildren(rack: Rack, zone: Zone, line: Line): void {
    rack.rows.forEach(row => {
      const rowKey = this.getRowKey(row, rack, zone, line);
      this.expandedRows.delete(rowKey);
    });
  }
  // Helper methods for tree connectors
  isLastZone(line: Line, zoneIndex: number): boolean {
    return zoneIndex === line.zones.length - 1;
  }
  isLastRack(zone: Zone, rackIndex: number): boolean {
    return rackIndex === zone.racks.length - 1;
  }
  isLastRow(rack: Rack, rowIndex: number): boolean {
    return rowIndex === rack.rows.length - 1;
  }
  isLastColumn(row: Row, columnIndex: number): boolean {
    return columnIndex === row.columns.length - 1;
  }
