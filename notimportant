/**

 * Calls ESL Pick-to-Light API:

 * PUT {external.p2l.url} with JSON array body.

 * Now operates linearly with a 40ms delay to prevent AIMS ForkJoinPool gateway crashes.

 * Catches 406 errors to bypass offline/broken lights without failing the transaction.

 */

@Service

public class ExternalPickToLightPublisher {

    private static final Logger log = LoggerFactory.getLogger(ExternalPickToLightPublisher.class);

    @Value("${external.p2l.url:https://172.25.86.106:9002/labels/contents/led/article}")

    private String endpointUrl;

    // Fixed fields per requirement

    private static final String FIXED_STATION_CODE = "100";

    private static final String FIXED_DURATION = "60m";

    private static final int FIXED_PATTERN_ID = 1;

    // trust-all (requested)

    private static final boolean TRUST_ALL_SSL = true;

    private volatile RestTemplate restTemplate; // lazy init

    private final ObjectMapper objectMapper = new ObjectMapper();

    /**

     * Publish Pick-to-Light for many articles (parts) at once.

     * @param articleIds list of articleId (from mac_articleid_kitting) for the VC+line+zone

     * @param color assigned LED color (e.g., RED/BLUE/etc.)

     * @return ResponseEntity<String> if HTTP 200/202/206; otherwise throws RuntimeException

     */

    public ResponseEntity<String> publishPickToLights(List<String> articleIds, String color) {

        if (articleIds == null || articleIds.isEmpty()) {

            throw new RuntimeException("Pick-to-Light: articleIds list is empty.");

        }

        log.info("▶️ External P2L PUT {} | Parts to pick: {}", endpointUrl, articleIds.size());

        HttpHeaders headers = new HttpHeaders();

        headers.setContentType(MediaType.valueOf("application/json;charset=UTF-8"));

        headers.setAccept(List.of(MediaType.valueOf("application/json;charset=UTF-8")));

        ResponseEntity<String> lastResp = ResponseEntity.ok().build(); // Default safe response

        // 🔥 THE LINEAR SPEEDRUN HACK 🔥

        // Send 1 part at a time to prevent AIMS from multi-threading and crashing the Gateway

        for (String id : articleIds) {

            Map<String, Object> item = new LinkedHashMap<>();

            item.put("color", nz(color));

            item.put("duration", FIXED_DURATION);

            item.put("patternId", FIXED_PATTERN_ID);

            item.put("stationCode", FIXED_STATION_CODE);

            item.put("articleId", nz(id));

            // Wrap single item in a list to match the required JSON array schema

            String jsonBody = toJson(List.of(item));

            HttpEntity<String> entity = new HttpEntity<>(jsonBody, headers);

            try {

                lastResp = getClient().exchange(endpointUrl, HttpMethod.PUT, entity, String.class);

                int statusCode = lastResp.getStatusCode().value();

                if (statusCode != 200 && statusCode != 202 && statusCode != 206) {

                    if (statusCode == 406) {

                        log.warn("⚠️ Pick 2 light [{}] does not exist in this zone replace it", id);

                        continue; // Skip this broken light, move to the next one

                    }

                    throw new RuntimeException("External P2L PUT failed for " + id + " with status " + statusCode);

                }

                // 🛑 40ms microscopic delay.

                Thread.sleep(40);

            } catch (HttpStatusCodeException ex) {

                // 🔥 Spring Boot throws HttpStatusCodeException for 4xx errors

                if (ex.getStatusCode().value() == 406) {

                    log.warn("⚠️ Pick 2 light [{}] does not exist in this zone replace it", id);

                    continue; // Skip this broken light, move to the next one without crashing

                }

                log.error("❌ External P2L PUT error for id {}: {}", id, ex.getMessage());

                throw new RuntimeException("External P2L PUT error: " + ex.getMessage(), ex);

            } catch (RestClientException ex) {

                log.error("❌ External P2L PUT error for id {}: {}", id, ex.getMessage());

                throw new RuntimeException("External P2L PUT error: " + ex.getMessage(), ex);

            } catch (InterruptedException ie) {

                Thread.currentThread().interrupt();

                throw new RuntimeException("P2L Thread Interrupted", ie);

            }

        }

        return lastResp;

    }

    // ---------- internals ----------

    private RestTemplate getClient() {

        RestTemplate rt = restTemplate;

        if (rt != null) return rt;

        synchronized (this) {

            if (restTemplate != null) return restTemplate;

            if (!TRUST_ALL_SSL) {

                restTemplate = new RestTemplate();

                return restTemplate;

            }

            try {

                SSLContext sslContext = SSLContextBuilder.create()

                        .loadTrustMaterial(null, TrustAllStrategy.INSTANCE)

                        .build();

                SSLConnectionSocketFactory sslSocketFactory = SSLConnectionSocketFactoryBuilder.create()

                        .setSslContext(sslContext)

                        .setHostnameVerifier(NoopHostnameVerifier.INSTANCE)

                        .build();

                var connMgr = PoolingHttpClientConnectionManagerBuilder.create()

                        .setSSLSocketFactory(sslSocketFactory)

                        .build();

                HttpClient httpClient = HttpClients.custom()

                        .setConnectionManager(connMgr)

                        .build();

                HttpComponentsClientHttpRequestFactory factory =

                        new HttpComponentsClientHttpRequestFactory(httpClient);

                restTemplate = new RestTemplate(factory);

                log.warn("ExternalPickToLightPublisher: INSECURE SSL ENABLED (trust-all + no hostname verification).");

            } catch (Exception e) {

                log.error("Failed to build insecure SSL client. Falling back to default RestTemplate.", e);

                restTemplate = new RestTemplate();

            }

            return restTemplate;

        }

    }

    private String toJson(Object obj) {

        try {

            return objectMapper.writeValueAsString(obj);

        } catch (JsonProcessingException e) {

            log.warn("Failed to serialize JSON for log/body, falling back: {}", e.getMessage());

            return String.valueOf(obj);

