@Service
public class VcBomProcessingService {

    // ✅ Added SLF4J Logger
    private static final Logger log = LoggerFactory.getLogger(VcBomProcessingService.class);

    private final VCDetailsRepository vcDetailsRepo;
    private final PartMasterRepository partRepo;
    private final VcBomMapRepository bomRepo;
    private final MacArticleRepository macRepo;
    private static final int BATCH_SIZE = 1000;

    public VcBomProcessingService(VCDetailsRepository vcDetailsRepo,
                                  PartMasterRepository partRepo,
                                  VcBomMapRepository bomRepo,
                                  MacArticleRepository macRepo) {
        this.vcDetailsRepo = vcDetailsRepo;
        this.partRepo = partRepo;
        this.bomRepo = bomRepo;
        this.macRepo = macRepo;
    }

    /**
     * STANDARD API: For smaller files (Uses heavy XSSFWorkbook)
     */
    @Transactional
    public ProcessingResult processBomFile(MultipartFile file, String uploadedBy) {
        try (InputStream is = file.getInputStream();
             Workbook workbook = new XSSFWorkbook(is)) {

            Sheet sheet = workbook.getSheetAt(0);
            if (sheet == null) throw new IllegalArgumentException("Excel sheet missing");
            Iterator<Row> rows = sheet.iterator();
            if (!rows.hasNext()) throw new IllegalArgumentException("Empty sheet");

            Row headerRow = rows.next();
            DataFormatter fmt = new DataFormatter();
            Map<String, Integer> colIndex = new HashMap<>();
            for (int c = 0; c < headerRow.getLastCellNum(); c++) {
                String raw = fmt.formatCellValue(headerRow.getCell(c));
                if (raw == null) continue;
                colIndex.put(raw.trim().toLowerCase().replace(" ", "_"), c);
            }

            String vcKey = "vc";
            String materialKey = "material";
            if (!colIndex.containsKey(vcKey)) {
                vcKey = headerRow.getCell(0) != null
                        ? headerRow.getCell(0).toString().trim().toLowerCase().replace(" ", "_")
                        : "vc";
            }
            if (!colIndex.containsKey(materialKey)) {
                if (colIndex.containsKey("part_number")) materialKey = "part_number";
                else throw new IllegalArgumentException("Expected header 'MATERIAL' or 'PART_NUMBER' not found in Excel");
            }

            class RowDto {
                String vc; String item; String level; String material; String description;
                BigDecimal quantity; String uom; String bulkInd; String procurement; String spProc;
                String model; String variant; String color;
            }
            List<RowDto> parsedRows = new ArrayList<>();
            Set<String> uniqueVcs = new HashSet<>();
            Set<String> uniqueMaterials = new HashSet<>();

            while (rows.hasNext()) {
                Row r = rows.next();
                if (r == null) continue;
                String vc = safeFmt(r, colIndex, vcKey, fmt);
                if (vc.isBlank()) continue;
                uniqueVcs.add(vc);

                RowDto dto = new RowDto();
                dto.vc = vc;
                dto.item = safeFmt(r, colIndex, "item", fmt);
                dto.level = safeFmt(r, colIndex, "level", fmt);
                dto.material = safeFmt(r, colIndex, materialKey, fmt);
                dto.description = safeFmt(r, colIndex, "description", fmt);
                String q = safeFmt(r, colIndex, "quantity", fmt);
                if (!q.isBlank()) {
                    try { dto.quantity = new BigDecimal(q.trim()); }
                    catch (Exception ex) { dto.quantity = BigDecimal.ZERO; }
                }
                dto.uom = safeFmt(r, colIndex, "uom", fmt);
                dto.bulkInd = safeFmt(r, colIndex, "bulk_ind", fmt);
                dto.procurement = safeFmt(r, colIndex, "procurement", fmt);
                dto.spProc = safeFmt(r, colIndex, "sp_proc", fmt);
                dto.model = safeFmt(r, colIndex, "model", fmt);
                dto.variant = safeFmt(r, colIndex, "variant", fmt);
                dto.color = safeFmt(r, colIndex, "color", fmt);

                if (dto.material != null && !dto.material.isBlank()) uniqueMaterials.add(dto.material);
                parsedRows.add(dto);
            }

            int totalParts = parsedRows.size();
            int kittingParts = 0;
            int sequencingParts = 0;
            int notKittingSequencingParts = 0;
            int pendingHardwareParts = 0;

            List<VCDetails> foundVcDetails = vcDetailsRepo.findByVcIn(uniqueVcs);
            Set<String> foundVcSet = foundVcDetails.stream().map(VCDetails::getVc).collect(Collectors.toSet());
            List<String> missingVcs = uniqueVcs.stream().filter(v -> !foundVcSet.contains(v)).sorted().collect(Collectors.toList());
            if (!missingVcs.isEmpty()) return ProcessingResult.errorMissingVcs(missingVcs);

            List<PartMaster> foundParts = partRepo.findAllById(uniqueMaterials);
            Map<String, PartMaster> partMap = foundParts.stream().collect(Collectors.toMap(PartMaster::getPartNumber, p -> p));

            List<MacArticle> foundMacs = macRepo.findByItemCodeIn(uniqueMaterials);
            Set<String> partsWithHardware = foundMacs.stream()
                    .map(MacArticle::getItemCode)
                    .collect(Collectors.toSet());

            List<VcBomMap> toInsert = new ArrayList<>();
            for (RowDto dto : parsedRows) {
                if (dto.material == null || dto.material.isBlank()) { notKittingSequencingParts++; continue; }

                PartMaster pm = partMap.get(dto.material);
                if (pm == null) { notKittingSequencingParts++; continue; }

                boolean hasHardware = partsWithHardware.contains(dto.material);
                String type = pm.getType();
                String classification = "UNKNOWN";

                if ("P2L".equalsIgnoreCase(type)) {
                    if (hasHardware) {
                        classification = "KITTING";
                        kittingParts++;
                    } else {
                        classification = "KITTING_PENDING_HARDWARE";
                        pendingHardwareParts++;
                    }
                }
                else if ("SP".equalsIgnoreCase(type)) {
                    classification = "SEQUENCING";
                    sequencingParts++;
                }
                else {
                    notKittingSequencingParts++;
                    continue;
                }

                VcBomMap m = new VcBomMap();
                m.setVc(dto.vc);
                m.setItem(dto.item);
                m.setLevel(dto.level);
                m.setMaterial(dto.material);
                m.setDescription(dto.description);
                m.setQuantity(dto.quantity);
                m.setUom(dto.uom);
                m.setBulkInd(dto.bulkInd);
                m.setProcurement(dto.procurement);
                m.setSpProc(dto.spProc);
                m.setModel(dto.model);
                m.setVariant(dto.variant);
                m.setColor(dto.color);
                m.setClassification(classification);

                toInsert.add(m);
            }

            if (!uniqueVcs.isEmpty()) bomRepo.deleteByVcIn(uniqueVcs);

            for (int i = 0; i < toInsert.size(); i += BATCH_SIZE) {
                int end = Math.min(i + BATCH_SIZE, toInsert.size());
                bomRepo.saveAll(toInsert.subList(i, end));
            }

            return ProcessingResult.success(new ArrayList<>(uniqueVcs),
                    totalParts, kittingParts, sequencingParts, notKittingSequencingParts, pendingHardwareParts);

        } catch (Exception ex) {
            throw new RuntimeException("Failed to process BOM: " + ex.getMessage(), ex);
        }
    }

    /**
     * NEW STREAMING API: Processes up to 1 Million rows without crashing RAM.
     * Uses the Triple Sync validation strategy and heavy SLF4J logging.
     */
    @Transactional
    public ProcessingResult processLargeBomFile(MultipartFile file, String uploadedBy) {
        log.info("======================================================");
        log.info("🚀 STARTING LARGE BOM UPLOAD. Uploaded By: {}", uploadedBy);
        log.info("File Size: {} bytes", file.getSize());

        try (InputStream is = file.getInputStream();
             Workbook workbook = StreamingReader.builder()
                     .rowCacheSize(100)    // Keep only 100 rows in memory at a time
                     .bufferSize(4096)     // Standard buffer size
                     .open(is)) {          // Opens the stream

            log.info("✅ Excel file opened successfully via StreamingReader.");

            Sheet sheet = workbook.getSheetAt(0);
            if (sheet == null) {
                log.error("❌ Excel sheet is missing/null.");
                throw new IllegalArgumentException("Excel sheet missing");
            }

            Iterator<Row> rows = sheet.iterator();
            if (!rows.hasNext()) {
                log.error("❌ Excel sheet is completely empty.");
                throw new IllegalArgumentException("Empty sheet");
            }

            // --- header mapping ---
            Row headerRow = rows.next();
            DataFormatter fmt = new DataFormatter();
            Map<String, Integer> colIndex = new HashMap<>();
            for (int c = 0; c < headerRow.getLastCellNum(); c++) {
                Cell cell = headerRow.getCell(c);
                if (cell == null) continue;
                String raw = fmt.formatCellValue(cell);
                if (raw == null) continue;
                colIndex.put(raw.trim().toLowerCase().replace(" ", "_"), c);
            }

            log.info("✅ Headers mapped successfully. Found {} columns.", colIndex.size());

            String vcKey = colIndex.containsKey("vc") ? "vc" :
                    (headerRow.getCell(0) != null ? fmt.formatCellValue(headerRow.getCell(0)).trim().toLowerCase().replace(" ", "_") : "vc");

            String materialKey = colIndex.containsKey("material") ? "material" :
                    (colIndex.containsKey("part_number") ? "part_number" : null);

            if (materialKey == null) {
                log.error("❌ Could not find 'MATERIAL' or 'PART_NUMBER' in headers!");
                throw new IllegalArgumentException("Expected header 'MATERIAL' or 'PART_NUMBER' not found in Excel");
            }

            class RowDto {
                String vc; String item; String level; String material; String description;
                BigDecimal quantity; String uom; String bulkInd; String procurement; String spProc;
                String model; String variant; String color;
            }

            List<RowDto> parsedRows = new ArrayList<>();
            Set<String> uniqueVcs = new HashSet<>();
            Set<String> uniqueMaterials = new HashSet<>();

            log.info("⏳ Starting to parse rows (This may take a moment for large files)...");

            int rowCount = 0;
            // As we iterate, the StreamingReader throws away old rows to save RAM
            while (rows.hasNext()) {
                rowCount++;
                if (rowCount % 50000 == 0) {
                    log.info("... Parsed {} rows so far ...", rowCount);
                }

                Row r = rows.next();
                if (r == null) continue;
                String vc = safeFmt(r, colIndex, vcKey, fmt);
                if (vc.isBlank()) continue;
                uniqueVcs.add(vc);

                RowDto dto = new RowDto();
                dto.vc = vc;
                dto.item = safeFmt(r, colIndex, "item", fmt);
                dto.level = safeFmt(r, colIndex, "level", fmt);
                dto.material = safeFmt(r, colIndex, materialKey, fmt);
                dto.description = safeFmt(r, colIndex, "description", fmt);
                String q = safeFmt(r, colIndex, "quantity", fmt);
                if (!q.isBlank()) {
                    try { dto.quantity = new BigDecimal(q.trim()); }
                    catch (Exception ex) { dto.quantity = BigDecimal.ZERO; }
                }
                dto.uom = safeFmt(r, colIndex, "uom", fmt);
                dto.bulkInd = safeFmt(r, colIndex, "bulk_ind", fmt);
                dto.procurement = safeFmt(r, colIndex, "procurement", fmt);
                dto.spProc = safeFmt(r, colIndex, "sp_proc", fmt);
                dto.model = safeFmt(r, colIndex, "model", fmt);
                dto.variant = safeFmt(r, colIndex, "variant", fmt);
                dto.color = safeFmt(r, colIndex, "color", fmt);

                if (dto.material != null && !dto.material.isBlank()) uniqueMaterials.add(dto.material);
                parsedRows.add(dto);
            }

            int totalParts = parsedRows.size();
            log.info("✅ Parsing complete. Total Valid Rows: {}. Unique VCs: {}", totalParts, uniqueVcs.size());

            int kittingParts = 0;
            int sequencingParts = 0;
            int notKittingSequencingParts = 0;
            int pendingHardwareParts = 0;

            log.info("⏳ SYNC 1: Validating VCs against Database...");
            List<VCDetails> foundVcDetails = vcDetailsRepo.findByVcIn(uniqueVcs);
            Set<String> foundVcSet = foundVcDetails.stream().map(VCDetails::getVc).collect(Collectors.toSet());
            List<String> missingVcs = uniqueVcs.stream().filter(v -> !foundVcSet.contains(v)).sorted().collect(Collectors.toList());

            if (!missingVcs.isEmpty()) {
                log.warn("⚠️ Upload Rejected: Found {} missing VCs.", missingVcs.size());
                return ProcessingResult.errorMissingVcs(missingVcs);
            }

            log.info("⏳ SYNC 2: Loading Part Master Data...");
            List<PartMaster> foundParts = partRepo.findAllById(uniqueMaterials);
            Map<String, PartMaster> partMap = foundParts.stream().collect(Collectors.toMap(PartMaster::getPartNumber, p -> p));

            log.info("⏳ SYNC 3: Loading MAC Hardware Mapping...");
            List<MacArticle> foundMacs = macRepo.findByItemCodeIn(uniqueMaterials);
            Set<String> partsWithHardware = foundMacs.stream()
                    .map(MacArticle::getItemCode)
                    .collect(Collectors.toSet());

            log.info("⏳ Classifying parts and building DB entities...");
            List<VcBomMap> toInsert = new ArrayList<>();
            for (RowDto dto : parsedRows) {
                if (dto.material == null || dto.material.isBlank()) { notKittingSequencingParts++; continue; }

                PartMaster pm = partMap.get(dto.material);
                if (pm == null) { notKittingSequencingParts++; continue; }

                boolean hasHardware = partsWithHardware.contains(dto.material);
                String type = pm.getType();
                String classification = "UNKNOWN";

                if ("P2L".equalsIgnoreCase(type)) {
                    if (hasHardware) {
                        classification = "KITTING";
                        kittingParts++;
                    } else {
                        classification = "KITTING_PENDING_HARDWARE";
                        pendingHardwareParts++;
                    }
                }
                else if ("SP".equalsIgnoreCase(type)) {
                    classification = "SEQUENCING";
                    sequencingParts++;
                }
                else {
                    notKittingSequencingParts++;
                    continue;
                }

                VcBomMap m = new VcBomMap();
                m.setVc(dto.vc);
                m.setItem(dto.item);
                m.setLevel(dto.level);
                m.setMaterial(dto.material);
                m.setDescription(dto.description);
                m.setQuantity(dto.quantity);
                m.setUom(dto.uom);
                m.setBulkInd(dto.bulkInd);
                m.setProcurement(dto.procurement);
                m.setSpProc(dto.spProc);
                m.setModel(dto.model);
                m.setVariant(dto.variant);
                m.setColor(dto.color);
                m.setClassification(classification);

                toInsert.add(m);
            }

            log.info("⏳ Deleting old BOM mappings for updated VCs...");
            if (!uniqueVcs.isEmpty()) bomRepo.deleteByVcIn(uniqueVcs);

            log.info("⏳ Inserting {} new BOM records into the database in batches of {}...", toInsert.size(), BATCH_SIZE);
            for (int i = 0; i < toInsert.size(); i += BATCH_SIZE) {
                int end = Math.min(i + BATCH_SIZE, toInsert.size());
                bomRepo.saveAll(toInsert.subList(i, end));
            }

            log.info("✅ SUCCESS! Large BOM Upload complete.");
            log.info("======================================================");

            return ProcessingResult.success(new ArrayList<>(uniqueVcs),
                    totalParts, kittingParts, sequencingParts, notKittingSequencingParts, pendingHardwareParts);

        } catch (Exception ex) {
            // ✅ THE MOST IMPORTANT LOG: This prints the exact crash line
            log.error("❌ CRITICAL ERROR DURING LARGE BOM UPLOAD: ", ex);
            throw new RuntimeException("Failed to process Large BOM: " + ex.getMessage(), ex);
        }
    }

    private String safeFmt(Row r, Map<String, Integer> colIndex, String key, DataFormatter fmt) {
        Integer idx = colIndex.get(key);
        if (idx == null) return "";
        Cell c = r.getCell(idx, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL);
        return c == null ? "" : fmt.formatCellValue(c).trim();
    }

